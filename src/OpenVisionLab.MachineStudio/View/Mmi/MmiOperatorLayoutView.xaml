<UserControl x:Class="OpenVisionLab.MachineStudio.View.Mmi.MmiOperatorLayoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:OpenVisionLab.MachineStudio.Converter"
             xmlns:inspector="clr-namespace:OpenVisionLab.MachineStudio.View.Inspector"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behavior="clr-namespace:OpenVisionLab.MachineStudio.Behavior"
             xmlns:loc="clr-namespace:OpenVisionLab.MachineStudio.Localization"
             Margin="8,6,8,4">
    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <conv:ProjectImageSourceConverter x:Key="ProjectImageSourceConverter" />
        <conv:NumericalFramePreviewConverter x:Key="NumericalFramePreviewConverter" />
        <conv:KoreanWordWrappingConverter x:Key="PreparationWordWrapping" />
        <SolidColorBrush x:Key="Mmi.InspectionTabText" Color="{StaticResource Color.Text.Primary}" />
        <SolidColorBrush x:Key="Mmi.InspectionTabBackground" Color="{StaticResource Color.Surface.Raised}" />
        <SolidColorBrush x:Key="Mmi.InspectionTabBorder" Color="{StaticResource Color.Border.Default}" />
        <SolidColorBrush x:Key="Mmi.InspectionTabSelected" Color="{StaticResource Color.Accent.Soft}" />
        <SolidColorBrush x:Key="Mmi.InspectionTabHover" Color="{StaticResource Color.Surface.Hover}" />
        <SolidColorBrush x:Key="Mmi.InspectionTabAccent" Color="{StaticResource Color.Accent.Primary}" />
        <SolidColorBrush x:Key="Mmi.InspectionStage" Color="{StaticResource Color.Scene.ImageBackground}" />
        <SolidColorBrush x:Key="Mmi.InspectionInspector" Color="{StaticResource Color.Surface.Panel}" />
        <SolidColorBrush x:Key="Mmi.InspectionMuted" Color="{StaticResource Color.Text.Secondary}" />
        <Style x:Key="ProjectIntegrationFilterStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Style.Resources>
                <SolidColorBrush x:Key="ComboBoxBackground" Color="{Binding Color, Source={StaticResource Mmi.InspectionInspector}, Mode=OneWay}" />
                <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="{Binding Color, Source={StaticResource Mmi.InspectionInspector}, Mode=OneWay}" />
                <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{Binding Color, Source={StaticResource Mmi.InspectionTabHover}, Mode=OneWay}" />
                <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="{Binding Color, Source={StaticResource Surface.Panel}, Mode=OneWay}" />
                <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="{Binding Color, Source={StaticResource Mmi.InspectionTabAccent}, Mode=OneWay}" />
                <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="{Binding Color, Source={StaticResource Border.Default}, Mode=OneWay}" />
                <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="{Binding Color, Source={StaticResource Text.Disabled}, Mode=OneWay}" />
                <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{Binding Color, Source={StaticResource Mmi.InspectionInspector}, Mode=OneWay}" />
                <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{Binding Color, Source={StaticResource Mmi.InspectionTabBorder}, Mode=OneWay}" />
                <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="{Binding Color, Source={StaticResource Mmi.InspectionTabSelected}, Mode=OneWay}" />
                <SolidColorBrush x:Key="ComboBoxItemForeground" Color="{Binding Color, Source={StaticResource Mmi.InspectionTabText}, Mode=OneWay}" />
                <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="{Binding Color, Source={StaticResource Mmi.InspectionTabText}, Mode=OneWay}" />
                <SolidColorBrush x:Key="ComboBoxItemPillFillBrush" Color="{Binding Color, Source={StaticResource Mmi.InspectionTabAccent}, Mode=OneWay}" />
            </Style.Resources>
            <Setter Property="Background" Value="{StaticResource Mmi.InspectionInspector}" />
            <Setter Property="BorderBrush" Value="{StaticResource Mmi.InspectionTabBorder}" />
            <Setter Property="Foreground" Value="{StaticResource Mmi.InspectionTabText}" />
        </Style>
        <Style x:Key="CaptureToolbarToggleStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="{StaticResource Density.GlobalCommandButtonHeight}" />
            <Setter Property="MinWidth" Value="58" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            <Setter Property="Background" Value="{DynamicResource Surface.Raised}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ToggleBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource Accent.Soft}" />
                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource Surface.Hover}" />
                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource Accent.Hover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource Surface.Selected}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource Text.Disabled}" />
                                <Setter Property="Opacity" Value="0.55" />
                                <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource Surface.Panel}" />
                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid x:Name="MmiEmptyCameraWorkspace" UseLayoutRounding="False">
            <Grid.Resources>
                <SolidColorBrush x:Key="Camera.EmptyStage" Color="{StaticResource Color.Scene.ImageBackground}" />
                <SolidColorBrush x:Key="Camera.EmptyInspector" Color="{StaticResource Color.Surface.Panel}" />
                <SolidColorBrush x:Key="Camera.EmptyBorder" Color="{StaticResource Color.Border.Subtle}" />
                <SolidColorBrush x:Key="Camera.EmptyText" Color="{StaticResource Color.Text.Primary}" />
                <SolidColorBrush x:Key="Camera.EmptyMuted" Color="{StaticResource Color.Text.Secondary}" />
                <Style TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic" />
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="LineHeight" Value="18.85" />
                    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
                    <Setter Property="Foreground" Value="{StaticResource Camera.EmptyMuted}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Navigation.IsCompactLayout}" Value="True">
                            <Setter Property="FontSize" Value="12.5" /><Setter Property="LineHeight" Value="18.125" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Resources>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Camera.HasVirtualCamera}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                        <DataTrigger Binding="{Binding Navigation.SelectedInspectionSettingsTabIndex}" Value="3"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="5" /><ColumnDefinition Width="360" /></Grid.ColumnDefinitions>
            <Border x:Name="MmiEmptyCameraStage" Background="{StaticResource Camera.EmptyStage}">
                <StackPanel Width="420" MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="MmiEmptyCameraTitle" Text="{loc:Loc Key=R24.CameraEmptyTitle}" FontSize="14" FontWeight="Bold" LineHeight="20.3" TextAlignment="Center" />
                    <TextBlock x:Name="MmiEmptyCameraHint" Text="{loc:Loc Key=R24.CameraEmptyHint}" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
            </Border>
            <Border x:Name="MmiEmptyCameraInspector" Grid.Column="2" Background="{StaticResource Camera.EmptyInspector}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border Padding="12,9" BorderBrush="{StaticResource Camera.EmptyBorder}" BorderThickness="0,0,0,1">
                        <TextBlock x:Name="MmiEmptyCameraInspectorTitle" Text="{loc:Loc Key=Workspace.Execution}" FontWeight="Bold" Foreground="{StaticResource Camera.EmptyText}" />
                    </Border>
                    <StackPanel Grid.Row="1" Margin="12" VerticalAlignment="Top">
                        <TextBlock x:Name="MmiEmptyCameraInspectorHint" Text="{loc:Loc Key=R24.CameraEmptyInspector}" TextWrapping="Wrap" />
                        <Button x:Name="MmiEmptyCameraIntegrationButton" Margin="0,10,0,0" HorizontalAlignment="Left" Command="{Binding Navigation.OpenInspectionStatusCommand}"
                                Content="{loc:Loc Key=Camera.InspectionConnection}" AutomationProperties.Name="{loc:Loc Key=Camera.InspectionConnection}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    <Border x:Name="MmiCameraConfiguredWorkspace" Padding="0"
            Background="{StaticResource Mmi.InspectionInspector}"
            BorderBrush="{DynamicResource Accent.Primary}"
            BorderThickness="0"
            CornerRadius="0">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Camera.HasVirtualCamera}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                    <DataTrigger Binding="{Binding Navigation.SelectedInspectionSettingsTabIndex}" Value="3"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid x:Name="MmiInspectionLayoutGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="MmiInspectionPreviewColumn" MinWidth="300">
                    <ColumnDefinition.Style>
                        <Style TargetType="ColumnDefinition">
                            <Setter Property="Width" Value="*" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Navigation.IsCompactLayout}" Value="True">
                                    <Setter Property="Width" Value="*" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Navigation.IsInspectionSettingsExpanded}" Value="True">
                                    <Setter Property="Width" Value="*" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
                <ColumnDefinition x:Name="MmiInspectionColumnGap">
                    <ColumnDefinition.Style>
                        <Style TargetType="ColumnDefinition">
                            <Setter Property="Width" Value="5" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Navigation.IsCompactLayout}" Value="True">
                                    <Setter Property="Width" Value="5" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Navigation.IsNarrowLayout}" Value="True">
                                    <Setter Property="Width" Value="0" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Navigation.IsInspectionSettingsExpanded}" Value="True">
                                    <Setter Property="Width" Value="12" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
                <ColumnDefinition x:Name="MmiInspectionSetupColumn">
                    <ColumnDefinition.Style>
                        <Style TargetType="ColumnDefinition">
                            <Setter Property="Width" Value="360" />
                            <Setter Property="MinWidth" Value="310" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Navigation.IsCompactLayout}" Value="True">
                                    <Setter Property="Width" Value="360" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Navigation.IsNarrowLayout}" Value="True">
                                    <Setter Property="Width" Value="0" />
                                    <Setter Property="MinWidth" Value="0" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Navigation.IsInspectionSettingsExpanded}" Value="True">
                                    <Setter Property="Width" Value="*" />
                                    <Setter Property="MinWidth" Value="310" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Grid x:Name="MmiInspectionHeader" Grid.Row="4" Grid.Column="0" Margin="0,8,0,0">
                <WrapPanel x:Name="MmiInspectionHeaderActions" VerticalAlignment="Center">
                <Button x:Name="MmiReturnToResultsButton" Content="{loc:Loc Key=RunHistory.ReturnToAnalysis}" Command="{Binding Navigation.ReturnToResultsCommand}"
                        Visibility="{Binding Navigation.HasResultSettingsReturn, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Style="{StaticResource GlobalCommandButtonStyle}" AutomationProperties.Name="{loc:Loc Key=RunHistory.ReturnToAnalysis}" />
                <Button x:Name="MmiPublishButton"
                        Margin="0,0,5,4"
                        Command="{Binding Integration.PublishInspectionHandoffCommand}"
                        Content="{Binding Integration.PublishInspectionHandoffCaption}"
                        Style="{StaticResource PrimaryCommandButtonStyle}"
                        ToolTip="{Binding Integration.PublishInspectionHandoffTooltip}"
                        AutomationProperties.Name="{Binding Integration.PublishInspectionHandoffCaption}" />
                <DockPanel x:Name="MmiCameraHeader" LastChildFill="True" Margin="0,0,12,0">
                    <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" Text="{loc:Loc Key=Camera.CaptureStation}" />
                    <ComboBox x:Name="MmiCameraSelectionComboBox" MinHeight="34" MaxWidth="340" HorizontalAlignment="Left"
                              IsEnabled="{Binding Camera.HasVirtualCamera}" ItemsSource="{Binding Camera.VirtualCameras}"
                              SelectedValuePath="Id" SelectedValue="{Binding Camera.SelectedCameraId, Mode=OneWay}"
                              AutomationProperties.Name="{loc:Loc Key=Camera.CaptureStation}">
                        <ComboBox.ItemTemplate><DataTemplate>
                            <TextBlock TextWrapping="Wrap"><TextBlock.Text><MultiBinding StringFormat="{}{0} / {1}"><Binding Path="Name" /><Binding Path="Id" /></MultiBinding></TextBlock.Text></TextBlock>
                        </DataTemplate></ComboBox.ItemTemplate>
                        <b:Interaction.Behaviors><behavior:ComboBoxSelectionCommandBehavior Command="{Binding Camera.SelectCameraCommand}" /></b:Interaction.Behaviors>
                    </ComboBox>
                </DockPanel>
                    <Border x:Name="MmiInspectionStatusPill" Style="{StaticResource StatusPillStyle}" Padding="7,3" Margin="0,0,6,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Camera.CurrentCaptureOutputText}" />
                    </Border>
                    <ToggleButton x:Name="MmiInspectionSettingsToggle" IsChecked="{Binding Navigation.IsInspectionSettingsExpanded, Mode=TwoWay}"
                                  AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}}">
                        <ToggleButton.Style><Style TargetType="ToggleButton" BasedOn="{StaticResource CaptureToolbarToggleStyle}">
                            <Setter Property="Content" Value="{loc:Loc Key=Integration.MmiSettingsWide}" />
                            <Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Content" Value="{loc:Loc Key=Integration.MmiShowInputWithSettings}" /></Trigger></Style.Triggers>
                        </Style></ToggleButton.Style>
                    </ToggleButton>
                    <ToggleButton x:Name="MmiRunInputsButton" Content="{loc:Loc Key=Camera.RunInputs}" Style="{StaticResource CaptureToolbarToggleStyle}"
                                  IsEnabled="{Binding Camera.HasCurrentCameraInputs}" AutomationProperties.Name="{loc:Loc Key=Camera.RunInputs}" />
                    <Button x:Name="MmiInspectionStatusButton" Content="{loc:Loc Key=Integration.MmiInspectionStatus}" Style="{StaticResource GlobalCommandButtonStyle}"
                            Command="{Binding Navigation.OpenInspectionStatusCommand}" AutomationProperties.Name="{loc:Loc Key=Integration.MmiInspectionStatus}" />
                    <Button x:Name="MmiEquipmentLocationButton" Content="{loc:Loc Key=Camera.EquipmentLocation}" Style="{StaticResource GlobalCommandButtonStyle}"
                            Command="{Binding ShowCameraEquipmentLocationCommand}" AutomationProperties.Name="{loc:Loc Key=Camera.EquipmentLocation}" />
                </WrapPanel>
                <Popup x:Name="MmiRunInputsPopup" PlacementTarget="{Binding ElementName=MmiRunInputsButton}" Placement="Bottom"
                       IsOpen="{Binding IsChecked, ElementName=MmiRunInputsButton, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True">
                    <Border DataContext="{Binding DataContext, ElementName=MmiInspectionLayoutGrid}" Width="440" MaxHeight="420" Padding="12" Background="{DynamicResource Surface.Panel}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="5">
                        <ScrollViewer x:Name="MmiInputHeaderScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Key=Camera.CurrentInputs}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <ComboBox x:Name="MmiCurrentInputComboBox" MinHeight="34" IsEnabled="{Binding Camera.HasCurrentCameraInputs}"
                                          ItemsSource="{Binding Camera.CurrentCameraInputs}" SelectedValuePath="Id"
                                          SelectedValue="{Binding Camera.SelectedCameraId, Mode=OneWay}" AutomationProperties.Name="{loc:Loc Key=Camera.CurrentInputs}">
                                    <ComboBox.ItemTemplate><DataTemplate><StackPanel>
                                        <TextBlock TextWrapping="Wrap"><TextBlock.Text><MultiBinding StringFormat="{}{0} / {1}"><Binding Path="Name" /><Binding Path="Id" /></MultiBinding></TextBlock.Text></TextBlock>
                                        <TextBlock Text="{Binding StateText}" TextWrapping="Wrap" />
                                    </StackPanel></DataTemplate></ComboBox.ItemTemplate>
                                    <b:Interaction.Behaviors><behavior:ComboBoxSelectionCommandBehavior Command="{Binding Camera.SelectCameraCommand}" /></b:Interaction.Behaviors>
                                </ComboBox>
                                                            <Expander x:Name="MmiCurrentInputDetails" Margin="0,0,0,6">
                                <Expander.Header>
                                    <TextBlock x:Name="MmiCurrentInputSummary" FontWeight="SemiBold"
                                               Text="{Binding Camera.CurrentInputSummaryText}" TextWrapping="Wrap" />
                                </Expander.Header>
                                <ScrollViewer x:Name="MmiCurrentInputDetailsScrollViewer" MaxHeight="180"
                                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Margin="8,4">
                                        <TextBlock
                                                   Margin="0,2,0,6"
                                                   Foreground="{DynamicResource Text.Secondary}"
                                                   Text="{loc:Loc Key=Integration.MmiCaptureInspectionImagesHint}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Foreground="{DynamicResource Text.Secondary}"
                                                   Text="{loc:Loc Key=Camera.LatestInputsOnly}" TextWrapping="Wrap" />
                                        <TextBlock x:Name="MmiCurrentInputContext" Foreground="{DynamicResource Text.Secondary}"
                                                   Text="{Binding Camera.SelectedInputContextText}" TextWrapping="Wrap" />
                                        <TextBlock x:Name="MmiCurrentInputStepContext" Foreground="{DynamicResource Text.Secondary}"
                                                   Text="{Binding Camera.SelectedInputStepContextText}" TextWrapping="Wrap" />
                                        <TextBlock x:Name="MmiCurrentInputAcquisition" Foreground="{DynamicResource Text.Secondary}"
                                                   Text="{Binding Camera.SelectedInputAcquisitionText}" TextWrapping="Wrap" />
                                        <TextBlock Margin="0,2,0,0"
                                                   Foreground="{DynamicResource Text.Secondary}"
                                                   Text="{Binding Camera.CurrentCameraInputKindText}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="0,2,0,0"
                                                   Foreground="{DynamicResource Text.Secondary}"
                                                   Text="{Binding Camera.CurrentCameraSourceModeText}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>

            <Grid x:Name="MmiInspectionSetupPanel" Grid.RowSpan="5">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Grid.Row" Value="0" />
                        <Setter Property="Grid.Column" Value="2" />
                        <Setter Property="Grid.ColumnSpan" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Navigation.IsNarrowLayout}" Value="True">
                                <Setter Property="Grid.Row" Value="0" />
                                <Setter Property="Grid.Column" Value="0" />
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Navigation.IsInspectionSettingsExpanded}" Value="True">
                                <Setter Property="Grid.Row" Value="0" />
                                <Setter Property="Grid.Column" Value="2" />
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <TabControl x:Name="MmiInspectionSettingsTabs"
                            SelectedIndex="{Binding Navigation.SelectedInspectionSettingsTabIndex, Mode=TwoWay}">
                    <TabControl.Template>
                        <ControlTemplate TargetType="TabControl">
                            <Grid KeyboardNavigation.TabNavigation="Local">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Border x:Name="MmiSettingsIdentityHeader" Padding="12,9" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,0,1">
                                    <StackPanel>
                                        <Grid x:Name="MmiSettingsCameraIdentity" MinHeight="22" Margin="0,0,0,6">
                                            <Grid.Style><Style TargetType="Grid">
                                                <Style.Triggers><DataTrigger Binding="{Binding Camera.SelectedVirtualCamera}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                            </Style></Grid.Style>
                                            <Grid.Resources>
                                                <Style x:Key="MmiSettingsIdentityText" TargetType="TextBlock">
                                                    <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic" /><Setter Property="FontSize" Value="13" />
                                                    <Setter Property="LineHeight" Value="18.85" /><Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
                                                    <Setter Property="Foreground" Value="{StaticResource Mmi.InspectionTabText}" /><Setter Property="VerticalAlignment" Value="Center" />
                                                    <Style.Triggers><DataTrigger Binding="{Binding Navigation.IsCompactLayout}" Value="True">
                                                        <Setter Property="FontSize" Value="12.5" /><Setter Property="LineHeight" Value="18.125" />
                                                    </DataTrigger></Style.Triggers>
                                                </Style>
                                            </Grid.Resources>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock x:Name="MmiSettingsCameraIcon" Margin="0,0,8,0" Foreground="{DynamicResource State.Vision}">
                                                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource MmiSettingsIdentityText}">
                                                    <Setter Property="Text" Value="▣" /><Setter Property="FontWeight" Value="Normal" />
                                                    <Style.Triggers><DataTrigger Binding="{Binding Camera.SelectedVirtualCamera.Camera.NumericalInput.InputKind}" Value="HeightMap3D"><Setter Property="Text" Value="▤" /></DataTrigger></Style.Triggers>
                                                </Style></TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock x:Name="MmiSettingsCameraName" Grid.Column="1" Text="{Binding Camera.SelectedVirtualCamera.Name, Mode=OneWay}" Style="{StaticResource MmiSettingsIdentityText}"
                                                       FontWeight="Bold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Camera.SelectedVirtualCamera.Name}" />
                                            <TextBlock x:Name="MmiSettingsCameraId" Grid.Column="2" Margin="8,0,0,0" MaxWidth="150" Text="{Binding Camera.SelectedVirtualCamera.Id, Mode=OneWay}"
                                                       Style="{StaticResource MmiSettingsIdentityText}" FontSize="11.5" FontWeight="Normal" LineHeight="16.675" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" />
                                            <Border x:Name="MmiSettingsCameraTypeChip" Grid.Column="3" Margin="8,0,0,0" Padding="9,1" MinHeight="22" VerticalAlignment="Center"
                                                    CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource Border.Default}" Background="{DynamicResource Surface.Tinted}">
                                                <TextBlock x:Name="MmiSettingsCameraType" FontSize="11.5" FontWeight="Normal" LineHeight="16.675">
                                                    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource MmiSettingsIdentityText}">
                                                        <Setter Property="Text" Value="{loc:Loc Key=Camera.TwoDImage}" />
                                                        <Style.Triggers><DataTrigger Binding="{Binding Camera.SelectedVirtualCamera.Camera.NumericalInput.InputKind}" Value="HeightMap3D"><Setter Property="Text" Value="{loc:Loc Key=Camera.HeightMap3D}" /></DataTrigger></Style.Triggers>
                                                    </Style></TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                        <TabPanel IsItemsHost="True" />
                                        <Grid x:Name="MmiPreparationPanel" Margin="0,8,0,0">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Camera.SelectedVirtualCamera}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding Navigation.SelectedInspectionSettingsTabIndex}" Value="3"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Expander x:Name="MmiCameraPreparation" IsExpanded="False" AutomationProperties.Name="{loc:Loc Key=R40.CapturePreparation}">
                                                <Expander.Header>
                                                    <WrapPanel>
                                                        <TextBlock Text="{loc:Loc Key=R40.CapturePreparation}" />
                                                        <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                                                            <TextBlock Text="{loc:Loc Key=R40.LinkedCaptureSteps}" Foreground="{DynamicResource Text.Secondary}" />
                                                            <TextBlock x:Name="MmiPreparationStepCount" Text="{Binding Camera.CurrentAcquisitionSteps.Count}" Margin="4,0,0,0" />
                                                        </StackPanel>
                                                    </WrapPanel>
                                                </Expander.Header>
                                                <ScrollViewer x:Name="MmiPreparationDetails" MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                    <StackPanel Margin="0,4,0,8">
