<UserControl x:Class="OpenVisionLab.MachineStudio.View.Mmi.MmiOperatorLayoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:OpenVisionLab.MachineStudio.Converter"
             xmlns:inspector="clr-namespace:OpenVisionLab.MachineStudio.View.Inspector"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behavior="clr-namespace:OpenVisionLab.MachineStudio.Behavior"
             xmlns:loc="clr-namespace:OpenVisionLab.MachineStudio.Localization"
             Margin="8,6,8,4">
    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <conv:ProjectImageSourceConverter x:Key="ProjectImageSourceConverter" />
    </UserControl.Resources>
    <Border Padding="10,8"
            Background="{DynamicResource Surface.Panel}"
            BorderBrush="{DynamicResource Accent.Primary}"
            BorderThickness="1"
            CornerRadius="6">
        <Grid x:Name="MmiInspectionLayoutGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="MmiInspectionPreviewColumn" MinWidth="300">
                    <ColumnDefinition.Style>
                        <Style TargetType="ColumnDefinition">
                            <Setter Property="Width" Value="1.25*" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Navigation.IsCompactLayout}" Value="True">
                                    <Setter Property="Width" Value="*" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Navigation.IsInspectionSettingsExpanded}" Value="True">
                                    <Setter Property="MinWidth" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
                <ColumnDefinition x:Name="MmiInspectionColumnGap">
                    <ColumnDefinition.Style>
                        <Style TargetType="ColumnDefinition">
                            <Setter Property="Width" Value="18" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Navigation.IsCompactLayout}" Value="True">
                                    <Setter Property="Width" Value="12" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Navigation.IsNarrowLayout}" Value="True">
                                    <Setter Property="Width" Value="0" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Navigation.IsInspectionSettingsExpanded}" Value="True">
                                    <Setter Property="Width" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
                <ColumnDefinition x:Name="MmiInspectionSetupColumn">
                    <ColumnDefinition.Style>
                        <Style TargetType="ColumnDefinition">
                            <Setter Property="Width" Value="0.75*" />
                            <Setter Property="MinWidth" Value="310" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Navigation.IsCompactLayout}" Value="True">
                                    <Setter Property="Width" Value="330" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Navigation.IsNarrowLayout}" Value="True">
                                    <Setter Property="Width" Value="0" />
                                    <Setter Property="MinWidth" Value="0" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Navigation.IsInspectionSettingsExpanded}" Value="True">
                                    <Setter Property="Width" Value="0" />
                                    <Setter Property="MinWidth" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0">
                <DockPanel LastChildFill="True">
                    <TextBlock Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Text="{loc:Loc Key=Camera.SelectedCamera}" />
                    <ComboBox x:Name="MmiCameraSelectionComboBox"
                              MinHeight="34"
                              MaxWidth="440"
                              HorizontalAlignment="Left"
                              HorizontalContentAlignment="Stretch"
                              IsEnabled="{Binding Camera.HasVirtualCamera}"
                              ItemsSource="{Binding Camera.VirtualCameras}"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding Camera.SelectedCameraId, Mode=OneWay}"
                              AutomationProperties.Name="{loc:Loc Key=Camera.SelectedCamera}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                    <TextBlock Foreground="{DynamicResource Text.Secondary}" Text="{Binding Id}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                        <b:Interaction.Behaviors>
                            <behavior:ComboBoxSelectionCommandBehavior Command="{Binding Camera.SelectCameraCommand}" />
                        </b:Interaction.Behaviors>
                    </ComboBox>
                </DockPanel>
                <TextBlock Margin="0,2,0,0"
                           Foreground="{DynamicResource Text.Secondary}"
                           Text="{Binding Camera.CurrentCameraInputKindText}"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,2,0,0"
                           Foreground="{DynamicResource Text.Secondary}"
                           Text="{Binding Camera.CurrentCameraSourceModeText}"
                           TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel x:Name="MmiInspectionHeaderActions"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Grid.Row" Value="0" />
                        <Setter Property="Grid.Column" Value="2" />
                        <Setter Property="Grid.ColumnSpan" Value="1" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="HorizontalAlignment" Value="Right" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Navigation.IsNarrowLayout}" Value="True">
                                <Setter Property="Grid.Row" Value="1" />
                                <Setter Property="Grid.Column" Value="0" />
                                <Setter Property="Margin" Value="0,4,0,0" />
                                <Setter Property="HorizontalAlignment" Value="Left" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Navigation.IsInspectionSettingsExpanded}" Value="True">
                                <Setter Property="Grid.Row" Value="1" />
                                <Setter Property="Grid.Column" Value="0" />
                                <Setter Property="Grid.ColumnSpan" Value="3" />
                                <Setter Property="Margin" Value="0,4,0,0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Border x:Name="MmiInspectionStatusPill"
                        Margin="0,0,6,0"
                        Padding="7,3" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource StatusPillStyle}" />
                    </Border.Style>
                    <TextBlock FontFamily="{StaticResource Typography.Telemetry}"
                               Foreground="{DynamicResource State.Vision}"
                               Text="{Binding ModeText}" />
                </Border>
                <ToggleButton x:Name="MmiInspectionSettingsToggle"
                              IsChecked="{Binding Navigation.IsInspectionSettingsExpanded, Mode=TwoWay}"
                              AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}}">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Height" Value="{StaticResource Density.GlobalCommandButtonHeight}" />
                            <Setter Property="MinWidth" Value="58" />
                            <Setter Property="Margin" Value="3,0" />
                            <Setter Property="Padding" Value="10,0" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                            <Setter Property="Background" Value="{DynamicResource Surface.Raised}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Content" Value="{loc:Loc Key=Integration.MmiSettingsWide}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ToggleBorder"
                                                Padding="{TemplateBinding Padding}"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource Accent.Soft}" />
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource Surface.Hover}" />
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource Accent.Hover}" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource Surface.Selected}" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Foreground" Value="{DynamicResource Text.Disabled}" />
                                                <Setter Property="Opacity" Value="0.55" />
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource Surface.Panel}" />
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
                                                <Setter Property="Cursor" Value="Arrow" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Navigation.IsInspectionSettingsExpanded}" Value="True">
                                    <Setter Property="Content" Value="{loc:Loc Key=Integration.MmiShowInputWithSettings}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
            </StackPanel>

            <Grid x:Name="MmiInspectionSetupPanel" Margin="0,8,0,0">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Grid.Row" Value="2" />
                        <Setter Property="Grid.Column" Value="2" />
                        <Setter Property="Grid.ColumnSpan" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Navigation.IsNarrowLayout}" Value="True">
                                <Setter Property="Grid.Row" Value="3" />
                                <Setter Property="Grid.Column" Value="0" />
                                <Setter Property="MaxHeight" Value="220" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Navigation.IsInspectionSettingsExpanded}" Value="True">
                                <Setter Property="Grid.Row" Value="2" />
                                <Setter Property="Grid.Column" Value="0" />
                                <Setter Property="Grid.ColumnSpan" Value="3" />
                                <Setter Property="MaxHeight" Value="Infinity" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <TabControl x:Name="MmiInspectionSettingsTabs"
                            SelectedIndex="{Binding Navigation.SelectedInspectionSettingsTabIndex, Mode=TwoWay}">
                    <TabItem Header="{loc:Loc Key=Camera.CaptureSetup}">
                        <Grid Margin="12" DataContext="{Binding Camera}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding CameraCommissioningHintText}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Text.Secondary}" />
                            <TextBlock Grid.Row="1" Margin="0,10,0,3" Text="{loc:Loc Key=Camera.Recipe}" />
                            <ComboBox Grid.Row="2" ItemsSource="{Binding CurrentCameraRecipes}"
                                      SelectedItem="{Binding SelectedCameraRecipe, Mode=TwoWay}"
                                      AutomationProperties.Name="{loc:Loc Key=Camera.Recipe}" />
                            <inspector:CameraImageSourceView x:Name="MmiCameraSourceSettings" Grid.Row="3" />
                        </Grid>
                    </TabItem>
                    <TabItem Header="{loc:Loc Key=Integration.ExternalSetup}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid x:Name="MmiExternalInspectionSettingsGrid" Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition>
                        <ColumnDefinition.Style>
                            <Style TargetType="ColumnDefinition">
                                <Setter Property="Width" Value="*" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Navigation.IsInspectionSettingsExpanded}" Value="True">
                                        <Setter Property="Width" Value="2*" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ColumnDefinition.Style>
                    </ColumnDefinition>
                    <ColumnDefinition>
                        <ColumnDefinition.Style>
                            <Style TargetType="ColumnDefinition">
                                <Setter Property="Width" Value="0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Navigation.IsInspectionSettingsExpanded}" Value="True">
                                        <Setter Property="Width" Value="*" />
                                        <Setter Property="MinWidth" Value="220" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ColumnDefinition.Style>
                    </ColumnDefinition>
                </Grid.ColumnDefinitions>

                <Border x:Name="MmiMachineStateCard"
                        Margin="0,0,0,6"
                        Padding="8,7"
                        Background="{DynamicResource Surface.Raised}"
                        BorderBrush="{DynamicResource Border.Subtle}"
                        BorderThickness="1"
                        CornerRadius="5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Grid.Row" Value="0" />
                            <Setter Property="Grid.Column" Value="0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Navigation.IsInspectionSettingsExpanded}" Value="True">
                                    <Setter Property="Grid.Column" Value="1" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionCaptionStyle}"
                                   Text="{loc:Loc Key=Left.MachineState}" />
                        <TextBlock FontSize="15"
                                   FontWeight="SemiBold"
                                   Text="{Binding StateText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource State.Paused}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource State.Running}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Margin="0,3,0,0"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   Text="{Binding ControlOwnerText}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding ControlOwnerText}" />
                        <TextBlock Margin="0,2,0,0"
                                   Style="{StaticResource TelemetryTextStyle}"
                                   Text="{Binding SimulationStatusText}"
                                   TextWrapping="Wrap"
                                   ToolTip="{Binding SimulationStatusText}" />
                    </StackPanel>
                </Border>

                <Border x:Name="MmiInspectionRecipeCard"
                        Margin="0,0,0,6"
                        Padding="8,7"
                        Background="{DynamicResource Surface.Raised}"
                        BorderBrush="{DynamicResource Border.Subtle}"
                        BorderThickness="1"
                        CornerRadius="5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Grid.Row" Value="1" />
                            <Setter Property="Grid.Column" Value="0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Navigation.IsInspectionSettingsExpanded}" Value="True">
                                    <Setter Property="Grid.Row" Value="0" />
                                    <Setter Property="Grid.RowSpan" Value="2" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionCaptionStyle}"
                                   Text="{loc:Loc Key=Integration.MmiActiveRecipe}" />
                        <ComboBox x:Name="MmiActiveRecipeComboBox"
                                  MinHeight="30"
                                  AutomationProperties.Name="{loc:Loc Key=Integration.MmiActiveRecipe}"
                                  IsEnabled="{Binding Integration.Setup.HasRecipeCatalogItems}"
                                  ItemsSource="{Binding Integration.Setup.RecipeCatalogItems}"
                                  SelectedItem="{Binding Integration.Setup.SelectedRecipe, Mode=TwoWay}"
                                  ToolTip="{loc:Loc Key=Integration.InspectionActiveRecipeTooltip}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   TextWrapping="Wrap"
                                                   ToolTip="{Binding Path}" />
                                        <TextBlock Grid.Row="1"
                                                   Margin="0,2,0,0"
                                                   Foreground="{DynamicResource Text.Secondary}"
                                                   Text="{Binding AvailabilityText}" />
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Margin="0,3,0,0"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   Text="{Binding Integration.Setup.InspectionRecipePath}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Integration.Setup.InspectionRecipePath}" />
                        <TextBlock Margin="0,3,0,0"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   Text="{Binding Integration.Setup.InspectionRecipeStatusText}"
                                   TextWrapping="Wrap"
                                   ToolTip="{Binding Integration.Setup.InspectionRecipeStatusText}" />
                        <TextBlock Margin="0,2,0,0"
                                   FontFamily="{StaticResource Typography.Telemetry}"
                                   FontSize="9.5"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   Text="{Binding Integration.Setup.SetupSaveStateText}"
                                   TextWrapping="Wrap"
                                   ToolTip="{Binding Integration.Setup.SetupSaveStateText}" />
                        <WrapPanel Margin="0,5,0,0">
                            <Button x:Name="MmiAddRecipeButton"
                                    Margin="0,0,5,0"
                                    Command="{Binding Integration.Setup.AddRecipeCommand}"
                                    Content="{loc:Loc Key=Integration.MmiRecipeAdd}"
                                    Style="{StaticResource GlobalCommandButtonStyle}"
                                    ToolTip="{loc:Loc Key=Integration.InspectionRecipeAddTooltip}"
                                    AutomationProperties.Name="{loc:Loc Key=Integration.MmiRecipeAdd}" />
                            <Button x:Name="MmiRemoveRecipeButton"
                                    Command="{Binding Integration.Setup.RemoveRecipeCommand}"
                                    CommandParameter="{Binding Integration.Setup.SelectedRecipe}"
                                    Content="{loc:Loc Key=Integration.MmiRecipeRemove}"
                                    Style="{StaticResource GlobalCommandButtonStyle}"
                                    ToolTip="{loc:Loc Key=Integration.InspectionRecipeRemoveTooltip}"
                                    AutomationProperties.Name="{loc:Loc Key=Integration.MmiRecipeRemove}" />
                            <Button x:Name="MmiSaveSetupButton"
                                    Margin="0,5,5,0"
                                    Command="{Binding Integration.Setup.SaveSetupCommand}"
                                    Content="{loc:Loc Key=Integration.SaveSetup}"
                                    Style="{StaticResource PrimaryCommandButtonStyle}"
                                    ToolTip="{loc:Loc Key=Integration.SaveSetupTooltip}"
                                    AutomationProperties.Name="{loc:Loc Key=Integration.SaveSetup}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="MmiInspectionResultCard"
                        Padding="8,7"
                        Background="{DynamicResource Surface.Raised}"
                        BorderBrush="{DynamicResource Border.Subtle}"
                        BorderThickness="1"
                        CornerRadius="5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Grid.Row" Value="2" />
                            <Setter Property="Grid.Column" Value="0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Navigation.IsInspectionSettingsExpanded}" Value="True">
                                    <Setter Property="Grid.Row" Value="1" />
                                    <Setter Property="Grid.Column" Value="1" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionCaptionStyle}"
                                   Text="{loc:Loc Key=Integration.MmiInspectionStatus}" />
                        <TextBlock FontWeight="SemiBold"
                                   Text="{Binding Camera.CurrentCameraStateText}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Camera.CurrentCameraStateText}" />
                        <TextBlock Margin="0,2,0,0"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   Text="{Binding Camera.CurrentCameraResultText}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Camera.CurrentCameraResultText}" />
                        <TextBlock x:Name="MmiInspectionExecutionModeTextBlock"
                                   Margin="0,3,0,0"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   Text="{Binding Integration.InspectionExecutionModeText}"
                                   TextWrapping="Wrap"
                                   ToolTip="{Binding Integration.InspectionExecutionModeText}" />
                        <TextBlock x:Name="MmiResultStatusTextBlock"
                                   Margin="0,5,0,0"
                                   Foreground="{DynamicResource State.Vision}"
                                   Text="{Binding Integration.ResultStatusText}"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Integration.ResultStatusText}" />
                    </StackPanel>
                </Border>
                        </Grid>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>

            <Border x:Name="MmiInspectionPreviewPanel"
                    Grid.Row="2"
                    Grid.Column="0"
                    Margin="0,8,0,0"
                    Padding="8,7"
                    Background="{DynamicResource Surface.Raised}"
                    BorderBrush="{DynamicResource Border.Subtle}"
                    BorderThickness="1"
                    CornerRadius="5">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Navigation.IsInspectionSettingsExpanded}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <ScrollViewer x:Name="MmiInspectionPreviewScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource SectionCaptionStyle}"
                               Text="{loc:Loc Key=Integration.MmiCaptureInspectionImages}" />
                    <TextBlock Grid.Row="1"
                               Margin="0,2,0,6"
                               Foreground="{DynamicResource Text.Secondary}"
                               Text="{loc:Loc Key=Integration.MmiCaptureInspectionImagesHint}"
                               TextWrapping="Wrap" />
                    <StackPanel Grid.Row="2">
                        <TextBlock FontWeight="SemiBold"
                                   Text="{loc:Loc Key=Integration.MmiVirtualCameraImage}" />
                        <Border x:Name="MmiVirtualCameraImageFrame"
                                Margin="0,4,0,0"
                                Background="{DynamicResource Surface.Panel}"
                                BorderBrush="{DynamicResource Border.Subtle}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="MinHeight" Value="260" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Navigation.IsCompactLayout}" Value="True">
                                            <Setter Property="MinHeight" Value="180" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Navigation.IsNarrowLayout}" Value="True">
                                            <Setter Property="MinHeight" Value="240" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Image x:Name="MmiVirtualCameraImageViewer"
                                       Source="{Binding Camera.CurrentCameraImagePath, Converter={StaticResource ProjectImageSourceConverter}}"
                                       Stretch="Uniform"
                                       SnapsToDevicePixels="True"
                                       ToolTip="{Binding Camera.CurrentCameraSourceText}" />
                                <TextBlock Margin="8"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           Text="{loc:Loc Key=Integration.MmiVirtualCameraImageEmpty}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding Camera.HasCurrentCameraImage, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=invert}" />
                            </Grid>
                        </Border>
                        <TextBlock Margin="0,4,0,0"
                                   FontFamily="{StaticResource Typography.Telemetry}"
                                   FontSize="9.5"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   Text="{Binding Camera.CurrentCameraSourceText}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Camera.CurrentCameraSourceText}" />
                    </StackPanel>
                    <Grid Grid.Row="3"
                          Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock FontWeight="SemiBold"
                                       Text="{loc:Loc Key=Integration.MmiTwoDImage}" />
                            <Border Height="150"
                                    Margin="0,4,0,0"
                                    Background="{DynamicResource Surface.Panel}"
                                    BorderBrush="{DynamicResource Border.Subtle}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <Grid>
                                    <Image x:Name="MmiTwoDImageViewer"
                                           Source="{Binding Integration.LatestTwoDImageUri}"
                                           Stretch="Uniform"
                                           SnapsToDevicePixels="True"
                                           ToolTip="{Binding Integration.LatestTwoDImageSourceText}" />
                                    <TextBlock Margin="8"
                                               HorizontalAlignment="Stretch"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource Text.Secondary}"
                                               Text="{Binding Integration.LatestTwoDImageStatusText}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding Integration.HasLatestTwoDImage, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=invert}" />
                                </Grid>
                            </Border>
                            <TextBlock Margin="0,4,0,0"
                                       FontFamily="{StaticResource Typography.Telemetry}"
                                       FontSize="9.5"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{Binding Integration.LatestTwoDImageSourceText}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Integration.LatestTwoDImageSourceText}" />
                            <TextBlock x:Name="MmiTwoDResultStatusTextBlock"
                                       Margin="0,2,0,0"
                                       Foreground="{DynamicResource State.Vision}"
                                       Text="{Binding Integration.LatestTwoDResultStatusText}"
                                       TextWrapping="Wrap"
                                       ToolTip="{Binding Integration.LatestTwoDResultStatusText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock FontWeight="SemiBold"
                                       Text="{loc:Loc Key=Integration.MmiThreeDImage}" />
                            <Border Height="150"
                                    Margin="0,4,0,0"
                                    Background="{DynamicResource Surface.Panel}"
                                    BorderBrush="{DynamicResource Border.Subtle}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <Grid>
                                    <Image x:Name="MmiThreeDImageViewer"
                                           Source="{Binding Integration.LatestThreeDImageUri}"
                                           Stretch="Uniform"
                                           SnapsToDevicePixels="True"
                                           ToolTip="{Binding Integration.LatestThreeDImageSourceText}" />
                                    <TextBlock Margin="8"
                                               HorizontalAlignment="Stretch"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource Text.Secondary}"
                                               Text="{Binding Integration.LatestThreeDImageStatusText}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding Integration.HasLatestThreeDImage, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=invert}" />
                                </Grid>
                            </Border>
                            <TextBlock Margin="0,4,0,0"
                                       FontFamily="{StaticResource Typography.Telemetry}"
                                       FontSize="9.5"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{Binding Integration.LatestThreeDImageSourceText}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Integration.LatestThreeDImageSourceText}" />
                            <TextBlock x:Name="MmiThreeDResultStatusTextBlock"
                                       Margin="0,2,0,0"
                                       Foreground="{DynamicResource State.Vision}"
                                       Text="{Binding Integration.LatestThreeDResultStatusText}"
                                       TextWrapping="Wrap"
                                       ToolTip="{Binding Integration.LatestThreeDResultStatusText}" />
                        </StackPanel>
                    </Grid>
                </Grid>
                </ScrollViewer>
            </Border>

            <WrapPanel Grid.Row="4"
                       Grid.ColumnSpan="3"
                       Margin="0,8,0,0">
                <Button x:Name="MmiPublishButton"
                        Margin="0,0,5,4"
                        Command="{Binding Integration.PublishTwoDImageHandoffCommand}"
                        Content="{loc:Loc Key=Integration.MmiCreateTwoDRequest}"
                        Style="{StaticResource PrimaryCommandButtonStyle}"
                        ToolTip="{loc:Loc Key=Integration.MmiCreateTwoDRequestTooltip}"
                        AutomationProperties.Name="{loc:Loc Key=Integration.MmiCreateTwoDRequest}" />
                <Button x:Name="MmiRefreshButton"
                        Margin="0,0,5,4"
                        Command="{Binding Integration.RefreshResultsCommand}"
                        Content="{loc:Loc Key=Integration.MmiCheckInspectionResult}"
                        Style="{StaticResource GlobalCommandButtonStyle}"
                        ToolTip="{loc:Loc Key=Integration.MmiCheckInspectionResultTooltip}"
                        AutomationProperties.Name="{loc:Loc Key=Integration.MmiCheckInspectionResult}" />
                <Button x:Name="MmiApplyResultButton"
                        Margin="0,0,5,4"
                        Command="{Binding Integration.ApplyResultToSimulationCommand}"
                        Content="{loc:Loc Key=Integration.MmiApplyInspectionResult}"
                        Style="{StaticResource GlobalCommandButtonStyle}"
                        ToolTip="{loc:Loc Key=Integration.MmiApplyInspectionResultTooltip}"
                        AutomationProperties.Name="{loc:Loc Key=Integration.MmiApplyInspectionResult}" />
            </WrapPanel>
        </Grid>
    </Border>
</UserControl>
