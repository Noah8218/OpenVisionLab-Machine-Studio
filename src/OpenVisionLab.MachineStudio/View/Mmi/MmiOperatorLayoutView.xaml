                                        </Grid>
                                        <WrapPanel Margin="0,12,0,0">
                                            <Button x:Name="MmiRefreshButton" Margin="0,0,5,4" Command="{Binding Integration.RefreshResultsCommand}" Content="{loc:Loc Key=Integration.MmiCheckInspectionResult}" Style="{StaticResource GlobalCommandButtonStyle}" ToolTip="{loc:Loc Key=Integration.MmiCheckInspectionResultTooltip}" AutomationProperties.Name="{loc:Loc Key=Integration.MmiCheckInspectionResult}"/>
                                            <Button x:Name="MmiApplyResultButton" Margin="0,0,5,4" Command="{Binding Integration.ApplyResultToSimulationCommand}" Content="{loc:Loc Key=Integration.MmiApplyInspectionResult}" Style="{StaticResource GlobalCommandButtonStyle}" ToolTip="{loc:Loc Key=Integration.MmiApplyInspectionResultTooltip}" AutomationProperties.Name="{loc:Loc Key=Integration.MmiApplyInspectionResult}"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource PanelSurfaceStyle}" Margin="0,12,0,0">
                                    <StackPanel x:Name="IntegrationTransactionHistorySection" AutomationProperties.AutomationId="ProjectIntegrationTransactionHistory" AutomationProperties.Name="{loc:Loc Key=R24.ProjectExchangeHistory}">
                                        <TextBlock Style="{StaticResource SectionCaptionStyle}" Text="{loc:Loc Key=R24.ProjectExchangeHistory}" TextWrapping="Wrap"/>
                                        <StackPanel Margin="0,8,0,0">
                                            <TextBlock Foreground="{DynamicResource Text.Secondary}" Text="{loc:Loc Key=R24.ProjectTransactionHistoryHint}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{loc:Loc Key=Integration.TransactionHistoryFilter}" Margin="0,8,0,0" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" />
                                            <ComboBox x:Name="IntegrationTransactionHistoryFilter" Style="{StaticResource ProjectIntegrationFilterStyle}" Margin="0,8,0,0" ItemsSource="{Binding Integration.TransactionHistoryFilters}" DisplayMemberPath="DisplayText" SelectedItem="{Binding Integration.SelectedTransactionHistoryFilter, Mode=TwoWay}" AutomationProperties.AutomationId="CentralIntegrationTransactionHistoryFilter" AutomationProperties.Name="{loc:Loc Key=Integration.TransactionHistoryFilter}"/>
                                            <TextBlock x:Name="IntegrationTransactionHistoryEmptyText" Margin="0,6,0,0" Foreground="{DynamicResource Text.Secondary}" Text="{Binding Integration.TransactionHistoryEmptyText}" TextWrapping="Wrap" Visibility="{Binding Integration.HasTransactionHistoryEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <ListBox x:Name="IntegrationTransactionHistoryList" Margin="0,6,0,0" MaxHeight="220" HorizontalContentAlignment="Stretch" ItemsSource="{Binding Integration.VisibleTransactionHistoryRows}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="CentralIntegrationTransactionHistoryList" AutomationProperties.Name="{loc:Loc Key=R24.ProjectExchangeHistory}">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="3,3">
                                                            <TextBlock FontWeight="SemiBold" Text="{Binding FullTransactionId}" TextWrapping="Wrap" ToolTip="{Binding FullTransactionId}"/>
                                                            <TextBlock Style="{StaticResource TelemetryTextStyle}" Text="{Binding Handoff.CreatedAtUtc}"/>
                                                            <TextBlock Foreground="{DynamicResource Text.Secondary}" Text="{Binding Handoff.Context.Modality}"/>
                                                            <TextBlock Foreground="{DynamicResource Text.Secondary}" Text="{Binding StatusText}" TextWrapping="Wrap" ToolTip="{Binding StatusText}"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource PanelSurfaceStyle}" Margin="0,12,0,0">
                                    <StackPanel x:Name="IntegrationTransactionDiagnosticsSection" AutomationProperties.AutomationId="ProjectIntegrationTransactionDiagnostics" AutomationProperties.Name="{loc:Loc Key=R24.ProjectExchangeDiagnostics}">
                                        <TextBlock Style="{StaticResource SectionCaptionStyle}" Text="{loc:Loc Key=R24.ProjectExchangeDiagnostics}" TextWrapping="Wrap"/>
                                        <StackPanel Margin="0,8,0,0">
                                            <TextBlock Foreground="{DynamicResource Text.Secondary}" Text="{loc:Loc Key=Integration.TransactionDiagnosticsFilterHint}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{loc:Loc Key=Integration.TransactionDiagnosticsFilter}" Margin="0,8,0,0" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" />
                                            <ComboBox x:Name="IntegrationTransactionDiagnosticsFilter" Style="{StaticResource ProjectIntegrationFilterStyle}" Margin="0,8,0,0" ItemsSource="{Binding Integration.TransactionDiagnosticFilters}" DisplayMemberPath="DisplayText" SelectedItem="{Binding Integration.SelectedTransactionDiagnosticFilter, Mode=TwoWay}" AutomationProperties.AutomationId="CentralIntegrationTransactionDiagnosticsFilter" AutomationProperties.Name="{loc:Loc Key=Integration.TransactionDiagnosticsFilter}"/>
                                            <TextBlock x:Name="IntegrationTransactionDiagnosticsReadErrorText" Margin="0,6,0,0" Foreground="{DynamicResource Text.Secondary}" Text="{Binding Integration.TransactionDiagnosticReadError}" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="IntegrationTransactionDiagnosticsEmptyText" Margin="0,6,0,0" Foreground="{DynamicResource Text.Secondary}" Text="{Binding Integration.TransactionDiagnosticsEmptyText}" TextWrapping="Wrap" Visibility="{Binding Integration.HasTransactionDiagnosticsEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <ListBox x:Name="IntegrationTransactionDiagnosticsList" Margin="0,6,0,0" MaxHeight="220" HorizontalContentAlignment="Stretch" ItemsSource="{Binding Integration.VisibleTransactionDiagnostics}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="CentralIntegrationTransactionDiagnosticsList" AutomationProperties.Name="{loc:Loc Key=R24.ProjectExchangeDiagnostics}">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="3,3">
                                                            <TextBlock FontWeight="SemiBold" Text="{Binding State}"/>
                                                            <TextBlock Style="{StaticResource TelemetryTextStyle}" Text="{Binding TransactionId}" TextWrapping="Wrap" ToolTip="{Binding TransactionId}"/>
                                                            <TextBlock Foreground="{DynamicResource Text.Secondary}" Text="{Binding Detail}" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Expander>
                        </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>

            <Border x:Name="MmiInspectionPreviewPanel" Grid.Row="0" Grid.RowSpan="4" Grid.Column="0" Padding="0"
                    Background="{StaticResource Mmi.InspectionStage}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0" CornerRadius="0">
                <ScrollViewer x:Name="MmiInspectionPreviewScrollViewer" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <DockPanel LastChildFill="True" Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Border Margin="3,0" Background="{DynamicResource Surface.Raised}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="4">
                                    <Menu Background="Transparent">
                                        <MenuItem x:Name="MmiSourceSummaryMenu" Header="{loc:Loc Key=Camera.Source}" Height="{StaticResource Density.GlobalCommandButtonHeight}" Padding="10,0"
                                                  Foreground="{DynamicResource Text.Primary}" Style="{StaticResource MachineTopMenuItemStyle}" AutomationProperties.Name="{loc:Loc Key=Camera.Source}">
                                            <MenuItem Height="Auto" Padding="8" StaysOpenOnClick="True" Style="{StaticResource MachineSubmenuItemStyle}">
                                                <MenuItem.Header>
                                                    <ScrollViewer x:Name="MmiSourceSummaryScrollViewer" Width="400" MaxHeight="280" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                        <StackPanel>
                                                            <TextBlock Text="{loc:Loc Key=Camera.Source}" FontWeight="SemiBold" />
                                                            <TextBlock x:Name="MmiAppliedSourceSummary" Text="{Binding Camera.CurrentCameraInputKindText}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                                            <TextBlock x:Name="MmiSourceActionHint" Text="{Binding Camera.CameraCommissioningHintText}" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}" Margin="0,3,0,0" />
                                                            <TextBlock Text="{loc:Loc Key=Camera.NumericalInputHint}" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" Margin="0,10,0,0" />
                                                        </StackPanel>
                                                    </ScrollViewer>
                                                </MenuItem.Header>
                                            </MenuItem>
                                        </MenuItem>
                                    </Menu>
                                </Border>
                                <RadioButton x:Name="MmiImageOutputButton" Content="{loc:Loc Key=Camera.TwoDImage}" Style="{StaticResource CaptureToolbarToggleStyle}" GroupName="CaptureOutput"
                                             Command="{Binding Camera.ShowInputOutputCommand}" CommandParameter="image" IsChecked="{Binding Camera.IsImageDataView, Mode=OneWay}" />
                                <RadioButton x:Name="MmiHeightOutputButton" Content="{loc:Loc Key=Camera.HeightData}" Style="{StaticResource CaptureToolbarToggleStyle}" GroupName="CaptureOutput"
                                             Command="{Binding Camera.ShowInputOutputCommand}" CommandParameter="height" IsChecked="{Binding Camera.IsHeightDataView, Mode=TwoWay}" />
                            </StackPanel>
                            <WrapPanel x:Name="MmiSelectedCameraIdentity" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="MmiSelectedCameraName" TextWrapping="Wrap"
                                           MaxWidth="{Binding ActualWidth, ElementName=MmiSelectedCameraIdentity}"
                                           FontFamily="Segoe UI, Malgun Gothic" Foreground="{StaticResource Mmi.InspectionTabText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Text" Value="{Binding Camera.SelectedVirtualCamera.Name, StringFormat=▣ {0}}" />
                                            <Setter Property="FontSize" Value="13" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                            <Setter Property="LineHeight" Value="18.85" />
                                            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Navigation.IsCompactLayout}" Value="True">
                                                    <Setter Property="FontSize" Value="12.5" />
                                                    <Setter Property="LineHeight" Value="18.125" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Camera.SelectedVirtualCamera.Camera.NumericalInput.InputKind}" Value="HeightMap3D">
                                                    <Setter Property="Text" Value="{Binding Camera.SelectedVirtualCamera.Name, StringFormat=▤ {0}}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Camera.CanShowHeightData}" Value="True">
                                                    <Setter Property="Text" Value="{Binding Camera.SelectedVirtualCamera.Name, StringFormat=▤ {0}}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Border Padding="8,0,0,0" VerticalAlignment="Center"
                                        MaxWidth="{Binding ActualWidth, ElementName=MmiSelectedCameraIdentity}">
                                    <TextBlock x:Name="MmiSelectedCameraId" Text="{Binding Camera.SelectedVirtualCamera.Id}" TextWrapping="Wrap"
                                               FontFamily="Segoe UI, Malgun Gothic" FontSize="11.5" FontWeight="Normal"
                                               LineHeight="16.675" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource Text.Secondary}" />
                                </Border>
                            </WrapPanel>
                        </DockPanel>
                        <Border x:Name="MmiVirtualCameraImageFrame"
                                Grid.Row="2"
                                Margin="0,4,0,0"
                                Background="{StaticResource Mmi.InspectionStage}"
                                BorderBrush="{DynamicResource Border.Subtle}"
                                BorderThickness="0"
                                CornerRadius="0">
                            <Grid>
                                <Image x:Name="MmiVirtualCameraImageViewer"
                                       Source="{Binding Camera.CurrentInputImagePath, Converter={StaticResource ProjectImageSourceConverter}}"
                                       Stretch="Uniform"
                                       SnapsToDevicePixels="True"
                                       ToolTip="{Binding Camera.CurrentCameraSourceText}"
                                       Visibility="{Binding Camera.IsHeightDataView, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=invert}" />
                                <Image x:Name="MmiNumericalCameraImageViewer"
                                       Source="{Binding Camera.CurrentNumericalInput, Converter={StaticResource NumericalFramePreviewConverter}}"
                                       Stretch="Uniform"
                                       SnapsToDevicePixels="True"
                                       Visibility="{Binding Camera.IsHeightDataView, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=invert}" />
                                <Image x:Name="MmiHeightDataImageViewer" Source="{Binding Camera.CurrentNumericalInput, Converter={StaticResource NumericalFramePreviewConverter}, ConverterParameter=height}"
                                       Stretch="Uniform" SnapsToDevicePixels="True" Visibility="{Binding Camera.IsHeightDataView, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock x:Name="MmiCurrentInputEmptyTitle" Margin="8" MaxWidth="420"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe UI, Malgun Gothic" FontSize="14" FontWeight="Bold"
                                           LineHeight="20.3" LineStackingStrategy="BlockLineHeight"
                                           Foreground="{StaticResource Mmi.InspectionMuted}"
                                           Text="{loc:Loc Key=Camera.EmptyInput}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding Camera.HasSelectedCameraInput, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=invert}" />
                                <TextBlock x:Name="MmiVirtualCameraImageError"
                                           Margin="8"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource State.Fault}"
                                           Text="{loc:Loc Key=Integration.MmiVirtualCameraImageError}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Camera.HasSelectedCameraInput}" Value="True" />
                                                        <Condition Binding="{Binding Camera.HasCurrentNumericalInput}" Value="False" />
                                                        <Condition Binding="{Binding ElementName=MmiVirtualCameraImageViewer, Path=Source}" Value="{x:Null}" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                        <Border Grid.Row="3" Margin="0,12,0,0" Padding="10,8" Background="{DynamicResource Accent.Soft}" BorderBrush="{DynamicResource Accent.Primary}" BorderThickness="2,0,0,0">
                            <ScrollViewer x:Name="MmiCurrentInputStateScrollViewer" MaxHeight="100" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <TextBlock x:Name="MmiCurrentInputState" Text="{Binding Camera.SelectedInputStateText}" TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Border>
                        <TextBlock Grid.Row="4" Text="{Binding Camera.CurrentHeightRangeText}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Visibility="{Binding Camera.IsHeightDataView, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                </ScrollViewer>
            </Border>


        </Grid>
    </Border>
    </Grid>
</UserControl>
