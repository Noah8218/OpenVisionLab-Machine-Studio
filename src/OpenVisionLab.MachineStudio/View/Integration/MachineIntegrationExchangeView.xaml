<UserControl x:Class="OpenVisionLab.MachineStudio.View.Integration.MachineIntegrationExchangeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:OpenVisionLab.MachineStudio.Localization"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Border Style="{StaticResource PanelSurfaceStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Style="{StaticResource PanelHeaderStyle}">
                <TextBlock Style="{StaticResource PanelHeaderTextStyle}"
                           Text="{loc:Loc Key=Integration.Title}" />
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid MaxWidth="1100" Margin="18" HorizontalAlignment="Left">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Padding="16"
                            Background="{DynamicResource Surface.Raised}"
                            BorderBrush="{DynamicResource Border.Subtle}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <StackPanel>
                            <TextBlock FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text.Primary}"
                                       Text="{loc:Loc Key=Integration.SetupTitle}" />
                            <TextBlock Margin="0,5,0,14"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{loc:Loc Key=Integration.SetupHint}"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,0,0,4"
                                       FontWeight="SemiBold"
                                       Text="{loc:Loc Key=Integration.ExchangeRoot}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ExchangeRootTextBox"
                                         MinWidth="420"
                                         Height="32"
                                         Padding="8,4"
                                         VerticalContentAlignment="Center"
                                         Text="{Binding IntegrationExchange.ExchangeRoot, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="3D Studio exchange folder" />
                                <Button Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Command="{Binding IntegrationExchange.BrowseExchangeRootCommand}"
                                        Style="{StaticResource QuietCommandButtonStyle}"
                                        AutomationProperties.Name="Browse exchange folder">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="FolderOpen24" />
                                        <TextBlock Margin="5,0,0,0" Text="{loc:Loc Key=Integration.Browse}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBlock Margin="0,12,0,4"
                                       FontWeight="SemiBold"
                                       Text="{loc:Loc Key=Integration.Source}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="InspectionSourceTextBox"
                                         MinWidth="420"
                                         Height="32"
                                         Padding="8,4"
                                         VerticalContentAlignment="Center"
                                         Text="{Binding IntegrationExchange.InspectionSourcePath, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="C3D inspection source" />
                                <Button Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Command="{Binding IntegrationExchange.BrowseInspectionSourceCommand}"
                                        Style="{StaticResource QuietCommandButtonStyle}"
                                        AutomationProperties.Name="Browse C3D inspection source">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="DocumentSearch24" />
                                        <TextBlock Margin="5,0,0,0" Text="{loc:Loc Key=Integration.Browse}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBlock Margin="0,10,0,0"
                                       FontFamily="{StaticResource Typography.Telemetry}"
                                       FontSize="11"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{Binding IntegrationExchange.ProjectSummary}"
                                       TextWrapping="Wrap" />
                            <WrapPanel Margin="0,14,0,0">
                                <Button x:Name="SaveIntegrationSetupButton"
                                        Margin="0,0,8,0"
                                        Command="{Binding IntegrationExchange.SaveSetupCommand}"
                                        Style="{StaticResource PrimaryCommandButtonStyle}"
                                        AutomationProperties.Name="Save 3D exchange setup">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Save24" Foreground="{DynamicResource Accent.Primary}" />
                                        <TextBlock Margin="5,0,0,0" Text="{loc:Loc Key=Integration.SaveSetup}" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding IntegrationExchange.ResetSetupCommand}"
                                        Style="{StaticResource QuietCommandButtonStyle}"
                                        AutomationProperties.Name="Reset 3D exchange setup">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ArrowReset24" />
                                        <TextBlock Margin="5,0,0,0" Text="{loc:Loc Key=Integration.Reset}" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1"
                            Margin="0,14,0,0"
                            Padding="16"
                            Background="{DynamicResource Surface.Raised}"
                            BorderBrush="{DynamicResource Border.Subtle}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <StackPanel>
                            <TextBlock FontSize="16"
                                       FontWeight="SemiBold"
                                       Text="Authenticated TCP transport" />
                            <TextBlock Margin="0,4,0,12"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="Explicitly start a listener or transfer the selected transaction. The shared key is session-only and is never saved."
                                       TextWrapping="Wrap" />
                            <WrapPanel>
                                <StackPanel Width="220" Margin="0,0,12,8">
                                    <TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="Listen address" />
                                    <TextBox x:Name="TcpListenAddressTextBox"
                                             Height="32"
                                             Padding="8,4"
                                             VerticalContentAlignment="Center"
                                             IsEnabled="{Binding IntegrationExchange.CanEditTcpSetup}"
                                             Text="{Binding IntegrationExchange.TcpListenAddress, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="TCP listen address" />
                                </StackPanel>
                                <StackPanel Width="150" Margin="0,0,12,8">
                                    <TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="Listen port" />
                                    <TextBox x:Name="TcpListenPortTextBox"
                                             Height="32"
                                             Padding="8,4"
                                             VerticalContentAlignment="Center"
                                             IsEnabled="{Binding IntegrationExchange.CanEditTcpSetup}"
                                             Text="{Binding IntegrationExchange.TcpListenPortText, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="TCP listen port" />
                                </StackPanel>
                                <StackPanel Width="220" Margin="0,0,12,8">
                                    <TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="Peer host" />
                                    <TextBox x:Name="TcpPeerHostTextBox"
                                             Height="32"
                                             Padding="8,4"
                                             VerticalContentAlignment="Center"
                                             IsEnabled="{Binding IntegrationExchange.CanEditTcpSetup}"
                                             Text="{Binding IntegrationExchange.TcpPeerHost, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="TCP peer host" />
                                </StackPanel>
                                <StackPanel Width="150" Margin="0,0,12,8">
                                    <TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="Peer port" />
                                    <TextBox x:Name="TcpPeerPortTextBox"
                                             Height="32"
                                             Padding="8,4"
                                             VerticalContentAlignment="Center"
                                             IsEnabled="{Binding IntegrationExchange.CanEditTcpSetup}"
                                             Text="{Binding IntegrationExchange.TcpPeerPortText, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="TCP peer port" />
                                </StackPanel>
                                <StackPanel Width="320" Margin="0,0,12,8">
                                    <TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="Shared key (Base64, 32+ bytes)" />
                                    <PasswordBox x:Name="TcpSharedKeyPasswordBox"
                                                 Height="32"
                                                 Padding="8,4"
                                                 VerticalContentAlignment="Center"
                                                 PasswordChanged="TcpSharedKeyPasswordBox_OnPasswordChanged"
                                                 AutomationProperties.Name="TCP shared key" />
                                </StackPanel>
                            </WrapPanel>
                            <TextBlock Margin="0,2,0,0"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{Binding IntegrationExchange.SharedKeyStatusText}"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,4,0,0"
                                       Foreground="{DynamicResource State.Vision}"
                                       Text="{Binding IntegrationExchange.TcpListenerStatusText}"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,4,0,0"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{Binding IntegrationExchange.LastTcpTransferText}"
                                       TextWrapping="Wrap" />
                            <WrapPanel Margin="0,12,0,0">
                                <Button x:Name="StartTcpListenerButton"
                                        Margin="0,0,8,8"
                                        Command="{Binding IntegrationExchange.StartTcpListenerCommand}"
                                        Style="{StaticResource PrimaryCommandButtonStyle}"
                                        AutomationProperties.Name="Start TCP listener">
                                    <TextBlock Text="Start listener" />
                                </Button>
                                <Button x:Name="StopTcpListenerButton"
                                        Margin="0,0,8,8"
                                        Command="{Binding IntegrationExchange.StopTcpListenerCommand}"
                                        Style="{StaticResource QuietCommandButtonStyle}"
                                        AutomationProperties.Name="Stop TCP listener">
                                    <TextBlock Text="Stop listener" />
                                </Button>
                                <Button x:Name="PingTcpPeerButton"
                                        Margin="0,0,8,8"
                                        Command="{Binding IntegrationExchange.PingTcpPeerCommand}"
                                        Style="{StaticResource QuietCommandButtonStyle}"
                                        AutomationProperties.Name="Ping TCP peer">
                                    <TextBlock Text="Ping peer" />
                                </Button>
                                <Button x:Name="PushLatestTransactionButton"
                                        Margin="0,0,8,8"
                                        Command="{Binding IntegrationExchange.PushLatestTransactionCommand}"
                                        Style="{StaticResource GlobalCommandButtonStyle}"
                                        AutomationProperties.Name="Push latest transaction">
                                    <TextBlock Text="Push latest" />
                                </Button>
                                <Button x:Name="PullLatestTransactionButton"
                                        Margin="0,0,8,8"
                                        Command="{Binding IntegrationExchange.PullLatestTransactionCommand}"
                                        Style="{StaticResource QuietCommandButtonStyle}"
                                        AutomationProperties.Name="Pull latest transaction">
                                    <TextBlock Text="Pull latest" />
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2"
                            Margin="0,14,0,0"
                            Padding="16"
                            Background="{DynamicResource Surface.Raised}"
                            BorderBrush="{DynamicResource Border.Subtle}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="16"
                                           FontWeight="SemiBold"
                                           Text="{loc:Loc Key=Integration.MachineStepTitle}" />
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           Text="{loc:Loc Key=Integration.MachineStepHint}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,10,0,0"
                                           FontFamily="{StaticResource Typography.Telemetry}"
                                           Foreground="{DynamicResource State.Vision}"
                                           Text="{Binding IntegrationExchange.TransactionSummary}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <WrapPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                                <Button x:Name="ExportHandoffButton"
                                        Margin="0,0,8,0"
                                        Command="{Binding IntegrationExchange.ExportHandoffCommand}"
                                        Style="{StaticResource GlobalCommandButtonStyle}"
                                        AutomationProperties.Name="Export handoff to 3D Studio">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ArrowExport24" />
                                        <TextBlock Margin="5,0,0,0" Text="{loc:Loc Key=Integration.Export}" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding IntegrationExchange.RefreshResultCommand}"
                                        Style="{StaticResource QuietCommandButtonStyle}"
                                        AutomationProperties.Name="Refresh 3D Studio result">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ArrowSync24" />
                                        <TextBlock Margin="5,0,0,0" Text="{loc:Loc Key=Integration.Refresh}" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="3"
                            Margin="0,14,0,0"
                            Padding="12,9"
                            Background="{DynamicResource Accent.Soft}"
                            BorderBrush="{DynamicResource Accent.Primary}"
                            BorderThickness="1"
                            CornerRadius="5">
                        <TextBlock Foreground="{DynamicResource Text.Primary}"
                                   Text="{Binding IntegrationExchange.StatusText}"
                                   TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
