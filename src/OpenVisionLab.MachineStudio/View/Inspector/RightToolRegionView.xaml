                                              ToolTip="{loc:Loc Key=Debugger.WatchSelectionTooltip}" />
                                    <WrapPanel Margin="0,6,0,0">
                                        <Button Margin="0,0,6,4"
                                                Command="{Binding RuntimeDebugger.AddWatchCommand}"
                                                Content="{loc:Loc Key=Debugger.AddWatch}"
                                                Style="{StaticResource GlobalCommandButtonStyle}" />
