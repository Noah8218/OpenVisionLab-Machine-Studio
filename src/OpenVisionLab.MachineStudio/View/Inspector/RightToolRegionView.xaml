in="0,12,0,0"><Button Style="{StaticResource EquipmentInspectorApplyStyle}" Margin="0,0,6,6" Command="{Binding EquipmentInspectorManualCommand}" CommandParameter="capture" Content="{loc:Loc Key=R24.TestCapture}" /><Button Margin="0,0,6,6" Style="{StaticResource EquipmentInspectorActionStyle}" Command="{Binding OpenEquipmentCameraSettingsCommand}" Content="{loc:Loc Key=R24.GoVision}" /></WrapPanel><TextBlock Margin="0,6,0,0" Text="{loc:Loc Key=R24.CameraManualHint}" Foreground="{StaticResource EquipmentInspector.Faint}" FontSize="11.5" LineHeight="16.675" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" /></StackPanel><StackPanel Visibility="{Binding Layout.SelectedComponentEditor.ShowNoManualCommand, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Margin="0,12,0,0" Text="{loc:Loc Key=R24.NoManualCommand}" Foreground="{StaticResource EquipmentInspector.Muted}" /></StackPanel></StackPanel><StackPanel Visibility="{Binding Navigation.IsEquipmentWorkspace, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=invert}"><StackPanel x:Name="InspectorNonIntegrationBeforeSetup" Visibility="{Binding IntegrationSetupOnly, RelativeSource={RelativeSource AncestorType=local:RightToolRegionView}, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=invert}">
                    <StackPanel x:Name="ManualCommissioningEntryPanel" Margin="0,0,0,10" DataContext="{Binding ManualEquipment}">
