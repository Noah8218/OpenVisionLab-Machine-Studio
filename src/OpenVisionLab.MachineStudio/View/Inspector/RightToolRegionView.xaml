                                            <DataTemplate>
                                                <StackPanel Margin="3,2">
                                                    <TextBlock FontWeight="SemiBold"
                                                               Text="{Binding Name}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Foreground="{DynamicResource Text.Secondary}"
                                                               Text="{Binding KindText}" />
                                                    <TextBlock Style="{StaticResource TelemetryTextStyle}"
                                                               Text="{Binding ValueText}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Expander>

                            <Expander x:Name="DebuggerTimelineExpander"
                                      Margin="0,7,0,0"
                                      Header="{loc:Loc Key=Debugger.Timeline}">
                                <StackPanel Margin="0,5,0,0">
