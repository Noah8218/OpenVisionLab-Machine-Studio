                                                               FontWeight="Bold"
                                                               Text="●">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource Text.Disabled}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource State.Fault}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding DisplayText}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding DisplayText}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button x:Name="ToggleSequenceBreakpointButton"
                                            Margin="0,6,0,0"
                                            HorizontalAlignment="Stretch"
