<UserControl x:Class="OpenVisionLab.MachineStudio.View.Inspector.RightToolRegionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behavior="clr-namespace:OpenVisionLab.MachineStudio.Behavior"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:OpenVisionLab.MachineStudio.Converter"
             xmlns:loc="clr-namespace:OpenVisionLab.MachineStudio.Localization">
    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <loc:LocalizedFaultKindConverter x:Key="LocalizedFaultKindConverter" />
        <loc:LocalizedForcedValueConverter x:Key="LocalizedForcedValueConverter" />
        <Style x:Key="InspectorFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,7,0,3" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
        </Style>
    </UserControl.Resources>
    <Border Style="{StaticResource PanelSurfaceStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource PanelHeaderStyle}">
                <TextBlock Style="{StaticResource PanelHeaderTextStyle}"
                           Text="{Binding RightPanelHeaderText}" />
            </Border>

            <ScrollViewer x:Name="DesignInspectorScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRunMode}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <StackPanel>
                    <ListBox Margin="3"
                             ItemsSource="{Binding Properties.Items}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.Style>
                            <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Layout.HasSelection}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasSelectedAxisDefinition}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsMultiAxisCommissioningRecipeSelection}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="6,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="112" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Foreground="{DynamicResource Text.Secondary}"
                                               Text="{Binding Name}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Value}"
                                               TextWrapping="Wrap"
                                               ToolTip="{Binding Value}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border x:Name="MultiAxisRecipeDesignPanel"
                            Style="{StaticResource InspectorCardStyle}"
                            Visibility="{Binding IsMultiAxisCommissioningRecipeSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel DataContext="{Binding MultiAxisCommissioningRecipe}">
                            <TextBlock Style="{StaticResource SectionCaptionStyle}"
                                       Text="{loc:Loc Key=Axis.MultiAxisRecipe}" />
                            <TextBlock Margin="0,2,0,8"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{loc:Loc Key=Axis.RecipeDesignHint}"
                                       TextWrapping="Wrap" />
                            <Button Command="{Binding CreateRecipeCommand}"
                                    Content="{loc:Loc Key=Axis.CreateRecipe}"
                                    AutomationProperties.Name="{loc:Loc Key=Axis.CreateRecipe}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryCommandButtonStyle}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConfigured}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConfigured}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Style="{StaticResource InspectorFieldLabelStyle}"
                                           Text="{loc:Loc Key=Axis.RecipeName}" />
                                <TextBox x:Name="MultiAxisRecipeNameTextBox"
                                         Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,12,0,3"
                                           Style="{StaticResource SectionCaptionStyle}"
                                           Text="{loc:Loc Key=Axis.RecipeTargets}" />
                                <ItemsControl ItemsSource="{Binding Targets}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,7"
                                                    Padding="8"
                                                    Background="{DynamicResource Surface.Panel}"
                                                    CornerRadius="4">
                                                <StackPanel>
                                                    <ComboBox ItemsSource="{Binding AvailableAxes}"
                                                              DisplayMemberPath="Name"
                                                              SelectedValuePath="Id"
                                                              SelectedValue="{Binding AxisId, Mode=TwoWay}" />
                                                    <ui:NumberBox Margin="0,6,0,0"
                                                                  Minimum="-1000000"
                                                                  Maximum="1000000"
                                                                  SmallChange="1"
                                                                  Value="{Binding TargetPosition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <WrapPanel Margin="0,6,0,0">
                                                        <Button MinWidth="34"
                                                                Margin="0,0,4,0"
                                                                Command="{Binding MoveUpCommand}"
                                                                Content="↑"
                                                                ToolTip="{loc:Loc Key=Axis.MoveTargetUp}"
                                                                AutomationProperties.Name="{loc:Loc Key=Axis.MoveTargetUp}" />
                                                        <Button MinWidth="34"
                                                                Margin="0,0,4,0"
                                                                Command="{Binding MoveDownCommand}"
                                                                Content="↓"
                                                                ToolTip="{loc:Loc Key=Axis.MoveTargetDown}"
                                                                AutomationProperties.Name="{loc:Loc Key=Axis.MoveTargetDown}" />
                                                        <Button Command="{Binding RemoveCommand}"
                                                                Content="{loc:Loc Key=Axis.RemoveTarget}"
                                                                ToolTip="{loc:Loc Key=Axis.RemoveTarget}"
                                                                AutomationProperties.Name="{loc:Loc Key=Axis.RemoveTarget}" />
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <WrapPanel>
                                    <Button Margin="0,0,6,4"
                                            Command="{Binding AddTargetCommand}"
                                            Content="{loc:Loc Key=Axis.AddRecipeTarget}" />
                                    <Button Margin="0,0,6,4"
                                            Command="{Binding DeleteRecipeCommand}"
                                            Content="{loc:Loc Key=Axis.DeleteRecipe}" />
                                </WrapPanel>
                            </StackPanel>
                            <Border Margin="0,10,0,0"
                                    Padding="8,6"
                                    Background="{DynamicResource Surface.Panel}"
                                    CornerRadius="4">
                                <TextBlock Text="{Binding ValidationMessage}" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource State.Running}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasValidationErrors}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource State.Warning}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border x:Name="AxisDriveTuningPanel"
                            Style="{StaticResource InspectorCardStyle}"
                            Visibility="{Binding HasSelectedAxisDefinition, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel DataContext="{Binding AxisDriveTuningEditor}">
                            <TextBlock Style="{StaticResource SectionCaptionStyle}"
                                       Text="{loc:Loc Key=Axis.AuthoredDriveTuning}" />
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding Name}" />
                                <TextBlock Grid.Column="1" Margin="8,0,0,0" Foreground="{DynamicResource Text.Secondary}" Text="{Binding Id}" />
                            </Grid>

                            <TextBlock Margin="0,4,0,2" Style="{StaticResource SectionCaptionStyle}" Text="{loc:Loc Key=Axis.TravelSetup}" />
                            <TextBlock Style="{StaticResource InspectorFieldLabelStyle}" Text="{loc:Loc Key=Axis.HomePosition}" />
                            <ui:NumberBox AutomationProperties.AutomationId="AxisHomePositionNumberBox" Minimum="-1000000" Maximum="1000000" SmallChange="1" Value="{Binding HomePosition, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource InspectorFieldLabelStyle}" Text="{loc:Loc Key=Axis.SoftLimitMin}" />
                            <ui:NumberBox AutomationProperties.AutomationId="AxisSoftLimitMinNumberBox" Minimum="-1000000" Maximum="1000000" SmallChange="1" Value="{Binding SoftLimitMin, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource InspectorFieldLabelStyle}" Text="{loc:Loc Key=Axis.SoftLimitMax}" />
                            <ui:NumberBox AutomationProperties.AutomationId="AxisSoftLimitMaxNumberBox" Minimum="-1000000" Maximum="1000000" SmallChange="1" Value="{Binding SoftLimitMax, Mode=TwoWay}" />

                            <TextBlock Margin="0,12,0,2" Style="{StaticResource SectionCaptionStyle}" Text="{loc:Loc Key=Axis.DriveTuning}" />
                            <TextBlock Style="{StaticResource InspectorFieldLabelStyle}" Text="{loc:Loc Key=Axis.MaxVelocity}" />
                            <ui:NumberBox AutomationProperties.AutomationId="AxisMaxVelocityNumberBox" Minimum="0.001" Maximum="1000000" SmallChange="1" Value="{Binding MaxVelocity, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource InspectorFieldLabelStyle}" Text="{loc:Loc Key=Axis.MaxAcceleration}" />
                            <ui:NumberBox AutomationProperties.AutomationId="AxisMaxAccelerationNumberBox" Minimum="0.001" Maximum="1000000" SmallChange="1" Value="{Binding MaxAcceleration, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource InspectorFieldLabelStyle}" Text="{loc:Loc Key=Axis.MaxDeceleration}" />
                            <ui:NumberBox AutomationProperties.AutomationId="AxisMaxDecelerationNumberBox" Minimum="0.001" Maximum="1000000" SmallChange="1" Value="{Binding MaxDeceleration, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource InspectorFieldLabelStyle}" Text="{loc:Loc Key=Axis.FollowingErrorLimit}" />
                            <ui:NumberBox AutomationProperties.AutomationId="AxisFollowingErrorLimitNumberBox" Minimum="0.001" Maximum="1000000" SmallChange="0.01" Value="{Binding FollowingErrorLimit, Mode=TwoWay}" />
                            <Button x:Name="ResetAxisDriveDefaultsButton"
                                    Margin="0,10,0,0"
                                    AutomationProperties.Name="{loc:Loc Key=Axis.ResetDriveDefaults}"
                                    Command="{Binding ResetDriveDefaultsCommand}"
                                    Content="{loc:Loc Key=Axis.ResetDriveDefaults}"
                                    Style="{StaticResource GlobalCommandButtonStyle}"
                                    ToolTip="{loc:Loc Key=Axis.ResetDriveDefaultsTooltip}" />

                            <Border Margin="0,12,0,0" Padding="8,6" Background="{DynamicResource Surface.Panel}" CornerRadius="4">
                                <TextBlock x:Name="AxisTuningValidationMessage" Text="{Binding ValidationMessage}" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource State.Running}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasValidationErrors}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource State.Warning}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border x:Name="LayerOrderPanel"
                            Style="{StaticResource InspectorCardStyle}"
                            Visibility="{Binding Layout.HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionCaptionStyle}"
                                       Text="{loc:Loc Key=Inspector.LayerOrder}" />
                            <TextBlock Margin="0,3,0,8"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{loc:Loc Key=Inspector.LayerOrderHint}"
                                       TextWrapping="Wrap" />
                            <UniformGrid Columns="2">
                                <Button x:Name="SendToBackButton"
                                        AutomationProperties.Name="{loc:Loc Key=LayerOrder.SendToBack}"
                                        Command="{Binding ChangeLayoutLayerOrderCommand}"
                                        CommandParameter="SendToBack"
                                        Content="{loc:Loc Key=LayerOrder.SendToBack}"
                                        ToolTip="{loc:Loc Key=LayerOrder.SendToBackTooltip}" />
                                <Button x:Name="SendBackwardButton"
                                        AutomationProperties.Name="{loc:Loc Key=LayerOrder.SendBackward}"
                                        Command="{Binding ChangeLayoutLayerOrderCommand}"
                                        CommandParameter="SendBackward"
                                        Content="{loc:Loc Key=LayerOrder.SendBackward}"
                                        ToolTip="{loc:Loc Key=LayerOrder.SendBackwardTooltip}" />
                            </UniformGrid>
                            <UniformGrid Margin="0,4,0,0" Columns="2">
                                <Button x:Name="BringForwardButton"
                                        AutomationProperties.Name="{loc:Loc Key=LayerOrder.BringForward}"
                                        Command="{Binding ChangeLayoutLayerOrderCommand}"
                                        CommandParameter="BringForward"
                                        Content="{loc:Loc Key=LayerOrder.BringForward}"
                                        ToolTip="{loc:Loc Key=LayerOrder.BringForwardTooltip}" />
                                <Button x:Name="BringToFrontButton"
                                        AutomationProperties.Name="{loc:Loc Key=LayerOrder.BringToFront}"
                                        Command="{Binding ChangeLayoutLayerOrderCommand}"
                                        CommandParameter="BringToFront"
                                        Content="{loc:Loc Key=LayerOrder.BringToFront}"
                                        ToolTip="{loc:Loc Key=LayerOrder.BringToFrontTooltip}" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border x:Name="MultiSelectionAlignmentPanel"
                            Style="{StaticResource InspectorCardStyle}"
                            Visibility="{Binding Layout.HasMultipleSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock FontSize="13"
                                       FontWeight="SemiBold"
                                       Text="{Binding Layout.SelectionSummaryText}" />
                            <TextBlock Margin="0,3,0,8"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{loc:Loc Key=Inspector.AlignmentReferenceHint}"
                                       TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource InspectorFieldLabelStyle}"
                                       Text="{loc:Loc Key=Inspector.HorizontalAlignment}" />
                            <UniformGrid Columns="3">
                                <Button x:Name="AlignLeftButton"
                                        AutomationProperties.Name="{loc:Loc Key=Alignment.Left}"
                                        Command="{Binding AlignLayoutSelectionCommand}"
                                        CommandParameter="Left"
                                        Content="{loc:Loc Key=Alignment.Left}"
                                        ToolTip="{loc:Loc Key=Alignment.LeftTooltip}" />
                                <Button AutomationProperties.Name="{loc:Loc Key=Alignment.HorizontalCenter}"
                                        Command="{Binding AlignLayoutSelectionCommand}"
                                        CommandParameter="HorizontalCenter"
                                        Content="{loc:Loc Key=Alignment.HorizontalCenter}"
                                        ToolTip="{loc:Loc Key=Alignment.HorizontalCenterTooltip}" />
                                <Button AutomationProperties.Name="{loc:Loc Key=Alignment.Right}"
                                        Command="{Binding AlignLayoutSelectionCommand}"
                                        CommandParameter="Right"
                                        Content="{loc:Loc Key=Alignment.Right}"
                                        ToolTip="{loc:Loc Key=Alignment.RightTooltip}" />
                            </UniformGrid>
                            <TextBlock Style="{StaticResource InspectorFieldLabelStyle}"
                                       Text="{loc:Loc Key=Inspector.VerticalAlignment}" />
                            <UniformGrid Columns="3">
                                <Button AutomationProperties.Name="{loc:Loc Key=Alignment.Top}"
                                        Command="{Binding AlignLayoutSelectionCommand}"
                                        CommandParameter="Top"
                                        Content="{loc:Loc Key=Alignment.Top}"
                                        ToolTip="{loc:Loc Key=Alignment.TopTooltip}" />
                                <Button AutomationProperties.Name="{loc:Loc Key=Alignment.VerticalCenter}"
                                        Command="{Binding AlignLayoutSelectionCommand}"
                                        CommandParameter="VerticalCenter"
                                        Content="{loc:Loc Key=Alignment.VerticalCenter}"
                                        ToolTip="{loc:Loc Key=Alignment.VerticalCenterTooltip}" />
                                <Button AutomationProperties.Name="{loc:Loc Key=Alignment.Bottom}"
                                        Command="{Binding AlignLayoutSelectionCommand}"
                                        CommandParameter="Bottom"
                                        Content="{loc:Loc Key=Alignment.Bottom}"
                                        ToolTip="{loc:Loc Key=Alignment.BottomTooltip}" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border IsEnabled="{Binding IsSceneEditable}"
                            Style="{StaticResource InspectorCardStyle}"
                            Visibility="{Binding Layout.HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel DataContext="{Binding Layout.SelectedComponentEditor}">
                            <TextBlock Style="{StaticResource SectionCaptionStyle}" Text="{loc:Loc Key=Inspector.AuthoredProperties}" />
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding KindText}" />
                                <TextBlock Grid.Column="1" Margin="8,0,0,0" Foreground="{DynamicResource Text.Secondary}" Text="{Binding Id}" />
                            </Grid>

                            <TextBlock Style="{StaticResource InspectorFieldLabelStyle}" Text="{loc:Loc Key=Properties.Name}" />
                            <TextBox x:Name="ComponentNameTextBox"
                                     Height="30"
                                     Text="{Binding Name, Mode=TwoWay}"
                                     ToolTip="{Binding Name}" />

                            <TextBlock Margin="0,10,0,2" Style="{StaticResource SectionCaptionStyle}" Text="{loc:Loc Key=Inspector.LayoutTransform}" />
                            <TextBlock x:Name="AspectRatioHintText"
                                       Margin="0,0,0,4"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{loc:Loc Key=Inspector.AspectRatioHint}"
                                       TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource InspectorFieldLabelStyle}" Text="{loc:Loc Key=Properties.X}" />
                            <ui:NumberBox Minimum="-10000" Maximum="10000" SmallChange="10" Value="{Binding X, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource InspectorFieldLabelStyle}" Text="{loc:Loc Key=Properties.Y}" />
                            <ui:NumberBox Minimum="-10000" Maximum="10000" SmallChange="10" Value="{Binding Y, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource InspectorFieldLabelStyle}" Text="{loc:Loc Key=Properties.Rotation}" />
                            <ui:NumberBox Minimum="-360" Maximum="360" SmallChange="1" Value="{Binding RotationDegrees, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource InspectorFieldLabelStyle}" Text="{loc:Loc Key=Properties.Width}" />
                            <ui:NumberBox Minimum="1" Maximum="10000" SmallChange="1" Value="{Binding Width, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource InspectorFieldLabelStyle}" Text="{loc:Loc Key=Properties.Height}" />
                            <ui:NumberBox Minimum="1" Maximum="10000" SmallChange="1" Value="{Binding Height, Mode=TwoWay}" />
                            <UniformGrid Margin="0,8,0,0" Columns="4" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <Button Command="{Binding NudgeLayoutComponentCommand}" CommandParameter="Left" Content="←" ToolTip="Move left by one grid step" />
                                <Button Command="{Binding NudgeLayoutComponentCommand}" CommandParameter="Up" Content="↑" ToolTip="Move up by one grid step" />
                                <Button Command="{Binding NudgeLayoutComponentCommand}" CommandParameter="Down" Content="↓" ToolTip="Move down by one grid step" />
                                <Button x:Name="NudgeRightButton" Command="{Binding NudgeLayoutComponentCommand}" CommandParameter="Right" Content="→" ToolTip="Move right by one grid step" />
                            </UniformGrid>

                            <StackPanel Visibility="{Binding HasBehaviorBinding, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Margin="0,12,0,2" Style="{StaticResource SectionCaptionStyle}" Text="{loc:Loc Key=Properties.Simulation}" />
                                <TextBlock Style="{StaticResource InspectorFieldLabelStyle}" Text="{loc:Loc Key=Properties.Behavior}" />
                                <ComboBox x:Name="BehaviorBindingComboBox"
                                          ItemsSource="{Binding BehaviorBindingOptions}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding BehaviorBindingId, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Visibility="{Binding ShowSensorProperties, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Margin="0,12,0,2" Style="{StaticResource SectionCaptionStyle}" Text="{loc:Loc Key=Properties.Sensor}" />
                                <TextBlock Style="{StaticResource InspectorFieldLabelStyle}" Text="{loc:Loc Key=Properties.OutputChannel}" />
                                <ComboBox ItemsSource="{Binding DigitalInputOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectedValue="{Binding SensorOutputChannelId, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource InspectorFieldLabelStyle}" Text="{loc:Loc Key=Properties.TargetComponent}" />
                                <ComboBox ItemsSource="{Binding TargetComponentOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectedValue="{Binding SensorTargetComponentId, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource InspectorFieldLabelStyle}" Text="{loc:Loc Key=Properties.OnDelay}" />
                                <ui:NumberBox Minimum="0" Maximum="600000" SmallChange="1" Value="{Binding SensorOnDelayMilliseconds, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource InspectorFieldLabelStyle}" Text="{loc:Loc Key=Properties.OffDelay}" />
                                <ui:NumberBox Minimum="0" Maximum="600000" SmallChange="1" Value="{Binding SensorOffDelayMilliseconds, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel x:Name="CylinderPropertiesSection" Visibility="{Binding ShowCylinderProperties, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Margin="0,12,0,2" Style="{StaticResource SectionCaptionStyle}" Text="{loc:Loc Key=Properties.Cylinder}" />
                                <TextBlock Style="{StaticResource InspectorFieldLabelStyle}" Text="{loc:Loc Key=Properties.ExtendCommand}" />
                                <ComboBox ItemsSource="{Binding DigitalOutputOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectedValue="{Binding CylinderExtendCommandChannelId, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource InspectorFieldLabelStyle}" Text="{loc:Loc Key=Properties.ExtendedSensor}" />
                                <ComboBox ItemsSource="{Binding DigitalInputOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectedValue="{Binding CylinderExtendedSensorChannelId, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource InspectorFieldLabelStyle}" Text="{loc:Loc Key=Properties.RetractedSensor}" />
                                <ComboBox ItemsSource="{Binding DigitalInputOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectedValue="{Binding CylinderRetractedSensorChannelId, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource InspectorFieldLabelStyle}" Text="{loc:Loc Key=Properties.ExtendDuration}" />
                                <ui:NumberBox Minimum="1" Maximum="600000" SmallChange="1" Value="{Binding CylinderExtendDurationMilliseconds, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource InspectorFieldLabelStyle}" Text="{loc:Loc Key=Properties.RetractDuration}" />
                                <ui:NumberBox Minimum="1" Maximum="600000" SmallChange="1" Value="{Binding CylinderRetractDurationMilliseconds, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource InspectorFieldLabelStyle}" Text="{loc:Loc Key=Properties.ExtendedSensorDelay}" />
                                <ui:NumberBox Minimum="0" Maximum="600000" SmallChange="1" Value="{Binding CylinderExtendedSensorDelayMilliseconds, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource InspectorFieldLabelStyle}" Text="{loc:Loc Key=Properties.RetractedSensorDelay}" />
                                <ui:NumberBox Minimum="0" Maximum="600000" SmallChange="1" Value="{Binding CylinderRetractedSensorDelayMilliseconds, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource InspectorFieldLabelStyle}" Text="{loc:Loc Key=Properties.Stroke}" />
                                <ui:NumberBox Minimum="0.001" Maximum="100000" SmallChange="1" Value="{Binding CylinderStroke, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Visibility="{Binding ShowConveyorProperties, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Margin="0,12,0,2" Style="{StaticResource SectionCaptionStyle}" Text="{loc:Loc Key=Properties.Conveyor}" />
                                <TextBlock Style="{StaticResource InspectorFieldLabelStyle}" Text="{loc:Loc Key=Properties.RunCommand}" />
                                <ComboBox ItemsSource="{Binding DigitalOutputOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectedValue="{Binding ConveyorRunCommandChannelId, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource InspectorFieldLabelStyle}" Text="{loc:Loc Key=Properties.ReverseCommand}" />
                                <ComboBox ItemsSource="{Binding DigitalOutputOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectedValue="{Binding ConveyorReverseCommandChannelId, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource InspectorFieldLabelStyle}" Text="{loc:Loc Key=Properties.Speed}" />
                                <ui:NumberBox Minimum="0.001" Maximum="100000" SmallChange="1" Value="{Binding ConveyorSpeedUnitsPerSecond, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Visibility="{Binding ShowWorkpieceProperties, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Margin="0,12,0,2" Style="{StaticResource SectionCaptionStyle}" Text="{loc:Loc Key=Properties.Workpiece}" />
                                <TextBlock Style="{StaticResource InspectorFieldLabelStyle}" Text="{loc:Loc Key=Properties.Type}" />
                                <TextBox Height="30" Text="{Binding WorkpieceType, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource InspectorFieldLabelStyle}" Text="{loc:Loc Key=Properties.Conveyor}" />
                                <ComboBox ItemsSource="{Binding ConveyorComponentOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectedValue="{Binding WorkpieceConveyorComponentId, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource InspectorFieldLabelStyle}" Text="{loc:Loc Key=Properties.InspectionState}" />
                                <ComboBox ItemsSource="{Binding InspectionStateOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectedValue="{Binding WorkpieceInspectionStateId, Mode=TwoWay}" />
                            </StackPanel>

                            <Border Margin="0,12,0,0" Padding="8,6" Background="{DynamicResource Surface.Panel}" CornerRadius="4">
                                <TextBlock x:Name="PropertyValidationMessage" Text="{Binding ValidationMessage}" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource State.Running}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasValidationErrors}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource State.Warning}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="RunInspectorScrollViewer"
                          Grid.Row="1"
                          VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
