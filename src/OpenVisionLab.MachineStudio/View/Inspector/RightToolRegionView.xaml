<UserControl x:Class="OpenVisionLab.MachineStudio.View.Inspector.RightToolRegionView" x:Name="InspectorViewRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behavior="clr-namespace:OpenVisionLab.MachineStudio.Behavior"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:OpenVisionLab.MachineStudio.Converter"
             xmlns:loc="clr-namespace:OpenVisionLab.MachineStudio.Localization"
             xmlns:local="clr-namespace:OpenVisionLab.MachineStudio.View.Inspector"
             xmlns:shell="clr-namespace:OpenVisionLab.MachineStudio.View.Shell"
             xmlns:sequence="clr-namespace:OpenVisionLab.MachineStudio.View.Sequence">
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Navigation.IsEquipmentWorkspace}" Value="True">
                    <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic, Segoe UI" />
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="Foreground" Value="{DynamicResource EquipmentInspector.Text}" />
                </DataTrigger>
            <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Navigation.IsEquipmentWorkspace}" Value="True" /><Condition Binding="{Binding (shell:ShellWindow.IsCompactLayout), RelativeSource={RelativeSource AncestorType=shell:ShellWindow}}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="FontSize" Value="12.5" /></MultiDataTrigger></Style.Triggers>
        </Style>
    </UserControl.Style>
    <UserControl.Resources>
        <SolidColorBrush x:Key="EquipmentInspector.Surface" Color="{StaticResource Color.Surface.Panel}" />
        <SolidColorBrush x:Key="EquipmentInspector.Input" Color="{StaticResource Color.Surface.Input}" />
        <SolidColorBrush x:Key="EquipmentInspector.Button" Color="{StaticResource Color.Surface.Raised}" />
        <SolidColorBrush x:Key="EquipmentInspector.Line" Color="{StaticResource Color.Border.Subtle}" />
        <SolidColorBrush x:Key="EquipmentInspector.ControlLine" Color="{StaticResource Color.Border.Default}" />
        <SolidColorBrush x:Key="EquipmentInspector.Text" Color="{StaticResource Color.Text.Primary}" />
        <SolidColorBrush x:Key="EquipmentInspector.Muted" Color="{StaticResource Color.Text.Secondary}" />
        <SolidColorBrush x:Key="EquipmentInspector.Faint" Color="{StaticResource Color.Text.Secondary}" />
        <SolidColorBrush x:Key="EquipmentInspector.Accent" Color="{StaticResource Color.Accent.Primary}" />
        <SolidColorBrush x:Key="EquipmentInspector.Selected" Color="{StaticResource Color.Accent.Soft}" />
        <SolidColorBrush x:Key="EquipmentInspector.SelectedText" Color="{StaticResource Color.Accent.Primary}" />
        <SolidColorBrush x:Key="EquipmentInspector.OnAccent" Color="{StaticResource Color.Text.OnAccent}" />
        <SolidColorBrush x:Key="EquipmentInspector.DisabledText" Color="{StaticResource Color.Text.Disabled}" />
        <SolidColorBrush x:Key="EquipmentInspector.DisabledSurface" Color="{StaticResource Color.Surface.Disabled}" />
        <SolidColorBrush x:Key="EquipmentInspector.DisabledLine" Color="{StaticResource Color.Border.Disabled}" />
        <ResourceDictionary x:Key="R24InputStateResources">
            <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="{StaticResource Color.Surface.Input}" />
            <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="{StaticResource Color.Text.Secondary}" />
            <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="{StaticResource Color.Border.Default}" />
            <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="{StaticResource Color.Surface.Input}" />
            <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="{StaticResource Color.Text.Secondary}" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="{StaticResource Color.Border.Default}" />
        </ResourceDictionary>
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <loc:LocalizedFaultKindConverter x:Key="LocalizedFaultKindConverter" />
        <loc:LocalizedForcedValueConverter x:Key="LocalizedForcedValueConverter" />
        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.Navigation.IsEquipmentWorkspace, RelativeSource={RelativeSource AncestorType=local:RightToolRegionView}}" Value="True">
                    <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic, Segoe UI" />
                    <Setter Property="FontSize" Value="{Binding FontSize, RelativeSource={RelativeSource AncestorType=local:RightToolRegionView}}" />
                    <Setter Property="LineHeight" Value="18.85" />
                    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
                </DataTrigger>
            <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding DataContext.Navigation.IsEquipmentWorkspace, RelativeSource={RelativeSource AncestorType=local:RightToolRegionView}}" Value="True" /><Condition Binding="{Binding (shell:ShellWindow.IsCompactLayout), RelativeSource={RelativeSource AncestorType=shell:ShellWindow}}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="LineHeight" Value="18.125" /></MultiDataTrigger></Style.Triggers>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.Navigation.IsEquipmentWorkspace, RelativeSource={RelativeSource AncestorType=local:RightToolRegionView}}" Value="True">
                    <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic, Segoe UI" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Background" Value="{StaticResource EquipmentInspector.Input}" />
                    <Setter Property="Foreground" Value="{StaticResource EquipmentInspector.Muted}" />
                    <Setter Property="BorderBrush" Value="{StaticResource EquipmentInspector.ControlLine}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Height" Value="28" />
                    <Setter Property="MinHeight" Value="28" />
                    <Setter Property="Padding" Value="7,4" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </DataTrigger>
                <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding DataContext.Navigation.IsEquipmentWorkspace, RelativeSource={RelativeSource AncestorType=local:RightToolRegionView}}" Value="True" /><Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="False" /></MultiDataTrigger.Conditions><Setter Property="Opacity" Value="0.6" /></MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ui:NumberBox" BasedOn="{StaticResource {x:Type ui:NumberBox}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.Navigation.IsEquipmentWorkspace, RelativeSource={RelativeSource AncestorType=local:RightToolRegionView}}" Value="True">
                    <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic, Segoe UI" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Background" Value="{StaticResource EquipmentInspector.Input}" />
                    <Setter Property="Foreground" Value="{StaticResource EquipmentInspector.Muted}" />
                    <Setter Property="BorderBrush" Value="{StaticResource EquipmentInspector.ControlLine}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Height" Value="28" />
                    <Setter Property="MinHeight" Value="28" />
                    <Setter Property="Padding" Value="7,4" />
                </DataTrigger>
                <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding DataContext.Navigation.IsEquipmentWorkspace, RelativeSource={RelativeSource AncestorType=local:RightToolRegionView}}" Value="True" /><Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="False" /></MultiDataTrigger.Conditions><Setter Property="Opacity" Value="0.6" /></MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.Navigation.IsEquipmentWorkspace, RelativeSource={RelativeSource AncestorType=local:RightToolRegionView}}" Value="True">
                    <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic, Segoe UI" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Background" Value="{StaticResource EquipmentInspector.Input}" />
                    <Setter Property="Foreground" Value="{StaticResource EquipmentInspector.Muted}" />
                    <Setter Property="BorderBrush" Value="{StaticResource EquipmentInspector.ControlLine}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Height" Value="Auto" />
                    <Setter Property="MinHeight" Value="28" />
                    <Setter Property="Padding" Value="7,4" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </DataTrigger>
                <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding DataContext.Navigation.IsEquipmentWorkspace, RelativeSource={RelativeSource AncestorType=local:RightToolRegionView}}" Value="True" /><Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="False" /></MultiDataTrigger.Conditions><Setter Property="Opacity" Value="0.6" /></MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="InspectorFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,7,0,3" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.Navigation.IsEquipmentWorkspace, RelativeSource={RelativeSource AncestorType=local:RightToolRegionView}}" Value="True">
                    <Setter Property="Margin" Value="0,9,0,3" />
                    <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic, Segoe UI" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Foreground" Value="{StaticResource EquipmentInspector.Muted}" />
                    <Setter Property="LineHeight" Value="17.4" />
                    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SectionCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource SectionCaptionStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.Navigation.IsEquipmentWorkspace, RelativeSource={RelativeSource AncestorType=local:RightToolRegionView}}" Value="True">
                    <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic, Segoe UI" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="LineHeight" Value="17.4" />
                    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TelemetryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TelemetryTextStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.Navigation.IsEquipmentWorkspace, RelativeSource={RelativeSource AncestorType=local:RightToolRegionView}}" Value="True">
                    <Setter Property="FontFamily" Value="Consolas, Cascadia Mono" />
                    <Setter Property="FontSize" Value="11.5" />
                    <Setter Property="LineHeight" Value="16.675" />
                    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EquipmentFirstFieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource InspectorFieldLabelStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.Navigation.IsEquipmentWorkspace, RelativeSource={RelativeSource AncestorType=local:RightToolRegionView}}" Value="True">
                    <Setter Property="Margin" Value="0,0,0,3" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EquipmentColumnGapStyle" TargetType="ColumnDefinition">
            <Setter Property="Width" Value="10" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.Navigation.IsEquipmentWorkspace, ElementName=InspectorViewRoot}" Value="True">
                    <Setter Property="Width" Value="9" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EquipmentGeometryFieldStyle" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.Navigation.IsEquipmentWorkspace, RelativeSource={RelativeSource AncestorType=local:RightToolRegionView}}" Value="True">
                    <Setter Property="Margin" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EquipmentHintTextStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.Navigation.IsEquipmentWorkspace, RelativeSource={RelativeSource AncestorType=local:RightToolRegionView}}" Value="True">
                    <Setter Property="FontSize" Value="11.5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EquipmentTransformCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource SectionCaptionStyle}">
            <Setter Property="Margin" Value="0,10,0,2" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.Navigation.IsEquipmentWorkspace, RelativeSource={RelativeSource AncestorType=local:RightToolRegionView}}" Value="True">
                    <Setter Property="Margin" Value="0,12,0,3" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="EquipmentConnectionOptionTemplate">
            <TextBlock Text="{Binding DisplayName}" FontSize="12" LineHeight="17.4" Foreground="{StaticResource EquipmentInspector.Muted}" TextWrapping="Wrap" />
        </DataTemplate>
        <Style x:Key="EquipmentInspectorTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="{StaticResource Density.InspectorFieldHeight}" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.Navigation.IsEquipmentWorkspace, RelativeSource={RelativeSource AncestorType=local:RightToolRegionView}}" Value="True">
                    <Setter Property="Height" Value="28" />
                    <Setter Property="MinHeight" Value="28" />
                    <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic, Segoe UI" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Padding" Value="7,4" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EquipmentInspectorTabButtonStyle" TargetType="Button" BasedOn="{StaticResource GlobalCommandButtonStyle}">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Height" Value="Auto" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="Background" Value="{StaticResource EquipmentInspector.Button}" />
            <Setter Property="BorderBrush" Value="{StaticResource EquipmentInspector.ControlLine}" />
            <Setter Property="Foreground" Value="{StaticResource EquipmentInspector.Text}" />
            <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic, Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="InspectorButtonBorder" Padding="{TemplateBinding Padding}" CornerRadius="5"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="InspectorButtonBorder" Property="Background" Value="{DynamicResource Surface.Hover}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="InspectorButtonBorder" Property="Background" Value="{DynamicResource Surface.Pressed}" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="InspectorButtonBorder" Property="BorderBrush" Value="{StaticResource EquipmentInspector.Accent}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource EquipmentInspector.DisabledText}" /><Setter TargetName="InspectorButtonBorder" Property="Background" Value="{StaticResource EquipmentInspector.DisabledSurface}" /><Setter TargetName="InspectorButtonBorder" Property="BorderBrush" Value="{StaticResource EquipmentInspector.DisabledLine}" /></Trigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}" Value="{StaticResource EquipmentInspector.Accent}" /><Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True" /><Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource TemplatedParent}}" Value="True" /></MultiDataTrigger.Conditions><Setter TargetName="InspectorButtonBorder" Property="Background" Value="{DynamicResource Accent.Hover}" /></MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}" Value="{StaticResource EquipmentInspector.Accent}" /><Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource TemplatedParent}}" Value="False" /></MultiDataTrigger.Conditions><Setter Property="Foreground" Value="{DynamicResource Text.Disabled}" /><Setter TargetName="InspectorButtonBorder" Property="Background" Value="{DynamicResource Accent.Soft}" /><Setter TargetName="InspectorButtonBorder" Property="BorderBrush" Value="{DynamicResource State.RunningBorder}" /></MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center" FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="LineHeight" Value="17.4" /><Setter Property="LineStackingStrategy" Value="BlockLineHeight" /><Style.Triggers><DataTrigger Binding="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}" Value="13"><Setter Property="LineHeight" Value="18.85" /></DataTrigger><DataTrigger Binding="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}" Value="12.5"><Setter Property="LineHeight" Value="18.125" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EquipmentInspectorActionStyle" TargetType="Button" BasedOn="{StaticResource EquipmentInspectorTabButtonStyle}">
            <Setter Property="Height" Value="Auto" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="{Binding FontSize, RelativeSource={RelativeSource AncestorType=local:RightToolRegionView}}" />
        </Style>
        <Style x:Key="EquipmentInspectorApplyStyle" TargetType="Button" BasedOn="{StaticResource EquipmentInspectorActionStyle}">
            <Setter Property="Height" Value="Auto" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="{Binding FontSize, RelativeSource={RelativeSource AncestorType=local:RightToolRegionView}}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="{StaticResource EquipmentInspector.Accent}" />
            <Setter Property="BorderBrush" Value="{StaticResource EquipmentInspector.Accent}" />
            <Setter Property="Foreground" Value="{StaticResource EquipmentInspector.OnAccent}" />
        </Style>
        <Style x:Key="EquipmentInspectorDraftStateStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic, Segoe UI" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="LineHeight" Value="16.675" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{StaticResource EquipmentInspector.Faint}" />
            <Setter Property="Text" Value="{loc:Loc Key=Equipment.InspectorUnchanged}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasPendingInspectorDraft}" Value="True">
                    <Setter Property="Text" Value="{loc:Loc Key=R24.UnappliedDraft}" />
                    <Setter Property="Foreground" Value="{DynamicResource State.Warning}" />
                </DataTrigger>
            <DataTrigger Binding="{Binding HasPlacementValidationErrors}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="EquipmentInspectorDraftErrorStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic, Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineHeight" Value="17.4" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource State.Warning}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="R24FieldErrorTextStyle" TargetType="TextBlock"><Setter Property="FontSize" Value="11.5" /><Setter Property="LineHeight" Value="16.675" /><Setter Property="Margin" Value="0,3,0,0" /><Setter Property="Foreground" Value="{DynamicResource State.Fault}" /><Setter Property="TextWrapping" Value="Wrap" /><Style.Triggers><DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value=""><Setter Property="Height" Value="0" /></DataTrigger></Style.Triggers></Style>
        <Style x:Key="R24ErrorInputStyle" TargetType="TextBox" BasedOn="{StaticResource EquipmentInspectorTextBoxStyle}"><Style.Triggers><DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource State.Fault}" /><Setter Property="Background" Value="{DynamicResource State.FaultSurface}" /></DataTrigger></Style.Triggers></Style>
        <DataTemplate x:Key="EquipmentSettingsFieldTemplate">
            <StackPanel>
                <TextBlock FontSize="12" LineHeight="17.4" Margin="0,0,0,3" Foreground="{StaticResource EquipmentInspector.Muted}"><Run Text="{Binding CaptionText, Mode=OneWay}" /><Run Text="{Binding UnitText, Mode=OneWay}" FontSize="11" Foreground="{StaticResource EquipmentInspector.Faint}" /></TextBlock>
                <Grid>
                    <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="{Binding Id}" ToolTip="{Binding Value}" Tag="{Binding ErrorText}">
                        <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource R24ErrorInputStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsChoice}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBox.Style>
                    </TextBox>
                    <ComboBox ItemsSource="{Binding Options}" SelectedValuePath="Id" SelectedValue="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="{Binding Id}" ItemTemplate="{StaticResource EquipmentConnectionOptionTemplate}" Visibility="{Binding IsChoice, Converter={StaticResource BooleanToVisibilityConverter}}" Tag="{Binding ErrorText}"><ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}"><Setter Property="IsEnabled" Value="{Binding IsEnabled}" /></Style></ComboBox.ItemContainerStyle><ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Style.Triggers><DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource State.Fault}" /><Setter Property="Background" Value="{DynamicResource State.FaultSurface}" /></DataTrigger></Style.Triggers></Style></ComboBox.Style></ComboBox>
                </Grid>
                <TextBlock Text="{Binding ErrorText}" Style="{StaticResource R24FieldErrorTextStyle}" /><TextBlock Text="{Binding Help}" FontSize="10.5" LineHeight="15.225" Margin="0,3,0,0" Foreground="{StaticResource EquipmentInspector.Faint}" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Help}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Border>
        <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource PanelSurfaceStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Navigation.IsSequenceWorkspace}" Value="True"><Setter Property="Background" Value="{StaticResource EquipmentInspector.Surface}" /><Setter Property="BorderThickness" Value="0" /></DataTrigger>
                    <DataTrigger Binding="{Binding Navigation.IsEquipmentWorkspace}" Value="True">
                        <Setter Property="Background" Value="{StaticResource EquipmentInspector.Surface}" />
                        <Setter Property="BorderThickness" Value="0" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Height="Auto">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource PanelHeaderStyle}">
                        <Setter Property="Visibility" Value="{Binding IntegrationSetupOnly, RelativeSource={RelativeSource AncestorType=local:RightToolRegionView}, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=invert}" />
                        <Setter Property="Padding" Value="12,6" />
                        <Setter Property="MinHeight" Value="48" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Navigation.IsSequenceWorkspace}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            <DataTrigger Binding="{Binding Navigation.IsEquipmentWorkspace}" Value="True">
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Padding" Value="12,9" />
                                <Setter Property="Background" Value="{StaticResource EquipmentInspector.Surface}" />
                                <Setter Property="BorderBrush" Value="{StaticResource EquipmentInspector.Line}" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Navigation.IsEquipmentWorkspace}" Value="True" />
                                    <Condition Binding="{Binding Layout.HasSelection}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Height" Value="Auto" />
                                <Setter Property="MinHeight" Value="48" />
                                <Setter Property="Padding" Value="12,9,12,0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                            </MultiDataTrigger>
                            <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Navigation.IsEquipmentWorkspace}" Value="True" /><Condition Binding="{Binding Layout.SelectedComponentEditor.ShowWorkpieceProperties}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="MinHeight" Value="0" /><Setter Property="Padding" Value="12,9" /><Setter Property="BorderThickness" Value="0,0,0,1" /></MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
