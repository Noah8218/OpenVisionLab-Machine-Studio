                                           Text="{loc:Loc Key=Integration.HandoffStatus}" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Integration.HandoffStatusText}"
                                           TextWrapping="Wrap"
                                           ToolTip="{Binding Integration.HandoffStatusText}" />
                                <TextBlock Grid.Row="1"
                                           Margin="0,5,0,0"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           Text="{loc:Loc Key=Integration.AcknowledgementStatus}" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="2"
                                           Margin="0,5,0,0"
                                           Text="{Binding Integration.AcknowledgementStatusText}"
                                           TextWrapping="Wrap"
                                           ToolTip="{Binding Integration.AcknowledgementStatusText}" />
                                <TextBlock Grid.Row="2"
                                           Margin="0,5,0,0"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           Text="{loc:Loc Key=Integration.ResultStatus}" />
                                <TextBlock x:Name="MachineIntegrationResultStatusTextBlock"
                                           Grid.Row="2"
                                           Grid.Column="2"
                                           Margin="0,5,0,0"
                                           Text="{Binding Integration.ResultStatusText}"
                                           TextWrapping="Wrap"
                                           ToolTip="{Binding Integration.ResultStatusText}" />
                                <TextBlock Grid.Row="3"
                                           Margin="0,5,0,0"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           Text="{loc:Loc Key=Integration.ProjectionStatus}" />
                                <TextBlock Grid.Row="3"
                                           Grid.Column="2"
                                           Margin="0,5,0,0"
                                           Text="{Binding Integration.ProjectionStatusText}"
                                           TextWrapping="Wrap"
                                           ToolTip="{Binding Integration.ProjectionStatusText}" />
                                <TextBlock Grid.Row="4"
                                           Margin="0,5,0,0"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           Text="{loc:Loc Key=Integration.LastTransaction}" />
                                <TextBlock Grid.Row="4"
                                           Grid.Column="2"
                                           Margin="0,5,0,0"
                                           FontFamily="{StaticResource Typography.Telemetry}"
                                           FontSize="9.5"
                                           Text="{Binding Integration.LastTransactionText}"
                                           TextWrapping="Wrap"
                                           ToolTip="{Binding Integration.LastTransactionText}" />
                            </Grid>
                            <TextBlock Margin="0,9,0,0"
                                       FontSize="10"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{loc:Loc Key=Integration.ThreeDReadOnlyHint}"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="MachineIntegrationStatusTextBlock"
                                       Margin="0,7,0,0"
                                       Text="{Binding Integration.StatusText}"
                                       TextWrapping="Wrap"
                                       ToolTip="{Binding Integration.StatusText}" />
                            <Expander x:Name="MachineIntegrationTransactionHistoryExpander"
                                      Margin="0,7,0,0"
                                      Header="{loc:Loc Key=Integration.TransactionHistory}"
                                      IsExpanded="False"
                                      AutomationProperties.AutomationId="MachineIntegrationTransactionHistoryExpander"
                                      AutomationProperties.Name="{loc:Loc Key=Integration.TransactionHistory}">
                                <StackPanel Margin="0,5,0,0">
                                    <TextBlock Foreground="{DynamicResource Text.Secondary}"
                                               Text="{loc:Loc Key=Integration.TransactionHistoryHint}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,5,0,0"
                                               Foreground="{DynamicResource Text.Secondary}"
                                               Text="{loc:Loc Key=Integration.TransactionHistoryFilterHint}"
                                               TextWrapping="Wrap" />
                                    <StackPanel Margin="0,5,0,0"
                                                Orientation="Horizontal">
                                        <TextBlock VerticalAlignment="Center"
                                                   Text="{loc:Loc Key=Integration.TransactionHistoryFilter}" />
                                        <ComboBox x:Name="MachineIntegrationTransactionHistoryFilter"
                                                  Margin="7,0,0,0"
                                                  MinWidth="150"
                                                  ItemsSource="{Binding Integration.TransactionHistoryFilters}"
                                                  DisplayMemberPath="DisplayText"
                                                  SelectedItem="{Binding Integration.SelectedTransactionHistoryFilter, Mode=TwoWay}"
                                                  AutomationProperties.AutomationId="MachineIntegrationTransactionHistoryFilter"
                                                  AutomationProperties.Name="{loc:Loc Key=Integration.TransactionHistoryFilter}" />
                                    </StackPanel>
                                    <TextBlock x:Name="MachineIntegrationTransactionHistoryEmptyText"
                                               Margin="0,5,0,0"
                                               Foreground="{DynamicResource Text.Secondary}"
                                               Text="{Binding Integration.TransactionHistoryEmptyText}"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding Integration.HasTransactionHistoryEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <ListBox x:Name="MachineIntegrationTransactionHistoryList"
                                             Margin="0,5,0,0"
                                             MaxHeight="180"
                                             ItemsSource="{Binding Integration.VisibleTransactionHistoryRows}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             AutomationProperties.AutomationId="MachineIntegrationTransactionHistoryList"
                                             AutomationProperties.Name="{loc:Loc Key=Integration.TransactionHistory}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="3,3">
                                                    <TextBlock FontWeight="SemiBold"
                                                               Text="{Binding ShortTransactionId}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding FullTransactionId}" />
                                                    <TextBlock Style="{StaticResource TelemetryTextStyle}"
                                                               Text="{Binding Handoff.CreatedAtUtc}" />
                                                    <TextBlock Foreground="{DynamicResource Text.Secondary}"
                                                               Text="{Binding Handoff.Context.Modality}" />
                                                    <TextBlock Foreground="{DynamicResource Text.Secondary}"
                                                               Text="{Binding Handoff.Context.InputKind}" />
                                                    <TextBlock Foreground="{DynamicResource Text.Secondary}"
                                                               Text="{Binding StatusText}"
                                                               TextWrapping="Wrap"
                                                               ToolTip="{Binding StatusText}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Expander>
                            <Expander x:Name="MachineIntegrationTransactionDiagnosticsExpander"
                                      Margin="0,7,0,0"
                                      Header="{loc:Loc Key=Integration.TransactionDiagnostics}"
                                      IsExpanded="False"
                                      AutomationProperties.AutomationId="MachineIntegrationTransactionDiagnosticsExpander"
                                      AutomationProperties.Name="{loc:Loc Key=Integration.TransactionDiagnostics}">
                                <StackPanel Margin="0,5,0,0">
                                    <TextBlock Foreground="{DynamicResource Text.Secondary}"
                                               Text="{loc:Loc Key=Integration.TransactionDiagnosticsFilterHint}"
                                               TextWrapping="Wrap" />
                                    <StackPanel Margin="0,5,0,0"
                                                Orientation="Horizontal">
                                        <TextBlock VerticalAlignment="Center"
                                                   Text="{loc:Loc Key=Integration.TransactionDiagnosticsFilter}" />
                                        <ComboBox x:Name="MachineIntegrationTransactionDiagnosticsFilter"
                                                  Margin="7,0,0,0"
                                                  MinWidth="150"
                                                  ItemsSource="{Binding Integration.TransactionDiagnosticFilters}"
                                                  DisplayMemberPath="DisplayText"
                                                  SelectedItem="{Binding Integration.SelectedTransactionDiagnosticFilter, Mode=TwoWay}"
                                                  AutomationProperties.AutomationId="MachineIntegrationTransactionDiagnosticsFilter"
                                                  AutomationProperties.Name="{loc:Loc Key=Integration.TransactionDiagnosticsFilter}" />
                                    </StackPanel>
                                    <TextBlock Foreground="{DynamicResource Text.Secondary}"
                                               Text="{Binding Integration.TransactionDiagnosticReadError}"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Name="MachineIntegrationTransactionDiagnosticsEmptyText"
                                               Margin="0,5,0,0"
                                               Foreground="{DynamicResource Text.Secondary}"
                                               Text="{Binding Integration.TransactionDiagnosticsEmptyText}"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding Integration.HasTransactionDiagnosticsEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <ListBox x:Name="MachineIntegrationTransactionDiagnosticsList"
                                             Margin="0,5,0,0"
                                             MaxHeight="180"
                                             ItemsSource="{Binding Integration.VisibleTransactionDiagnostics}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             AutomationProperties.AutomationId="MachineIntegrationTransactionDiagnosticsList"
                                             AutomationProperties.Name="{loc:Loc Key=Integration.TransactionDiagnostics}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="3,3">
                                                    <TextBlock FontWeight="SemiBold"
                                                               Text="{Binding State}" />
                                                    <TextBlock Style="{StaticResource TelemetryTextStyle}"
                                                               Text="{Binding TransactionId}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding TransactionId}" />
                                                    <TextBlock Foreground="{DynamicResource Text.Secondary}"
                                                               Text="{Binding Detail}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Foreground="{DynamicResource Text.Secondary}"
                                                               Text="{Binding DirectoryPath}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding DirectoryPath}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </Border>
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource InspectorCardStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DigitalIo.HasSignals}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock x:Name="DigitalIoSectionAnchor"
                                       Style="{StaticResource SectionCaptionStyle}"
                                       Text="{loc:Loc Key=Inspector.IoCommissioning}" />
                            <TextBlock Margin="0,2,0,8"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{loc:Loc Key=Inspector.IoCommissioningHint}"
                                       TextWrapping="Wrap" />
                            <DataGrid x:Name="DigitalIoSignalGrid"
                                      MinHeight="96"
                                      MaxHeight="190"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserReorderColumns="False"
                                      CanUserResizeRows="False"
                                      CanUserSortColumns="False"
                                      HeadersVisibility="Column"
                                      IsReadOnly="True"
                                      ItemsSource="{Binding DigitalIo.Signals}"
                                      SelectedItem="{Binding DigitalIo.SelectedSignal, Mode=TwoWay}"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="*" Header="{loc:Loc Key=Inspector.Signal}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel ToolTip="{Binding Id}">
                                                    <TextBlock Foreground="{DynamicResource Text.Primary}"
                                                               Text="{Binding DisplayName}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock FontFamily="{StaticResource Typography.Telemetry}"
                                                               FontSize="9.5"
                                                               Foreground="{DynamicResource Text.Secondary}"
                                                               Text="{Binding Id}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Width="46"
                                                        Binding="{Binding KindText}"
                                                        Header="{loc:Loc Key=Inspector.Kind}" />
                                    <DataGridTextColumn Width="48"
                                                        Binding="{Binding ValueText}"
                                                        Header="{loc:Loc Key=Inspector.Value}" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <Grid Margin="0,9,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Foreground="{DynamicResource Text.Secondary}"
                                           Text="{loc:Loc Key=Inspector.RuntimeOwner}" />
                                <TextBlock Grid.Column="1"
                                           Margin="8,0,0,0"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource TelemetryTextStyle}"
                                           Text="{Binding DigitalIo.ControlOwnerText}" />
                                <TextBlock Grid.Row="1"
                                           Margin="0,5,0,0"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           Text="{loc:Loc Key=Inspector.Revision}" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Margin="8,5,0,0"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource TelemetryTextStyle}"
                                           Text="{Binding DigitalIo.SignalRevisionText}" />
                                <TextBlock Grid.Row="2"
                                           Margin="0,5,0,0"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           Text="{loc:Loc Key=Inspector.NominalValue}" />
                                <TextBlock Grid.Row="2"
                                           Grid.Column="1"
                                           Margin="8,5,0,0"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource TelemetryTextStyle}"
                                           Text="{Binding DigitalIo.SelectedNominalValueText}" />
                                <TextBlock Grid.Row="3"
                                           Margin="0,5,0,0"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           Text="{loc:Loc Key=Inspector.ForceState}" />
                                <TextBlock Grid.Row="3"
                                           Grid.Column="1"
                                           Margin="8,5,0,0"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource TelemetryTextStyle}"
                                           Text="{Binding DigitalIo.SelectedForceText}" />
                            </Grid>

                            <Button x:Name="StartDigitalIoManualControlButton"
                                    Margin="0,9,0,0"
                                    Command="{Binding DigitalIo.StartManualControlCommand}"
                                    Content="{loc:Loc Key=Io.StartManualControl}"
                                    Style="{StaticResource PrimaryCommandButtonStyle}"
                                    ToolTip="{loc:Loc Key=Io.StartManualControlTooltip}" />
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.9*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="0.9*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="1.2*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="DigitalIoForceOnButton"
                                        Command="{Binding DigitalIo.ForceOnCommand}"
                                        Content="{loc:Loc Key=Io.ForceOn}"
                                        ToolTip="{loc:Loc Key=Io.ForceOnTooltip}" />
                                <Button x:Name="DigitalIoForceOffButton"
                                        Grid.Column="2"
                                        Command="{Binding DigitalIo.ForceOffCommand}"
                                        Content="{loc:Loc Key=Io.ForceOff}"
                                        ToolTip="{loc:Loc Key=Io.ForceOffTooltip}" />
                                <Button x:Name="DigitalIoClearForceButton"
                                        Grid.Column="4"
                                        Command="{Binding DigitalIo.ClearForceCommand}"
                                        Content="{loc:Loc Key=Io.ClearForce}"
                                        ToolTip="{loc:Loc Key=Io.ClearForceTooltip}" />
                            </Grid>
                            <TextBlock Margin="2,8,2,0"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{Binding DigitalIo.OperationHintText}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource InspectorCardStyle}">
                        <StackPanel>
                            <TextBlock x:Name="FaultManagerSectionAnchor"
                                       Style="{StaticResource SectionCaptionStyle}"
                                       Text="{loc:Loc Key=Inspector.FaultManager}" />
                            <TextBlock Margin="0,2,0,8"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{loc:Loc Key=Inspector.FaultRecoveryHint}"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,0,0,3"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{loc:Loc Key=Inspector.FaultType}" />
                            <ComboBox x:Name="FaultKindComboBox"
                                      ItemsSource="{Binding FaultManager.AvailableKinds}"
                                      SelectedItem="{Binding FaultManager.SelectedKind, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource LocalizedFaultKindConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Margin="0,8,0,3"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{loc:Loc Key=Inspector.RuntimeTarget}" />
                            <ComboBox x:Name="FaultTargetComboBox"
                                      ItemsSource="{Binding FaultManager.Targets}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedItem="{Binding FaultManager.SelectedTarget, Mode=TwoWay}"
                                      ToolTip="{loc:Loc Key=Inspector.RuntimeTargetTooltip}"
                                      IsEnabled="{Binding FaultManager.HasTargets}" />
                            <TextBlock Margin="0,4,0,0"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource State.Warning}"
                                       Text="{Binding FaultManager.TargetSelectionHelpText}"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FaultManager.HasTargets}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel Margin="0,8,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FaultManager.RequiresForcedValue}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Margin="0,0,0,3"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           Text="{loc:Loc Key=Inspector.ForcedValue}" />
                                <ComboBox x:Name="FaultForcedValueComboBox"
                                          ItemsSource="{Binding FaultManager.ForcedValueOptions}"
                                          SelectedItem="{Binding FaultManager.SelectedForcedValue, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource LocalizedForcedValueConverter}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <Button x:Name="InjectFaultButton"
                                    Margin="0,10,0,0"
                                    Command="{Binding FaultManager.InjectCommand}"
                                    Style="{StaticResource PrimaryCommandButtonStyle}"
                                    Content="{loc:Loc Key=Inspector.InjectFault}" />

                            <Grid Margin="0,12,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SectionCaptionStyle}" Text="{loc:Loc Key=Inspector.ActiveFaults}" />
                                <TextBlock Grid.Column="1" Text="{Binding FaultManager.ActiveFaultCountText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FaultManager.HasActiveFaults}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource State.Fault}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <ListBox x:Name="ActiveFaultListBox"
                                     MinHeight="46"
                                     MaxHeight="112"
                                     ItemsSource="{Binding FaultManager.ActiveFaults}"
                                     SelectedItem="{Binding FaultManager.SelectedActiveFault, Mode=TwoWay}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.Style>
                                    <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FaultManager.HasActiveFaults}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.Style>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="4,3"
                                                   Foreground="{DynamicResource Text.Primary}"
                                                   Text="{Binding DisplayText}"
                                                   TextWrapping="Wrap"
                                                   ToolTip="{Binding TargetId}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="ClearSelectedFaultButton"
                                        Command="{Binding FaultManager.ClearSelectedCommand}"
                                        Content="{loc:Loc Key=Inspector.ClearSelected}" />
                                <Button x:Name="ClearAllFaultsButton"
                                        Grid.Column="2"
                                        Command="{Binding FaultManager.ClearAllCommand}"
                                        Content="{loc:Loc Key=Inspector.ClearAll}" />
                            </Grid>
                            <TextBlock x:Name="NoActiveFaultsText"
                                       Margin="0,4,0,0"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{loc:Loc Key=Inspector.NoActiveFaults}"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FaultManager.HasActiveFaults}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock x:Name="FaultOperationStatusText"
                                       Margin="2,8,2,0"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{Binding FaultManager.OperationStatusText}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource InspectorCardStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasEmbeddedSequence}" Value="True" />
                                            <Condition Binding="{Binding HasCycleStartInput}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionCaptionStyle}" Text="{loc:Loc Key=Inspector.VirtualInput}" />
                            <Button Command="{Binding CycleStartCommand}"
                                    Style="{StaticResource PrimaryCommandButtonStyle}"
                                    ToolTip="{loc:Loc Key=Inspector.CycleStartTooltip}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Play24" Foreground="{DynamicResource State.Running}" />
                                    <TextBlock Margin="6,0,0,0" Text="{loc:Loc Key=Inspector.CycleStart}" />
                                </StackPanel>
                            </Button>
                            <TextBlock Margin="2,8,2,0"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{loc:Loc Key=Inspector.CycleStartHint}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
