                                    <ComboBox x:Name="DebuggerWatchTargetComboBox"
                                              ItemsSource="{Binding RuntimeDebugger.WatchTargets}"
                                              SelectedItem="{Binding RuntimeDebugger.SelectedWatchTarget, Mode=TwoWay}"
