                                            Style="{StaticResource GlobalCommandButtonStyle}"
                                            AutomationProperties.Name="{Binding RuntimeDebugger.BreakpointActionText}" />
                                </StackPanel>
                            </Expander>

                            <Expander x:Name="DebuggerWatchesExpander"
