<UserControl x:Class="OpenVisionLab.MachineStudio.View.Inspector.RightToolRegionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behavior="clr-namespace:OpenVisionLab.MachineStudio.Behavior"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:OpenVisionLab.MachineStudio.Converter"
             xmlns:loc="clr-namespace:OpenVisionLab.MachineStudio.Localization"
             xmlns:local="clr-namespace:OpenVisionLab.MachineStudio.View.Inspector">
    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <loc:LocalizedFaultKindConverter x:Key="LocalizedFaultKindConverter" />
        <loc:LocalizedForcedValueConverter x:Key="LocalizedForcedValueConverter" />
        <Style x:Key="InspectorFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,7,0,3" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
        </Style>
        <Style x:Key="EquipmentInspectorTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="{StaticResource Density.InspectorFieldHeight}" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="EquipmentInspectorTabButtonStyle" TargetType="Button" BasedOn="{StaticResource GlobalCommandButtonStyle}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Padding" Value="4,0" />
        </Style>
    </UserControl.Resources>
    <Border Style="{StaticResource PanelSurfaceStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource PanelHeaderStyle}">
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Navigation.IsEquipmentWorkspace}" Value="True" />
                                    <Condition Binding="{Binding Layout.HasSelection}" Value="True" />
                                    <Condition Binding="{Binding IsRunMode}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Height" Value="Auto" />
                                <Setter Property="MinHeight" Value="48" />
                                <Setter Property="Padding" Value="12,6" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <TextBlock Text="{Binding RightPanelHeaderText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource PanelHeaderTextStyle}">
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Navigation.IsEquipmentWorkspace}" Value="True" />
                                            <Condition Binding="{Binding Layout.HasSelection}" Value="True" />
                                            <Condition Binding="{Binding IsRunMode}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Grid DataContext="{Binding Layout.SelectedComponentEditor}">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding DataContext.Navigation.IsEquipmentWorkspace, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                                            <Condition Binding="{Binding DataContext.Layout.HasSelection, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                                            <Condition Binding="{Binding DataContext.IsRunMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold" Text="{Binding PaneTitle}" TextWrapping="Wrap" />
                            <TextBlock Foreground="{DynamicResource Text.Secondary}" FontSize="11" Text="{Binding Id}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Width="30" Height="30" Margin="8,0,0,0"
                                VerticalAlignment="Center" Content="×"
                                AutomationProperties.Name="{loc:Loc Key=Shell.CloseProperties}"
                                Command="{Binding DataContext.Navigation.ToggleInspectorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="1" Padding="8,8" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,0,1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Navigation.IsEquipmentWorkspace}" Value="True" />
                                    <Condition Binding="{Binding Layout.HasSelection}" Value="True" />
                                    <Condition Binding="{Binding IsRunMode}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <UniformGrid Columns="3">
                    <Button Command="{Binding OpenEquipmentPropertiesCommand}"
                            Content="{loc:Loc Key=Equipment.PlacementTab}"
                            AutomationProperties.Name="{loc:Loc Key=Equipment.PlacementTab}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource EquipmentInspectorTabButtonStyle}">
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsEquipmentDriveTabOpen}" Value="False" />
                                            <Condition Binding="{Binding IsEquipmentSinglePartCheckOpen}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="{DynamicResource Accent.Soft}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Command="{Binding OpenEquipmentDriveTabCommand}"
                            Content="{loc:Loc Key=Equipment.DriveTab}"
                            AutomationProperties.Name="{loc:Loc Key=Equipment.DriveTab}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource EquipmentInspectorTabButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEquipmentDriveTabOpen}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Accent.Soft}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Command="{Binding OpenEquipmentSinglePartCheckCommand}"
                            Content="{loc:Loc Key=Equipment.SinglePartCheck}"
                            AutomationProperties.Name="{loc:Loc Key=Equipment.SinglePartCheck}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource EquipmentInspectorTabButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEquipmentSinglePartCheckOpen}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Accent.Soft}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </UniformGrid>
            </Border>

            <ScrollViewer x:Name="DesignInspectorScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRunMode}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsEquipmentSinglePartCheckOpen}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <StackPanel>
                    <ItemsControl Margin="3"
                                  ItemsSource="{Binding Properties.Items}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Layout.HasSelection}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasSelectedAxisDefinition}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsMultiAxisCommissioningRecipeSelection}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasSelectedAnalogChannel}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="6,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="112" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Foreground="{DynamicResource Text.Secondary}"
                                               Text="{Binding Name}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Value}"
                                               TextWrapping="Wrap"
                                               ToolTip="{Binding Value}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border x:Name="AnalogIoAuthoringPanel"
                            Visibility="{Binding HasSelectedAnalogChannel, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource InspectorCardStyle}">
                                <Setter Property="IsEnabled" Value="True" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDryRunPlaybackActive}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel DataContext="{Binding AnalogIoAuthoring}">
                            <TextBlock Style="{StaticResource SectionCaptionStyle}"
                                       Text="{loc:Loc Key=Io.AnalogAuthoring}" />
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontSize="14"
                                           FontWeight="SemiBold"
                                           Text="{Binding DisplayName}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Id}" />
                                <TextBlock Grid.Column="1"
                                           Margin="8,0,0,0"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           Text="{Binding KindText}" />
                            </Grid>
                            <TextBlock Margin="0,0,0,8"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{loc:Loc Key=Io.AnalogAuthoringHint}"
                                       TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource InspectorFieldLabelStyle}"
                                       Text="{loc:Loc Key=Io.InitialValue}" />
                            <TextBox x:Name="AnalogInitialValueTextBox"
                                     Height="30"
                                     AutomationProperties.AutomationId="AnalogInitialValueTextBox"
                                     AutomationProperties.Name="{loc:Loc Key=Io.InitialValue}"
                                     Text="{Binding InitialValueText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{Binding InitialValueText}" />
                            <Border Margin="0,10,0,0"
                                    Padding="8,6"
                                    Background="{DynamicResource Surface.Panel}"
                                    CornerRadius="4">
                                <TextBlock x:Name="AnalogValueValidationMessage"
                                           Text="{Binding ValidationMessage}"
                                           TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource State.Running}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasValidationErrors}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource State.Warning}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border x:Name="MultiAxisRecipeDesignPanel"
                            Style="{StaticResource InspectorCardStyle}"
                            Visibility="{Binding IsMultiAxisCommissioningRecipeSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel DataContext="{Binding MultiAxisCommissioningRecipe}">
                            <TextBlock Style="{StaticResource SectionCaptionStyle}"
                                       Text="{loc:Loc Key=Axis.MultiAxisRecipe}" />
                            <TextBlock Margin="0,2,0,8"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{loc:Loc Key=Axis.RecipeDesignHint}"
                                       TextWrapping="Wrap" />
                            <Button Command="{Binding CreateRecipeCommand}"
                                    Content="{loc:Loc Key=Axis.CreateRecipe}"
                                    AutomationProperties.Name="{loc:Loc Key=Axis.CreateRecipe}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryCommandButtonStyle}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConfigured}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConfigured}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Style="{StaticResource InspectorFieldLabelStyle}"
                                           Text="{loc:Loc Key=Axis.RecipeName}" />
                                <TextBox x:Name="MultiAxisRecipeNameTextBox"
                                         Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Margin="0,12,0,3"
                                           Style="{StaticResource SectionCaptionStyle}"
                                           Text="{loc:Loc Key=Axis.RecipeTargets}" />
                                <ItemsControl ItemsSource="{Binding Targets}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,7"
                                                    Padding="8"
                                                    Background="{DynamicResource Surface.Panel}"
                                                    CornerRadius="4">
                                                <StackPanel>
                                                    <ComboBox ItemsSource="{Binding AvailableAxes}"
                                                              DisplayMemberPath="Name"
                                                              SelectedValuePath="Id"
                                                              SelectedValue="{Binding AxisId, Mode=TwoWay}" />
                                                    <ui:NumberBox Margin="0,6,0,0"
                                                                  Minimum="-1000000"
                                                                  Maximum="1000000"
                                                                  SmallChange="1"
                                                                  Value="{Binding TargetPosition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <WrapPanel Margin="0,6,0,0">
                                                        <Button MinWidth="34"
                                                                Margin="0,0,4,0"
                                                                Command="{Binding MoveUpCommand}"
                                                                Content="↑"
                                                                ToolTip="{loc:Loc Key=Axis.MoveTargetUp}"
                                                                AutomationProperties.Name="{loc:Loc Key=Axis.MoveTargetUp}" />
                                                        <Button MinWidth="34"
                                                                Margin="0,0,4,0"
                                                                Command="{Binding MoveDownCommand}"
                                                                Content="↓"
                                                                ToolTip="{loc:Loc Key=Axis.MoveTargetDown}"
                                                                AutomationProperties.Name="{loc:Loc Key=Axis.MoveTargetDown}" />
                                                        <Button Command="{Binding RemoveCommand}"
                                                                Content="{loc:Loc Key=Axis.RemoveTarget}"
                                                                ToolTip="{loc:Loc Key=Axis.RemoveTarget}"
                                                                AutomationProperties.Name="{loc:Loc Key=Axis.RemoveTarget}" />
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <WrapPanel>
                                    <Button Margin="0,0,6,4"
                                            Command="{Binding AddTargetCommand}"
                                            Content="{loc:Loc Key=Axis.AddRecipeTarget}" />
                                    <Button Margin="0,0,6,4"
                                            Command="{Binding DeleteRecipeCommand}"
                                            Content="{loc:Loc Key=Axis.DeleteRecipe}" />
                                </WrapPanel>
                            </StackPanel>
                            <Border Margin="0,10,0,0"
                                    Padding="8,6"
                                    Background="{DynamicResource Surface.Panel}"
                                    CornerRadius="4">
                                <TextBlock Text="{Binding ValidationMessage}" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource State.Running}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasValidationErrors}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource State.Warning}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border x:Name="AxisDriveTuningPanel"
                            Style="{StaticResource InspectorCardStyle}"
                            Visibility="{Binding HasSelectedAxisDefinition, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel DataContext="{Binding AxisDriveTuningEditor}">
                            <TextBlock Style="{StaticResource SectionCaptionStyle}"
                                       Text="{loc:Loc Key=Axis.AuthoredDriveTuning}" />
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding Name}" />
                                <TextBlock Grid.Column="1" Margin="8,0,0,0" Foreground="{DynamicResource Text.Secondary}" Text="{Binding Id}" />
                            </Grid>

                            <TextBlock Margin="0,4,0,2" Style="{StaticResource SectionCaptionStyle}" Text="{loc:Loc Key=Axis.TravelSetup}" />
                            <TextBlock Style="{StaticResource InspectorFieldLabelStyle}" Text="{loc:Loc Key=Axis.HomePosition}" />
                            <ui:NumberBox AutomationProperties.AutomationId="AxisHomePositionNumberBox" Minimum="-1000000" Maximum="1000000" SmallChange="1" Value="{Binding HomePosition, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource InspectorFieldLabelStyle}" Text="{loc:Loc Key=Axis.SoftLimitMin}" />
                            <ui:NumberBox AutomationProperties.AutomationId="AxisSoftLimitMinNumberBox" Minimum="-1000000" Maximum="1000000" SmallChange="1" Value="{Binding SoftLimitMin, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource InspectorFieldLabelStyle}" Text="{loc:Loc Key=Axis.SoftLimitMax}" />
                            <ui:NumberBox AutomationProperties.AutomationId="AxisSoftLimitMaxNumberBox" Minimum="-1000000" Maximum="1000000" SmallChange="1" Value="{Binding SoftLimitMax, Mode=TwoWay}" />

                            <TextBlock Margin="0,12,0,2" Style="{StaticResource SectionCaptionStyle}" Text="{loc:Loc Key=Axis.DriveTuning}" />
                            <TextBlock Style="{StaticResource InspectorFieldLabelStyle}" Text="{loc:Loc Key=Axis.MaxVelocity}" />
                            <ui:NumberBox AutomationProperties.AutomationId="AxisMaxVelocityNumberBox" Minimum="0.001" Maximum="1000000" SmallChange="1" Value="{Binding MaxVelocity, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource InspectorFieldLabelStyle}" Text="{loc:Loc Key=Axis.MaxAcceleration}" />
                            <ui:NumberBox AutomationProperties.AutomationId="AxisMaxAccelerationNumberBox" Minimum="0.001" Maximum="1000000" SmallChange="1" Value="{Binding MaxAcceleration, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource InspectorFieldLabelStyle}" Text="{loc:Loc Key=Axis.MaxDeceleration}" />
                            <ui:NumberBox AutomationProperties.AutomationId="AxisMaxDecelerationNumberBox" Minimum="0.001" Maximum="1000000" SmallChange="1" Value="{Binding MaxDeceleration, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource InspectorFieldLabelStyle}" Text="{loc:Loc Key=Axis.FollowingErrorLimit}" />
                            <ui:NumberBox AutomationProperties.AutomationId="AxisFollowingErrorLimitNumberBox" Minimum="0.001" Maximum="1000000" SmallChange="0.01" Value="{Binding FollowingErrorLimit, Mode=TwoWay}" />
                            <Button x:Name="ResetAxisDriveDefaultsButton"
                                    Margin="0,10,0,0"
                                    AutomationProperties.Name="{loc:Loc Key=Axis.ResetDriveDefaults}"
                                    Command="{Binding ResetDriveDefaultsCommand}"
                                    Content="{loc:Loc Key=Axis.ResetDriveDefaults}"
                                    Style="{StaticResource GlobalCommandButtonStyle}"
                                    ToolTip="{loc:Loc Key=Axis.ResetDriveDefaultsTooltip}" />

                            <Border Margin="0,12,0,0" Padding="8,6" Background="{DynamicResource Surface.Panel}" CornerRadius="4">
                                <TextBlock x:Name="AxisTuningValidationMessage" Text="{Binding ValidationMessage}" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource State.Running}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasValidationErrors}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource State.Warning}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Visibility="{Binding Layout.HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource InspectorCardStyle}">
                                <Setter Property="IsEnabled" Value="True" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Navigation.IsEquipmentWorkspace}" Value="True">
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="Padding" Value="14" />
                                        <Setter Property="Background" Value="Transparent" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsDryRunPlaybackActive}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel DataContext="{Binding Layout.SelectedComponentEditor}">
                            <TextBlock Text="{loc:Loc Key=Inspector.AuthoredProperties}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SectionCaptionStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.Navigation.IsEquipmentWorkspace, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Grid Margin="0,0,0,6">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.Navigation.IsEquipmentWorkspace, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding KindText}" />
                                <TextBlock Grid.Column="1" Margin="8,0,0,0" Foreground="{DynamicResource Text.Secondary}" Text="{Binding Id}" />
                            </Grid>

                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsEquipmentDriveTabOpen, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                            <TextBlock Style="{StaticResource InspectorFieldLabelStyle}" Text="{loc:Loc Key=Properties.Name}" />
                            <TextBox x:Name="ComponentNameTextBox"
                                     Style="{StaticResource EquipmentInspectorTextBoxStyle}"
                                      Text="{Binding DraftName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      ToolTip="{Binding DraftName}" />
                            <StackPanel Margin="0,5,0,0"
                                        Visibility="{Binding HasUnitAssignmentOptions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Style="{StaticResource InspectorFieldLabelStyle}" Text="{loc:Loc Key=Properties.Unit}" />
                                <ComboBox AutomationProperties.Name="{loc:Loc Key=Properties.Unit}"
                                          ItemsSource="{Binding UnitOptions}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding UnitId, Mode=TwoWay}" />
                            </StackPanel>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource InspectorFieldLabelStyle}" Text="{loc:Loc Key=Equipment.CoordinateX}" />
                                    <TextBox Style="{StaticResource EquipmentInspectorTextBoxStyle}" Text="{Binding DraftXText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource InspectorFieldLabelStyle}" Text="{loc:Loc Key=Equipment.CoordinateHeightY}" />
                                    <TextBox Style="{StaticResource EquipmentInspectorTextBoxStyle}" Text="{Binding DraftBaseElevationText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource InspectorFieldLabelStyle}" Text="{loc:Loc Key=Equipment.CoordinateDepthZ}" />
                            <TextBox Style="{StaticResource EquipmentInspectorTextBoxStyle}" Text="{Binding DraftDepthText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource Text.Secondary}"
                                       Text="{loc:Loc Key=Equipment.PlacementDraftHint}"
                                       TextWrapping="Wrap" />
                            <Border Margin="0,6,0,0"
                                    Padding="8,6"
                                    Background="{DynamicResource Surface.Panel}"
                                    CornerRadius="4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
