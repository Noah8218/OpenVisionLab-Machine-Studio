l><Button Style="{StaticResource EquipmentInspectorActionStyle}" Margin="0,0,6,6" Command="{Binding EquipmentInspectorManualCommand}" CommandParameter="ext" Content="{loc:Loc Key=R24.Extend}" /><Button Style="{StaticResource EquipmentInspectorActionStyle}" Margin="0,0,6,6" Command="{Binding EquipmentInspectorManualCommand}" CommandParameter="ret" Content="{loc:Loc Key=R24.Retract}" /></WrapPanel></StackPanel><StackPanel Visibility="{Binding Layout.SelectedComponentEditor.ShowConveyorProperties, Converter={StaticResource BooleanToVisibilityConverter}}"><Grid Margin="0,24,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="4" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock FontSize="12" LineHeight="17.4" Text="{loc:Loc Key=R24.RunOutput}" Foreground="{StaticResource EquipmentInspector.Faint}" /><TextBlock Grid.Column="2" FontSize="12" LineHeight="17.4" Text="{Binding EquipmentInspectorManualStatusText}" TextWrapping="Wrap" /><TextBlock Grid.Row="2" FontSize="12" LineHeight="17.4" Text="{loc:Loc Key=R24.Products}" Foreground="{StaticResource EquipmentInspector.Faint}" /><TextBlock Grid.Row="2" Grid.Column="2" FontSize="12" LineHeight="17.4" Text="{Binding EquipmentInspectorProductsText}" TextWrapping="Wrap" /></Grid><WrapPanel><Button Style="{StaticResource EquipmentInspectorActionStyle}" Margin="0,0,6,6" Command="{Binding EquipmentInspectorManualCommand}" CommandParameter="run" Content="{loc:Loc Key=R24.RunOn}" /><Button Style="{StaticResource EquipmentInspectorActionStyle}" Margin="0,0,6,6" Command="{Binding EquipmentInspectorManualCommand}" CommandParameter="halt" Content="{loc:Loc Key=R24.RunOff}" /><Button Style="{StaticResource EquipmentInspectorActionStyle}" Margin="0,0,6,6" Command="{Binding EquipmentInspectorManualCommand}" CommandParameter="placeWp" Content="{loc:Loc Key=R2