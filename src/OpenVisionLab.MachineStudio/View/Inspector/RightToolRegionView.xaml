                                                Margin="8,0,0,0"
                                                Command="{Binding RuntimeDebugger.ClearTimelineCommand}"
                                                Content="{loc:Loc Key=Debugger.ClearTimeline}"
                                                Style="{StaticResource GlobalCommandButtonStyle}" />
                                    </Grid>
                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Text.Secondary}"
                                                   Text="{loc:Loc Key=Debugger.TimelineFilterLabel}"
                                                   TextWrapping="Wrap" />
                                        <ComboBox x:Name="DebuggerTimelineFilterComboBox"
                                                  Grid.Column="1"
                                                  Margin="8,0,0,0"
                                                  HorizontalAlignment="Stretch"
                                                  AutomationProperties.Name="{loc:Loc Key=Debugger.TimelineFilterLabel}"
                                                  DisplayMemberPath="DisplayText"
                                                  ItemsSource="{Binding RuntimeDebugger.TimelineFilters}"
                                                  SelectedItem="{Binding RuntimeDebugger.SelectedTimelineFilter, Mode=TwoWay}" />
                                    </Grid>
                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Text.Secondary}"
                                                   Text="{loc:Loc Key=Debugger.TimelineSeverityFilterLabel}"
                                                   TextWrapping="Wrap" />
                                        <ComboBox x:Name="DebuggerTimelineSeverityFilterComboBox"
                                                  Grid.Column="1"
                                                  Margin="8,0,0,0"
                                                  HorizontalAlignment="Stretch"
                                                  AutomationProperties.Name="{loc:Loc Key=Debugger.TimelineSeverityFilterLabel}"
                                                  DisplayMemberPath="DisplayText"
                                                  ItemsSource="{Binding RuntimeDebugger.TimelineSeverityFilters}"
                                                  SelectedItem="{Binding RuntimeDebugger.SelectedTimelineSeverityFilter, Mode=TwoWay}" />
                                    </Grid>
                                    <TextBlock x:Name="DebuggerTimelineEmptyTextBlock"
                                               Margin="3,8,3,3"
                                               Foreground="{DynamicResource Text.Secondary}"
                                               Text="{Binding RuntimeDebugger.TimelineEmptyText}"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding RuntimeDebugger.HasTimeline, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=invert}" />
                                    <ListBox x:Name="DebuggerTimelineList"
                                             Margin="0,5,0,0"
                                             MaxHeight="220"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ItemsSource="{Binding RuntimeDebugger.Timeline}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="3,3">
                                                    <TextBlock Style="{StaticResource TelemetryTextStyle}"
                                                               Text="{Binding HeaderText}" />
                                                    <TextBlock Foreground="{DynamicResource Text.Secondary}"
                                                               Text="{Binding CommandIdText}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding CommandIdTooltip}" />
                                                    <TextBlock FontWeight="SemiBold"
                                                               Text="{Binding Category}" />
                                                    <TextBlock Foreground="{DynamicResource Text.Secondary}"
                                                               Text="{Binding Code}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Code}" />
                                                    <TextBlock Text="{Binding Message}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Expander>

                            <Expander x:Name="DebuggerAlarmsExpander"
                                      Margin="0,7,0,0"
                                      Header="{loc:Loc Key=Debugger.AlarmsRecovery}"
                                      IsExpanded="True">
                                 <StackPanel Margin="0,5,0,0">
                                     <TextBlock FontWeight="SemiBold"
                                                Text="{Binding RuntimeDebugger.AlarmSummaryText}" />
                                     <TextBlock Margin="0,2,0,0"
                                                Foreground="{DynamicResource Text.Secondary}"
                                                Text="{Binding RuntimeDebugger.AlarmAcknowledgementSummaryText}"
                                                TextWrapping="Wrap" />
                                     <ListBox x:Name="DebuggerAlarmList"
                                              Margin="0,5,0,0"
                                              MaxHeight="170"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ItemsSource="{Binding RuntimeDebugger.Alarms}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="3,3">
                                                    <TextBlock FontWeight="SemiBold"
                                                               Text="{Binding Source}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Source}" />
                                                    <TextBlock Text="{Binding State}"
                                                               TextWrapping="Wrap" />
                                                     <TextBlock Foreground="{DynamicResource Text.Secondary}"
                                                                Text="{Binding RecoveryText}"
                                                                TextWrapping="Wrap" />
                                                     <TextBlock Foreground="{DynamicResource Text.Secondary}"
                                                                Text="{Binding LifecycleText}"
                                                                TextWrapping="Wrap" />
                                                     <TextBlock Foreground="{DynamicResource Text.Secondary}"
                                                                Text="{Binding OccurrenceText}"
                                                                TextWrapping="Wrap" />
                                                     <Button Margin="0,4,0,0"
                                                             HorizontalAlignment="Left"
                                                             Command="{Binding DataContext.RuntimeDebugger.AcknowledgeAlarmCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                             CommandParameter="{Binding}"
                                                             Content="{Binding AcknowledgeActionText}"
                                                             IsEnabled="{Binding CanAcknowledge}"
                                                             Style="{StaticResource GlobalCommandButtonStyle}"
                                                             AutomationProperties.Name="{Binding AcknowledgeActionText}" />
                                                 </StackPanel>
                                             </DataTemplate>
                                         </ListBox.ItemTemplate>
                                    </ListBox>
                                     <TextBlock Margin="0,5,0,0"
                                                Foreground="{DynamicResource Text.Secondary}"
                                                Text="{loc:Loc Key=Debugger.AlarmRecoveryHint}"
                                                TextWrapping="Wrap" />
                                     <WrapPanel Margin="0,6,0,0">
                                         <Button x:Name="AcknowledgeAllAlarmsButton"
                                                 Margin="0,0,6,4"
                                                 Command="{Binding RuntimeDebugger.AcknowledgeAllAlarmsCommand}"
                                                 Content="{loc:Loc Key=Debugger.AcknowledgeAllAlarms}"
                                                 Style="{StaticResource GlobalCommandButtonStyle}"
                                                 AutomationProperties.Name="{loc:Loc Key=Debugger.AcknowledgeAllAlarms}" />
                                         <Button Margin="0,0,6,4"
                                                 Command="{Binding FaultManager.ClearAllCommand}"
                                                 Content="{loc:Loc Key=Inspector.ClearAll}"
                                                Style="{StaticResource GlobalCommandButtonStyle}" />
                                        <Button Command="{Binding ResetCommand}"
                                                Content="{loc:Loc Key=Shell.Reset}"
                                                 Style="{StaticResource GlobalCommandButtonStyle}" />
                                     </WrapPanel>
                                     <Expander x:Name="DebuggerAlarmHistoryExpander"
                                               Margin="0,6,0,0"
                                               Header="{loc:Loc Key=Debugger.AlarmHistory}"
                                               IsExpanded="False">
                                         <StackPanel Margin="0,5,0,0">
                                             <TextBlock Foreground="{DynamicResource Text.Secondary}"
                                                        Text="{Binding RuntimeDebugger.AlarmHistorySummaryText}" />
                                             <TextBlock Margin="0,5,0,0"
                                                        Foreground="{DynamicResource Text.Secondary}"
                                                        Text="{loc:Loc Key=Debugger.AlarmHistoryFilterHint}"
                                                        TextWrapping="Wrap" />
                                             <StackPanel Margin="0,5,0,0"
                                                         Orientation="Horizontal">
                                                 <TextBlock VerticalAlignment="Center"
                                                            Text="{loc:Loc Key=Debugger.AlarmHistoryFilter}" />
                                                 <ComboBox x:Name="DebuggerAlarmHistoryFilterComboBox"
                                                           Margin="7,0,0,0"
                                                           MinWidth="150"
                                                           ItemsSource="{Binding RuntimeDebugger.AlarmHistoryFilters}"
                                                           DisplayMemberPath="DisplayText"
                                                           SelectedItem="{Binding RuntimeDebugger.SelectedAlarmHistoryFilter, Mode=TwoWay}"
                                                           AutomationProperties.AutomationId="DebuggerAlarmHistoryFilter"
                                                           AutomationProperties.Name="{loc:Loc Key=Debugger.AlarmHistoryFilter}" />
                                             </StackPanel>
                                             <TextBlock x:Name="DebuggerAlarmHistoryEmptyTextBlock"
                                                        Margin="0,5,0,0"
                                                        Foreground="{DynamicResource Text.Secondary}"
                                                        Text="{Binding RuntimeDebugger.AlarmHistoryEmptyText}"
                                                        TextWrapping="Wrap"
                                                        Visibility="{Binding RuntimeDebugger.HasAlarmHistoryEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                             <ListBox x:Name="DebuggerAlarmHistoryList"
                                                      Margin="0,5,0,0"
                                                      MaxHeight="170"
                                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                      ItemsSource="{Binding RuntimeDebugger.VisibleAlarmHistory}">
                                                 <ListBox.ItemTemplate>
                                                     <DataTemplate>
                                                         <StackPanel Margin="3,3">
                                                             <TextBlock FontWeight="SemiBold"
                                                                        Text="{Binding Source}"
                                                                        TextTrimming="CharacterEllipsis"
                                                                        ToolTip="{Binding Source}" />
                                                             <TextBlock Text="{Binding State}"
                                                                        TextWrapping="Wrap" />
                                                             <TextBlock Foreground="{DynamicResource Text.Secondary}"
                                                                        Text="{Binding LifecycleText}"
                                                                        TextWrapping="Wrap" />
                                                             <TextBlock Foreground="{DynamicResource Text.Secondary}"
                                                                        Text="{Binding OccurrenceText}"
                                                                        TextWrapping="Wrap" />
                                                             <TextBlock Foreground="{DynamicResource Text.Secondary}"
                                                                        Text="{Binding ClearedAtText}"
                                                                        TextWrapping="Wrap" />
                                                         </StackPanel>
                                                     </DataTemplate>
                                                 </ListBox.ItemTemplate>
                                             </ListBox>
                                         </StackPanel>
                                     </Expander>
                                 </StackPanel>
                             </Expander>
                        </StackPanel>
                    </Border>
                    <Border x:Name="SimulationCommandTracePanel"
                            Style="{StaticResource InspectorCardStyle}">
                        <StackPanel>
                            <TextBlock x:Name="SimulationCommandTraceSectionAnchor"
                                       Style="{StaticResource SectionCaptionStyle}"
                                       Text="{loc:Loc Key=Simulation.CommandTrace}" />
                            <TextBlock Margin="0,2,0,8"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{loc:Loc Key=Simulation.CommandTraceHint}"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,0,0,4"
                                       FontWeight="SemiBold"
                                       Text="{Binding SimulationCommandTraceStatusText}"
                                       TextWrapping="Wrap" />
                            <WrapPanel Margin="0,4,0,0">
                                <Button x:Name="StartSimulationCommandTraceCaptureButton"
                                        Margin="0,0,6,4"
                                        Content="{loc:Loc Key=Simulation.StartCommandTraceCapture}"
                                        Style="{StaticResource GlobalCommandButtonStyle}"
                                        Command="{Binding StartSimulationCommandTraceCaptureCommand}"
                                        AutomationProperties.Name="{loc:Loc Key=Simulation.StartCommandTraceCapture}" />
                                <Button x:Name="ExportSimulationCommandTraceButton"
                                        Margin="0,0,6,4"
                                        Content="{loc:Loc Key=Simulation.ExportCommandTrace}"
                                        Style="{StaticResource GlobalCommandButtonStyle}"
                                        Command="{Binding ExportSimulationCommandTraceCommand}"
                                        AutomationProperties.Name="{loc:Loc Key=Simulation.ExportCommandTrace}" />
                                <Button x:Name="ReplaySimulationCommandTraceButton"
                                        Margin="0,0,6,4"
                                        Content="{loc:Loc Key=Simulation.ReplayCommandTrace}"
                                        Style="{StaticResource GlobalCommandButtonStyle}"
                                        Command="{Binding ReplaySimulationCommandTraceCommand}"
                                        AutomationProperties.Name="{loc:Loc Key=Simulation.ReplayCommandTrace}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border x:Name="UnifiedCommissioningEvidencePanel"
                            Style="{StaticResource InspectorCardStyle}">
                        <StackPanel>
                            <TextBlock x:Name="UnifiedCommissioningEvidenceSectionAnchor"
                                       Style="{StaticResource SectionCaptionStyle}"
                                       Text="{loc:Loc Key=Simulation.UnifiedCommissioningEvidence}" />
                            <TextBlock Margin="0,2,0,8"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{loc:Loc Key=Simulation.UnifiedCommissioningEvidenceHint}"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,0,0,4"
                                       FontWeight="SemiBold"
                                       Text="{Binding UnifiedCommissioningEvidenceStatusText}"
                                       TextWrapping="Wrap" />
                            <WrapPanel Margin="0,4,0,0">
                                <Button x:Name="ExportUnifiedCommissioningEvidenceButton"
                                        Margin="0,0,6,4"
                                        Content="{loc:Loc Key=Simulation.ExportUnifiedCommissioningEvidence}"
                                        Style="{StaticResource GlobalCommandButtonStyle}"
                                        Command="{Binding ExportUnifiedCommissioningEvidenceCommand}"
                                        AutomationProperties.Name="{loc:Loc Key=Simulation.ExportUnifiedCommissioningEvidence}" />
                                <Button x:Name="ImportUnifiedCommissioningEvidenceButton"
                                        Margin="0,0,6,4"
                                        Content="{loc:Loc Key=Simulation.ImportUnifiedCommissioningEvidence}"
                                        Style="{StaticResource GlobalCommandButtonStyle}"
                                        Command="{Binding ImportUnifiedCommissioningEvidenceCommand}"
                                        AutomationProperties.Name="{loc:Loc Key=Simulation.ImportUnifiedCommissioningEvidence}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border x:Name="MultiAxisRecipeRunPanel"
                            Style="{StaticResource InspectorCardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionCaptionStyle}"
                                       Text="{loc:Loc Key=Axis.MultiAxisRecipe}" />
                            <TextBlock Margin="0,2,0,8"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{loc:Loc Key=Axis.RecipeRunHint}"
                                       TextWrapping="Wrap" />
                            <TextBlock FontSize="14"
                                       FontWeight="SemiBold"
                                       Text="{Binding MultiAxisCommissioningRecipe.Name}" />
                            <ItemsControl Margin="0,7,0,0"
                                          ItemsSource="{Binding MultiAxisCommissioningRecipe.Targets}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" Text="{Binding AxisName}" />
                                                <TextBlock Foreground="{DynamicResource Text.Secondary}"
                                                           Text="{Binding StateText}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                <TextBlock HorizontalAlignment="Right"
                                                           Style="{StaticResource TelemetryTextStyle}"
                                                           Text="{Binding TargetText}" />
                                                <TextBlock HorizontalAlignment="Right"
                                                           Foreground="{DynamicResource Text.Secondary}"
                                                           Text="{Binding CurrentPositionText}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <WrapPanel Margin="0,9,0,0">
                                <Button x:Name="RunMultiAxisRecipeButton"
                                        Margin="0,0,6,4"
                                        Command="{Binding RunMultiAxisCommissioningRecipeCommand}"
                                        Content="{loc:Loc Key=Axis.RunRecipe}"
                                        Style="{StaticResource PrimaryCommandButtonStyle}"
                                        AutomationProperties.Name="{loc:Loc Key=Axis.RunRecipe}" />
                                <Button x:Name="StopMultiAxisRecipeButton"
                                        Margin="0,0,6,4"
                                        Command="{Binding StopMultiAxisCommissioningRecipeCommand}"
                                        Content="{loc:Loc Key=Axis.StopRecipe}"
                                        AutomationProperties.Name="{loc:Loc Key=Axis.StopRecipe}" />
                            </WrapPanel>
                            <TextBlock Margin="0,5,0,0"
                                       FontWeight="SemiBold"
                                       Text="{Binding MultiAxisCommissioningRecipe.RuntimeStatusText}" />
                            <TextBlock Margin="0,3,0,0"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{Binding MultiAxisCommissioningRecipe.ValidationMessage}"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MultiAxisCommissioningRecipe.IsValid}"
                                                         Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Border Margin="0,10,0,8"
                                    BorderBrush="{DynamicResource Border.Subtle}"
                                    BorderThickness="0,1,0,0" />
                            <TextBlock Style="{StaticResource SectionCaptionStyle}"
                                       Text="{loc:Loc Key=Axis.RecipeRepeatValidation}" />
                            <TextBlock Margin="0,2,0,7"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{loc:Loc Key=Axis.RecipeRepeatValidationHint}"
                                       TextWrapping="Wrap" />
                            <Grid IsEnabled="{Binding IsCommissioningValidationConfigurationEnabled}">
                                <Grid.ColumnDefinitions>
