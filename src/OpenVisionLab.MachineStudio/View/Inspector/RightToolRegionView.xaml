                                           Text="{Binding RuntimeDebugger.PauseReasonText}"
                                           TextWrapping="Wrap" />
                            </Border>
                            <Button x:Name="SemanticSequenceStepButton"
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding RuntimeDebugger.SemanticStepCommand}"
                                    Content="{loc:Loc Key=Debugger.NextSequenceStep}"
                                    Style="{StaticResource PrimaryCommandButtonStyle}"
                                    ToolTip="{loc:Loc Key=Debugger.NextSequenceStepTooltip}"
                                    AutomationProperties.Name="{loc:Loc Key=Debugger.NextSequenceStep}" />
                            <TextBlock Margin="0,5,0,0"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{Binding RuntimeDebugger.OperationStatusText}"
                                       TextWrapping="Wrap" />

                            <Expander x:Name="DebuggerBreakpointsExpander"
                                      Margin="0,8,0,0"
                                      Header="{loc:Loc Key=Debugger.Breakpoints}"
                                      IsExpanded="True">
                                <StackPanel Margin="0,5,0,0">
                                    <ComboBox x:Name="DebuggerBreakpointComboBox"
                                              ItemsSource="{Binding RuntimeDebugger.Breakpoints}"
                                              SelectedItem="{Binding RuntimeDebugger.SelectedBreakpoint, Mode=TwoWay}"
                                              ToolTip="{loc:Loc Key=Debugger.BreakpointSelectionTooltip}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
