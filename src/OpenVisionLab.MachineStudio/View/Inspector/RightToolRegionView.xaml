                                            AutomationProperties.Name="{loc:Loc Key=Conveyor.Stop}" />
                                    <Button x:Name="RunConveyorReverseButton"
                                            Grid.Column="4"
                                            Command="{Binding RunConveyorReverseCommand}"
                                            IsEnabled="{Binding CanRunConveyorReverse}"
                                            Content="{loc:Loc Key=Conveyor.Reverse}"
                                            ToolTip="{loc:Loc Key=Conveyor.ReverseTooltip}"
                                            AutomationProperties.Name="{loc:Loc Key=Conveyor.Reverse}" />
                                </Grid>
                                <TextBlock Margin="2,7,2,0"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           Text="{Binding ConveyorCommissioningHintText}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource InspectorCardStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasVirtualCamera}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock x:Name="CameraSectionAnchor"
                                       Style="{StaticResource SectionCaptionStyle}"
                                       Text="{loc:Loc Key=Camera.Commissioning}" />
                            <TextBlock Margin="0,2,0,8"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{Binding CameraCommissioningHintText}"
                                       TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource InspectorFieldLabelStyle}"
                                       Text="{loc:Loc Key=Camera.SelectedCamera}" />
                            <ComboBox x:Name="CameraSelectionComboBox"
                                      ItemsSource="{Binding VirtualCameras}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding SelectedCameraId, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource InspectorFieldLabelStyle}"
                                       Text="{loc:Loc Key=Camera.Recipe}" />
                            <ComboBox x:Name="CameraRecipeComboBox"
                                      ItemsSource="{Binding CurrentCameraRecipes}"
                                      SelectedItem="{Binding SelectedCameraRecipe, Mode=TwoWay}" />
                            <TextBlock Margin="0,10,0,2"
                                       Style="{StaticResource SectionCaptionStyle}"
                                       Text="{loc:Loc Key=Camera.SourceSetup}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="CameraSourcePathTextBox"
                                         Height="{StaticResource Density.InspectorFieldHeight}"
                                         Padding="7,0"
                                         VerticalContentAlignment="Center"
                                         IsReadOnly="True"
                                         Text="{Binding CameraImageSourceEditor.PathText}"
                                         ToolTip="{Binding CameraImageSourceEditor.PathText}"
                                         AutomationProperties.Name="{loc:Loc Key=Camera.SourceRelativePath}" />
                                <Button x:Name="BrowseCameraSourceButton"
                                        Grid.Column="2"
                                        MinWidth="58"
                                        Command="{Binding CameraImageSourceEditor.BrowseCommand}"
                                        Content="{loc:Loc Key=Camera.Browse}"
                                        ToolTip="{loc:Loc Key=Camera.BrowseTooltip}"
                                        AutomationProperties.Name="{loc:Loc Key=Camera.Browse}" />
                            </Grid>
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource InspectorFieldLabelStyle}"
                                               Text="{loc:Loc Key=Camera.SourceWidth}" />
                                    <ui:NumberBox AutomationProperties.AutomationId="CameraSourceWidthNumberBox"
                                                  Minimum="1"
                                                  Maximum="100000"
                                                  SmallChange="1"
                                                  Value="{Binding CameraImageSourceEditor.Width, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource InspectorFieldLabelStyle}"
                                               Text="{loc:Loc Key=Camera.SourceHeight}" />
                                    <ui:NumberBox AutomationProperties.AutomationId="CameraSourceHeightNumberBox"
                                                  Minimum="1"
                                                  Maximum="100000"
                                                  SmallChange="1"
                                                  Value="{Binding CameraImageSourceEditor.Height, Mode=TwoWay}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource InspectorFieldLabelStyle}"
                                       Text="{loc:Loc Key=Camera.SourcePixelFormat}" />
                            <TextBox x:Name="CameraSourcePixelFormatTextBox"
                                     Height="{StaticResource Density.InspectorFieldHeight}"
                                     Padding="7,0"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding CameraImageSourceEditor.PixelFormatText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{loc:Loc Key=Camera.PixelFormatTooltip}"
                                     AutomationProperties.Name="{loc:Loc Key=Camera.SourcePixelFormat}">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CameraImageSourceEditor.HasError}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource State.Fault}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <TextBlock x:Name="CameraSourceValidationText"
                                       Margin="2,5,2,0"
                                       FontSize="10.5"
                                       Text="{Binding CameraImageSourceEditor.ValidationText}"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource State.Running}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CameraImageSourceEditor.HasError}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource State.Fault}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="7" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="ApplyCameraSourceButton"
                                        Command="{Binding CameraImageSourceEditor.ApplyCommand}"
                                        IsEnabled="{Binding CameraImageSourceEditor.CanApply}"
                                        Style="{StaticResource PrimaryCommandButtonStyle}"
                                        Content="{loc:Loc Key=Camera.ApplySource}"
                                        ToolTip="{loc:Loc Key=Camera.ApplySourceTooltip}"
                                        AutomationProperties.Name="{loc:Loc Key=Camera.ApplySource}" />
                                <Button x:Name="RevertCameraSourceButton"
                                        Grid.Column="2"
                                        Command="{Binding CameraImageSourceEditor.RevertCommand}"
                                        IsEnabled="{Binding CameraImageSourceEditor.CanRevert}"
                                        Content="{loc:Loc Key=Camera.RevertSource}"
                                        ToolTip="{loc:Loc Key=Camera.RevertSourceTooltip}"
                                        AutomationProperties.Name="{loc:Loc Key=Camera.RevertSource}" />
                            </Grid>
                            <Grid Margin="0,9,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Foreground="{DynamicResource Text.Secondary}"
                                           Text="{loc:Loc Key=Camera.State}" />
                                <TextBlock Grid.Column="1"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource TelemetryTextStyle}"
                                           Text="{Binding CurrentCameraStateText}" />
                                <TextBlock Grid.Row="1"
                                           Margin="0,7,0,0"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           Text="{loc:Loc Key=Camera.ExposureRemaining}" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Margin="0,7,0,0"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource TelemetryTextStyle}"
                                           Text="{Binding CurrentCameraExposureTicksText}" />
                                <TextBlock Grid.Row="2"
                                           Margin="0,7,0,0"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           Text="{loc:Loc Key=Camera.TransferRemaining}" />
                                <TextBlock Grid.Row="2"
                                           Grid.Column="1"
                                           Margin="0,7,0,0"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource TelemetryTextStyle}"
                                           Text="{Binding CurrentCameraTransferTicksText}" />
                                <TextBlock Grid.Row="3"
                                           Margin="0,7,0,0"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           Text="{loc:Loc Key=Camera.Result}" />
                                <TextBlock Grid.Row="3"
                                           Grid.Column="1"
                                           Margin="0,7,0,0"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource TelemetryTextStyle}"
                                           Text="{Binding CurrentCameraResultText}" />
                            </Grid>
                            <TextBlock Margin="0,8,0,2"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{loc:Loc Key=Camera.Frame}" />
                            <TextBlock FontFamily="{StaticResource Typography.Telemetry}"
                                       FontSize="10.5"
                                       Text="{Binding CurrentCameraFrameText}"
                                       ToolTip="{Binding CurrentCameraFrameText}"
                                       TextWrapping="Wrap" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="7" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="StartCameraManualControlButton"
                                        Command="{Binding StartManualCameraControlCommand}"
                                        IsEnabled="{Binding CanStartManualCameraControl}"
                                        Content="{loc:Loc Key=Camera.StartManualShort}"
                                        ToolTip="{loc:Loc Key=Camera.StartManualControlTooltip}"
                                        AutomationProperties.Name="{loc:Loc Key=Camera.StartManualShort}" />
                                <Button x:Name="TriggerCameraButton"
                                        Grid.Column="2"
                                        Command="{Binding TriggerCameraCommand}"
                                        IsEnabled="{Binding CanTriggerCamera}"
                                        Style="{StaticResource PrimaryCommandButtonStyle}"
                                        Content="{loc:Loc Key=Camera.Trigger}"
                                        ToolTip="{loc:Loc Key=Camera.TriggerTooltip}"
                                        AutomationProperties.Name="{loc:Loc Key=Camera.Trigger}" />
                            </Grid>
                            <TextBlock Margin="0,9,0,2"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{loc:Loc Key=Camera.Source}" />
                            <TextBlock FontFamily="{StaticResource Typography.Telemetry}"
                                       FontSize="9.5"
                                       Text="{Binding CurrentCameraSourceText}"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,7,0,2"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="SHA-256" />
                            <TextBlock x:Name="CameraFrameHashTextBlock"
                                       FontFamily="{StaticResource Typography.Telemetry}"
                                       FontSize="9.5"
                                       Text="{Binding CurrentCameraFrameHashText}"
                                       ToolTip="{Binding CurrentCameraFrameHashText}"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="CameraExecutionEvidenceDetailsTextBlock"
                                       Margin="0,9,0,0"
                                       FontFamily="{StaticResource Typography.Telemetry}"
                                       FontSize="9.5"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{Binding CurrentCameraEvidenceDetailsText}"
                                       ToolTip="{Binding CurrentCameraEvidenceDetailsText}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource InspectorCardStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DigitalIo.HasSignals}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock x:Name="DigitalIoSectionAnchor"
                                       Style="{StaticResource SectionCaptionStyle}"
                                       Text="{loc:Loc Key=Inspector.IoCommissioning}" />
                            <TextBlock Margin="0,2,0,8"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{loc:Loc Key=Inspector.IoCommissioningHint}"
                                       TextWrapping="Wrap" />
                            <DataGrid x:Name="DigitalIoSignalGrid"
                                      MinHeight="96"
                                      MaxHeight="190"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserReorderColumns="False"
                                      CanUserResizeRows="False"
                                      CanUserSortColumns="False"
                                      HeadersVisibility="Column"
                                      IsReadOnly="True"
                                      ItemsSource="{Binding DigitalIo.Signals}"
                                      SelectedItem="{Binding DigitalIo.SelectedSignal, Mode=TwoWay}"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="*" Header="{loc:Loc Key=Inspector.Signal}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel ToolTip="{Binding Id}">
                                                    <TextBlock Foreground="{DynamicResource Text.Primary}"
                                                               Text="{Binding DisplayName}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock FontFamily="{StaticResource Typography.Telemetry}"
                                                               FontSize="9.5"
                                                               Foreground="{DynamicResource Text.Secondary}"
                                                               Text="{Binding Id}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Width="46"
                                                        Binding="{Binding KindText}"
                                                        Header="{loc:Loc Key=Inspector.Kind}" />
                                    <DataGridTextColumn Width="48"
                                                        Binding="{Binding ValueText}"
                                                        Header="{loc:Loc Key=Inspector.Value}" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <Grid Margin="0,9,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Foreground="{DynamicResource Text.Secondary}"
                                           Text="{loc:Loc Key=Inspector.RuntimeOwner}" />
                                <TextBlock Grid.Column="1"
                                           Margin="8,0,0,0"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource TelemetryTextStyle}"
                                           Text="{Binding DigitalIo.ControlOwnerText}" />
                                <TextBlock Grid.Row="1"
                                           Margin="0,5,0,0"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           Text="{loc:Loc Key=Inspector.Revision}" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Margin="8,5,0,0"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource TelemetryTextStyle}"
                                           Text="{Binding DigitalIo.SignalRevisionText}" />
                                <TextBlock Grid.Row="2"
                                           Margin="0,5,0,0"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           Text="{loc:Loc Key=Inspector.NominalValue}" />
                                <TextBlock Grid.Row="2"
                                           Grid.Column="1"
                                           Margin="8,5,0,0"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource TelemetryTextStyle}"
                                           Text="{Binding DigitalIo.SelectedNominalValueText}" />
                                <TextBlock Grid.Row="3"
                                           Margin="0,5,0,0"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           Text="{loc:Loc Key=Inspector.ForceState}" />
                                <TextBlock Grid.Row="3"
                                           Grid.Column="1"
                                           Margin="8,5,0,0"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource TelemetryTextStyle}"
                                           Text="{Binding DigitalIo.SelectedForceText}" />
                            </Grid>

                            <Button x:Name="StartDigitalIoManualControlButton"
                                    Margin="0,9,0,0"
                                    Command="{Binding DigitalIo.StartManualControlCommand}"
                                    Content="{loc:Loc Key=Io.StartManualControl}"
                                    Style="{StaticResource PrimaryCommandButtonStyle}"
                                    ToolTip="{loc:Loc Key=Io.StartManualControlTooltip}" />
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.9*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="0.9*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="1.2*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="DigitalIoForceOnButton"
                                        Command="{Binding DigitalIo.ForceOnCommand}"
                                        Content="{loc:Loc Key=Io.ForceOn}"
                                        ToolTip="{loc:Loc Key=Io.ForceOnTooltip}" />
                                <Button x:Name="DigitalIoForceOffButton"
                                        Grid.Column="2"
                                        Command="{Binding DigitalIo.ForceOffCommand}"
                                        Content="{loc:Loc Key=Io.ForceOff}"
                                        ToolTip="{loc:Loc Key=Io.ForceOffTooltip}" />
                                <Button x:Name="DigitalIoClearForceButton"
                                        Grid.Column="4"
                                        Command="{Binding DigitalIo.ClearForceCommand}"
                                        Content="{loc:Loc Key=Io.ClearForce}"
                                        ToolTip="{loc:Loc Key=Io.ClearForceTooltip}" />
                            </Grid>
                            <TextBlock Margin="2,8,2,0"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{Binding DigitalIo.OperationHintText}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource InspectorCardStyle}">
                        <StackPanel>
                            <TextBlock x:Name="FaultManagerSectionAnchor"
                                       Style="{StaticResource SectionCaptionStyle}"
                                       Text="{loc:Loc Key=Inspector.FaultManager}" />
                            <TextBlock Margin="0,2,0,8"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{loc:Loc Key=Inspector.FaultRecoveryHint}"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,0,0,3"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{loc:Loc Key=Inspector.FaultType}" />
                            <ComboBox x:Name="FaultKindComboBox"
                                      ItemsSource="{Binding FaultManager.AvailableKinds}"
                                      SelectedItem="{Binding FaultManager.SelectedKind, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource LocalizedFaultKindConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Margin="0,8,0,3"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{loc:Loc Key=Inspector.RuntimeTarget}" />
                            <ComboBox x:Name="FaultTargetComboBox"
                                      ItemsSource="{Binding FaultManager.Targets}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedItem="{Binding FaultManager.SelectedTarget, Mode=TwoWay}"
                                      ToolTip="{loc:Loc Key=Inspector.RuntimeTargetTooltip}"
                                      IsEnabled="{Binding FaultManager.HasTargets}" />
                            <TextBlock Margin="0,4,0,0"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource State.Warning}"
                                       Text="{Binding FaultManager.TargetSelectionHelpText}"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FaultManager.HasTargets}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel Margin="0,8,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FaultManager.RequiresForcedValue}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Margin="0,0,0,3"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           Text="{loc:Loc Key=Inspector.ForcedValue}" />
                                <ComboBox x:Name="FaultForcedValueComboBox"
                                          ItemsSource="{Binding FaultManager.ForcedValueOptions}"
                                          SelectedItem="{Binding FaultManager.SelectedForcedValue, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource LocalizedForcedValueConverter}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <Button x:Name="InjectFaultButton"
                                    Margin="0,10,0,0"
                                    Command="{Binding FaultManager.InjectCommand}"
                                    Style="{StaticResource PrimaryCommandButtonStyle}"
                                    Content="{loc:Loc Key=Inspector.InjectFault}" />

                            <Grid Margin="0,12,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SectionCaptionStyle}" Text="{loc:Loc Key=Inspector.ActiveFaults}" />
                                <TextBlock Grid.Column="1"
                                           Foreground="{DynamicResource State.Fault}"
                                           Text="{Binding FaultManager.ActiveFaultCountText}" />
                            </Grid>
                            <ListBox x:Name="ActiveFaultListBox"
                                     MinHeight="46"
                                     MaxHeight="112"
                                     ItemsSource="{Binding FaultManager.ActiveFaults}"
                                     SelectedItem="{Binding FaultManager.SelectedActiveFault, Mode=TwoWay}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.Style>
                                    <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FaultManager.HasActiveFaults}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.Style>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="4,3"
                                                   Foreground="{DynamicResource Text.Primary}"
                                                   Text="{Binding DisplayText}"
                                                   TextWrapping="Wrap"
                                                   ToolTip="{Binding TargetId}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="ClearSelectedFaultButton"
                                        Command="{Binding FaultManager.ClearSelectedCommand}"
                                        Content="{loc:Loc Key=Inspector.ClearSelected}" />
                                <Button x:Name="ClearAllFaultsButton"
                                        Grid.Column="2"
                                        Command="{Binding FaultManager.ClearAllCommand}"
                                        Content="{loc:Loc Key=Inspector.ClearAll}" />
                            </Grid>
                            <TextBlock x:Name="NoActiveFaultsText"
                                       Margin="0,4,0,0"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{loc:Loc Key=Inspector.NoActiveFaults}"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FaultManager.HasActiveFaults}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock x:Name="FaultOperationStatusText"
                                       Margin="2,8,2,0"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{Binding FaultManager.OperationStatusText}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource InspectorCardStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasEmbeddedSequence}" Value="True" />
                                            <Condition Binding="{Binding HasCycleStartInput}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionCaptionStyle}" Text="{loc:Loc Key=Inspector.VirtualInput}" />
                            <Button Command="{Binding CycleStartCommand}"
                                    Style="{StaticResource PrimaryCommandButtonStyle}"
                                    ToolTip="{loc:Loc Key=Inspector.CycleStartTooltip}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Play24" Foreground="{DynamicResource State.Running}" />
                                    <TextBlock Margin="6,0,0,0" Text="{loc:Loc Key=Inspector.CycleStart}" />
                                </StackPanel>
                            </Button>
                            <TextBlock Margin="2,8,2,0"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{loc:Loc Key=Inspector.CycleStartHint}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
