                                                 MinHeight="28"
                                                 Text="{Binding Integration.Setup.TcpPeerHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding Integration.CanEditTcpSetup}"
                                                 AutomationProperties.AutomationId="IntegrationTcpPeerHostTextBox"
                                                 AutomationProperties.Name="{loc:Loc Key=Integration.TcpPeerHost}" />
                                        <TextBlock Grid.Row="3"
                                                   Margin="0,7,0,0"
                                                   Foreground="{DynamicResource Text.Secondary}"
                                                   Text="{loc:Loc Key=Integration.TcpPeerPort}" />
                                        <TextBox x:Name="IntegrationTcpPeerPortTextBox"
                                                 Grid.Row="3"
                                                 Grid.Column="2"
                                                 Margin="0,3,0,0"
                                                 MinHeight="28"
                                                 Text="{Binding Integration.Setup.TcpPeerPortText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding Integration.CanEditTcpSetup}"
                                                 AutomationProperties.AutomationId="IntegrationTcpPeerPortTextBox"
                                                 AutomationProperties.Name="{loc:Loc Key=Integration.TcpPeerPort}" />
                                        <TextBlock Grid.Row="4"
                                                   Margin="0,7,0,0"
                                                   Foreground="{DynamicResource Text.Secondary}"
                                                   Text="{loc:Loc Key=Integration.TcpSharedKey}" />
                                        <PasswordBox x:Name="IntegrationTcpSharedKeyBox"
                                                     Grid.Row="4"
                                                     Grid.Column="2"
                                                     Margin="0,3,0,0"
                                                     MinHeight="28"
                                                     IsEnabled="{Binding Integration.CanEditTcpSetup}"
                                                     AutomationProperties.AutomationId="IntegrationTcpSharedKeyBox"
                                                     AutomationProperties.Name="{loc:Loc Key=Integration.TcpSharedKey}">
                                            <b:Interaction.Behaviors>
                                                <behavior:PasswordBoxBehavior
                                                    PasswordChangedCommand="{Binding Integration.SetSessionSharedKeyCommand}"
                                                    ResetToken="{Binding Integration.Setup.ResetVersion}" />
                                            </b:Interaction.Behaviors>
                                        </PasswordBox>
                                    </Grid>
                                    <TextBlock x:Name="IntegrationTcpSharedKeyStatusTextBlock"
                                               Margin="0,5,0,0"
                                               FontSize="10"
                                               Foreground="{DynamicResource Text.Secondary}"
                                               Text="{Binding Integration.SharedKeyStatusText}"
                                               TextWrapping="Wrap" />
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="7" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="StartIntegrationTcpListenerButton"
                                                Command="{Binding Integration.StartTcpListenerCommand}"
                                                Height="48"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Center"
                                                Style="{StaticResource PrimaryCommandButtonStyle}"
                                                AutomationProperties.AutomationId="StartIntegrationTcpListenerButton"
                                                AutomationProperties.Name="{loc:Loc Key=Integration.StartTcpListener}">
                                            <TextBlock Text="{loc:Loc Key=Integration.StartTcpListener}"
                                                       HorizontalAlignment="Stretch"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap" />
                                        </Button>
                                        <Button x:Name="StopIntegrationTcpListenerButton"
                                                Grid.Column="2"
                                                Command="{Binding Integration.StopTcpListenerCommand}"
                                                Height="48"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Center"
                                                Style="{StaticResource GlobalCommandButtonStyle}"
                                                AutomationProperties.AutomationId="StopIntegrationTcpListenerButton"
                                                AutomationProperties.Name="{loc:Loc Key=Integration.StopTcpListener}">
                                            <TextBlock Text="{loc:Loc Key=Integration.StopTcpListener}"
                                                       HorizontalAlignment="Stretch"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap" />
                                        </Button>
                                    </Grid>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="7" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="PingIntegrationTcpPeerButton"
                                                Command="{Binding Integration.PingTcpPeerCommand}"
                                                Height="48"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Center"
                                                Style="{StaticResource GlobalCommandButtonStyle}"
                                                AutomationProperties.AutomationId="PingIntegrationTcpPeerButton"
                                                AutomationProperties.Name="{loc:Loc Key=Integration.PingTcpPeer}">
                                            <TextBlock Text="{loc:Loc Key=Integration.PingTcpPeer}"
                                                       HorizontalAlignment="Stretch"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap" />
                                        </Button>
                                        <Button x:Name="PushIntegrationTcpTransactionButton"
                                                Grid.Column="2"
                                                Command="{Binding Integration.PushLatestTransactionCommand}"
                                                Height="48"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Center"
                                                Style="{StaticResource GlobalCommandButtonStyle}"
                                                AutomationProperties.AutomationId="PushIntegrationTcpTransactionButton"
                                                AutomationProperties.Name="{loc:Loc Key=Integration.PushTcpTransaction}">
                                            <TextBlock Text="{loc:Loc Key=Integration.PushTcpTransaction}"
                                                       HorizontalAlignment="Stretch"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap" />
                                        </Button>
                                    </Grid>
                                     <Button x:Name="PullIntegrationTcpTransactionButton"
                                            Margin="0,6,0,0"
                                            Command="{Binding Integration.PullLatestTransactionCommand}"
                                            Height="48"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Center"
                                            Style="{StaticResource GlobalCommandButtonStyle}"
                                            AutomationProperties.AutomationId="PullIntegrationTcpTransactionButton"
                                            AutomationProperties.Name="{loc:Loc Key=Integration.PullTcpTransaction}">
                                        <TextBlock Text="{loc:Loc Key=Integration.PullTcpTransaction}"
                                                   HorizontalAlignment="Stretch"
                                                   TextAlignment="Center"
                                                    TextWrapping="Wrap" />
                                     </Button>
                                     <Button x:Name="CancelIntegrationTcpTransactionButton"
                                             Margin="0,6,0,0"
                                             Command="{Binding Integration.CancelLatestTransactionCommand}"
                                             Height="48"
                                             HorizontalContentAlignment="Stretch"
                                             VerticalContentAlignment="Center"
                                             Style="{StaticResource GlobalCommandButtonStyle}"
                                             ToolTip="{loc:Loc Key=Integration.CancelTcpTransactionTooltip}"
                                             AutomationProperties.AutomationId="CancelIntegrationTcpTransactionButton"
                                             AutomationProperties.Name="{loc:Loc Key=Integration.CancelTcpTransaction}">
                                         <TextBlock Text="{loc:Loc Key=Integration.CancelTcpTransaction}"
                                                    HorizontalAlignment="Stretch"
                                                    TextAlignment="Center"
                                                    TextWrapping="Wrap" />
                                     </Button>
                                     <TextBlock x:Name="IntegrationTcpListenerStatusTextBlock"
                                               Margin="0,6,0,0"
                                               FontSize="10"
                                               Foreground="{DynamicResource Text.Secondary}"
                                               Text="{Binding Integration.TcpListenerStatusText}"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Name="IntegrationTcpTransferStatusTextBlock"
                                               Margin="0,3,0,0"
                                               FontFamily="{StaticResource Typography.Telemetry}"
                                               FontSize="9.5"
                                               Foreground="{DynamicResource Text.Secondary}"
                                               Text="{Binding Integration.LastTcpTransferText}"
                                               TextWrapping="Wrap"
                                               ToolTip="{Binding Integration.LastTcpTransferText}" />
                                </StackPanel>
                            </Expander>
                            <Grid Margin="0,9,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="7" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="SaveIntegrationSetupButton"
                                        Command="{Binding Integration.Setup.SaveSetupCommand}"
                                        Content="{loc:Loc Key=Integration.SaveSetup}"
                                        ToolTip="{loc:Loc Key=Integration.SaveSetupTooltip}"
                                        AutomationProperties.AutomationId="SaveIntegrationSetupButton"
                                        AutomationProperties.Name="{loc:Loc Key=Integration.SaveSetup}" />
                                <Button x:Name="ResetIntegrationSetupButton"
                                        Grid.Column="2"
                                        Command="{Binding Integration.Setup.ResetSetupCommand}"
                                        Content="{loc:Loc Key=Integration.ResetSetup}"
                                        ToolTip="{loc:Loc Key=Integration.ResetSetupTooltip}"
                                         AutomationProperties.AutomationId="ResetIntegrationSetupButton"
                                         AutomationProperties.Name="{loc:Loc Key=Integration.ResetSetup}" />
                            </Grid>
                            <Button x:Name="PublishTwoDImageHandoffButton"
                                    Margin="0,9,0,0"
                                    Command="{Binding Integration.PublishInspectionHandoffCommand}"
                                    IsEnabled="{Binding Integration.CanPublishInspectionHandoff}"
                                    Style="{StaticResource PrimaryCommandButtonStyle}"
                                    Content="{Binding Integration.PublishInspectionHandoffCaption}"
                                    ToolTip="{Binding Integration.PublishInspectionHandoffTooltip}"
                                    AutomationProperties.AutomationId="PublishTwoDImageHandoffButton"
                                    AutomationProperties.Name="{Binding Integration.PublishInspectionHandoffCaption}" />
                        </StackPanel>
                    </Border>
                    <StackPanel x:Name="InspectorNonIntegrationAfterSetup" Visibility="{Binding IntegrationSetupOnly, RelativeSource={RelativeSource AncestorType=local:RightToolRegionView}, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=invert}">
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource InspectorCardStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DigitalIo.HasSignals}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock x:Name="DigitalIoSectionAnchor"
                                       Style="{StaticResource SectionCaptionStyle}"
                                       Text="{loc:Loc Key=Inspector.IoCommissioning}" />
                            <TextBlock Margin="0,2,0,8"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{loc:Loc Key=Inspector.IoCommissioningHint}"
                                       TextWrapping="Wrap" />
                            <DataGrid x:Name="DigitalIoSignalGrid"
                                      MinHeight="96"
                                      MaxHeight="190"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserReorderColumns="False"
                                      CanUserResizeRows="False"
                                      CanUserSortColumns="False"
                                      HeadersVisibility="Column"
                                      IsReadOnly="True"
                                      ItemsSource="{Binding DigitalIo.Signals}"
                                      SelectedItem="{Binding DigitalIo.SelectedSignal, Mode=TwoWay}"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="*" Header="{loc:Loc Key=Inspector.Signal}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel ToolTip="{Binding Id}">
                                                    <TextBlock Foreground="{DynamicResource Text.Primary}"
                                                               Text="{Binding DisplayName}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock FontFamily="{StaticResource Typography.Telemetry}"
                                                               FontSize="9.5"
                                                               Foreground="{DynamicResource Text.Secondary}"
                                                               Text="{Binding Id}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Width="46"
                                                        Binding="{Binding KindText}"
                                                        Header="{loc:Loc Key=Inspector.Kind}" />
                                    <DataGridTextColumn Width="48"
                                                        Binding="{Binding ValueText}"
                                                        Header="{loc:Loc Key=Inspector.Value}" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <Grid Margin="0,9,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Foreground="{DynamicResource Text.Secondary}"
                                           Text="{loc:Loc Key=Inspector.RuntimeOwner}" />
                                <TextBlock Grid.Column="1"
                                           Margin="8,0,0,0"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource TelemetryTextStyle}"
                                           Text="{Binding DigitalIo.ControlOwnerText}" />
                                <TextBlock Grid.Row="1"
                                           Margin="0,5,0,0"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           Text="{loc:Loc Key=Inspector.Revision}" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Margin="8,5,0,0"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource TelemetryTextStyle}"
                                           Text="{Binding DigitalIo.SignalRevisionText}" />
                                <TextBlock Grid.Row="2"
                                           Margin="0,5,0,0"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           Text="{loc:Loc Key=Inspector.NominalValue}" />
                                <TextBlock Grid.Row="2"
                                           Grid.Column="1"
                                           Margin="8,5,0,0"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource TelemetryTextStyle}"
                                           Text="{Binding DigitalIo.SelectedNominalValueText}" />
                                <TextBlock Grid.Row="3"
                                           Margin="0,5,0,0"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           Text="{loc:Loc Key=Inspector.ForceState}" />
                                <TextBlock Grid.Row="3"
                                           Grid.Column="1"
                                           Margin="8,5,0,0"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource TelemetryTextStyle}"
                                           Text="{Binding DigitalIo.SelectedForceText}" />
                            </Grid>

                            <Button x:Name="StartDigitalIoManualControlButton"
                                    Margin="0,9,0,0"
                                    Command="{Binding DigitalIo.StartManualControlCommand}"
                                    Content="{loc:Loc Key=Io.StartManualControl}"
                                    Style="{StaticResource PrimaryCommandButtonStyle}"
                                    ToolTip="{loc:Loc Key=Io.StartManualControlTooltip}" />
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.9*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="0.9*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="1.2*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="DigitalIoForceOnButton"
                                        Command="{Binding DigitalIo.ForceOnCommand}"
                                        Content="{loc:Loc Key=Io.ForceOn}"
                                        ToolTip="{loc:Loc Key=Io.ForceOnTooltip}" />
                                <Button x:Name="DigitalIoForceOffButton"
                                        Grid.Column="2"
                                        Command="{Binding DigitalIo.ForceOffCommand}"
                                        Content="{loc:Loc Key=Io.ForceOff}"
                                        ToolTip="{loc:Loc Key=Io.ForceOffTooltip}" />
                                <Button x:Name="DigitalIoClearForceButton"
                                        Grid.Column="4"
                                        Command="{Binding DigitalIo.ClearForceCommand}"
                                        Content="{loc:Loc Key=Io.ClearForce}"
                                        ToolTip="{loc:Loc Key=Io.ClearForceTooltip}" />
                            </Grid>
                            <TextBlock Margin="2,8,2,0"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{Binding DigitalIo.OperationHintText}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource InspectorCardStyle}">
                        <StackPanel>
                            <TextBlock x:Name="FaultManagerSectionAnchor"
                                       Style="{StaticResource SectionCaptionStyle}"
                                       Text="{loc:Loc Key=Inspector.FaultManager}" />
                            <TextBlock Margin="0,2,0,8"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{loc:Loc Key=Inspector.FaultRecoveryHint}"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,0,0,3"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{loc:Loc Key=Inspector.FaultType}" />
                            <ComboBox x:Name="FaultKindComboBox"
                                      ItemsSource="{Binding FaultManager.AvailableKinds}"
                                      SelectedItem="{Binding FaultManager.SelectedKind, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource LocalizedFaultKindConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Margin="0,8,0,3"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{loc:Loc Key=Inspector.RuntimeTarget}" />
                            <ComboBox x:Name="FaultTargetComboBox"
                                      ItemsSource="{Binding FaultManager.Targets}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedItem="{Binding FaultManager.SelectedTarget, Mode=TwoWay}"
                                      ToolTip="{loc:Loc Key=Inspector.RuntimeTargetTooltip}"
                                      IsEnabled="{Binding FaultManager.HasTargets}" />
                            <TextBlock Margin="0,4,0,0"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource State.Warning}"
                                       Text="{Binding FaultManager.TargetSelectionHelpText}"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FaultManager.HasTargets}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel Margin="0,8,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FaultManager.RequiresForcedValue}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Margin="0,0,0,3"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           Text="{loc:Loc Key=Inspector.ForcedValue}" />
                                <ComboBox x:Name="FaultForcedValueComboBox"
                                          ItemsSource="{Binding FaultManager.ForcedValueOptions}"
                                          SelectedItem="{Binding FaultManager.SelectedForcedValue, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource LocalizedForcedValueConverter}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <Button x:Name="InjectFaultButton"
                                    Margin="0,10,0,0"
                                    Command="{Binding FaultManager.InjectCommand}"
                                    Style="{StaticResource PrimaryCommandButtonStyle}"
                                    Content="{loc:Loc Key=Inspector.InjectFault}" />

                            <Grid Margin="0,12,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SectionCaptionStyle}" Text="{loc:Loc Key=Inspector.ActiveFaults}" />
                                <TextBlock Grid.Column="1" Text="{Binding FaultManager.ActiveFaultCountText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FaultManager.HasActiveFaults}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource State.Fault}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <ListBox x:Name="ActiveFaultListBox"
                                     MinHeight="46"
                                     MaxHeight="112"
                                     ItemsSource="{Binding FaultManager.ActiveFaults}"
                                     SelectedItem="{Binding FaultManager.SelectedActiveFault, Mode=TwoWay}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.Style>
                                    <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FaultManager.HasActiveFaults}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.Style>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="4,3"
                                                   Foreground="{DynamicResource Text.Primary}"
                                                   Text="{Binding DisplayText}"
                                                   TextWrapping="Wrap"
                                                   ToolTip="{Binding TargetId}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="ClearSelectedFaultButton"
                                        Command="{Binding FaultManager.ClearSelectedCommand}"
                                        Content="{loc:Loc Key=Inspector.ClearSelected}" />
                                <Button x:Name="ClearAllFaultsButton"
                                        Grid.Column="2"
                                        Command="{Binding FaultManager.ClearAllCommand}"
                                        Content="{loc:Loc Key=Inspector.ClearAll}" />
                            </Grid>
                            <TextBlock x:Name="NoActiveFaultsText"
                                       Margin="0,4,0,0"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{loc:Loc Key=Inspector.NoActiveFaults}"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FaultManager.HasActiveFaults}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock x:Name="FaultOperationStatusText"
                                       Margin="2,8,2,0"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{Binding FaultManager.OperationStatusText}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource InspectorCardStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasEmbeddedSequence}" Value="True" />
                                            <Condition Binding="{Binding HasCycleStartInput}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionCaptionStyle}" Text="{loc:Loc Key=Inspector.VirtualInput}" />
                            <Button Command="{Binding CycleStartCommand}"
                                    Style="{StaticResource PrimaryCommandButtonStyle}"
                                    ToolTip="{loc:Loc Key=Inspector.CycleStartTooltip}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Play24" Foreground="{DynamicResource State.Running}" />
                                    <TextBlock Margin="6,0,0,0" Text="{loc:Loc Key=Inspector.CycleStart}" />
                                </StackPanel>
                            </Button>
                            <TextBlock Margin="2,8,2,0"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{loc:Loc Key=Inspector.CycleStartHint}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    </StackPanel>
                    </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
