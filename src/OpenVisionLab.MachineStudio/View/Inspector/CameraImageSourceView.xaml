<UserControl x:Class="OpenVisionLab.MachineStudio.View.Inspector.CameraImageSourceView" x:Name="CameraSourceViewRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:OpenVisionLab.MachineStudio.Converter"
             xmlns:loc="clr-namespace:OpenVisionLab.MachineStudio.Localization"
             xmlns:local="clr-namespace:OpenVisionLab.MachineStudio.View.Inspector"
             xmlns:mmi="clr-namespace:OpenVisionLab.MachineStudio.View.Mmi"
             xmlns:shell="clr-namespace:OpenVisionLab.MachineStudio.View.Shell"
             xmlns:devices="clr-namespace:OpenVisionLab.Machine.Core.Devices;assembly=OpenVisionLab.Machine.Core">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:NumericalFramePreviewConverter x:Key="NumericalFramePreviewConverter" />
        <Style TargetType="ui:NumberBox" BasedOn="{StaticResource {x:Type ui:NumberBox}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.Navigation.IsEquipmentWorkspace, RelativeSource={RelativeSource AncestorType=local:RightToolRegionView}}" Value="True">
                    <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic, Segoe UI" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Height" Value="28" />
                    <Setter Property="MinHeight" Value="28" />
                    <Setter Property="Padding" Value="7,4" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext.Camera.HasVirtualCamera, RelativeSource={RelativeSource AncestorType=mmi:MmiOperatorLayoutView}}" Value="True">
                    <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic, Segoe UI" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Height" Value="28" />
                    <Setter Property="MinHeight" Value="28" />
                    <Setter Property="Padding" Value="7,4" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding DataContext.Camera.HasVirtualCamera, RelativeSource={RelativeSource AncestorType=mmi:MmiOperatorLayoutView}}" Value="True" />
                        <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
                    <Setter Property="Background" Value="{DynamicResource Surface.Input}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.Camera.HasVirtualCamera, RelativeSource={RelativeSource AncestorType=mmi:MmiOperatorLayoutView}}" Value="True">
                    <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic, Segoe UI" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Height" Value="28" />
                    <Setter Property="MinHeight" Value="28" />
                    <Setter Property="Padding" Value="7,4" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding DataContext.Camera.HasVirtualCamera, RelativeSource={RelativeSource AncestorType=mmi:MmiOperatorLayoutView}}" Value="True" />
                        <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
                    <Setter Property="Background" Value="{DynamicResource Surface.Input}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding DataContext.Navigation.IsEquipmentWorkspace, RelativeSource={RelativeSource AncestorType=local:RightToolRegionView}}" Value="True">
                    <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic, Segoe UI" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Background" Value="{DynamicResource EquipmentInspector.Input}" />
                    <Setter Property="Foreground" Value="{DynamicResource EquipmentInspector.Muted}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource EquipmentInspector.ControlLine}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Height" Value="28" />
                    <Setter Property="MinHeight" Value="28" />
                    <Setter Property="Padding" Value="7,4" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </DataTrigger>
                <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding DataContext.Navigation.IsEquipmentWorkspace, RelativeSource={RelativeSource AncestorType=local:RightToolRegionView}}" Value="True" /><Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="False" /></MultiDataTrigger.Conditions><Setter Property="Opacity" Value="0.6" /></MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CaptureParameterCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.Camera.HasVirtualCamera, RelativeSource={RelativeSource AncestorType=mmi:MmiOperatorLayoutView}}" Value="True">
                    <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic, Segoe UI" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="LineHeight" Value="17.4" />
                    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
                    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext.Navigation.IsEquipmentWorkspace, RelativeSource={RelativeSource AncestorType=local:RightToolRegionView}}" Value="True">
                    <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic, Segoe UI" />
                    <Setter Property="FontSize" Value="{Binding FontSize, RelativeSource={RelativeSource AncestorType=local:RightToolRegionView}}" />
                    <Setter Property="LineHeight" Value="18.85" />
                    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
                </DataTrigger>
                <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding DataContext.Navigation.IsEquipmentWorkspace, RelativeSource={RelativeSource AncestorType=local:RightToolRegionView}}" Value="True" /><Condition Binding="{Binding (shell:ShellWindow.IsCompactLayout), RelativeSource={RelativeSource AncestorType=shell:ShellWindow}}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="LineHeight" Value="18.125" /></MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SectionCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource SectionCaptionStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.Navigation.IsEquipmentWorkspace, RelativeSource={RelativeSource AncestorType=local:RightToolRegionView}}" Value="True">
                    <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic, Segoe UI" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="LineHeight" Value="17.4" />
                    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CameraSourceInputStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="{StaticResource Density.InspectorFieldHeight}" />
            <Setter Property="Padding" Value="7,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.Navigation.IsEquipmentWorkspace, RelativeSource={RelativeSource AncestorType=local:RightToolRegionView}}" Value="True">
                    <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic, Segoe UI" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Height" Value="28" />
                    <Setter Property="MinHeight" Value="28" />
                    <Setter Property="Padding" Value="7,4" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext.Camera.HasVirtualCamera, RelativeSource={RelativeSource AncestorType=mmi:MmiOperatorLayoutView}}" Value="True">
                    <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic, Segoe UI" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Height" Value="28" />
                    <Setter Property="MinHeight" Value="28" />
                    <Setter Property="Padding" Value="7,4" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="InspectorFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,7,0,3" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.Navigation.IsEquipmentWorkspace, RelativeSource={RelativeSource AncestorType=local:RightToolRegionView}}" Value="True">
                    <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic, Segoe UI" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="LineHeight" Value="17.4" />
                    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext.Camera.HasVirtualCamera, RelativeSource={RelativeSource AncestorType=mmi:MmiOperatorLayoutView}}" Value="True">
                    <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic, Segoe UI" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="LineHeight" Value="17.4" />
                    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
                    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="CaptureInputKindTemplate">
            <TextBlock TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="{Binding}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding}" Value="{x:Static devices:NumericalCameraInputKind.Image2D}"><Setter Property="Text" Value="{loc:Loc Key=Camera.TwoDImage}" /></DataTrigger>
                            <DataTrigger Binding="{Binding}" Value="{x:Static devices:NumericalCameraInputKind.HeightMap3D}"><Setter Property="Text" Value="{loc:Loc Key=Camera.HeightMap3D}" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>
        <DataTemplate x:Key="CaptureParameterTemplate">
            <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" Style="{StaticResource CaptureParameterCaptionStyle}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Name}" />
                <TextBlock Grid.Column="2" Text="{Binding Unit}" Style="{StaticResource CaptureParameterCaptionStyle}" VerticalAlignment="Center" Margin="5,0,0,0" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="CameraVariationParameterTemplate">
            <StackPanel Margin="0,0,9,9">
                <Grid Margin="0,0,0,3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource CaptureParameterCaptionStyle}" TextWrapping="Wrap" />
                    <TextBlock Grid.Column="1" Text="{Binding Unit}" Style="{StaticResource CaptureParameterCaptionStyle}" Margin="6,0,0,0" />
                </Grid>
                <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Name}" />
            </StackPanel>
        </DataTemplate>
        <Style x:Key="CaptureSetupContentStyle" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers><DataTrigger Binding="{Binding CaptureSection, ElementName=CameraSourceViewRoot}" Value="-1"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                <DataTrigger Binding="{Binding CaptureSection, ElementName=CameraSourceViewRoot}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer x:Name="CameraSourceFieldsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="Padding" Value="0,0,14,0" /><Style.Triggers>
                <DataTrigger Binding="{Binding CaptureSection, ElementName=CameraSourceViewRoot}" Value="1"><Setter Property="Padding" Value="0" /></DataTrigger>
            </Style.Triggers></Style></ScrollViewer.Style>
        <StackPanel x:Name="CameraSourceFieldsPanel">
        <StackPanel DataContext="{Binding CaptureEditor}">
            <StackPanel IsEnabled="{Binding CanEdit}">
                <StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers><DataTrigger Binding="{Binding CaptureSection, ElementName=CameraSourceViewRoot}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                </Style></StackPanel.Style>
                    <TextBlock Text="{loc:Loc Key=Camera.CaptureSetup}" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{loc:Loc Key=Camera.CaptureSetupHint}" TextWrapping="Wrap" Margin="0,12,0,8" />
                    <TextBlock Text="{loc:Loc Key=Camera.CaptureScopeHint}" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}" />
                    <TextBlock Text="{loc:Loc Key=Camera.ReferenceAxis}" Style="{StaticResource InspectorFieldLabelStyle}" />
                    <ComboBox x:Name="CaptureReferenceAxisComboBox" ItemsSource="{Binding Axes}" SelectedValuePath="Id" SelectedValue="{Binding AxisId, Mode=TwoWay}">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock TextWrapping="Wrap"><TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} / {1}"><Binding Path="Name" /><Binding Path="Id" /></MultiBinding>
                        </TextBlock.Text></TextBlock></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{loc:Loc Key=Camera.CaptureWidth}" Style="{StaticResource InspectorFieldLabelStyle}" Margin="0,14,0,3" />
                    <TextBox x:Name="CaptureFieldOfViewTextBox" Text="{Binding Parameters[0].Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="116" HorizontalAlignment="Left" AutomationProperties.Name="{loc:Loc Key=Camera.CaptureWidth}" />
                    <TextBlock Text="{loc:Loc Key=Camera.AxisDeviationHint}" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}" Margin="0,14,0,8" />
                    <CheckBox Content="{loc:Loc Key=Camera.UseNumericalInput}" IsChecked="{Binding Enabled, Mode=TwoWay}" Margin="0,0,0,8" />
                </StackPanel>
                <StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers><DataTrigger Binding="{Binding CaptureSection, ElementName=CameraSourceViewRoot}" Value="1"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                </Style></StackPanel.Style>
                    <TextBlock x:Name="CameraVariationHeading" Text="{loc:Loc Key=Camera.Variation}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.Camera.HasVirtualCamera, RelativeSource={RelativeSource AncestorType={x:Type mmi:MmiOperatorLayoutView}}}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock x:Name="CameraVariationScopeHint" Text="{loc:Loc Key=Camera.VariationScopeHint}" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}" Margin="0,0,0,10" />
                    <TextBlock x:Name="CameraVariationSourceRequired" TextWrapping="Wrap" Foreground="{DynamicResource State.Warning}" Margin="0,0,0,10">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{loc:Loc Key=Camera.VariationSourceRequired}" /><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers>
                            <DataTrigger Binding="{Binding Enabled}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            <DataTrigger Binding="{Binding CanEdit}" Value="False"><Setter Property="Text" Value="{loc:Loc Key=Camera.VariationSelectionRequired}" /><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                        </Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <ItemsControl x:Name="CameraVariationFields" ItemsSource="{Binding VariationParameters}" ItemTemplate="{StaticResource CameraVariationParameterTemplate}" IsEnabled="{Binding Enabled}" Margin="0,0,-9,0">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
                <StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers><DataTrigger Binding="{Binding CaptureSection, ElementName=CameraSourceViewRoot}" Value="2"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                </Style></StackPanel.Style>
                    <TextBlock Text="{loc:Loc Key=Camera.GenerateInput}" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{loc:Loc Key=Camera.NumericalInputHint}" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}" Margin="0,10,0,6" />
                    <TextBlock Text="{loc:Loc Key=Camera.InputKind}" Style="{StaticResource InspectorFieldLabelStyle}" />
                    <ComboBox ItemsSource="{Binding InputKinds}" ItemTemplate="{StaticResource CaptureInputKindTemplate}" SelectedItem="{Binding InputKind, Mode=TwoWay}" AutomationProperties.Name="{loc:Loc Key=Camera.InputKind}" />
                    <ItemsControl ItemsSource="{Binding GenerationParameters}" ItemTemplate="{StaticResource CaptureParameterTemplate}" Margin="0,10,0,0" />
                    <CheckBox Content="{loc:Loc Key=Camera.MockDefect}" IsChecked="{Binding Defect, Mode=TwoWay}" Margin="0,8" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
        <Expander Header="편차 조건 · 2D / 3D 합성 이미지" IsExpanded="True" Margin="0,4,0,10">
            <Expander.Style><Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers>
                <DataTrigger Binding="{Binding CaptureSection, ElementName=CameraSourceViewRoot}" Value="-1"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
            </Style.Triggers></Style></Expander.Style>
            <StackPanel>
                <TextBlock Text="카메라별 설정입니다. 적용·저장 후 시퀀스를 운전하면 촬영 이미지가 생성됩니다." TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}" />
                <StackPanel DataContext="{Binding CaptureEditor}" IsEnabled="{Binding CanEdit}">
                    <CheckBox Content="합성 이미지 사용" IsChecked="{Binding Enabled, Mode=TwoWay}" Margin="0,7,0,4" />
                    <TextBlock Text="{loc:Loc Key=Camera.InputKind}" Style="{StaticResource InspectorFieldLabelStyle}" />
                    <ComboBox ItemsSource="{Binding InputKinds}" ItemTemplate="{StaticResource CaptureInputKindTemplate}" SelectedItem="{Binding InputKind, Mode=TwoWay}" AutomationProperties.Name="{loc:Loc Key=Camera.InputKind}" />
                    <TextBlock Text="검사 레시피" Style="{StaticResource InspectorFieldLabelStyle}" />
                    <TextBox Text="{Binding RecipeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" AutomationProperties.Name="검사 레시피 이름" />
                    <TextBlock Text="버전" Style="{StaticResource InspectorFieldLabelStyle}" />
                    <TextBox Text="{Binding Version, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="6" AutomationProperties.Name="검사 레시피 버전" />
                    <Button Content="현재 버전 확인" Command="{Binding ConfirmVersionCommand}" Margin="0,5,0,3" />
                    <TextBlock Text="{Binding ConfirmationText}" TextWrapping="Wrap" />
                    <TextBlock Text="촬영 기준 축" Style="{StaticResource InspectorFieldLabelStyle}" />
                    <ComboBox ItemsSource="{Binding Axes}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding AxisId, Mode=TwoWay}" />
                    <ItemsControl ItemsSource="{Binding Parameters}" Margin="0,7,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="68" /><ColumnDefinition Width="*" /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource CaptureParameterCaptionStyle}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Name}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Unit}" Style="{StaticResource CaptureParameterCaptionStyle}" VerticalAlignment="Center" Margin="5,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <CheckBox Content="NG 이미지 생성" IsChecked="{Binding Defect, Mode=TwoWay}" Margin="0,7" />
                    <WrapPanel>
                        <Button Content="촬영 설정 적용" Command="{Binding ApplyCommand}" Style="{StaticResource PrimaryCommandButtonStyle}" Margin="0,0,5,5" />
                        <Button Content="저장 설정 복원" Command="{Binding RevertCommand}" Margin="0,0,5,5" />
                        <Button Content="기본값" Command="{Binding ResetCommand}" Margin="0,0,0,5" />
                    </WrapPanel>
                </StackPanel>
                <TextBlock Text="{Binding CaptureEditor.Status}" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}" Margin="0,4" />
                <Image Source="{Binding CurrentNumericalInput, Converter={StaticResource NumericalFramePreviewConverter}}" Height="150" Stretch="Uniform" />
                <TextBlock Text="촬영 이미지 미리보기 · 높이맵은 밝기로 높이를 표시합니다." TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}" />
            </StackPanel>
        </Expander>
        <StackPanel Style="{StaticResource CaptureSetupContentStyle}">
        <StackPanel Visibility="{Binding CaptureEditor.Enabled, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=invert}">
        <TextBlock Text="{Binding CameraCommissioningHintText}" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}" />
        <TextBlock Style="{StaticResource InspectorFieldLabelStyle}" Text="{loc:Loc Key=Camera.Recipe}" />
        <ComboBox x:Name="CameraRecipeComboBox"
                  ItemsSource="{Binding CurrentCameraRecipes}"
                  SelectedItem="{Binding SelectedCameraRecipe, Mode=TwoWay}"
                  AutomationProperties.Name="{loc:Loc Key=Camera.Recipe}" />
        <TextBlock Margin="0,10,0,2"
                   Style="{StaticResource SectionCaptionStyle}"
                   Text="{loc:Loc Key=Camera.SourceSetup}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="CameraSourcePathTextBox"
                     Style="{StaticResource CameraSourceInputStyle}"
                     VerticalContentAlignment="Center"
                     IsReadOnly="True"
                     Text="{Binding ImageSourceEditor.PathText}"
                     ToolTip="{Binding ImageSourceEditor.PathText}"
                     AutomationProperties.Name="{loc:Loc Key=Camera.SourceRelativePath}" />
            <Button x:Name="BrowseCameraSourceButton"
                    Grid.Column="2"
                    MinWidth="58"
                    Command="{Binding ImageSourceEditor.BrowseCommand}"
                    Content="{loc:Loc Key=Camera.Browse}"
                    ToolTip="{loc:Loc Key=Camera.BrowseTooltip}"
                    AutomationProperties.Name="{loc:Loc Key=Camera.Browse}" />
        </Grid>
        <Grid Margin="0,7,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource InspectorFieldLabelStyle}"
                           Text="{loc:Loc Key=Camera.SourceWidth}" />
                <ui:NumberBox AutomationProperties.AutomationId="CameraSourceWidthNumberBox"
                              Minimum="1"
                              Maximum="100000"
                              SmallChange="1"
                              Value="{Binding ImageSourceEditor.Width, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource InspectorFieldLabelStyle}"
                           Text="{loc:Loc Key=Camera.SourceHeight}" />
                <ui:NumberBox AutomationProperties.AutomationId="CameraSourceHeightNumberBox"
                              Minimum="1"
                              Maximum="100000"
                              SmallChange="1"
                              Value="{Binding ImageSourceEditor.Height, Mode=TwoWay}" />
            </StackPanel>
        </Grid>
        <TextBlock Style="{StaticResource InspectorFieldLabelStyle}"
                   Text="{loc:Loc Key=Camera.SourcePixelFormat}" />
        <TextBox x:Name="CameraSourcePixelFormatTextBox"
                 VerticalContentAlignment="Center"
                 Text="{Binding ImageSourceEditor.PixelFormatText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="{loc:Loc Key=Camera.PixelFormatTooltip}"
                 AutomationProperties.Name="{loc:Loc Key=Camera.SourcePixelFormat}">
            <TextBox.Style>
                <Style TargetType="TextBox" BasedOn="{StaticResource CameraSourceInputStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ImageSourceEditor.HasError}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource State.Fault}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBox.Style>
        </TextBox>
        <TextBlock x:Name="CameraSourceValidationText"
                   Margin="2,5,2,0"
                   FontSize="10.5"
                   Text="{Binding ImageSourceEditor.ValidationText}"
                   TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource State.Running}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ImageSourceEditor.HasError}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource State.Fault}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        </StackPanel>
        </StackPanel>
        </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1">
            <Border x:Name="CaptureSettingsFooter" Margin="0,8,0,0" Padding="0,6,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Border.Subtle}" DataContext="{Binding CaptureEditor}">
                <Border.Style><Style TargetType="Border"><Style.Triggers>
                    <DataTrigger Binding="{Binding CaptureSection, ElementName=CameraSourceViewRoot}" Value="-1"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                    <MultiDataTrigger><MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding CaptureSection, ElementName=CameraSourceViewRoot}" Value="0" />
                        <Condition Binding="{Binding HasCaptureSettingsToApply}" Value="False" />
                    </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Collapsed" /></MultiDataTrigger>
                </Style.Triggers></Style></Border.Style>
                <StackPanel>
                    <WrapPanel IsEnabled="{Binding CanEdit}">
                    <Button x:Name="CaptureApplySettingsButton" Content="{loc:Loc Key=Camera.ApplySettings}" Command="{Binding ApplyCommand}" Margin="0,0,6,5">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryCommandButtonStyle}"><Style.Triggers>
                            <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding CaptureSection, ElementName=CameraSourceViewRoot}" Value="1" /><Condition Binding="{Binding Enabled}" Value="False" /></MultiDataTrigger.Conditions><Setter Property="IsEnabled" Value="False" /></MultiDataTrigger>
                        </Style.Triggers></Style></Button.Style>
                    </Button>
                    <Button Content="{loc:Loc Key=Camera.RevertSource}" Command="{Binding RevertCommand}" Margin="0,0,6,5" />
                    <Button Content="{loc:Loc Key=Shell.Defaults}" Command="{Binding ResetCommand}" Margin="0,0,0,5" />
                    </WrapPanel>
                    <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                        <TextBlock x:Name="CaptureSettingsStatus" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,5,0,0">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" /><Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Foreground" Value="{DynamicResource State.Fault}" /></DataTrigger>
                            </Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        <StackPanel Style="{StaticResource CaptureSetupContentStyle}">
        <Grid Margin="0,7,0,0">
            <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers>
                <DataTrigger Binding="{Binding CaptureEditor.HasCaptureSettingsToApply}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
            </Style.Triggers></Style></Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="7" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="ApplyCameraSourceButton"
                    Command="{Binding ImageSourceEditor.ApplyCommand}"
                    IsEnabled="{Binding ImageSourceEditor.CanApply}"
                    Style="{StaticResource PrimaryCommandButtonStyle}"
                    Content="{loc:Loc Key=Camera.ApplySource}"
                    ToolTip="{loc:Loc Key=Camera.ApplySourceTooltip}"
                    AutomationProperties.Name="{loc:Loc Key=Camera.ApplySource}" />
            <Button x:Name="RevertCameraSourceButton"
                    Grid.Column="2"
                    Command="{Binding ImageSourceEditor.RevertCommand}"
                    IsEnabled="{Binding ImageSourceEditor.CanRevert}"
                    Content="{loc:Loc Key=Camera.RevertSource}"
                    ToolTip="{loc:Loc Key=Camera.RevertSourceTooltip}"
                    AutomationProperties.Name="{loc:Loc Key=Camera.RevertSource}" />
        </Grid>
        </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
