<UserControl x:Class="OpenVisionLab.MachineStudio.View.Inspector.CameraImageSourceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:OpenVisionLab.MachineStudio.Localization">
    <UserControl.Resources>
        <Style x:Key="InspectorFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,7,0,3" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer x:Name="CameraSourceFieldsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
        <TextBlock Margin="0,10,0,2"
                   Style="{StaticResource SectionCaptionStyle}"
                   Text="{loc:Loc Key=Camera.SourceSetup}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="CameraSourcePathTextBox"
                     Height="{StaticResource Density.InspectorFieldHeight}"
                     Padding="7,0"
                     VerticalContentAlignment="Center"
                     IsReadOnly="True"
                     Text="{Binding ImageSourceEditor.PathText}"
                     ToolTip="{Binding ImageSourceEditor.PathText}"
                     AutomationProperties.Name="{loc:Loc Key=Camera.SourceRelativePath}" />
            <Button x:Name="BrowseCameraSourceButton"
                    Grid.Column="2"
                    MinWidth="58"
                    Command="{Binding ImageSourceEditor.BrowseCommand}"
                    Content="{loc:Loc Key=Camera.Browse}"
                    ToolTip="{loc:Loc Key=Camera.BrowseTooltip}"
                    AutomationProperties.Name="{loc:Loc Key=Camera.Browse}" />
        </Grid>
        <Grid Margin="0,7,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource InspectorFieldLabelStyle}"
                           Text="{loc:Loc Key=Camera.SourceWidth}" />
                <ui:NumberBox AutomationProperties.AutomationId="CameraSourceWidthNumberBox"
                              Minimum="1"
                              Maximum="100000"
                              SmallChange="1"
                              Value="{Binding ImageSourceEditor.Width, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource InspectorFieldLabelStyle}"
                           Text="{loc:Loc Key=Camera.SourceHeight}" />
                <ui:NumberBox AutomationProperties.AutomationId="CameraSourceHeightNumberBox"
                              Minimum="1"
                              Maximum="100000"
                              SmallChange="1"
                              Value="{Binding ImageSourceEditor.Height, Mode=TwoWay}" />
            </StackPanel>
        </Grid>
        <TextBlock Style="{StaticResource InspectorFieldLabelStyle}"
                   Text="{loc:Loc Key=Camera.SourcePixelFormat}" />
        <TextBox x:Name="CameraSourcePixelFormatTextBox"
                 Height="{StaticResource Density.InspectorFieldHeight}"
                 Padding="7,0"
                 VerticalContentAlignment="Center"
                 Text="{Binding ImageSourceEditor.PixelFormatText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="{loc:Loc Key=Camera.PixelFormatTooltip}"
                 AutomationProperties.Name="{loc:Loc Key=Camera.SourcePixelFormat}">
            <TextBox.Style>
                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ImageSourceEditor.HasError}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource State.Fault}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBox.Style>
        </TextBox>
        <TextBlock x:Name="CameraSourceValidationText"
                   Margin="2,5,2,0"
                   FontSize="10.5"
                   Text="{Binding ImageSourceEditor.ValidationText}"
                   TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource State.Running}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ImageSourceEditor.HasError}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource State.Fault}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="1" Margin="0,7,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="7" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="ApplyCameraSourceButton"
                    Command="{Binding ImageSourceEditor.ApplyCommand}"
                    IsEnabled="{Binding ImageSourceEditor.CanApply}"
                    Style="{StaticResource PrimaryCommandButtonStyle}"
                    Content="{loc:Loc Key=Camera.ApplySource}"
                    ToolTip="{loc:Loc Key=Camera.ApplySourceTooltip}"
                    AutomationProperties.Name="{loc:Loc Key=Camera.ApplySource}" />
            <Button x:Name="RevertCameraSourceButton"
                    Grid.Column="2"
                    Command="{Binding ImageSourceEditor.RevertCommand}"
                    IsEnabled="{Binding ImageSourceEditor.CanRevert}"
                    Content="{loc:Loc Key=Camera.RevertSource}"
                    ToolTip="{loc:Loc Key=Camera.RevertSourceTooltip}"
                    AutomationProperties.Name="{loc:Loc Key=Camera.RevertSource}" />
        </Grid>
    </Grid>
</UserControl>
