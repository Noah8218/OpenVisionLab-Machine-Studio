<UserControl x:Class="OpenVisionLab.MachineStudio.View.Shell.StudioStatusBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:OpenVisionLab.MachineStudio.Localization">
    <Border Background="{DynamicResource Surface.Root}"
            BorderBrush="{DynamicResource Border.Default}"
            BorderThickness="0,1,0,0">
        <Grid Margin="10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Height="22" MinWidth="0" Margin="0,0,8,0" Padding="6,0"
                    Command="{Binding Navigation.ToggleEvidenceDrawerCommand}"
                    Content="{loc:Loc Key=Shell.Evidence}"
                    AutomationProperties.Name="{loc:Loc Key=Diagnostics.Toggle}"
                    ToolTip="{loc:Loc Key=Diagnostics.Hint}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource GlobalCommandButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Navigation.IsEquipmentWorkspace}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <TextBlock Grid.Column="1"
                       MaxWidth="280"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource Text.Secondary}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding ProjectStatusText}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="{Binding ProjectStatusText}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Navigation.IsEquipmentWorkspace}" Value="True">
                                <Setter Property="Text" Value="{Binding EquipmentFooterStatusText}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Grid.Column="2"
                       Margin="16,0,12,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource Text.Secondary}"
                       Text="{Binding SelectionStatusText}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding SelectionStatusText}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Navigation.IsEquipmentWorkspace}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Grid.Column="3"
                       Margin="10,0"
                       VerticalAlignment="Center"
                       Style="{StaticResource TelemetryTextStyle}"
                       Text="{Binding SimulationStatusText}" />
            <TextBlock Grid.Column="4"
                       Margin="10,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource Text.Secondary}"
                       Text="{Binding FixedStepStatusText}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Navigation.IsEquipmentWorkspace}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Grid.Column="4" Margin="10,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource Text.Secondary}" Text="{loc:Loc Key=Equipment.SimulationOnly}"
                       Visibility="{Binding Navigation.IsEquipmentWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>
    </Border>
</UserControl>
