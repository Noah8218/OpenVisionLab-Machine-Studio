<UserControl x:Class="OpenVisionLab.MachineStudio.View.Shell.StudioStatusBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:OpenVisionLab.MachineStudio.Localization">
    <Border Background="{DynamicResource Surface.Root}"
            BorderBrush="{DynamicResource Border.Default}"
            BorderThickness="0,1,0,0">
        <Grid Margin="10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Height="22" MinWidth="0" Margin="0,0,8,0" Padding="6,0"
                    Command="{Binding Navigation.ToggleEvidenceDrawerCommand}"
                    Content="{loc:Loc Key=Shell.Evidence}"
                    AutomationProperties.Name="{loc:Loc Key=Diagnostics.Toggle}"
                    ToolTip="{loc:Loc Key=Diagnostics.Hint}"
                    Style="{StaticResource GlobalCommandButtonStyle}" />
            <TextBlock Grid.Column="1"
                       MaxWidth="280"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource Text.Secondary}"
                       Text="{Binding ProjectStatusText}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding ProjectStatusText}" />
            <TextBlock Grid.Column="2"
                       Margin="16,0,12,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource Text.Secondary}"
                       Text="{Binding SelectionStatusText}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding SelectionStatusText}" />

            <TextBlock Grid.Column="3"
                       Margin="10,0"
                       VerticalAlignment="Center"
                       Style="{StaticResource TelemetryTextStyle}"
                       Text="{Binding SimulationStatusText}" />
            <TextBlock Grid.Column="4"
                       Margin="10,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource Text.Secondary}"
                       Text="{Binding FixedStepStatusText}" />
        </Grid>
    </Border>
</UserControl>
