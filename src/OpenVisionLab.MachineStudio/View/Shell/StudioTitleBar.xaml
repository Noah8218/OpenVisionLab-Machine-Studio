<UserControl x:Class="OpenVisionLab.MachineStudio.View.Shell.StudioTitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:OpenVisionLab.MachineStudio.Localization">
    <ui:TitleBar Height="32"
                 Title="{Binding Title}"
                 Background="{DynamicResource Surface.Root}"
                 Foreground="{DynamicResource Text.Primary}"
                 ButtonsForeground="{DynamicResource Text.Secondary}"
                 ButtonsBackground="Transparent"
                 ShowMinimize="True"
                 ShowMaximize="True"
                 ShowClose="True">
        <ui:TitleBar.Header>
            <StackPanel Margin="8,0,10,0" Orientation="Horizontal">
                <Border Width="18"
                        Height="18"
                        VerticalAlignment="Center"
                        Background="{DynamicResource Accent.Soft}"
                        BorderBrush="{DynamicResource Accent.Primary}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="8"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Accent.Hover}"
                               Text="OV" />
                </Border>
                <TextBlock Margin="7,0,0,0"
                           MaxWidth="520"
                           VerticalAlignment="Center"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Text="{Binding Title}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </ui:TitleBar.Header>
        <ui:TitleBar.TrailingContent>
            <StackPanel Margin="0,0,8,0" Orientation="Horizontal">
                <TextBlock Margin="0,0,6,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Text.Secondary}"
                           Text="{loc:Loc Key=Shell.Language}" />
                <ComboBox Width="84"
                          Margin="0,0,12,0"
                          DisplayMemberPath="DisplayName"
                          ItemsSource="{Binding LanguageOptions}"
                          SelectedItem="{Binding SelectedLanguageOption, Mode=TwoWay}"
                          Style="{StaticResource LanguageComboBoxStyle}"
                          ToolTip="{loc:Loc Key=Shell.LanguageTooltip}" />
            </StackPanel>
        </ui:TitleBar.TrailingContent>
    </ui:TitleBar>
</UserControl>
