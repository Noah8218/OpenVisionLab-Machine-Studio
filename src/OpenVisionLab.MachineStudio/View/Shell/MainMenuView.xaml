<UserControl x:Class="OpenVisionLab.MachineStudio.View.Shell.MainMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:OpenVisionLab.MachineStudio.Localization">
    <UserControl.Resources>
        <DataTemplate x:Key="R24MenuHeaderTemplate">
            <AccessText Text="{Binding}" FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=MenuItem}}"
                        FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=MenuItem}}" FontWeight="Normal"
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}}"
                        TextBlock.LineHeight="{Binding Path=(TextBlock.LineHeight), RelativeSource={RelativeSource AncestorType=MenuItem}}"
                        TextBlock.LineStackingStrategy="BlockLineHeight">
                <AccessText.Resources><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Setter Property="LineHeight" Value="{Binding Path=(TextBlock.LineHeight), RelativeSource={RelativeSource AncestorType=MenuItem}}" />
                    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
                </Style></AccessText.Resources>
            </AccessText>
        </DataTemplate>
        <Style x:Key="R24TopMenuItemStyle" TargetType="MenuItem" BasedOn="{StaticResource MachineTopMenuItemStyle}">
            <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic" /><Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" /><Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{x:Null}" /><Setter Property="TextBlock.LineHeight" Value="18.85" />
            <Setter Property="Height" Value="28.85" /><Setter Property="Padding" Value="9,5" /><Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" /><Setter Property="HeaderTemplate" Value="{StaticResource R24MenuHeaderTemplate}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
                <Grid>
                    <Border x:Name="HeaderBorder" CornerRadius="4" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                        <ContentPresenter VerticalAlignment="Center" ContentSource="Header" RecognizesAccessKey="True" />
                    </Border>
                    <Border x:Name="FocusCue" Margin="-3" CornerRadius="5" BorderThickness="2" BorderBrush="{DynamicResource Accent.Primary}" IsHitTestVisible="False" Visibility="Collapsed" />
                    <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsSubmenuOpen}"
                           Placement="Relative" HorizontalOffset="-20" VerticalOffset="12" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" PopupAnimation="Fade">
                        <Border Padding="20,20,20,30" Background="Transparent">
                            <Border x:Name="MenuPanel" MinWidth="250" Padding="5" Background="{DynamicResource Surface.Panel}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="6">
                                <Border.Effect><DropShadowEffect Color="Black" Opacity="0.6" BlurRadius="30" ShadowDepth="10" Direction="270" /></Border.Effect>
                                <ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter Margin="0,0,0,-2" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </ScrollViewer>
                            </Border>
                        </Border>
                    </Popup>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource Surface.Hover}" /></Trigger>
                    <Trigger Property="IsSubmenuOpen" Value="True"><Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource Surface.Hover}" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusCue" Property="Visibility" Value="Visible" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><DataTrigger Binding="{Binding Navigation.IsCompactLayout}" Value="True"><Setter Property="FontSize" Value="12.5" /><Setter Property="TextBlock.LineHeight" Value="18.125" /><Setter Property="Height" Value="28.125" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="R24SubmenuItemStyle" TargetType="MenuItem" BasedOn="{StaticResource MachineSubmenuItemStyle}">
            <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic" /><Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{x:Null}" /><Setter Property="TextBlock.LineHeight" Value="18.85" /><Setter Property="Height" Value="28" /><Setter Property="Padding" Value="10,4" /><Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" /><Setter Property="HeaderTemplate" Value="{StaticResource R24MenuHeaderTemplate}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
                <Grid>
                    <Border x:Name="ItemBorder" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="5">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" ContentSource="Header" RecognizesAccessKey="True" />
                            <TextBlock Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center" Text="{TemplateBinding InputGestureText}"
                                       FontFamily="{TemplateBinding FontFamily}" FontSize="11" FontWeight="Normal" LineHeight="15.95" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource Text.Secondary}" />
                        </Grid>
                    </Border>
                    <Border x:Name="FocusCue" Margin="-3" CornerRadius="6" BorderThickness="2" BorderBrush="{DynamicResource Accent.Primary}" IsHitTestVisible="False" Visibility="Collapsed" />
                </Grid>
                <ControlTemplate.Triggers>
                    <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsHighlighted" Value="True" /><Condition Property="IsEnabled" Value="True" /></MultiTrigger.Conditions><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Surface.Hover}" /></MultiTrigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusCue" Property="Visibility" Value="Visible" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Navigation.IsCompactLayout}" Value="True"><Setter Property="FontSize" Value="12.5" /><Setter Property="TextBlock.LineHeight" Value="18.125" /></DataTrigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource Text.Disabled}" /><Setter Property="Opacity" Value="1" /><Setter Property="Cursor" Value="No" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="R24MenuSeparatorStyle" TargetType="Separator">
            <Setter Property="Height" Value="1" /><Setter Property="Margin" Value="0,3,0,5" /><Setter Property="Background" Value="{DynamicResource Border.Subtle}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Background="{TemplateBinding Background}" /></ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
        <Menu VerticalAlignment="Center" Padding="0" Background="Transparent" UseLayoutRounding="False">
            <MenuItem Header="{loc:Loc Key=Shell.File}" Style="{StaticResource R24TopMenuItemStyle}">
                <MenuItem Header="{loc:Loc Key=Shell.New}" Command="{Binding NewProjectCommand}" InputGestureText="Ctrl+N" Style="{StaticResource R24SubmenuItemStyle}" />
                <MenuItem Header="{loc:Loc Key=Gallery.Open}" Command="{Binding SemiconductorRecipes.OpenCommand}" Style="{StaticResource R24SubmenuItemStyle}" />
                <MenuItem Header="{loc:Loc Key=Shell.Open}" Command="{Binding OpenProjectCommand}" InputGestureText="Ctrl+O" Style="{StaticResource R24SubmenuItemStyle}" />
                <MenuItem Header="{loc:Loc Key=Shell.Save}" Command="{Binding SaveProjectCommand}" InputGestureText="Ctrl+S" Style="{StaticResource R24SubmenuItemStyle}" />
                <MenuItem Header="{loc:Loc Key=Shell.SaveAs}" Command="{Binding SaveProjectAsCommand}" InputGestureText="Ctrl+Shift+S" Style="{StaticResource R24SubmenuItemStyle}" />
                <MenuItem Header="{loc:Loc Key=SupportDiagnostics.Export}" Command="{Binding ExportSupportDiagnosticsCommand}" Style="{StaticResource R24SubmenuItemStyle}" />
                <Separator Style="{StaticResource R24MenuSeparatorStyle}" />
                <MenuItem Header="{loc:Loc Key=Shell.Exit}" Command="{Binding ExitCommand}" Style="{StaticResource R24SubmenuItemStyle}" />
            </MenuItem>
            <MenuItem x:Name="EditMenuItem" Header="{loc:Loc Key=Shell.Edit}" Style="{StaticResource R24TopMenuItemStyle}">
                <MenuItem Header="{loc:Loc Key=Shell.Undo}" Command="{Binding UndoLayoutEditCommand}" InputGestureText="Ctrl+Z" Style="{StaticResource R24SubmenuItemStyle}" />
                <MenuItem Header="{loc:Loc Key=Shell.Redo}" Command="{Binding RedoLayoutEditCommand}" InputGestureText="Ctrl+Y" Style="{StaticResource R24SubmenuItemStyle}" />
                <Separator Style="{StaticResource R24MenuSeparatorStyle}" />
                <MenuItem Header="{loc:Loc Key=Shell.Copy}" Command="{Binding CopyLayoutSelectionCommand}" InputGestureText="Ctrl+C" Style="{StaticResource R24SubmenuItemStyle}" />
                <MenuItem Header="{loc:Loc Key=Shell.Duplicate}" Command="{Binding DuplicateLayoutSelectionCommand}" InputGestureText="Ctrl+D" Style="{StaticResource R24SubmenuItemStyle}" />
                <MenuItem Header="{loc:Loc Key=Shell.Paste}" Command="{Binding PasteLayoutSelectionCommand}" InputGestureText="Ctrl+V" Style="{StaticResource R24SubmenuItemStyle}" />
                <MenuItem Header="{loc:Loc Key=Shell.Delete}" Command="{Binding DeleteLayoutComponentCommand}" InputGestureText="Delete" Style="{StaticResource R24SubmenuItemStyle}" />
            </MenuItem>
            <MenuItem x:Name="ViewMenuItem" Header="{loc:Loc Key=Shell.View}" Style="{StaticResource R24TopMenuItemStyle}">
                <MenuItem Command="{Binding Navigation.ToggleInspectorCommand}">
                    <MenuItem.Style>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource R24SubmenuItemStyle}">
                            <Setter Property="Header" Value="{loc:Loc Key=Shell.Inspector}" />
                            <Style.Triggers><DataTrigger Binding="{Binding Navigation.IsEquipmentWorkspace}" Value="True"><Setter Property="Header" Value="{loc:Loc Key=R24.ViewToggleInspector}" /></DataTrigger></Style.Triggers>
                        </Style>
                    </MenuItem.Style>
                </MenuItem>
                <MenuItem x:Name="ManualCommissioningMenuItem" Header="{loc:Loc Key=Shell.ManualRunTarget}"
                          Command="{Binding Navigation.OpenManualCommissioningCommand}" IsEnabled="{Binding IsRunMode}" Style="{StaticResource R24SubmenuItemStyle}" />
                <MenuItem Header="{loc:Loc Key=Shell.Evidence}" Command="{Binding Navigation.ToggleEvidenceDrawerCommand}" Style="{StaticResource R24SubmenuItemStyle}" />
                <Separator Style="{StaticResource R24MenuSeparatorStyle}" />
                <MenuItem x:Name="RecipeConnectionsMenuItem" Header="{loc:Loc Key=Shell.RecipeConnectionsMenu}"
                          Command="{Binding Navigation.OpenRecipeConnectionsCommand}" Style="{StaticResource R24SubmenuItemStyle}" />
                <MenuItem x:Name="TestScenarioMenuItem" Header="{loc:Loc Key=Shell.TestScenarioMenu}"
                          Command="{Binding Navigation.OpenTestScenarioCommand}" Style="{StaticResource R24SubmenuItemStyle}" />
            </MenuItem>
            <MenuItem Header="{loc:Loc Key=Shell.Run}" Style="{StaticResource R24TopMenuItemStyle}">
                <MenuItem Header="{loc:Loc Key=Shell.Run}" Command="{Binding RunCommand}" InputGestureText="F5" Style="{StaticResource R24SubmenuItemStyle}" />
                <MenuItem Header="{loc:Loc Key=Shell.Pause}" Command="{Binding PauseCommand}" InputGestureText="F6" Style="{StaticResource R24SubmenuItemStyle}" />
                <MenuItem Header="{loc:Loc Key=Debugger.NextSequenceStep}" Command="{Binding RuntimeDebugger.SemanticStepCommand}" Style="{StaticResource R24SubmenuItemStyle}" />
                <MenuItem Header="{loc:Loc Key=Shell.AbortSequence}" Command="{Binding AbortSequenceCommand}" Style="{StaticResource R24SubmenuItemStyle}" />
                <MenuItem Header="{loc:Loc Key=Shell.RetrySequence}" Command="{Binding RetrySequenceCommand}" Style="{StaticResource R24SubmenuItemStyle}" />
                <MenuItem Header="{loc:Loc Key=Shell.SingleTick}" Command="{Binding StepCommand}" InputGestureText="F10" Style="{StaticResource R24SubmenuItemStyle}" />
                <MenuItem Header="{loc:Loc Key=Shell.Reset}" Command="{Binding ResetCommand}" InputGestureText="Ctrl+Shift+R" Style="{StaticResource R24SubmenuItemStyle}" />
            </MenuItem>
            <MenuItem Header="{loc:Loc Key=Shell.Help}" Margin="0" Style="{StaticResource R24TopMenuItemStyle}">
                <MenuItem Header="{loc:Loc Key=SupportDiagnostics.Export}" Command="{Binding ExportSupportDiagnosticsCommand}" Style="{StaticResource R24SubmenuItemStyle}" />
                <MenuItem x:Name="LanguageMenuItem" Height="Auto" Padding="10,7" HeaderTemplate="{x:Null}" StaysOpenOnClick="True" Style="{StaticResource R24SubmenuItemStyle}">
                    <MenuItem.Header>
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Key=Shell.Language}" FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=MenuItem}}" FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=MenuItem}}" Foreground="{DynamicResource Text.Primary}" />
                            <ComboBox Width="180" Margin="0,6,0,0" DisplayMemberPath="DisplayName" FontFamily="Segoe UI, Malgun Gothic" FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=MenuItem}}" Foreground="{DynamicResource Text.Primary}"
                                      ItemsSource="{Binding Navigation.LanguageOptions}"
                                      SelectedItem="{Binding Navigation.SelectedLanguageOption, Mode=TwoWay}"
                                      Style="{StaticResource LanguageComboBoxStyle}" AutomationProperties.Name="{loc:Loc Key=Shell.Language}" />
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
            </MenuItem>
        </Menu>
</UserControl>
