<shell:MachineFluentWindow x:Class="OpenVisionLab.MachineStudio.View.Shell.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:OpenVisionLab.MachineStudio.View.Shell"
        xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:behavior="clr-namespace:OpenVisionLab.MachineStudio.Behavior"
        xmlns:project="clr-namespace:OpenVisionLab.MachineStudio.View.Project"
        xmlns:scene="clr-namespace:OpenVisionLab.MachineStudio.View.Scene"
        xmlns:simulation="clr-namespace:OpenVisionLab.MachineStudio.View.Simulation"
        xmlns:inspector="clr-namespace:OpenVisionLab.MachineStudio.View.Inspector"
        xmlns:diagnostics="clr-namespace:OpenVisionLab.MachineStudio.View.Diagnostics"
        xmlns:loc="clr-namespace:OpenVisionLab.MachineStudio.Localization"
        Title="{Binding Title}"
        MinWidth="1000"
        MinHeight="720"
        Background="{DynamicResource Surface.Root}"
        ExtendsContentIntoTitleBar="True"
        shell:ShellWindow.IsCompactLayout="{Binding Navigation.IsCompactLayout, Mode=TwoWay}"
        shell:ShellWindow.IsNarrowLayout="{Binding Navigation.IsNarrowLayout, Mode=TwoWay}"
        shell:ShellWindow.IsEquipmentInspectorOpen="{Binding Navigation.IsDockedInspectorOpen}"
        shell:ShellWindow.IsEquipmentWorkspace="{Binding Navigation.IsEquipmentWorkspace}"
        shell:ShellWindow.IsSequenceWorkspace="{Binding Navigation.IsSequenceWorkspace}"
        shell:ShellWindow.IsInspectionWorkspace="{Binding Navigation.IsInspectionWorkspace}"
        shell:ShellWindow.IsResultsWorkspace="{Binding Navigation.IsResultsWorkspace}"
        WindowStartupLocation="CenterScreen">
    <scene:MachineSceneViewport.LabelOverlayElement>
        <Binding ElementName="RightToolRegionView" />
    </scene:MachineSceneViewport.LabelOverlayElement>
    <b:Interaction.Behaviors>
        <behavior:ShellKeyboardCommandBehavior
            DeleteCommand="{Binding DeleteLayoutComponentCommand}"
            DuplicateCommand="{Binding DuplicateLayoutSelectionCommand}"
            SaveCommand="{Binding SaveProjectCommand}"
            SaveAsCommand="{Binding SaveProjectAsCommand}"
            IsModalOverlayOpen="{Binding Navigation.IsModalOverlayOpen}"
            CloseOverlayCommand="{Binding Navigation.CloseModalOverlayCommand}" />
    </b:Interaction.Behaviors>
    <shell:MachineFluentWindow.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewProjectCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenProjectCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoLayoutEditCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoLayoutEditCommand}" />
        <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopyLayoutSelectionCommand}" />
        <KeyBinding Key="V" Modifiers="Control" Command="{Binding PasteLayoutSelectionCommand}" />
        <KeyBinding Key="F5" Command="{Binding RunCommand}" />
        <KeyBinding Key="F6" Command="{Binding PauseCommand}" />
        <KeyBinding Key="F10" Command="{Binding StepCommand}" />
        <KeyBinding Key="R" Modifiers="Control+Shift" Command="{Binding ResetCommand}" />
        <KeyBinding Key="Escape" Command="{Binding SemiconductorRecipes.CloseCommand}" />
    </shell:MachineFluentWindow.InputBindings>

    <Grid x:Name="ShellRoot"
          Background="{DynamicResource Surface.Root}"
          UseLayoutRounding="True"
          SnapsToDevicePixels="True">
        <Grid.Resources>
            <Style x:Key="EquipmentInspectorSplitterStyle" TargetType="GridSplitter" BasedOn="{StaticResource {x:Type GridSplitter}}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Navigation.IsEquipmentWorkspace}" Value="True">
                        <Setter Property="Width" Value="Auto" />
                        <Setter Property="Background" Value="{DynamicResource Surface.Panel}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
                        <Setter Property="BorderThickness" Value="1,0,1,0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="GridSplitter">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </DataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Navigation.IsEquipmentWorkspace}" Value="True" />
                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Background" Value="{DynamicResource Border.Subtle}" />
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="SequenceInspectorSplitterStyle" TargetType="GridSplitter" BasedOn="{StaticResource EquipmentInspectorSplitterStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Navigation.IsSequenceWorkspace}" Value="True">
                        <Setter Property="Width" Value="Auto" />
                        <Setter Property="Background" Value="{DynamicResource Surface.Panel}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
                        <Setter Property="BorderThickness" Value="1,0,1,0" />
                        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GridSplitter">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
                        </ControlTemplate></Setter.Value></Setter>
                    </DataTrigger>
                    <MultiDataTrigger><MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Navigation.IsSequenceWorkspace}" Value="True" />
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                    </MultiDataTrigger.Conditions><Setter Property="Background" Value="{DynamicResource Border.Subtle}" /></MultiDataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="OpenedRecipeVisibility" TargetType="FrameworkElement">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Navigation.IsStartupChoiceVisible}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="0" />
            <RowDefinition Height="*" />
            <RowDefinition>
                <RowDefinition.Style>
                    <Style TargetType="RowDefinition">
                        <Setter Property="Height" Value="29" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Navigation.IsEquipmentWorkspace}" Value="True"><Setter Property="Height" Value="24" /></DataTrigger>
                            <DataTrigger Binding="{Binding Navigation.IsSequenceWorkspace}" Value="True"><Setter Property="Height" Value="24" /></DataTrigger>
                            <DataTrigger Binding="{Binding Navigation.IsInspectionWorkspace}" Value="True"><Setter Property="Height" Value="24" /></DataTrigger>
                            <DataTrigger Binding="{Binding Navigation.IsResultsWorkspace}" Value="True"><Setter Property="Height" Value="24" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </RowDefinition.Style>
            </RowDefinition>
        </Grid.RowDefinitions>

        <shell:StudioTitleBar Grid.Row="0" />

        <Grid x:Name="WorkspaceRowsGrid" Grid.Row="2" Style="{StaticResource OpenedRecipeVisibility}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="0" />
                <RowDefinition Height="2*" MinHeight="240" />
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="BottomWorkspaceRow">
                    <RowDefinition.Style><Style TargetType="RowDefinition">
                        <Setter Property="Height" Value="31" /><Setter Property="MinHeight" Value="31" /><Setter Property="MaxHeight" Value="31" />
                        <Style.Triggers><DataTrigger Binding="{Binding Navigation.IsEvidenceExpanded}" Value="True"><Setter Property="Height" Value="221" /><Setter Property="MinHeight" Value="221" /><Setter Property="MaxHeight" Value="221" /></DataTrigger></Style.Triggers>
                    </Style></RowDefinition.Style>
                </RowDefinition>
            </Grid.RowDefinitions>

            <Grid x:Name="CommonWorkspaceToolbar" MinHeight="44" Background="{DynamicResource Shell.WorkbarSurface}">
                <Grid.Resources>
                    <Style x:Key="RunWorkspaceTabStyle" TargetType="RadioButton" BasedOn="{StaticResource WorkspaceTabStyle}">
                        <Style.Resources>
                            <SolidColorBrush x:Key="Accent.Soft" Color="{StaticResource Color.Accent.Soft}" /><SolidColorBrush x:Key="Accent.Primary" Color="{StaticResource Color.Accent.Primary}" /><SolidColorBrush x:Key="Text.Secondary" Color="{StaticResource Color.Text.Secondary}" />
                            <SolidColorBrush x:Key="Surface.Hover" Color="{StaticResource Color.Surface.Hover}" />
                        </Style.Resources>
                        <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic" />
                        <Setter Property="Height" Value="43" /><Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="Normal" />
                        <Setter Property="ContentTemplate"><Setter.Value>
                            <DataTemplate><TextBlock Text="{Binding}" FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=RadioButton}}" FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=RadioButton}}" FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=RadioButton}}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /></DataTemplate>
                        </Setter.Value></Setter>
                        <Setter Property="Margin" Value="0,0,2,0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Navigation.IsCompactLayout}" Value="True"><Setter Property="Padding" Value="10,0" /><Setter Property="FontSize" Value="12.5" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Resources>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="WorkspaceTabsRegion" Height="44" VerticalAlignment="Bottom" Padding="10,0,0,0" Background="{DynamicResource Shell.WorkbarSurface}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,0,1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Navigation.IsCompactLayout}" Value="True">
                                    <Setter Property="Grid.ColumnSpan" Value="2" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal" KeyboardNavigation.TabNavigation="Once">
                        <RadioButton x:Name="EquipmentWorkspaceButton" GroupName="TaskWorkspace"
                                     Content="{loc:Loc Key=Workspace.Equipment}"
                                     IsChecked="{Binding Navigation.IsEquipmentWorkspace, Mode=TwoWay}"
                                     Style="{StaticResource RunWorkspaceTabStyle}" />
                        <RadioButton x:Name="ProcessWorkspaceButton" GroupName="TaskWorkspace"
                                     Content="{loc:Loc Key=Process.Workspace}"
                                     IsChecked="{Binding Navigation.IsProcessWorkspace, Mode=TwoWay}"
                                     Style="{StaticResource RunWorkspaceTabStyle}" />
                        <RadioButton x:Name="InspectionWorkspaceButton" GroupName="TaskWorkspace"
                                     Content="{loc:Loc Key=Camera.Workspace}"
                                     IsChecked="{Binding Navigation.IsInspectionWorkspace, Mode=TwoWay}"
                                     Style="{StaticResource RunWorkspaceTabStyle}" />
                        <RadioButton x:Name="SimulationWorkspaceButton" GroupName="TaskWorkspace"
                                     Content="{loc:Loc Key=Process.SimulationWorkspace}"
                                     IsChecked="{Binding Navigation.IsSimulationOverviewWorkspace, Mode=TwoWay}"
                                     Style="{StaticResource RunWorkspaceTabStyle}" />
                        <RadioButton x:Name="ExperimentWorkspaceButton" GroupName="TaskWorkspace"
                                     Content="{loc:Loc Key=Experiment.Workspace}"
                                     IsChecked="{Binding Navigation.IsExperimentWorkspace, Mode=TwoWay}"
                                     Style="{StaticResource RunWorkspaceTabStyle}" />
                        <RadioButton x:Name="ResultsWorkspaceButton" GroupName="TaskWorkspace" Margin="0"
                                     Content="{loc:Loc Key=RunHistory.AnalysisTitle}"
                                     IsChecked="{Binding Navigation.IsResultsWorkspace, Mode=TwoWay}"
                                     Style="{StaticResource RunWorkspaceTabStyle}" />
                    </StackPanel>
                </Border>
                <shell:GlobalCommandBarView x:Name="CommonCommandBar">
                    <shell:GlobalCommandBarView.Style>
                        <Style TargetType="{x:Type shell:GlobalCommandBarView}">
                            <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic" /><Setter Property="FontSize" Value="13" />
                            <Setter Property="Grid.Column" Value="1" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Navigation.IsCompactLayout}" Value="True">
                                    <Setter Property="FontSize" Value="12.5" />
                                    <Setter Property="Grid.Row" Value="1" />
                                    <Setter Property="Grid.Column" Value="0" />
                                    <Setter Property="Grid.ColumnSpan" Value="2" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </shell:GlobalCommandBarView.Style>
                </shell:GlobalCommandBarView>
            </Grid>

            <Grid x:Name="WorkspaceColumnsGrid" Grid.Row="2" Grid.IsSharedSizeScope="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" SharedSizeGroup="EquipmentFooter" />
                </Grid.RowDefinitions>
                <Grid.Resources>
                    <Style x:Key="WorkspaceInspectorStyle" TargetType="{x:Type inspector:RightToolRegionView}">
                        <Setter Property="Grid.Column" Value="2" />
                        <Setter Property="Grid.ColumnSpan" Value="1" />
                        <Setter Property="HorizontalAlignment" Value="Right" />
                        <Setter Property="VerticalAlignment" Value="Stretch" />
                        <Setter Property="Width" Value="405" />
                        <Setter Property="MinWidth" Value="300" />
                        <Setter Property="MaxWidth" Value="405" />
                        <Setter Property="MaxHeight" Value="580" />
                        <Setter Property="Margin" Value="16,68,16,10" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Navigation.IsCompactLayout}" Value="True">
                                <Setter Property="Width" Value="360" />
                                <Setter Property="Margin" Value="16,68,16,10" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Navigation.IsSimulationWorkspace}" Value="True">
                                <Setter Property="Margin" Value="16,138,16,10" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Navigation.IsEquipmentWorkspace}" Value="True">
                                <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic, Segoe UI" />
                                <Setter Property="FontSize" Value="13" />
                                <Setter Property="Grid.Column" Value="4" />
                                <Setter Property="Grid.RowSpan" Value="2" />
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                <Setter Property="Width" Value="Auto" />
                                <Setter Property="MinWidth" Value="0" />
                                <Setter Property="MaxWidth" Value="10000" />
                                <Setter Property="MaxHeight" Value="10000" />
                                <Setter Property="Margin" Value="0" />
                            </DataTrigger>
                            <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Navigation.IsEquipmentWorkspace}" Value="True" /><Condition Binding="{Binding Navigation.IsCompactLayout}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="FontSize" Value="12.5" /></MultiDataTrigger>
                            <DataTrigger Binding="{Binding Navigation.IsSequenceWorkspace}" Value="True">
                                <Setter Property="Grid.Column" Value="4" />
                                <Setter Property="Grid.RowSpan" Value="2" />
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                <Setter Property="Width" Value="Auto" />
                                <Setter Property="MinWidth" Value="0" />
                                <Setter Property="MaxWidth" Value="10000" />
                                <Setter Property="MaxHeight" Value="10000" />
                                <Setter Property="Margin" Value="0" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Navigation.IsInspectorOpen}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Navigation.IsInspectionWorkspace}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Navigation.IsResultsWorkspace}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Navigation.IsExperimentWorkspace}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LeftWorkspaceColumn" Width="240" MinWidth="185" MaxWidth="420" />
                    <ColumnDefinition x:Name="LeftWorkspaceSplitterColumn" Width="4" />
                    <ColumnDefinition x:Name="CenterWorkspaceColumn" Width="*" MinWidth="620" />
                    <ColumnDefinition x:Name="RightWorkspaceSplitterColumn" Width="0" />
                    <ColumnDefinition x:Name="RightWorkspaceColumn" Width="0" MinWidth="0" MaxWidth="0" />
                </Grid.ColumnDefinitions>

                <project:LeftToolRegionView x:Name="LeftToolRegionView" Grid.Column="0" Grid.RowSpan="2" />
                <GridSplitter x:Name="LeftWorkspaceSplitter" Grid.Column="1" Grid.RowSpan="2"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch" />
                <scene:SceneDocumentView x:Name="SceneDocumentView" Grid.Column="2" Grid.RowSpan="2" />
                <GridSplitter x:Name="RightWorkspaceSplitter" Grid.Column="3" Visibility="Collapsed"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                              Style="{StaticResource SequenceInspectorSplitterStyle}"
                              Focusable="True" KeyboardIncrement="16"
                              AutomationProperties.Name="{loc:Loc Key=Shell.Properties}" />
                <inspector:RightToolRegionView x:Name="RightToolRegionView"
                                               Panel.ZIndex="5"
                                               Style="{StaticResource WorkspaceInspectorStyle}" />
            </Grid>

            <GridSplitter x:Name="BottomWorkspaceSplitter" Grid.Row="3" Height="5"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                          Background="{DynamicResource Border.Default}"
                          Focusable="True" KeyboardIncrement="16"
                          AutomationProperties.Name="{loc:Loc Key=Diagnostics.Resize}"
                          >
                <GridSplitter.Style><Style TargetType="GridSplitter" BasedOn="{StaticResource {x:Type GridSplitter}}"><Setter Property="Visibility" Value="Collapsed" /></Style></GridSplitter.Style>
            </GridSplitter>
            <diagnostics:EventJournalView Grid.Row="4" />
        </Grid>

        <Border x:Name="StartupChoiceOverlay" Grid.Row="0" Grid.RowSpan="4" Panel.ZIndex="50"
                Background="{DynamicResource Surface.Root}" UseLayoutRounding="False"
                Visibility="{Binding Navigation.IsStartupChoiceVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border.Resources>
                <Style x:Key="StartupBodyTextStyle" TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="Segoe UI" />
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="FontWeight" Value="Normal" />
                    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
                    <Setter Property="LineHeight" Value="18.85" />
                    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
                    <Setter Property="TextWrapping" Value="Wrap" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DataContext.Navigation.IsCompactLayout, RelativeSource={RelativeSource AncestorType=shell:ShellWindow}}" Value="True">
                            <Setter Property="FontSize" Value="12.5" /><Setter Property="LineHeight" Value="18.125" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
                <Style x:Key="StartupTitleStyle" TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="Segoe UI" /><Setter Property="FontSize" Value="22" />
                    <Setter Property="FontWeight" Value="Bold" /><Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                    <Setter Property="LineHeight" Value="31.9" /><Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
                    <Setter Property="TextWrapping" Value="Wrap" />
                </Style>
                <Style x:Key="StartupHeadingStyle" TargetType="TextBlock" BasedOn="{StaticResource StartupTitleStyle}">
                    <Setter Property="FontSize" Value="16" /><Setter Property="LineHeight" Value="23.2" />
                </Style>
                <Style x:Key="StartupCardStyle" TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource Surface.Panel}" /><Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
                    <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="8" />
                </Style>
                <Style x:Key="StartupButtonStyle" TargetType="Button">
                    <Setter Property="FontFamily" Value="Segoe UI" /><Setter Property="FontSize" Value="13" />
                    <Setter Property="FontWeight" Value="Normal" /><Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                    <Setter Property="Background" Value="{DynamicResource Surface.Raised}" /><Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
                    <Setter Property="BorderThickness" Value="1" /><Setter Property="Height" Value="28.85" />
                    <Setter Property="Padding" Value="10,4" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                                        <TextBlock Text="{TemplateBinding Content}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource StartupBodyTextStyle}" />
                                    </Border>
                                    <Border x:Name="StartupButtonFocusCue" Margin="-4" CornerRadius="7" BorderBrush="{DynamicResource Accent.Primary}" BorderThickness="2" IsHitTestVisible="False" Visibility="Collapsed" />
                                </Grid>
                                <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="StartupButtonFocusCue" Property="Visibility" Value="Visible" /></Trigger></ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DataContext.Navigation.IsCompactLayout, RelativeSource={RelativeSource AncestorType=shell:ShellWindow}}" Value="True"><Setter Property="FontSize" Value="12.5" /><Setter Property="Height" Value="28.125" /></DataTrigger>
                        <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True" /><Condition Property="IsEnabled" Value="True" /></MultiTrigger.Conditions><Setter Property="Background" Value="{DynamicResource Surface.Hover}" /></MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource Text.Disabled}" /><Setter Property="Background" Value="{DynamicResource Surface.Disabled}" /><Setter Property="BorderBrush" Value="{DynamicResource Border.Disabled}" /></Trigger>
                    </Style.Triggers>
                </Style>
                <Style x:Key="StartupPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource StartupButtonStyle}">
                    <Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource Text.OnAccent}" />
                    <Setter Property="Background" Value="{DynamicResource Accent.Primary}" /><Setter Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
                    <Style.Triggers><Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource Accent.Pressed}" /></Trigger>
                        <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True" /><Condition Property="IsEnabled" Value="True" /></MultiTrigger.Conditions><Setter Property="Background" Value="{DynamicResource Accent.Hover}" /></MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource Text.Disabled}" /><Setter Property="Background" Value="{DynamicResource Accent.Soft}" /><Setter Property="BorderBrush" Value="{DynamicResource State.RunningBorder}" /></Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Resources>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <Border x:Name="StartupContent" MaxWidth="1040" Margin="0,72,0,40" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <StackPanel KeyboardNavigation.TabNavigation="Local">
                        <TextBlock x:Name="StartupTitleText" Style="{StaticResource StartupTitleStyle}"
                                   Text="{loc:Loc Key=RecipeEntry.Title}" TextWrapping="Wrap" />
                        <TextBlock x:Name="StartupHintText" Margin="0,6,0,18" Style="{StaticResource StartupBodyTextStyle}"
                                   Text="{loc:Loc Key=RecipeEntry.Hint}" TextWrapping="Wrap" />
                        <UniformGrid x:Name="StartupCardsPanel" Rows="1" Columns="3" Margin="-7,0,-7,0">
                            <Border MinHeight="160" Margin="7,0" Padding="16"
                                    CornerRadius="8" Style="{StaticResource StartupCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource StartupHeadingStyle}"
                                               Text="{loc:Loc Key=RecipeEntry.NewTitle}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="1" Margin="0,8,0,0" Style="{StaticResource StartupBodyTextStyle}"
                                               Text="{loc:Loc Key=RecipeEntry.NewDescription}" TextWrapping="Wrap" />
                                    <Button Grid.Row="2" x:Name="StartBlankLayoutButton" Margin="0,16,0,0"
                                            Command="{Binding NewProjectCommand}" Content="{loc:Loc Key=RecipeEntry.New}"
                                            AutomationProperties.Name="{loc:Loc Key=RecipeEntry.New}"
                                            AutomationProperties.HelpText="{loc:Loc Key=RecipeEntry.NewDescription}"
                                            Style="{StaticResource StartupPrimaryButtonStyle}" />
                                </Grid>
                            </Border>
                            <Border MinHeight="160" Margin="7,0" Padding="16"
                                    CornerRadius="8" Style="{StaticResource StartupCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource StartupHeadingStyle}"
                                               Text="{loc:Loc Key=RecipeEntry.InspectionTitle}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="1" Margin="0,8,0,0" Style="{StaticResource StartupBodyTextStyle}"
                                               Text="{loc:Loc Key=RecipeEntry.InspectionDescription}" TextWrapping="Wrap" />
                                    <Button Grid.Row="2" x:Name="StartSampleButton" Margin="0,16,0,0"
                                            Command="{Binding Navigation.OpenBundledSampleCommand}" Content="{loc:Loc Key=RecipeEntry.InspectionOpen}"
                                            AutomationProperties.Name="{loc:Loc Key=RecipeEntry.InspectionOpen}"
                                            AutomationProperties.HelpText="{loc:Loc Key=RecipeEntry.InspectionDescription}"
                                            Style="{StaticResource StartupButtonStyle}"
                                            ToolTip="{loc:Loc Key=RecipeEntry.InspectionDescription}" />
                                </Grid>
                            </Border>
                            <Border MinHeight="160" Margin="7,0" Padding="16"
                                    CornerRadius="8" Style="{StaticResource StartupCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource StartupHeadingStyle}"
                                               Text="{loc:Loc Key=RecipeEntry.LargeTitle}" TextWrapping="Wrap" />
                                    <StackPanel Grid.Row="1" Margin="0,8,0,0">
                                    <TextBlock Style="{StaticResource StartupBodyTextStyle}"
                                               Text="{loc:Loc Key=RecipeEntry.LargeDescription}" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,8,0,0" FontSize="12" LineHeight="17.4" Style="{StaticResource StartupBodyTextStyle}"
                                               Text="{loc:Loc Key=RecipeEntry.LargeHint}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Row="2" x:Name="StartLargeLayoutSampleButton" Margin="0,16,0,0"
                                            Command="{Binding Navigation.OpenLargeLayoutSampleCommand}"
                                            Content="{loc:Loc Key=RecipeEntry.LargeOpen}"
                                            AutomationProperties.Name="{loc:Loc Key=RecipeEntry.LargeOpen}"
                                            AutomationProperties.HelpText="{loc:Loc Key=RecipeEntry.LargeDescription}"
                                            Style="{StaticResource StartupButtonStyle}" />

                                </Grid>
                            </Border>
                        </UniformGrid>
                        <Border Margin="0,18,0,0" Padding="16" CornerRadius="8"
                                Style="{StaticResource StartupCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource StartupHeadingStyle}"
                                               Text="{loc:Loc Key=RecipeEntry.SavedTitle}" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,8,0,0" Style="{StaticResource StartupBodyTextStyle}"
                                               Text="{loc:Loc Key=RecipeEntry.OpenDescription}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button x:Name="OpenRecipeButton" Grid.Column="1" MinWidth="168"
                                        Margin="24,0,0,0" Command="{Binding OpenProjectCommand}"
                                        Content="{loc:Loc Key=RecipeEntry.Open}"
                                        AutomationProperties.Name="{loc:Loc Key=RecipeEntry.Open}"
                                        AutomationProperties.HelpText="{loc:Loc Key=RecipeEntry.OpenDescription}"
                                        Style="{StaticResource StartupButtonStyle}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Border>
        <project:SemiconductorRecipeGalleryView Grid.Row="2" Panel.ZIndex="100" />

        <project:EquipmentComponentLibraryDialogView Grid.Row="0" Grid.RowSpan="4" Panel.ZIndex="110" />
        <project:NewProjectNameDialogView Grid.Row="0" Grid.RowSpan="4" Panel.ZIndex="120" />

        <shell:StudioStatusBarView Grid.Row="3" />
        <project:RecipeConnectionWorkbenchView x:Name="RecipeConnectionsOverlay" Grid.Row="0" Grid.RowSpan="4" Panel.ZIndex="130" />
        <simulation:SimulationTestWorkspaceView x:Name="TestScenarioOverlay" Grid.Row="0" Grid.RowSpan="4" Panel.ZIndex="130" />
    </Grid>
</shell:MachineFluentWindow>
