<UserControl x:Class="OpenVisionLab.MachineStudio.View.Shell.FaultSimulationPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:OpenVisionLab.MachineStudio.Converter"
             xmlns:loc="clr-namespace:OpenVisionLab.MachineStudio.Localization"
             xmlns:shell="clr-namespace:OpenVisionLab.MachineStudio.View.Shell"
             UseLayoutRounding="False" Focusable="True" KeyDown="OnPopupKeyDown">
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Width" Value="390" /><Setter Property="KeyboardNavigation.TabNavigation" Value="Cycle" />
            <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic" /><Setter Property="FontSize" Value="13" /><Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            <Style.Triggers><DataTrigger Binding="{Binding IsEmbedded, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Width" Value="Auto" /><Setter Property="KeyboardNavigation.TabNavigation" Value="Continue" /></DataTrigger><DataTrigger Binding="{Binding (shell:ShellWindow.IsCompactLayout), RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="FontSize" Value="12.5" /></DataTrigger></Style.Triggers>
        </Style>
    </UserControl.Style>
    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <conv:KoreanWordWrappingConverter x:Key="EmbeddedFaultWordWrapping" />
        <loc:LocalizedFaultKindConverter x:Key="LocalizedFaultKindConverter" />
        <loc:LocalizedForcedValueConverter x:Key="LocalizedForcedValueConverter" />
        <Style x:Key="FaultTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic" /><Setter Property="FontSize" Value="{Binding FontSize, RelativeSource={RelativeSource AncestorType={x:Type shell:FaultSimulationPanelView}}}" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" /><Setter Property="LineHeight" Value="18.85" /><Setter Property="LineStackingStrategy" Value="BlockLineHeight" /><Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers><DataTrigger Binding="{Binding (shell:ShellWindow.IsCompactLayout), RelativeSource={RelativeSource AncestorType={x:Type shell:FaultSimulationPanelView}}}" Value="True"><Setter Property="LineHeight" Value="18.125" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="FaultLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource FaultTextStyle}">
            <Setter Property="FontSize" Value="12" /><Setter Property="LineHeight" Value="17.4" /><Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
            <Style.Triggers><DataTrigger Binding="{Binding (shell:ShellWindow.IsCompactLayout), RelativeSource={RelativeSource AncestorType={x:Type shell:FaultSimulationPanelView}}}" Value="True"><Setter Property="LineHeight" Value="17.4" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="FaultValueStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic" /><Setter Property="FontSize" Value="12" /><Setter Property="LineHeight" Value="17.4" /><Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" /><Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers><DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=ComboBox}}" Value="False"><Setter Property="Foreground" Value="{DynamicResource Text.Disabled}" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="FaultComboStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Style.Resources>
                <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="{StaticResource Color.Surface.Input}" /><SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{StaticResource Color.Surface.Input}" />
                <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="{StaticResource Color.Surface.Disabled}" /><SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="{StaticResource Color.Border.Disabled}" /><SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="{StaticResource Color.Text.Disabled}" />
                <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{StaticResource Color.Surface.Input}" /><SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{StaticResource Color.Border.Default}" />
            </Style.Resources>
            <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic" /><Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
            <Setter Property="Background" Value="{DynamicResource Surface.Input}" /><Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" /><Setter Property="Padding" Value="7,4" /><Setter Property="MinHeight" Value="28" /><Setter Property="Height" Value="Auto" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource Text.Disabled}" /></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="FaultButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic" /><Setter Property="FontSize" Value="{Binding FontSize, RelativeSource={RelativeSource AncestorType={x:Type shell:FaultSimulationPanelView}}}" />
            <Setter Property="Background" Value="{DynamicResource Surface.Raised}" /><Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            <Setter Property="Padding" Value="10,4" /><Setter Property="MinHeight" Value="28" /><Setter Property="Cursor" Value="Hand" /><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="FocusVisualStyle" Value="{StaticResource CommandFocusVisualStyle}" />
            <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" FontFamily="Segoe UI, Malgun Gothic" FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Style="{StaticResource FaultTextStyle}" TextWrapping="Wrap" /></DataTemplate></Setter.Value></Setter>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" /></Border></ControlTemplate></Setter.Value></Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Surface.Hover}" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource Surface.Pressed}" /></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Accent.Primary}" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{DynamicResource Surface.Disabled}" /><Setter Property="BorderBrush" Value="{DynamicResource Border.Disabled}" /><Setter Property="Foreground" Value="{DynamicResource Text.Disabled}" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FaultActiveItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="6,4" /><Setter Property="MinHeight" Value="26" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource CommandFocusVisualStyle}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="FaultItemBorder" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" /></Border></ControlTemplate></Setter.Value></Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Surface.Hover}" /></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource Accent.Soft}" /><Setter Property="BorderBrush" Value="{DynamicResource Accent.Primary}" /><Setter Property="Foreground" Value="{DynamicResource Accent.Primary}" /></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Accent.Primary}" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource Text.Disabled}" /></Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Border x:Name="FaultDrawerBorder" Background="{DynamicResource Surface.Panel}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1,0,0,0">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border x:Name="FaultDrawerHeader" Padding="14,10" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,0,1">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="FaultDrawerTitle" Text="{loc:Loc Key=Shell.FaultSimulation}" Style="{StaticResource FaultTextStyle}" FontWeight="Bold" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Padding="9,1" MinHeight="22" Background="{DynamicResource Surface.Tinted}" BorderBrush="{DynamicResource State.WarningBorder}" BorderThickness="1" CornerRadius="12"><TextBlock Text="{loc:Loc Key=Shell.FaultSessionBadge}" Style="{StaticResource FaultLabelStyle}" FontSize="11.5" LineHeight="16.675" Foreground="{DynamicResource State.Warning}" TextWrapping="NoWrap" /></Border>
                    <Button x:Name="CloseFaultDrawerButton" Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center" Content="×" Click="OnCloseClick" AutomationProperties.Name="{loc:Loc Key=Shell.CloseFaultSimulation}">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource FaultButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsEmbedded, RelativeSource={RelativeSource AncestorType={x:Type shell:FaultSimulationPanelView}}}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Button.Style>
                    </Button>
                </Grid>
            </Border>
            <ScrollViewer x:Name="FaultDrawerScroll" Grid.Row="1" Padding="14,12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Padding="9,7" Background="{DynamicResource State.InfoSurface}" BorderBrush="{DynamicResource State.Vision}" BorderThickness="3,0,0,0" CornerRadius="0,4,4,0"><TextBlock Text="{loc:Loc Key=Shell.FaultSessionHint}" Style="{StaticResource FaultLabelStyle}" /></Border>
                    <TextBlock Margin="0,12,0,0" Text="{loc:Loc Key=Shell.FaultRunModeHint}" Foreground="{DynamicResource State.Warning}" TextWrapping="Wrap">
                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource FaultLabelStyle}"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding IsEnabled}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <Border x:Name="EquipmentFaultCard" Margin="0,12,0,0" Padding="10" Background="{DynamicResource Surface.Panel}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="1" CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock Grid.ColumnSpan="2" Text="{loc:Loc Key=Shell.EquipmentFaults}" Style="{StaticResource FaultTextStyle}" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}" />
                            <StackPanel x:Name="FaultChoicePanel" IsEnabled="{Binding IsEnabled}">
                                <StackPanel.Style><Style TargetType="StackPanel">
                                    <Setter Property="Grid.Row" Value="1" /><Setter Property="Grid.ColumnSpan" Value="2" />
                                    <Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsEmbedded, RelativeSource={RelativeSource AncestorType={x:Type shell:FaultSimulationPanelView}}}" Value="True" />
                                        <Condition Binding="{Binding (shell:ShellWindow.IsCompactLayout), RelativeSource={RelativeSource AncestorType=Window}}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                        <Setter Property="Grid.ColumnSpan" Value="1" />
                                    </MultiDataTrigger></Style.Triggers>
                                </Style></StackPanel.Style>
                                <TextBlock Text="{loc:Loc Key=Inspector.FaultType}" Style="{StaticResource FaultLabelStyle}" Margin="0,8,0,3" />
                                <ComboBox x:Name="GlobalFaultKindComboBox" Style="{StaticResource FaultComboStyle}" ItemsSource="{Binding AvailableKinds}" SelectedItem="{Binding SelectedKind, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Style="{StaticResource FaultValueStyle}"><TextBlock.Text><MultiBinding Converter="{StaticResource LocalizedFaultKindConverter}"><Binding /><Binding Path="Revision" Source="{x:Static loc:LocExtension.RevisionSource}" /></MultiBinding></TextBlock.Text></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                                <TextBlock Text="{loc:Loc Key=Inspector.RuntimeTarget}" Style="{StaticResource FaultLabelStyle}" Margin="0,9,0,3" />
                                <ComboBox x:Name="GlobalFaultTargetComboBox" Style="{StaticResource FaultComboStyle}" ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget, Mode=TwoWay}" IsEnabled="{Binding HasTargets}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" Style="{StaticResource FaultValueStyle}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                                <TextBlock x:Name="GlobalFaultTargetHelpText" Text="{Binding TargetSelectionHelpText}" Margin="0,4,0,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource FaultLabelStyle}"><Style.Triggers><DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                <StackPanel Margin="0,9,0,0" Visibility="{Binding RequiresForcedValue, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{loc:Loc Key=Inspector.ForcedValue}" Style="{StaticResource FaultLabelStyle}" Margin="0,0,0,3" />
                                    <ComboBox x:Name="GlobalFaultForcedValueComboBox" Style="{StaticResource FaultComboStyle}" ItemsSource="{Binding ForcedValueOptions}" SelectedItem="{Binding SelectedForcedValue, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Style="{StaticResource FaultValueStyle}"><TextBlock.Text><MultiBinding Converter="{StaticResource LocalizedForcedValueConverter}"><Binding /><Binding Path="Revision" Source="{x:Static loc:LocExtension.RevisionSource}" /></MultiBinding></TextBlock.Text></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                                </StackPanel>
                                <Button x:Name="GlobalInjectFaultButton" Style="{StaticResource FaultButtonStyle}" Content="{loc:Loc Key=Inspector.InjectFault}" Command="{Binding InjectCommand}" Margin="0,12,0,0" />
                            </StackPanel>
                            <StackPanel x:Name="FaultActivePanel">
                                <StackPanel.Style><Style TargetType="StackPanel">
                                    <Setter Property="Grid.Row" Value="2" /><Setter Property="Grid.ColumnSpan" Value="2" />
                                    <Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsEmbedded, RelativeSource={RelativeSource AncestorType={x:Type shell:FaultSimulationPanelView}}}" Value="True" />
                                        <Condition Binding="{Binding (shell:ShellWindow.IsCompactLayout), RelativeSource={RelativeSource AncestorType=Window}}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                        <Setter Property="Grid.ColumnSpan" Value="1" /><Setter Property="Grid.Row" Value="1" /><Setter Property="Grid.Column" Value="1" /><Setter Property="Margin" Value="12,0,0,0" />
                                    </MultiDataTrigger></Style.Triggers>
                                </Style></StackPanel.Style>
                            <TextBlock Text="{Binding ActiveFaultCountText}" Style="{StaticResource FaultLabelStyle}" Margin="0,12,0,6" FontWeight="SemiBold" Foreground="{DynamicResource State.Warning}" />
                            <ListBox x:Name="GlobalActiveFaultList" ItemsSource="{Binding ActiveFaults}" SelectedItem="{Binding SelectedActiveFault, Mode=TwoWay}" ItemContainerStyle="{StaticResource FaultActiveItemStyle}" MaxHeight="180" Background="{DynamicResource Surface.Input}" BorderBrush="{DynamicResource Border.Default}" Foreground="{DynamicResource Text.Secondary}">
                                <ListBox.Style><Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}"><Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEmbedded, RelativeSource={RelativeSource AncestorType={x:Type shell:FaultSimulationPanelView}}}" Value="True"><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" /></DataTrigger>
                                </Style.Triggers></Style></ListBox.Style>
                            <ListBox.ItemTemplate><DataTemplate><StackPanel>
                                <TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                                    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource FaultLabelStyle}"><Setter Property="Text" Value="{Binding DisplayText}" />
                                        <Style.Triggers><DataTrigger Binding="{Binding IsEmbedded, RelativeSource={RelativeSource AncestorType={x:Type shell:FaultSimulationPanelView}}}" Value="True"><Setter Property="Text" Value="{Binding DisplayText, Converter={StaticResource EmbeddedFaultWordWrapping}}" /></DataTrigger></Style.Triggers>
                                    </Style></TextBlock.Style>
                                </TextBlock>
                                <TextBlock x:Name="FaultActiveTargetId" Text="{Binding TargetId}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Margin="0,2,0,0" AutomationProperties.Name="{loc:Loc Key=Inspector.RuntimeTarget}">
                                    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource FaultLabelStyle}"><Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers><DataTrigger Binding="{Binding IsEmbedded, RelativeSource={RelativeSource AncestorType={x:Type shell:FaultSimulationPanelView}}}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                    </Style></TextBlock.Style>
                                </TextBlock>
                            </StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
                            <Button x:Name="GlobalClearFaultButton" Style="{StaticResource FaultButtonStyle}" Content="{loc:Loc Key=Inspector.ClearSelected}" Command="{Binding ClearSelectedCommand}" Margin="0,8,0,0" />
                            <TextBlock x:Name="GlobalFaultOperationStatus" Text="{Binding OperationStatusText}" Style="{StaticResource FaultLabelStyle}" Margin="0,10,0,0" />
                            <TextBlock x:Name="FaultCommandPending" Text="{loc:Loc Key=R40.Fault.CommandPending}" Margin="0,6,0,0" Foreground="{DynamicResource State.Warning}">
                                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource FaultLabelStyle}"><Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsEmbedded, RelativeSource={RelativeSource AncestorType={x:Type shell:FaultSimulationPanelView}}}" Value="True" />
                                        <Condition Binding="{Binding IsOperationPending}" Value="True" />
                                    </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers>
                                </Style></TextBlock.Style>
                            </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Button x:Name="GlobalClearAllFaultsButton" Content="{loc:Loc Key=Shell.ClearAllFaultSimulation}" Command="{Binding ClearAllCommand}" Margin="0,12,0,0">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource FaultButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsEmbedded, RelativeSource={RelativeSource AncestorType={x:Type shell:FaultSimulationPanelView}}}" Value="True"><Setter Property="HorizontalAlignment" Value="Right" /></DataTrigger></Style.Triggers></Style></Button.Style>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
