<UserControl x:Class="OpenVisionLab.MachineStudio.View.Shell.GlobalCommandBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:loc="clr-namespace:OpenVisionLab.MachineStudio.Localization">
    <Border Background="{DynamicResource Surface.Root}"
            BorderBrush="{DynamicResource Border.Default}"
            BorderThickness="0,1,0,1">
        <Grid Margin="6,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRunMode}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Button Command="{Binding SemiconductorRecipes.OpenCommand}"
                        AutomationProperties.Name="{loc:Loc Key=Gallery.Open}"
                        Style="{StaticResource QuietCommandButtonStyle}"
                        ToolTip="{loc:Loc Key=Gallery.OpenTooltip}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="FolderOpen24" Foreground="{DynamicResource Accent.Primary}" />
                        <TextBlock Style="{StaticResource CompactCommandLabelStyle}" Text="{loc:Loc Key=Gallery.CommandLabel}" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding NewProjectCommand}"
                        AutomationProperties.Name="{loc:Loc Key=Shell.New}"
                        Style="{StaticResource QuietCommandButtonStyle}"
                        ToolTip="{loc:Loc Key=Shell.NewTooltip}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Add24" Foreground="{DynamicResource Accent.Primary}" />
                        <TextBlock Style="{StaticResource CompactCommandLabelStyle}" Text="{loc:Loc Key=Shell.New}" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding OpenProjectCommand}"
                        AutomationProperties.Name="{loc:Loc Key=Shell.Open}"
                        Style="{StaticResource QuietCommandButtonStyle}"
                        ToolTip="{loc:Loc Key=Shell.OpenTooltip}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="FolderOpen24" Foreground="{DynamicResource Accent.Primary}" />
                        <TextBlock Style="{StaticResource CompactCommandLabelStyle}" Text="{loc:Loc Key=Shell.Open}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <Border Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="3"
                    Background="{DynamicResource Surface.Raised}"
                    BorderBrush="{DynamicResource Border.Default}"
                    BorderThickness="1"
                    CornerRadius="5">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="{loc:Loc Key=Workspace.EndAndEdit}"
                                 AutomationProperties.Name="{loc:Loc Key=Workspace.EndAndEdit}"
                                 ToolTip="{loc:Loc Key=Workspace.EndAndEditHint}"
                                 GroupName="WorkspaceMode"
                                 IsChecked="{Binding IsDesignMode, Mode=TwoWay}"
                                 Style="{StaticResource WorkspaceModeRadioStyle}" />
                    <RadioButton Content="{loc:Loc Key=Shell.Run}"
                                 GroupName="WorkspaceMode"
                                 IsChecked="{Binding IsRunMode, Mode=TwoWay}"
                                 Style="{StaticResource WorkspaceModeRadioStyle}" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <Button Command="{Binding RunCommand}"
                        AutomationProperties.Name="{loc:Loc Key=Shell.SimulationOn}"
                        Style="{StaticResource SimulationOnCommandButtonStyle}"
                        ToolTip="{loc:Loc Key=Shell.SimulationOnTooltip}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Play24" Foreground="{DynamicResource State.Running}" />
                        <TextBlock Style="{StaticResource CompactCommandLabelStyle}" Text="{loc:Loc Key=Shell.SimulationOn}" />
                    </StackPanel>
                </Button>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                <Button Command="{Binding PauseCommand}"
                        AutomationProperties.Name="{loc:Loc Key=Shell.Pause}"
                        Style="{StaticResource QuietCommandButtonStyle}"
                        ToolTip="{loc:Loc Key=Shell.PauseTooltip}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Pause24" Foreground="{DynamicResource State.Paused}" />
                        <TextBlock Style="{StaticResource CompactCommandLabelStyle}" Text="{loc:Loc Key=Shell.Pause}" />
                    </StackPanel>
                </Button>
                <Button x:Name="SemanticSequenceStepButton"
                        Command="{Binding RuntimeDebugger.SemanticStepCommand}"
                        AutomationProperties.Name="{loc:Loc Key=Debugger.NextSequenceStep}"
                        Style="{StaticResource PrimaryCommandButtonStyle}"
                        ToolTipService.ShowOnDisabled="True"
                        ToolTip="{loc:Loc Key=Debugger.NextSequenceStepTooltip}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Next24" />
                        <TextBlock Margin="6,0,0,0" Text="{loc:Loc Key=Debugger.NextSequenceStep}" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding AbortSequenceCommand}"
                        AutomationProperties.Name="{loc:Loc Key=Shell.AbortSequence}"
                        MinWidth="76"
                        Style="{StaticResource QuietCommandButtonStyle}"
                        ToolTip="{loc:Loc Key=Shell.AbortSequenceTooltip}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Dismiss24" Foreground="{DynamicResource State.Fault}" />
                        <TextBlock Style="{StaticResource CompactCommandLabelStyle}"
                                   Text="{loc:Loc Key=Shell.AbortSequence}" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding RetrySequenceCommand}"
                        AutomationProperties.Name="{loc:Loc Key=Shell.RetrySequence}"
                        MinWidth="76"
                        Style="{StaticResource QuietCommandButtonStyle}"
                        ToolTip="{loc:Loc Key=Shell.RetrySequenceTooltip}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowSync24" Foreground="{DynamicResource State.Warning}" />
                        <TextBlock Style="{StaticResource CompactCommandLabelStyle}"
                                   Text="{loc:Loc Key=Shell.RetrySequence}" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding ResetCommand}"
                        AutomationProperties.Name="{loc:Loc Key=Shell.Reset}"
                        Style="{StaticResource QuietCommandButtonStyle}"
                        ToolTip="{loc:Loc Key=Shell.ResetTooltip}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowReset24" Foreground="{DynamicResource State.Warning}" />
                        <TextBlock Style="{StaticResource CompactCommandLabelStyle}" Text="{loc:Loc Key=Shell.Reset}" />
                    </StackPanel>
                </Button>
                <Button MinWidth="58"
                        AutomationProperties.Name="{loc:Loc Key=Shell.CycleStart}"
                        Command="{Binding CycleStartCommand}"
                        ToolTip="{loc:Loc Key=Shell.CycleStartTooltip}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryCommandButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasEmbeddedSequence}" Value="True" />
                                        <Condition Binding="{Binding HasCycleStartInput}" Value="True" />
                                        <Condition Binding="{Binding IsRunMode}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Play24" Foreground="{DynamicResource State.Running}" />
                        <TextBlock Style="{StaticResource CompactCommandLabelStyle}" Text="{loc:Loc Key=Shell.CycleStart}" />
                    </StackPanel>
                </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
