<UserControl x:Class="OpenVisionLab.MachineStudio.View.Shell.GlobalCommandBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:OpenVisionLab.MachineStudio.View.Shell"
             xmlns:conv="clr-namespace:OpenVisionLab.MachineStudio.Converter"
             xmlns:loc="clr-namespace:OpenVisionLab.MachineStudio.Localization" UseLayoutRounding="False">
    <UserControl.Resources>
        <SolidColorBrush x:Key="Text.Primary" Color="{StaticResource Color.Text.Primary}" /><SolidColorBrush x:Key="Text.Secondary" Color="{StaticResource Color.Text.Secondary}" />
        <SolidColorBrush x:Key="Accent.Primary" Color="{StaticResource Color.Accent.Primary}" /><SolidColorBrush x:Key="Text.OnAccent" Color="{StaticResource Color.Text.OnAccent}" />
        <SolidColorBrush x:Key="Border.Default" Color="{StaticResource Color.Border.Subtle}" />
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
            <Setter Property="FontSize" Value="{Binding FontSize, RelativeSource={RelativeSource AncestorType={x:Type shell:GlobalCommandBarView}}}" />
            <Setter Property="LineHeight" Value="18.85" /><Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Style.Triggers><DataTrigger Binding="{Binding Navigation.IsCompactLayout}" Value="True"><Setter Property="LineHeight" Value="18.125" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="RunToolbarLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Margin" Value="4,0,0,0" /><Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers><DataTrigger Binding="{Binding Navigation.IsCompactLayout}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="RunToolbarButton" TargetType="Button" BasedOn="{StaticResource GlobalCommandButtonStyle}">
            <Style.Resources>
                <SolidColorBrush x:Key="Surface.Hover" Color="{StaticResource Color.Surface.Hover}" /><SolidColorBrush x:Key="Surface.Selected" Color="{StaticResource Color.Surface.Pressed}" />
            </Style.Resources>
            <Setter Property="Height" Value="28.85" /><Setter Property="MinHeight" Value="28" /><Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="10,0" /><Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic" /><Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Background" Value="{DynamicResource Surface.Raised}" /><Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RunButtonBorder" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RunButtonBorder" Property="Background" Value="{DynamicResource Surface.Hover}" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="RunButtonBorder" Property="Background" Value="{DynamicResource Surface.Selected}" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="RunButtonBorder" Property="BorderBrush" Value="{DynamicResource Accent.Primary}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource Text.Disabled}" /><Setter TargetName="RunButtonBorder" Property="Background" Value="{DynamicResource Surface.Disabled}" /><Setter TargetName="RunButtonBorder" Property="BorderBrush" Value="{DynamicResource Border.Disabled}" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
            <Style.Triggers><DataTrigger Binding="{Binding Navigation.IsCompactLayout}" Value="True"><Setter Property="Height" Value="28.125" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="RunStartButtonStyle" TargetType="Button" BasedOn="{StaticResource RunToolbarButton}">
            <Setter Property="Margin" Value="0" /><Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Text.OnAccent}" /><Setter Property="Background" Value="{DynamicResource Accent.Primary}" /><Setter Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="StartBorder" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5,0,0,5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="StartBorder" Property="Background" Value="{DynamicResource Accent.Hover}" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="StartBorder" Property="Background" Value="{DynamicResource Accent.Pressed}" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="StartBorder" Property="BorderBrush" Value="{DynamicResource Accent.Hover}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource Text.Disabled}" /><Setter TargetName="StartBorder" Property="Background" Value="{DynamicResource Accent.Soft}" /><Setter TargetName="StartBorder" Property="BorderBrush" Value="{DynamicResource State.RunningBorder}" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
            <Style.Triggers><DataTrigger Binding="{Binding RuntimeDebugger.IsPausedForContinuation}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="RunSummaryChipStyle" TargetType="ToggleButton" BasedOn="{StaticResource ShellChipToggleStyle}">
            <Setter Property="Height" Value="22" /><Setter Property="Padding" Value="9,1" /><Setter Property="MaxWidth" Value="300" />
            <Setter Property="Background" Value="{DynamicResource Surface.Tinted}" /><Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" /><Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="SummaryBorder" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SummaryBorder" Property="Background" Value="{DynamicResource Surface.Hover}" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="SummaryBorder" Property="Background" Value="{DynamicResource Surface.Pressed}" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SummaryBorder" Property="BorderBrush" Value="{DynamicResource Accent.Primary}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource Text.Disabled}" /><Setter TargetName="SummaryBorder" Property="Background" Value="{DynamicResource Surface.Disabled}" /><Setter TargetName="SummaryBorder" Property="BorderBrush" Value="{DynamicResource Border.Disabled}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
            <Style.Triggers><DataTrigger Binding="{Binding Navigation.IsCompactLayout}" Value="True"><Setter Property="MaxWidth" Value="190" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="RunOptionsSplitStyle" TargetType="ToggleButton" BasedOn="{StaticResource ShellChipToggleStyle}">
            <Setter Property="Height" Value="28.85" /><Setter Property="Width" Value="25" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Padding" Value="6,0" /><Setter Property="BorderThickness" Value="0,1,1,1" />
            <Setter Property="Foreground" Value="{DynamicResource Text.OnAccent}" /><Setter Property="Background" Value="{DynamicResource Accent.Primary}" /><Setter Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="OptionsBorder" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0,5,5,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="OptionsBorder" Property="Background" Value="{DynamicResource Accent.Hover}" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="OptionsBorder" Property="Background" Value="{DynamicResource Accent.Pressed}" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="OptionsBorder" Property="BorderBrush" Value="{DynamicResource Accent.Hover}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource Text.Disabled}" /><Setter TargetName="OptionsBorder" Property="Background" Value="{DynamicResource Accent.Soft}" /><Setter TargetName="OptionsBorder" Property="BorderBrush" Value="{DynamicResource State.RunningBorder}" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
            <Style.Triggers><DataTrigger Binding="{Binding Navigation.IsCompactLayout}" Value="True"><Setter Property="Height" Value="28.125" /></DataTrigger></Style.Triggers>
        </Style>
        <DataTemplate x:Key="RunOptionCaptionTemplate">
            <TextBlock Text="{Binding}" FontFamily="Segoe UI, Malgun Gothic" LineStackingStrategy="BlockLineHeight"
                       FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                       FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentControl}}">
                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="LineHeight" Value="18.85" /><Style.Triggers>
                    <DataTrigger Binding="{Binding DataContext.Navigation.IsCompactLayout, RelativeSource={RelativeSource AncestorType=ContentControl}}" Value="True"><Setter Property="LineHeight" Value="18.125" /></DataTrigger>
                </Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
        </DataTemplate>
        <Style x:Key="RunOptionActionStyle" TargetType="Button" BasedOn="{StaticResource RunToolbarButton}">
            <Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="Bold" /><Setter Property="ContentTemplate" Value="{StaticResource RunOptionCaptionTemplate}" />
            <Style.Triggers><DataTrigger Binding="{Binding Navigation.IsCompactLayout}" Value="True"><Setter Property="FontSize" Value="12.5" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="RunOptionModeStyle" TargetType="RadioButton" BasedOn="{StaticResource WorkspaceModeRadioStyle}">
            <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic" /><Setter Property="FontSize" Value="13" /><Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            <Setter Property="ContentTemplate" Value="{StaticResource RunOptionCaptionTemplate}" />
            <Style.Triggers><DataTrigger Binding="{Binding Navigation.IsCompactLayout}" Value="True"><Setter Property="FontSize" Value="12.5" /></DataTrigger></Style.Triggers>
        </Style>
        <DataTemplate x:Key="SpeedChoiceCaptionTemplate">
            <TextBlock Text="{Binding}" FontFamily="Segoe UI, Malgun Gothic" LineStackingStrategy="BlockLineHeight"
                       FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=MenuItem}}"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}}">
                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="LineHeight" Value="18.85" /><Style.Triggers>
                    <DataTrigger Binding="{Binding DataContext.Navigation.IsCompactLayout, RelativeSource={RelativeSource AncestorType=MenuItem}}" Value="True"><Setter Property="LineHeight" Value="18.125" /></DataTrigger>
                </Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
        </DataTemplate>
        <Style x:Key="SpeedChoiceStyle" TargetType="MenuItem" BasedOn="{StaticResource MachineSubmenuItemStyle}">
            <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic" /><Setter Property="FontSize" Value="13" /><Setter Property="HeaderTemplate" Value="{StaticResource SpeedChoiceCaptionTemplate}" />
            <Style.Triggers><DataTrigger Binding="{Binding Navigation.IsCompactLayout}" Value="True"><Setter Property="FontSize" Value="12.5" /></DataTrigger></Style.Triggers>
        </Style>
    </UserControl.Resources>
    <UserControl.Style><Style TargetType="UserControl"><Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic" /><Setter Property="FontSize" Value="13" /><Style.Triggers><DataTrigger Binding="{Binding Navigation.IsCompactLayout}" Value="True"><Setter Property="FontSize" Value="12.5" /></DataTrigger></Style.Triggers></Style></UserControl.Style>
    <Border Height="44" Background="{DynamicResource Shell.WorkbarSurface}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="0,0,0,1">
        <StackPanel x:Name="CommonRunCommands" Margin="8,0,10,0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Border Height="22" Padding="9,1" Margin="0,0,6,0" Background="{DynamicResource Surface.Tinted}" BorderBrush="{DynamicResource Accent.Primary}" BorderThickness="1" CornerRadius="12">
                <TextBlock x:Name="CommonRunStateText" Text="{Binding RunStateCaptionText}" VerticalAlignment="Center" FontSize="11.5" LineHeight="16.675" Foreground="{DynamicResource Accent.Primary}" />
            </Border>
            <Border Height="22" Padding="9,1" Margin="0,0,6,0" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="12"
                    Visibility="{Binding HasRecipeExecutionStatus, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock x:Name="CommonRecipeStateText" Text="{Binding RecipeExecutionStatusText}" VerticalAlignment="Center" FontSize="11.5" LineHeight="16.675" />
            </Border>
            <ToggleButton x:Name="RunTargetDetailsButton" Margin="0,0,6,0" Style="{StaticResource RunSummaryChipStyle}" AutomationProperties.Name="{loc:Loc Key=Shell.RunTargetDetails}">
                <TextBlock x:Name="CommonRunSummaryText" Text="{Binding RunTargetSummaryText}" TextTrimming="CharacterEllipsis" FontSize="11.5" LineHeight="16.675" />
            </ToggleButton>
            <Popup x:Name="RunTargetDetailsPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=RunTargetDetailsButton}" VerticalOffset="8"
                   IsOpen="{Binding IsChecked, ElementName=RunTargetDetailsButton, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True" Opened="OnPopupOpened" Closed="OnPopupClosed">
                <Border Focusable="True" KeyDown="OnPopupKeyDown" KeyboardNavigation.TabNavigation="Cycle" Width="390" Padding="12" Background="{DynamicResource Surface.Panel}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="5">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Key=Shell.RunTargetDetails}" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ScrollViewer x:Name="CommonRunTargetScrollViewer" MaxHeight="240" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock x:Name="CommonRunSummaryDetailsText" Text="{Binding RunTargetSummaryText}" TextWrapping="Wrap" Foreground="{DynamicResource Text.Primary}" Margin="0,0,0,8" />
                                <TextBlock x:Name="CommonRunTargetText" Text="{Binding RunTargetText}" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}" />
                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Popup>
            <StackPanel Orientation="Horizontal" Margin="0,0,6,0">
                <Button x:Name="RunStartButton" Style="{StaticResource RunStartButtonStyle}" Command="{Binding RunCommand}" AutomationProperties.Name="{loc:Loc Key=Shell.SimulationOn}" ToolTip="{loc:Loc Key=Shell.SimulationOnTooltip}">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="▶" /><TextBlock x:Name="RunStartCaption" Margin="4,0,0,0" Text="{loc:Loc Key=Shell.SimulationOn}" FontWeight="SemiBold" /></StackPanel>
                </Button>
                <ToggleButton x:Name="RunOptionsButton" Margin="0" Style="{StaticResource RunOptionsSplitStyle}" AutomationProperties.Name="{loc:Loc Key=Shell.RunOptions}"><TextBlock Text="▾" /></ToggleButton>
                <Popup x:Name="RunOptionsPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=RunOptionsButton}" HorizontalOffset="-285" VerticalOffset="4" IsOpen="{Binding IsChecked, ElementName=RunOptionsButton, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True" Opened="OnPopupOpened" Closed="OnPopupClosed">
                    <Border Focusable="True" KeyDown="OnPopupKeyDown" KeyboardNavigation.TabNavigation="Cycle" Width="310" Padding="5" Background="{DynamicResource Surface.Panel}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="6">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Key=Shell.RunOptions}" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}" Margin="0,0,0,8" />
                            <RadioButton Content="{loc:Loc Key=Workspace.EndAndEdit}" GroupName="WorkspaceMode" IsChecked="{Binding IsDesignMode, Mode=TwoWay}" Style="{StaticResource RunOptionModeStyle}" ToolTip="{loc:Loc Key=Workspace.EndAndEditHint}" />
                            <RadioButton Margin="0,6,0,8" Content="{loc:Loc Key=Shell.Run}" GroupName="WorkspaceMode" IsChecked="{Binding IsRunMode, Mode=TwoWay}" Style="{StaticResource RunOptionModeStyle}" />
                            <Button Content="{loc:Loc Key=Shell.RetrySequence}" Command="{Binding RetrySequenceCommand}" Style="{StaticResource RunOptionActionStyle}" Margin="0,0,0,6" />
                            <Button Content="{loc:Loc Key=Shell.CycleStart}" Command="{Binding CycleStartCommand}" Style="{StaticResource RunOptionActionStyle}" Margin="0,0,0,6" />
                            <Button Content="{loc:Loc Key=Shell.SingleTick}" Command="{Binding StepCommand}" Style="{StaticResource RunOptionActionStyle}" />
                        </StackPanel>
                    </Border>
                </Popup>
            </StackPanel>
            <Button x:Name="RunPauseButton">
                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource RunToolbarButton}">
                    <Setter Property="Command" Value="{Binding PauseCommand}" /><Setter Property="AutomationProperties.Name" Value="{loc:Loc Key=Shell.Pause}" /><Setter Property="ToolTip" Value="{loc:Loc Key=Shell.PauseTooltip}" />
                    <Style.Triggers><DataTrigger Binding="{Binding RuntimeDebugger.IsPausedForContinuation}" Value="True"><Setter Property="Command" Value="{Binding RunCommand}" /><Setter Property="AutomationProperties.Name" Value="{loc:Loc Key=Shell.ContinueRun}" /><Setter Property="ToolTip" Value="{loc:Loc Key=Shell.ContinueRunTooltip}" /></DataTrigger></Style.Triggers>
                </Style></Button.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe UI Symbol"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Text" Value="⏸" /><Style.Triggers><DataTrigger Binding="{Binding RuntimeDebugger.IsPausedForContinuation}" Value="True"><Setter Property="Text" Value="▶" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                    <TextBlock x:Name="RunPauseCaption"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource RunToolbarLabel}"><Setter Property="Text" Value="{loc:Loc Key=Shell.Pause}" /><Style.Triggers><DataTrigger Binding="{Binding RuntimeDebugger.IsPausedForContinuation}" Value="True"><Setter Property="Text" Value="{loc:Loc Key=R24.Resume}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                </StackPanel>
            </Button>
            <Button x:Name="SemanticSequenceStepButton" Command="{Binding RuntimeDebugger.SemanticStepCommand}" AutomationProperties.Name="{loc:Loc Key=Debugger.NextSequenceStep}" Style="{StaticResource RunToolbarButton}" ToolTipService.ShowOnDisabled="True" ToolTip="{loc:Loc Key=Debugger.NextSequenceStepTooltip}">
                <StackPanel Orientation="Horizontal"><TextBlock Text="⏭" FontFamily="Segoe UI Symbol" /><TextBlock x:Name="RunStepCaption" Style="{StaticResource RunToolbarLabel}" Text="{loc:Loc Key=R24.OneStep}" /></StackPanel>
            </Button>
            <Button x:Name="RunStopButton" Command="{Binding AbortSequenceCommand}" AutomationProperties.Name="{loc:Loc Key=Shell.AbortSequence}" Style="{StaticResource RunToolbarButton}" ToolTip="{loc:Loc Key=Shell.AbortSequenceTooltip}">
                <StackPanel Orientation="Horizontal"><TextBlock x:Name="RunStopGlyph" Text="■" /><TextBlock x:Name="RunStopCaption" Style="{StaticResource RunToolbarLabel}" Text="{loc:Loc Key=R24.Stop}" /></StackPanel>
            </Button>
            <Button x:Name="RunResetButton" Command="{Binding ResetCommand}" AutomationProperties.Name="{loc:Loc Key=Shell.Reset}" Style="{StaticResource RunToolbarButton}" ToolTip="{loc:Loc Key=Shell.ResetTooltip}">
                <StackPanel Orientation="Horizontal"><TextBlock Text="⟲" /><TextBlock x:Name="RunResetCaption" Style="{StaticResource RunToolbarLabel}" Text="{loc:Loc Key=Shell.Reset}" /></StackPanel>
            </Button>
            <Border Width="52" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="4">
                <Border.Style><Style TargetType="Border"><Setter Property="Height" Value="29" /><Style.Triggers><DataTrigger Binding="{Binding Navigation.IsCompactLayout}" Value="True"><Setter Property="Height" Value="28" /></DataTrigger></Style.Triggers></Style></Border.Style>
                <Menu Background="{DynamicResource Surface.Input}" Padding="0">
                    <MenuItem x:Name="SimulationSpeedMenu" Foreground="{DynamicResource Text.Primary}" Width="50" Height="26" Padding="7,0" Style="{StaticResource MachineTopMenuItemStyle}" AutomationProperties.Name="{loc:Loc Key=Shell.Speed}">
                        <MenuItem.Header><Grid Width="36"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="SimulationSpeedCaption" Text="{Binding SimulationSpeedText}" />
                            <Path x:Name="SimulationSpeedArrow" Grid.Column="1" Data="M 1,1 L 4,4 L 7,1" Width="8" Height="5" Stretch="None" StrokeThickness="2" StrokeLineJoin="Round" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,2,-3,0" />
                        </Grid></MenuItem.Header>
                        <MenuItem Header="×1" Command="{Binding SetSimulationSpeedCommand}" CommandParameter="1" Style="{StaticResource SpeedChoiceStyle}" />
                        <MenuItem Header="×2" Command="{Binding SetSimulationSpeedCommand}" CommandParameter="2" Style="{StaticResource SpeedChoiceStyle}" />
                        <MenuItem Header="×4" Command="{Binding SetSimulationSpeedCommand}" CommandParameter="4" Style="{StaticResource SpeedChoiceStyle}" />
                        <MenuItem Header="×8" Command="{Binding SetSimulationSpeedCommand}" CommandParameter="8" Style="{StaticResource SpeedChoiceStyle}" />
                    </MenuItem>
                </Menu>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
