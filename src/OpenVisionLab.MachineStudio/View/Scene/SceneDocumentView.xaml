                                <TextBlock Foreground="{DynamicResource Text.Secondary}" Text="{Binding CommissioningBaselineStatusText}" TextWrapping="Wrap" />
                                <WrapPanel Margin="0,7,0,0">
                                    <Button x:Name="AcceptCommissioningBaselineButton" Margin="0,0,6,4" Command="{Binding AcceptCommissioningBaselineCommand}" Content="{loc:Loc Key=Axis.RecipeAcceptBaseline}" Style="{StaticResource GlobalCommandButtonStyle}" AutomationProperties.Name="{loc:Loc Key=Axis.RecipeAcceptBaseline}" />
                                    <Button Margin="0,0,6,4" Command="{Binding ClearCommissioningBaselineCommand}" Content="{loc:Loc Key=Axis.RecipeClearBaseline}" Style="{StaticResource GlobalCommandButtonStyle}" />
                                    <Button x:Name="NavigateCommissioningMismatchButton" Margin="0,0,6,4" Command="{Binding NavigateToCommissioningMismatchCommand}" Content="{loc:Loc Key=Axis.RecipeGoToMismatch}" Style="{StaticResource GlobalCommandButtonStyle}" />
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </TabItem>
                    <TabItem Header="{loc:Loc RunHistory.ViewTitle}">
                        <diagnostics:RunHistoryView DataContext="{Binding RunHistory}" />
                    </TabItem>
                </TabControl>
            </Border>
        </TabItem>
        <TabItem Header="{loc:Loc Key=Experiment.Workspace}" Visibility="Collapsed">
            <simulation:ExperimentWorkspaceView />
        </TabItem>
    </TabControl>
</UserControl>
