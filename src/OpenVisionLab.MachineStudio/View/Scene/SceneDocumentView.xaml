                    <TextBlock Margin="0,0,14,0" Foreground="{DynamicResource Text.Secondary}" Text="{loc:Loc Key=Scene.LegendSensor}" />
                    <TextBlock Margin="0,0,14,0" Foreground="{DynamicResource Text.Secondary}" Text="{loc:Loc Key=Scene.LegendCamera}" />
                    <TextBlock Foreground="{DynamicResource Text.Secondary}" Text="{loc:Loc Key=Scene.LegendUnit}" />
                </WrapPanel>

                </Grid>

                <Border Panel.ZIndex="10"
                        Background="{DynamicResource Scene.Background}">
