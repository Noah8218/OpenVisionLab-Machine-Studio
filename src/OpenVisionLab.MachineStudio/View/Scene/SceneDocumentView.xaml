                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource State.Vision}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDryRunPlaybackWaferHandlerFault}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource State.Fault}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
