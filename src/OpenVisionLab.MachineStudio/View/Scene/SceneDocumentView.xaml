                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryCommandButtonStyle}">
                                    <Setter Property="Content" Value="{loc:Loc Key=Equipment.AddPartButton}" />
                                    <Setter Property="AutomationProperties.Name" Value="{loc:Loc Key=Equipment.AddPartButton}" />
