                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{loc:Loc Key=Scene.EmptyHint}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Navigation.IsEquipmentWorkspace}" Value="True">
                                            <Setter Property="Text" Value="{loc:Loc Key=Scene.EmptyEquipmentHint}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
