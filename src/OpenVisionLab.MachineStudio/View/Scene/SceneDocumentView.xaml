  <UserControl x:Class="OpenVisionLab.MachineStudio.View.Scene.SceneDocumentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behavior="clr-namespace:OpenVisionLab.MachineStudio.Behavior"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:scene="clr-namespace:OpenVisionLab.MachineStudio.View.Scene"
             xmlns:project="clr-namespace:OpenVisionLab.MachineStudio.View.Project"
             xmlns:sequence="clr-namespace:OpenVisionLab.MachineStudio.View.Sequence"
             xmlns:simulation="clr-namespace:OpenVisionLab.MachineStudio.View.Simulation"
             xmlns:diagnostics="clr-namespace:OpenVisionLab.MachineStudio.View.Diagnostics"
             xmlns:converter="clr-namespace:OpenVisionLab.MachineStudio.Converter"
             xmlns:loc="clr-namespace:OpenVisionLab.MachineStudio.Localization">
    <UserControl.Resources>
        <SolidColorBrush x:Key="EquipmentScene.ToolsSurface" Color="{StaticResource Color.Surface.Overlay}" />
        <SolidColorBrush x:Key="EquipmentScene.ControlSurface" Color="{StaticResource Color.Surface.Raised}" />
        <SolidColorBrush x:Key="EquipmentScene.Line" Color="{StaticResource Color.Border.Subtle}" />
        <SolidColorBrush x:Key="EquipmentScene.ControlLine" Color="{StaticResource Color.Border.Default}" />
        <SolidColorBrush x:Key="EquipmentScene.Text" Color="{StaticResource Color.Text.Primary}" />
        <SolidColorBrush x:Key="EquipmentScene.Accent" Color="{StaticResource Color.Accent.Primary}" />
        <SolidColorBrush x:Key="EquipmentScene.Selected" Color="{StaticResource Color.Accent.Soft}" />
        <RadialGradientBrush x:Key="EquipmentScene.Background" Center="0.5,0.45" GradientOrigin="0.5,0.45" RadiusX="0.7071" RadiusY="0.7778">
            <GradientStop Color="{StaticResource Color.Scene.GradientCenter}" Offset="0" /><GradientStop Color="{StaticResource Color.Scene.GradientEdge}" Offset="0.72" />
        </RadialGradientBrush>
        <converter:SceneSelectionWidthConverter x:Key="EquipmentSelectionWidthConverter" />
        <Style x:Key="EquipmentSceneButtonStyle" TargetType="Button" BasedOn="{StaticResource GlobalCommandButtonStyle}">
            <Setter Property="MinWidth" Value="38" />
            <Setter Property="Margin" Value="0,0,4,4" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Navigation.IsEquipmentWorkspace}" Value="True">
                    <Setter Property="Background" Value="{StaticResource EquipmentScene.ControlSurface}" />
                    <Setter Property="BorderBrush" Value="{StaticResource EquipmentScene.ControlLine}" />
                    <Setter Property="Foreground" Value="{StaticResource EquipmentScene.Text}" />
                    <Setter Property="FontWeight" Value="Normal" />
                    <Setter Property="Height" Value="24" />
                    <Setter Property="MinHeight" Value="24" />
                    <Setter Property="MinWidth" Value="26" />
                    <Setter Property="Padding" Value="8,0" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Margin" Value="0,0,4,0" />
                    <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic, Segoe UI" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="SceneButtonBorder" Padding="{TemplateBinding Padding}" CornerRadius="5"
                                        Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SceneButtonBorder" Property="Background" Value="{DynamicResource Surface.Hover}" /></Trigger>
                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="SceneButtonBorder" Property="Background" Value="{DynamicResource Surface.Pressed}" /></Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SceneButtonBorder" Property="BorderBrush" Value="{StaticResource EquipmentScene.Accent}" /></Trigger>
                                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource Text.Disabled}" /></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="ContentTemplate">
                        <Setter.Value><DataTemplate><TextBlock Text="{Binding}" FontFamily="Segoe UI, Malgun Gothic, Segoe UI" FontSize="12" LineHeight="17.4" LineStackingStrategy="BlockLineHeight" /></DataTemplate></Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EquipmentSceneRadioStyle" TargetType="RadioButton" BasedOn="{StaticResource WorkspaceModeRadioStyle}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,0,4,4" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Navigation.IsEquipmentWorkspace}" Value="True">
                    <Setter Property="Height" Value="24" />
                    <Setter Property="MinWidth" Value="48" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="FontWeight" Value="Normal" />
                    <Setter Property="Margin" Value="0,0,4,0" />
                    <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic, Segoe UI" />
                    <Setter Property="ContentTemplate">
                        <Setter.Value><DataTemplate><TextBlock Text="{Binding}" FontFamily="Segoe UI, Malgun Gothic, Segoe UI" FontSize="12" LineHeight="17.4" LineStackingStrategy="BlockLineHeight" /></DataTemplate></Setter.Value>
                    </Setter>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="ViewButtonBorder" Padding="8,0" CornerRadius="5"
                                        Background="{StaticResource EquipmentScene.ControlSurface}" BorderBrush="{StaticResource EquipmentScene.ControlLine}" BorderThickness="1">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ViewButtonBorder" Property="Background" Value="{DynamicResource Surface.Hover}" />
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="ViewButtonBorder" Property="Background" Value="{StaticResource EquipmentScene.Selected}" />
                                        <Setter TargetName="ViewButtonBorder" Property="BorderBrush" Value="{StaticResource EquipmentScene.Accent}" />
                                        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="ViewButtonBorder" Property="Background" Value="{DynamicResource Surface.Pressed}" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="ViewButtonBorder" Property="BorderBrush" Value="{StaticResource EquipmentScene.Accent}" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource Text.Disabled}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <TabControl SelectedIndex="{Binding Navigation.SelectedDocumentContentIndex, Mode=OneWay}">
        <TabControl.Template>
            <ControlTemplate TargetType="TabControl">
                <Grid KeyboardNavigation.TabNavigation="Local">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TabPanel IsItemsHost="True" Visibility="Collapsed" />
                    <ContentPresenter Grid.Row="1" x:Name="PART_SelectedContentHost"
                                      ContentSource="SelectedContent" />
                </Grid>
            </ControlTemplate>
        </TabControl.Template>
        <TabItem Header="{loc:Loc Key=Shell.MachineLayout}" Visibility="Collapsed">
            <TabControl x:Name="ExecutionWorkspaceTabs"
                        SelectedIndex="{Binding Navigation.SelectedExecutionTabIndex, Mode=TwoWay}">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TabPanel IsItemsHost="True" Visibility="Collapsed" />
                            <ContentPresenter Grid.Row="1" x:Name="PART_SelectedContentHost"
                                              ContentSource="SelectedContent" />
                        </Grid>
                    </ControlTemplate>
                </TabControl.Template>
                <TabItem Header="{loc:Loc Key=Scene.EquipmentView}">
            <Border><Border.Style><Style TargetType="Border" BasedOn="{StaticResource PanelSurfaceStyle}"><Style.Triggers><DataTrigger Binding="{Binding Navigation.IsEquipmentWorkspace}" Value="True"><Setter Property="BorderThickness" Value="0" /><Setter Property="CornerRadius" Value="0" /></DataTrigger></Style.Triggers></Style></Border.Style>
                <Grid x:Name="SceneWorkspaceLayout">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="SimulationDiagnosticsColumn"><ColumnDefinition.Style><Style TargetType="ColumnDefinition"><Setter Property="Width" Value="0" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Navigation.IsSimulationOverviewWorkspace}" Value="True" /><Condition Binding="{Binding Navigation.IsSimulationDiagnosticsExpanded}" Value="True" /><Condition Binding="{Binding Navigation.IsCompactLayout}" Value="False" /><Condition Binding="{Binding Navigation.IsInspectorOpen}" Value="False" /></MultiDataTrigger.Conditions><Setter Property="Width" Value="360" /></MultiDataTrigger></Style.Triggers></Style></ColumnDefinition.Style></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="220" />
                <RowDefinition Height="Auto" SharedSizeGroup="EquipmentFooter" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="EquipmentTaskHeader" Grid.Row="0" Padding="14,10" Background="{DynamicResource Surface.Panel}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,0,1"
                    Visibility="{Binding Navigation.IsEquipmentWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="{loc:Loc Key=R24.Flow.Equipment}" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock x:Name="EquipmentTaskContext" Margin="0,4,0,0" Text="{Binding EquipmentSelectionStatusText}" ToolTip="{Binding EquipmentSelectionStatusText}" Foreground="{DynamicResource Text.Secondary}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button x:Name="EquipmentOpenProcessButton" Grid.Column="1" VerticalAlignment="Center" Command="{Binding Navigation.OpenSequenceEditorCommand}"
                            Content="{loc:Loc Key=R40.EditProcess}" AutomationProperties.Name="{loc:Loc Key=R40.EditProcess}" Style="{StaticResource GlobalCommandButtonStyle}" />
                </Grid>
            </Border>

            <Border x:Name="EquipmentSceneHeader">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource PanelHeaderStyle}">
                        <Setter Property="Grid.Row" Value="0" />
                        <Setter Property="Height" Value="Auto" />
                        <Setter Property="MinHeight" Value="55" />
                        <Setter Property="Padding" Value="14,8" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Navigation.IsEquipmentWorkspace}" Value="True">
                                <Setter Property="Grid.Row" Value="1" />
                                <Setter Property="Panel.ZIndex" Value="2" />
                                <Setter Property="VerticalAlignment" Value="Top" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Padding" Value="10,8,8,8" />
                                <Setter Property="Background" Value="{x:Null}" />
                                <Setter Property="BorderThickness" Value="0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel x:Name="EquipmentSceneHeading" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,12,0" HorizontalAlignment="Left"
                                MaxWidth="{Binding ActualWidth, ElementName=SceneViewport, Converter={StaticResource EquipmentSelectionWidthConverter}}"
                                IsHitTestVisible="False"
                                Visibility="{Binding Navigation.IsEquipmentWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock x:Name="EquipmentSceneTitle" FontFamily="Segoe UI, Malgun Gothic, Segoe UI" FontSize="14" FontWeight="Bold" LineHeight="20.3" LineStackingStrategy="BlockLineHeight"
                                   Text="{Binding Layout.EquipmentSceneTitleText}" TextWrapping="Wrap" Foreground="{StaticResource EquipmentScene.Text}" />
                        <TextBlock x:Name="EquipmentSceneHint" FontFamily="Segoe UI, Malgun Gothic, Segoe UI" FontSize="11.5" LineHeight="16.675" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{loc:Loc Key=R40.SelectionToolHint}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Layout.IsPlacementMoveTool}" Value="True"><Setter Property="Text" Value="{loc:Loc Key=R40.MoveToolHint}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding IsSceneEditable}" Value="False">
                                            <Setter Property="Text" Value="{loc:Loc Key=Scene.EquipmentRunHint}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ManualEquipment.IsManualControlAdmissionLocked}" Value="True">
                                            <Setter Property="Text" Value="{loc:Loc Key=Equipment.ManualHint.Busy}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <Grid x:Name="EquipmentSceneTools">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Grid.Column" Value="1" />
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="VerticalAlignment" Value="Top" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Navigation.IsEquipmentWorkspace}" Value="True">
                                        <Setter Property="Grid.Column" Value="0" />
                                        <Setter Property="HorizontalAlignment" Value="Left" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Navigation.IsSimulationWorkspace}" Value="True">
                                        <Setter Property="Grid.Row" Value="1" />
                                        <Setter Property="Grid.Column" Value="0" />
                                        <Setter Property="Grid.ColumnSpan" Value="2" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Border Padding="3" CornerRadius="6" Background="{DynamicResource Surface.Root}"
                                BorderBrush="{DynamicResource Border.Default}" BorderThickness="1"
                                Visibility="Collapsed">
                            <StackPanel x:Name="EquipmentSupplementalActions" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                <ToggleButton x:Name="EquipmentSlotsToggleButton" Height="24" Padding="8,0" Margin="0,0,4,0"
                                              IsChecked="False" Content="{loc:Loc Key=Scene.UnitSlots}" AutomationProperties.Name="{loc:Loc Key=Scene.UnitSlots}"
                                              ToolTip="{loc:Loc Key=Scene.UnitSlotsHint}" Style="{StaticResource ShellChipToggleStyle}" />
                                <Menu VerticalAlignment="Center" Padding="0" Background="{DynamicResource Surface.Root}" IsMainMenu="False">
                                    <MenuItem x:Name="EquipmentMoreActionsButton" Header="⋯" AutomationProperties.Name="{loc:Loc Key=Scene.MoreActions}"
                                              ToolTip="{loc:Loc Key=Scene.MoreActions}" Style="{StaticResource MachineTopMenuItemStyle}">
                                        <MenuItem IsEnabled="{Binding IsSceneEditable}" Header="{loc:Loc Key=Equipment.SettingsAction}" Command="{Binding OpenEquipmentPropertiesCommand}" Style="{StaticResource MachineSubmenuItemStyle}" />
                                        <MenuItem IsEnabled="{Binding IsSceneEditable}" Header="{loc:Loc Key=Equipment.BulkMoveButton}" Command="{Binding OpenBulkMoveEditorCommand}" Style="{StaticResource MachineSubmenuItemStyle}" />
                                        <MenuItem IsEnabled="{Binding IsSceneEditable}" Header="{loc:Loc Key=Shell.Delete}" Command="{Binding DeleteLayoutComponentCommand}" Style="{StaticResource MachineSubmenuItemStyle}" />
                                        <Separator />
                                        <MenuItem x:Name="EquipmentMaterialSettingsButton" IsEnabled="{Binding IsSceneEditable}" Header="{loc:Loc Key=MaterialFlow.SettingsTitle}" Command="{Binding MaterialFlowSettings.OpenCommand}"
                                                  AutomationProperties.Name="{loc:Loc Key=MaterialFlow.OpenSettings}" Style="{StaticResource MachineSubmenuItemStyle}" />
                                        <MenuItem x:Name="EquipmentInspectorToggleButton" Command="{Binding Navigation.ToggleInspectorCommand}">
                                            <MenuItem.Style>
                                                <Style TargetType="MenuItem" BasedOn="{StaticResource MachineSubmenuItemStyle}">
                                                    <Setter Property="Header" Value="{loc:Loc Key=Shell.Properties}" /><Setter Property="AutomationProperties.Name" Value="{loc:Loc Key=Shell.Properties}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Navigation.IsInspectorOpen}" Value="True">
                                                            <Setter Property="Header" Value="{loc:Loc Key=Shell.CloseProperties}" /><Setter Property="AutomationProperties.Name" Value="{loc:Loc Key=Shell.CloseProperties}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </MenuItem.Style>
                                        </MenuItem>
                                    </MenuItem>
                                </Menu>
                            </StackPanel>
                        </Border>
                    <Border x:Name="EquipmentViewToolbarGroup">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Grid.Row" Value="0" />
                                <Setter Property="Grid.Column" Value="1" />
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Margin" Value="8,0,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Navigation.IsEquipmentWorkspace}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource EquipmentScene.ToolsSurface}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource EquipmentScene.Line}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="CornerRadius" Value="6" />
                                        <Setter Property="Padding" Value="3" />
                                        <Setter Property="Grid.Column" Value="0" />
                                        <Setter Property="HorizontalAlignment" Value="Left" />
                                        <Setter Property="Margin" Value="0,0,0,6" />
                                        <Setter Property="VerticalAlignment" Value="Top" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Navigation.IsSimulationWorkspace}" Value="True">
                                        <Setter Property="Grid.Row" Value="1" />
                                        <Setter Property="Grid.Column" Value="0" />
                                        <Setter Property="Grid.ColumnSpan" Value="2" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <WrapPanel x:Name="EquipmentViewToolbar">
                        <StackPanel Orientation="Horizontal" Visibility="{Binding Navigation.IsEquipmentWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <RadioButton x:Name="EquipmentSelectionToolButton" GroupName="EquipmentPlacementTool" IsChecked="{Binding Layout.IsPlacementSelectionTool, Mode=TwoWay}"
                                         Content="{loc:Loc Key=R40.SelectTool}" AutomationProperties.Name="{loc:Loc Key=R40.SelectTool}" Style="{StaticResource EquipmentSceneRadioStyle}" />
                            <RadioButton x:Name="EquipmentMoveToolButton" GroupName="EquipmentPlacementTool" IsChecked="{Binding Layout.IsPlacementMoveTool, Mode=TwoWay}"
                                         IsEnabled="{Binding IsSceneEditable}" Content="{loc:Loc Key=R40.MoveTool}" AutomationProperties.Name="{loc:Loc Key=R40.MoveTool}" Style="{StaticResource EquipmentSceneRadioStyle}" />
                            <Border Width="1" Margin="3,2,7,2" Background="{DynamicResource Border.Subtle}" />
                        </StackPanel>

                        <RadioButton x:Name="SceneObliqueRadioButton"
                                     AutomationProperties.Name="{loc:Loc Key=Scene.ViewOblique}"
                                     Command="{Binding Layout.ShowObliqueViewCommand}"
                                     Content="{loc:Loc Key=Scene.ViewOblique}"
                                     GroupName="EquipmentSceneView"
                                     IsChecked="{Binding Layout.IsObliqueView, Mode=OneWay}"
                                     ToolTip="{loc:Loc Key=Scene.ToggleViewTooltip}">
                            <RadioButton.Style>
                                <Style TargetType="RadioButton" BasedOn="{StaticResource EquipmentSceneRadioStyle}">
                                    <Setter Property="MinWidth" Value="88" />
                                    <Style.Triggers><DataTrigger Binding="{Binding Navigation.IsEquipmentWorkspace}" Value="True"><Setter Property="MinWidth" Value="48" /></DataTrigger></Style.Triggers>
                                </Style>
                            </RadioButton.Style>
                        </RadioButton>
                        <RadioButton x:Name="ScenePlanRadioButton"
                                     AutomationProperties.Name="{loc:Loc Key=Scene.ViewPlan}"
                                     Command="{Binding Layout.ShowTopViewCommand}"
                                     Content="{loc:Loc Key=Scene.ViewPlan}"
                                     GroupName="EquipmentSceneView"
                                     IsChecked="{Binding Layout.IsTopView, Mode=OneWay}"
                                     Style="{StaticResource EquipmentSceneRadioStyle}"
                                     ToolTip="{loc:Loc Key=Scene.ToggleViewTooltip}" />
                        <Button x:Name="SceneZoomOutButton"

                                AutomationProperties.Name="{loc:Loc Key=Scene.ZoomOut}"
                                Content="−"
                                Style="{StaticResource EquipmentSceneButtonStyle}"
                                ToolTip="{loc:Loc Key=Scene.ZoomOutTooltip}">
                            <b:Interaction.Behaviors>
                                <behavior:ZoomSceneViewportBehavior SceneViewport="{Binding ElementName=SceneViewport}" WheelDelta="-120" />
                            </b:Interaction.Behaviors>
                        </Button>
                        <Button x:Name="FitLayoutButton"
                                Padding="8,0"
                                AutomationProperties.Name="{loc:Loc Key=Scene.FitLayout}"

                                ToolTip="{loc:Loc Key=Scene.FitLayoutTooltip}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource EquipmentSceneButtonStyle}">
                                    <Setter Property="Content" Value="{loc:Loc Key=Scene.FitLayout}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Navigation.IsEquipmentWorkspace}" Value="True">
                                            <Setter Property="Content" Value="{loc:Loc Key=Scene.FitShort}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <b:Interaction.Behaviors>
                                <behavior:FitSceneViewportBehavior SceneViewport="{Binding ElementName=SceneViewport}" />
                            </b:Interaction.Behaviors>
                        </Button>
                        <Button x:Name="SceneZoomInButton"

                                AutomationProperties.Name="{loc:Loc Key=Scene.ZoomIn}"
                                Content="+"
                                ToolTip="{loc:Loc Key=Scene.ZoomInTooltip}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource EquipmentSceneButtonStyle}">
                                    <Style.Triggers><DataTrigger Binding="{Binding Navigation.IsEquipmentWorkspace}" Value="True"><Setter Property="Margin" Value="0" /></DataTrigger></Style.Triggers>
                                </Style>
                            </Button.Style>
                            <b:Interaction.Behaviors>
                                <behavior:ZoomSceneViewportBehavior SceneViewport="{Binding ElementName=SceneViewport}" WheelDelta="120" />
                            </b:Interaction.Behaviors>
                        </Button>
                        </WrapPanel>
                    </Border>
                    </Grid>

                    <StackPanel Grid.Row="0" Grid.Column="1"
                                Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="8,4">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Navigation.IsSimulationWorkspace}" Value="True" />
                                            <Condition Binding="{Binding Navigation.SelectedExecutionTabIndex}" Value="0" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Margin="0,0,8,0" VerticalAlignment="Center"
                                   Text="{loc:Loc Key=Properties.Unit}" />
                        <Grid Width="252" MinHeight="34" Margin="0,0,8,0">
                            <ComboBox x:Name="SimulationUnitSelector"
                                      AutomationProperties.Name="{loc:Loc Key=Equipment.SimulationUnitsTitle}"
                                      ItemsSource="{Binding Layout.UnitOverviewItems}"
                                      SelectedValue="{Binding Layout.ActiveUnitId, Mode=OneWay}"
                                      SelectedValuePath="UnitId"
                                      Style="{StaticResource {x:Type ComboBox}}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding UnitName}" />
                                            <Run Text=" / " />
                                            <Run Text="{Binding UnitId}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                                <b:Interaction.Behaviors>
                                    <behavior:ComboBoxSelectionCommandBehavior Command="{Binding ShowEquipmentUnitCommand}" />
                                </b:Interaction.Behaviors>
                            </ComboBox>
                            <TextBlock x:Name="SimulationUnitScopePlaceholder"
                                       Margin="12,0,30,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       IsHitTestVisible="False"
                                       Focusable="False"
                                       Text="{loc:Loc Key=Equipment.SimulationUnitSelectPlaceholder}"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Layout.ActiveUnitId}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Button x:Name="SimulationWholeMachineButton"
                                Command="{Binding ShowEquipmentOverviewCommand}"
                                Content="{loc:Loc Key=Equipment.OverviewButton}"
                                AutomationProperties.Name="{loc:Loc Key=Equipment.OverviewButton}"
                                Style="{StaticResource GlobalCommandButtonStyle}" />
                        <Button x:Name="SimulationInspectorToggleButton"
                                Margin="8,0,0,0"
                                Command="{Binding Navigation.ToggleInspectorCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource GlobalCommandButtonStyle}">
                                    <Setter Property="Content" Value="{loc:Loc Key=Shell.Properties}" />
                                    <Setter Property="AutomationProperties.Name" Value="{loc:Loc Key=Shell.Properties}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Navigation.IsInspectorOpen}" Value="True">
                                            <Setter Property="Content" Value="×" />
                                            <Setter Property="AutomationProperties.Name" Value="{loc:Loc Key=Shell.CloseProperties}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Navigation.IsEquipmentWorkspace}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
