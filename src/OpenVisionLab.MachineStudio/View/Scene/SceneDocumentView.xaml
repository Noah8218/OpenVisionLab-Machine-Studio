                                <Setter Property="IsPlacementMoveEnabled" Value="True" />
                                <Style.Triggers><DataTrigger Binding="{Binding Navigation.IsEquipmentWorkspace}" Value="True"><Setter Property="IsPlacementMoveEnabled" Value="{Binding Layout.IsPlacementMoveTool}" /></DataTrigger></Style.Triggers>
                            </Style>
