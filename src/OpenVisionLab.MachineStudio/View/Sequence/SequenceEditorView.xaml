<UserControl x:Class="OpenVisionLab.MachineStudio.View.Sequence.SequenceEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:OpenVisionLab.MachineStudio.Localization"
             xmlns:local="clr-namespace:OpenVisionLab.MachineStudio.View.Sequence"
             MinWidth="520"
             MinHeight="320" UseLayoutRounding="False">
    <UserControl.Resources>
        <Style x:Key="ProcessViewTabStyle" TargetType="RadioButton" BasedOn="{StaticResource WorkspaceTabStyle}">
            <Setter Property="Height" Value="28" /><Setter Property="MinHeight" Value="28" />
        </Style>
        <Style x:Key="R24ListButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic" /><Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="{DynamicResource Surface.Raised}" /><Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" /><Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            <Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="10,4" /><Setter Property="MinHeight" Value="28" /><Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="ListButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="5">
                    <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ListButtonBorder" Property="Background" Value="{DynamicResource Surface.Hover}" /></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="ListButtonBorder" Property="Background" Value="{DynamicResource Surface.Pressed}" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ListButtonBorder" Property="BorderBrush" Value="{DynamicResource Accent.Primary}" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
            <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" FontFamily="Segoe UI, Malgun Gothic" FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Button}}" LineStackingStrategy="BlockLineHeight"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="LineHeight" Value="18.85" /><Style.Triggers><DataTrigger Binding="{Binding DataContext.Navigation.IsCompactLayout, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="LineHeight" Value="18.125" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate></Setter.Value></Setter>
            <Style.Triggers><DataTrigger Binding="{Binding DataContext.Navigation.IsCompactLayout, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="FontSize" Value="12.5" /></DataTrigger></Style.Triggers>
        </Style>

        <Style x:Key="SequenceCellTextStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="3,2" />
            <Style.Triggers><DataTrigger Binding="{Binding IsR24Docked, RelativeSource={RelativeSource AncestorType={x:Type local:SequenceEditorView}}}" Value="True"><Setter Property="Padding" Value="0" /><Setter Property="VerticalAlignment" Value="Top" /><Setter Property="LineHeight" Value="17.4" /><Setter Property="Foreground" Value="{DynamicResource Text.Primary}" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="SequenceNameCellTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SequenceCellTextStyle}">
            <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
            <Style.Triggers><DataTrigger Binding="{Binding IsSearchMatch}" Value="True"><Setter Property="FontWeight" Value="Bold" /><Setter Property="Foreground" Value="{DynamicResource Accent.Primary}" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="R24MutedCellTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SequenceCellTextStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsR24Docked, RelativeSource={RelativeSource AncestorType={x:Type local:SequenceEditorView}}}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" /></DataTrigger></Style.Triggers></Style>
        <Style x:Key="R24OrderCellTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SequenceCellTextStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsR24Docked, RelativeSource={RelativeSource AncestorType={x:Type local:SequenceEditorView}}}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" /></DataTrigger></Style.Triggers></Style>
        <Style x:Key="R24NextCellTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SequenceCellTextStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsR24Docked, RelativeSource={RelativeSource AncestorType={x:Type local:SequenceEditorView}}}" Value="True"><Setter Property="FontSize" Value="11.5" /><Setter Property="LineHeight" Value="16.675" /></DataTrigger></Style.Triggers></Style>
        <Style x:Key="SequenceLegacyHeaderTextStyle" TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsR24Docked, RelativeSource={RelativeSource AncestorType={x:Type local:SequenceEditorView}}}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style>
        <Style x:Key="SequenceDockedHeaderTextStyle" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic" /><Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource Text.Primary}" /><Setter Property="LineHeight" Value="17.4" /><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsR24Docked, RelativeSource={RelativeSource AncestorType={x:Type local:SequenceEditorView}}}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
        <DataTemplate x:Key="SequenceNameHeaderTemplate"><Grid><TextBlock Text="{Binding}" Style="{StaticResource SequenceLegacyHeaderTextStyle}" /><TextBlock Text="{loc:Loc Key=Sequence.Name}" Style="{StaticResource SequenceDockedHeaderTextStyle}" /></Grid></DataTemplate>
        <DataTemplate x:Key="SequenceValueHeaderTemplate"><Grid><TextBlock Text="{Binding}" Style="{StaticResource SequenceLegacyHeaderTextStyle}" /><TextBlock Text="{loc:Loc Key=R24.StepListValue}" Style="{StaticResource SequenceDockedHeaderTextStyle}" /></Grid></DataTemplate>
        <DataTemplate x:Key="SequenceStatusHeaderTemplate"><Grid><TextBlock Text="{Binding}" Style="{StaticResource SequenceLegacyHeaderTextStyle}" /><TextBlock Text="{loc:Loc Key=R24.StepListStatus}" Style="{StaticResource SequenceDockedHeaderTextStyle}" /></Grid></DataTemplate>
        <loc:LocalizedSequenceNameConverter x:Key="LocalizedSequenceNameConverter" />
        <loc:LocalizedSequenceActionConverter x:Key="LocalizedSequenceActionConverter" />
        <loc:LocalizedSequenceTemplateNameConverter x:Key="LocalizedSequenceTemplateNameConverter" />
        <Style x:Key="SequenceFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
            <Setter Property="FontSize" Value="10.5" />
        </Style>
        <Style x:Key="SequenceTextBoxStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="{StaticResource Density.InspectorFieldHeight}" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="SequenceComboBoxStyle"
               TargetType="ComboBox"
               BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="{StaticResource Density.InspectorFieldHeight}" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Border>
        <Border.Style><Style TargetType="Border" BasedOn="{StaticResource PanelSurfaceStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsR24Docked, RelativeSource={RelativeSource AncestorType={x:Type local:SequenceEditorView}}}" Value="True"><Setter Property="BorderThickness" Value="0" /><Setter Property="CornerRadius" Value="0" /><Setter Property="Background" Value="{DynamicResource Surface.Panel}" /><Setter Property="Padding" Value="0" /></DataTrigger></Style.Triggers></Style></Border.Style>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="70" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="310" />
                <ColumnDefinition x:Name="InlineEditorColumn" Width="0.55*" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <Border x:Name="DockedStepListHeader" Grid.Row="0" Grid.ColumnSpan="2" Padding="10,6" Background="{DynamicResource Surface.Panel}" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,0,1">
                <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsR24Docked, RelativeSource={RelativeSource AncestorType={x:Type local:SequenceEditorView}}}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <WrapPanel x:Name="DockedHeaderTextRegion" VerticalAlignment="Center">
                        <TextBlock x:Name="DockedStepUnitName" Text="{Binding SequenceUnitNameText}" FontFamily="Segoe UI, Malgun Gothic" FontWeight="Bold" Foreground="{DynamicResource Text.Primary}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="{Binding ActualWidth, ElementName=DockedHeaderTextRegion}">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="FontSize" Value="13" /><Setter Property="LineHeight" Value="18.85" /><Style.Triggers><DataTrigger Binding="{Binding DataContext.Navigation.IsCompactLayout, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="FontSize" Value="12.5" /><Setter Property="LineHeight" Value="18.125" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                        <TextBlock Margin="6,0,0,0" Text="{Binding StepListCountText, NotifyOnTargetUpdated=True}" TargetUpdated="OnStepListTargetUpdated" FontFamily="Segoe UI, Malgun Gothic" FontSize="11.5" LineHeight="16.675" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center" />
                    </WrapPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="DockedAddStepButton" Content="{loc:Loc Key=R24.AddStep}" Style="{StaticResource R24ListButtonStyle}" Click="ShowStepTemplateDialog" IsEnabled="{Binding CanChooseStepTemplate}" />
                        <Button x:Name="DockedReadinessButton" Content="{loc:Loc Key=R24.Readiness}" Style="{StaticResource R24ListButtonStyle}" Command="{Binding DataContext.RecipeConnections.DryRun.ValidateSimulationReadinessCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <Button x:Name="DockedTestStepButton" Content="{loc:Loc Key=R24.TestSelectedStep}" Style="{StaticResource R24ListButtonStyle}" Command="{Binding TestSelectedStepCommand}" />
                    </StackPanel>
                    <WrapPanel x:Name="ProcessViewToolbar" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,6,0,0">
                        <RadioButton Content="{loc:Loc Key=Process.Overview}" GroupName="ProcessView" IsChecked="{Binding IsProcessOverview, Mode=TwoWay}" Style="{StaticResource ProcessViewTabStyle}" Padding="10,3" MinHeight="28" />
                        <RadioButton Content="{loc:Loc Key=Sequence.TableView}" GroupName="ProcessView" IsChecked="{Binding IsProcessTable, Mode=TwoWay}" Style="{StaticResource ProcessViewTabStyle}" Padding="10,3" MinHeight="28" />

                        <CheckBox x:Name="AllProcessUnitsToggle" Content="{loc:Loc Key=Process.AllUnits}" IsChecked="{Binding IsProcessAllUnits, Mode=TwoWay}" Margin="12,0,0,0" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsProcessOverview, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <CheckBox x:Name="ProcessSummaryToggle" Content="{loc:Loc Key=Process.Summary}" IsChecked="{Binding IsProcessSummary, Mode=TwoWay}" Margin="12,0,8,0" VerticalAlignment="Center" />
                            <Button x:Name="FlowZoomOutButton" Content="−" Command="{Binding ChangeFlowZoomCommand}" CommandParameter="-" Style="{StaticResource R24ListButtonStyle}" AutomationProperties.Name="{loc:Loc Key=Process.ZoomOut}" />
                            <TextBlock Text="{Binding FlowZoomText}" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Text.Secondary}" />
                            <Button x:Name="FlowZoomInButton" Content="+" Command="{Binding ChangeFlowZoomCommand}" CommandParameter="+" Style="{StaticResource R24ListButtonStyle}" AutomationProperties.Name="{loc:Loc Key=Process.ZoomIn}" />
                            <Button x:Name="FlowZoomResetButton" Content="100%" Command="{Binding ChangeFlowZoomCommand}" CommandParameter="reset" Style="{StaticResource R24ListButtonStyle}" AutomationProperties.Name="{loc:Loc Key=Process.ZoomReset}" />
                        </StackPanel>
                        <CheckBox Content="{loc:Loc Key=Process.ShowEquipment}" IsChecked="{Binding IsProcessSceneVisible, Mode=TwoWay}" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </WrapPanel>
                    <Grid x:Name="StepSearchToolbar" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Loc Key=Sequence.Search}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource Text.Secondary}" FontSize="12" />
                        <TextBox x:Name="StepSearchTextBox" Grid.Column="1" MinWidth="70" MaxLength="256" Style="{StaticResource SequenceTextBoxStyle}"
                                 Text="{Binding StepSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{loc:Loc Key=Sequence.Search}">
                            <TextBox.ToolTip><ToolTip MaxWidth="900"><TextBlock Text="{loc:Loc Key=Sequence.SearchHint}" TextWrapping="NoWrap" /></ToolTip></TextBox.ToolTip>
                            <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding FindNextStepCommand}" /><KeyBinding Key="Escape" Command="{Binding ClearStepSearchCommand}" /></TextBox.InputBindings>
                        </TextBox>
                        <Button x:Name="FindNextStepButton" Grid.Column="2" Content="{loc:Loc Key=Sequence.FindNext}" Command="{Binding FindNextStepCommand}" Style="{StaticResource R24ListButtonStyle}" />
                        <TextBlock x:Name="StepSearchStatus" Grid.Column="3" Text="{Binding StepSearchStatusText}" Margin="8,0,0,0" MinWidth="54" VerticalAlignment="Center" Foreground="{DynamicResource Text.Secondary}" FontSize="12" AutomationProperties.LiveSetting="Polite" />
                    </Grid>
                </Grid>
            </Border>
            <Grid Grid.Row="0" Grid.ColumnSpan="2" Margin="10,6,10,5">
                <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding IsR24Docked, RelativeSource={RelativeSource AncestorType={x:Type local:SequenceEditorView}}}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Text.Secondary}"
                               Text="{loc:Loc Key=Shell.Sequence}" />
                <ComboBox Grid.Column="1"
                          MinWidth="160" MinHeight="30" Height="Auto" Padding="7,5"
                          HorizontalAlignment="Stretch"
                          ItemsSource="{Binding Sequences}"
                          SelectedItem="{Binding SelectedSequence, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource LocalizedSequenceNameConverter}}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Border Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource StatusPillStyle}">
                    <TextBlock FontSize="10" FontWeight="SemiBold" Text="{Binding ValidationSummary}" TextWrapping="Wrap" />
                </Border>

                <WrapPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,5,0,0">
                    <TextBlock Text="{loc:Loc Key=Sequence.OwnerUnit}" VerticalAlignment="Center" Margin="0,0,7,0" Visibility="{Binding ShowUnitSettings, RelativeSource={RelativeSource AncestorType={x:Type local:SequenceEditorView}}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ComboBox Width="145" MinHeight="30" Height="Auto" Padding="7,5" HorizontalContentAlignment="Stretch" Margin="0,0,6,0" IsEnabled="{Binding IsEditable}" ItemsSource="{Binding AvailableUnits}"
                              SelectedValuePath="Id" SelectedValue="{Binding SelectedUnitId, Mode=TwoWay}" AutomationProperties.Name="{loc:Loc Key=Sequence.OwnerUnit}" Visibility="{Binding ShowUnitSettings, RelativeSource={RelativeSource AncestorType={x:Type local:SequenceEditorView}}, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextWrapping="Wrap" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="{loc:Loc Key=Sequence.AddUnitSequence}" Command="{Binding AddUnitSequenceCommand}" Margin="0,0,6,0" Visibility="{Binding ShowUnitSettings, RelativeSource={RelativeSource AncestorType={x:Type local:SequenceEditorView}}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding HasSequenceUnit}" Value="True" /><Condition Binding="{Binding ShowUnitSettings, RelativeSource={RelativeSource AncestorType={x:Type local:SequenceEditorView}}}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{loc:Loc Key=Sequence.UnitRepeat}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="UnitRepeatCountTextBox" Width="54" MaxLength="3" IsEnabled="{Binding IsEditable}" Text="{Binding UnitRepeatCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource SequenceTextBoxStyle}" AutomationProperties.Name="{loc:Loc Key=Sequence.UnitRepeatRange}" />
                        <Button x:Name="ApplyUnitRepeatButton" Content="{loc:Loc Key=Sequence.ApplyUnitRepeat}" Command="{Binding ApplyUnitRepeatCommand}" Margin="6,0,0,0" />
                    </StackPanel>
                    <TextBlock Margin="0,0,7,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Text.Secondary}"
                               Text="{loc:Loc Key=Sequence.NewStep}" />
                    <ComboBox Width="175"
                              Margin="0,0,6,0"
                              ItemsSource="{Binding Templates}"
                              SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource LocalizedSequenceTemplateNameConverter}">
                                            <Binding />
                                            <Binding Path="Revision" Source="{x:Static loc:LocExtension.RevisionSource}" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Margin="0,0,6,0"
                            Command="{Binding AddStepCommand}"
                            Content="{loc:Loc Key=Sequence.Add}"
                            Style="{StaticResource PrimaryCommandButtonStyle}"
                            ToolTip="{loc:Loc Key=Sequence.AddTooltip}" />
                    <Button Margin="0,0,6,0"
                            Command="{Binding DeleteStepCommand}"
                            Content="{loc:Loc Key=Sequence.Delete}"
                            Style="{StaticResource GlobalCommandButtonStyle}"
                            ToolTip="{loc:Loc Key=Sequence.DeleteTooltip}" />
                    <Button Margin="0,0,6,0"
                            Command="{Binding MoveStepUpCommand}"
                            Content="{loc:Loc Key=Sequence.MoveUp}"
                            Style="{StaticResource GlobalCommandButtonStyle}" />
                    <Button Command="{Binding MoveStepDownCommand}"
                            Content="{loc:Loc Key=Sequence.MoveDown}"
                            Style="{StaticResource GlobalCommandButtonStyle}" />
                    <TextBlock Margin="12,0,0,0"
                               MaxWidth="340"
                               VerticalAlignment="Top"
                               Foreground="{DynamicResource Text.Secondary}"
                               Text="{Binding StructuralEditStatus}"
                               TextWrapping="Wrap" />
                </WrapPanel>
            </Grid>

            <TabControl x:Name="StepViewTabs" Grid.Row="1"
                        SelectedIndex="{Binding StepViewIndex, RelativeSource={RelativeSource AncestorType={x:Type local:SequenceEditorView}}, Mode=TwoWay}">
                <TabControl.Style><Style TargetType="TabControl" BasedOn="{StaticResource {x:Type TabControl}}"><Setter Property="Margin" Value="10,0,10,6" /><Style.Triggers><DataTrigger Binding="{Binding IsR24Docked, RelativeSource={RelativeSource AncestorType={x:Type local:SequenceEditorView}}}" Value="True"><Setter Property="Margin" Value="0" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><ContentPresenter ContentSource="SelectedContent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" /></ControlTemplate></Setter.Value></Setter></DataTrigger></Style.Triggers></Style></TabControl.Style>
                <TabItem Header="{loc:Loc Key=Process.Overview}">
                    <local:SequenceTaskOverviewView />
                </TabItem>
                <TabItem Header="{loc:Loc Key=Sequence.TableView}">
                    <Grid>
            <DataGrid x:Name="StepListDataGrid"
                      Loaded="OnStepListLoaded" Unloaded="OnStepListUnloaded" LayoutUpdated="OnStepListLayoutUpdated" TargetUpdated="OnStepListTargetUpdated"
                      RowHeight="NaN"
                      Margin="0"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      CanUserResizeRows="False"
                      HeadersVisibility="Column"
                      IsReadOnly="True"
                      ItemsSource="{Binding Steps}"
                      SelectedItem="{Binding SelectedStep, Mode=TwoWay, NotifyOnTargetUpdated=True}"
                      SelectionMode="Single"
                      SelectionUnit="FullRow">
                <DataGrid.Style><Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}"><Setter Property="MinRowHeight" Value="{StaticResource Density.DataGridRowHeight}" /><Style.Triggers><DataTrigger Binding="{Binding IsR24Docked, RelativeSource={RelativeSource AncestorType={x:Type local:SequenceEditorView}}}" Value="True"><Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic" /><Setter Property="FontSize" Value="12" /><Setter Property="MinRowHeight" Value="27.9" /><Setter Property="Background" Value="{DynamicResource Surface.Panel}" /><Setter Property="BorderThickness" Value="0" /><Setter Property="CanUserSortColumns" Value="False" /><Setter Property="CanUserResizeColumns" Value="False" /><Setter Property="GridLinesVisibility" Value="Horizontal" /><Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Surface.Raised}" /><Setter Property="RowBackground" Value="{DynamicResource Surface.Panel}" /><Setter Property="AlternatingRowBackground" Value="{DynamicResource Surface.Panel}" /></DataTrigger><DataTrigger Binding="{Binding IsProcessAllUnits}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></DataGrid.Style>
                <DataGrid.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}">
                        <Style.Triggers>
                            <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsR24Docked, RelativeSource={RelativeSource AncestorType={x:Type local:SequenceEditorView}}}" Value="True" /><Condition Binding="{Binding Orientation, RelativeSource={RelativeSource Self}}" Value="Vertical" /></MultiDataTrigger.Conditions><Setter Property="Width" Value="15" /></MultiDataTrigger>
                            <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsR24Docked, RelativeSource={RelativeSource AncestorType={x:Type local:SequenceEditorView}}}" Value="True" /><Condition Binding="{Binding Orientation, RelativeSource={RelativeSource Self}}" Value="Horizontal" /></MultiDataTrigger.Conditions><Setter Property="Height" Value="15" /></MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                    <Style x:Key="SequenceListRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}"><Style.Triggers><DataTrigger Binding="{Binding IsR24Docked, RelativeSource={RelativeSource AncestorType={x:Type local:SequenceEditorView}}}" Value="True"><Setter Property="BorderThickness" Value="0" /><Setter Property="BorderBrush" Value="Transparent" /></DataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsR24Docked, RelativeSource={RelativeSource AncestorType={x:Type local:SequenceEditorView}}}" Value="True" /><Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Background" Value="{DynamicResource Surface.Selected}" /></MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsR24Docked, RelativeSource={RelativeSource AncestorType={x:Type local:SequenceEditorView}}}" Value="True" /><Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Background" Value="{DynamicResource Surface.Selected}" /></MultiDataTrigger></Style.Triggers></Style>
                    <Style x:Key="SequenceListColumnHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Style.Triggers><DataTrigger Binding="{Binding IsR24Docked, RelativeSource={RelativeSource AncestorType={x:Type local:SequenceEditorView}}}" Value="True"><Setter Property="Background" Value="{DynamicResource Surface.Selected}" /><Setter Property="Foreground" Value="{DynamicResource Text.Primary}" /><Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic" /><Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Padding" Value="8,5" /><Setter Property="MinHeight" Value="27.9" /><Setter Property="BorderThickness" Value="0,0,0,0.5" /><Setter Property="BorderBrush" Value="{DynamicResource Surface.Raised}" /><Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource SequenceDockedHeaderTextStyle}" /></DataTemplate></Setter.Value></Setter><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridColumnHeader"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Top" /></Border></ControlTemplate></Setter.Value></Setter></DataTrigger></Style.Triggers></Style>
