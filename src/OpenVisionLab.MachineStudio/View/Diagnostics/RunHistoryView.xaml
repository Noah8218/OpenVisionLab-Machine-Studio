<UserControl x:Class="OpenVisionLab.MachineStudio.View.Diagnostics.RunHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:OpenVisionLab.MachineStudio.Localization"
             xmlns:shell="clr-namespace:OpenVisionLab.MachineStudio.View.Shell"
             xmlns:converter="clr-namespace:OpenVisionLab.MachineStudio.Converter" FontSize="13">
    <UserControl.Resources>
        <converter:RunEvidenceTextConverter x:Key="EvidenceText" />
        <converter:KoreanWordWrappingConverter x:Key="HistoryWordWrapping" />
        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="13" /></Style>
        <Style x:Key="HistorySecondaryText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" /><Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="HistoryButton" TargetType="Button" BasedOn="{StaticResource GlobalCommandButtonStyle}">
            <Setter Property="FontSize" Value="13" /><Setter Property="Height" Value="36" /><Setter Property="Margin" Value="0,0,8,4" />
        </Style>
        <Style x:Key="HistoryPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryCommandButtonStyle}">
            <Setter Property="FontSize" Value="13" /><Setter Property="Height" Value="36" /><Setter Property="Margin" Value="0,0,8,4" />
        </Style>
        <Style x:Key="HistoryCellText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Margin" Value="4" /></Style>
        <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}"><Setter Property="RowHeight" Value="NaN" /><Setter Property="MinRowHeight" Value="30" /><Setter Property="FontSize" Value="13" /><Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" /></Style>
        <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
            <Setter Property="FontSize" Value="13" /><Setter Property="Padding" Value="12,8" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
                <Border x:Name="HistoryTabBorder" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="HistoryTabBorder" Property="Background" Value="{DynamicResource Surface.Selected}" /><Setter TargetName="HistoryTabBorder" Property="BorderBrush" Value="{DynamicResource Accent.Primary}" /><Setter Property="Foreground" Value="{DynamicResource Accent.Primary}" /></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HistoryTabBorder" Property="Background" Value="{DynamicResource Surface.Hover}" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HistoryTabBorder" Property="BorderBrush" Value="{DynamicResource Accent.Primary}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="HistoryCaptureItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Margin" Value="0,0,0,8" /><Setter Property="Padding" Value="10" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="HistoryCaptureBorder" Background="{DynamicResource Surface.Raised}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Stretch" /></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="HistoryCaptureBorder" Property="Background" Value="{DynamicResource Surface.Selected}" /><Setter TargetName="HistoryCaptureBorder" Property="BorderBrush" Value="{DynamicResource Accent.Primary}" /><Setter TargetName="HistoryCaptureBorder" Property="BorderThickness" Value="4,1,1,1" /></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HistoryCaptureBorder" Property="Background" Value="{DynamicResource Surface.Hover}" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HistoryCaptureBorder" Property="BorderBrush" Value="{DynamicResource Accent.Primary}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid Margin="0,0,0,12">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Grid Margin="0,0,12,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock x:Name="RunAnalysisTitle" Text="{loc:Loc RunHistory.AnalysisTitle}" FontSize="20" FontWeight="SemiBold" />
                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Loc RunHistory.AnalysisRun}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ComboBox x:Name="RunHistoryPicker" Grid.Column="1" ItemsSource="{Binding Runs}" SelectedItem="{Binding Selected, Mode=TwoWay}" DisplayMemberPath="SelectionText"
                              MaxWidth="580" HorizontalAlignment="Left" MinWidth="240" AutomationProperties.Name="{loc:Loc RunHistory.AnalysisRun}">
                        <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers></Style></ComboBox.Style>
                    </ComboBox>
                    <Border x:Name="RunOutcomeBadge" Grid.Column="2" BorderThickness="1" CornerRadius="5" Padding="9,5" Margin="10,0,0,0" VerticalAlignment="Center">
                        <Border.Style><Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource Surface.Raised}" /><Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Selected}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                <DataTrigger Binding="{Binding Selected.Record.Outcome}" Value="Completed"><Setter Property="Background" Value="{DynamicResource State.RunningSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource State.RunningBorder}" /></DataTrigger>
                                <DataTrigger Binding="{Binding Selected.Record.Outcome}" Value="Faulted"><Setter Property="Background" Value="{DynamicResource State.FaultSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource State.FaultBorder}" /></DataTrigger>
                                <DataTrigger Binding="{Binding Selected.Record.Outcome}" Value="Stopped"><Setter Property="BorderBrush" Value="{DynamicResource State.WarningBorder}" /></DataTrigger>
                            </Style.Triggers>
                        </Style></Border.Style>
                        <TextBlock x:Name="RunOutcomeText" Text="{Binding Selected.Outcome}" FontWeight="SemiBold">
                            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Style.Triggers>
                                <DataTrigger Binding="{Binding Selected.Record.Outcome}" Value="Completed"><Setter Property="Foreground" Value="{DynamicResource State.Running}" /></DataTrigger>
                                <DataTrigger Binding="{Binding Selected.Record.Outcome}" Value="Faulted"><Setter Property="Foreground" Value="{DynamicResource State.Fault}" /></DataTrigger>
                                <DataTrigger Binding="{Binding Selected.Record.Outcome}" Value="Stopped"><Setter Property="Foreground" Value="{DynamicResource State.Warning}" /></DataTrigger>
                            </Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </Border>
                </Grid>
            </Grid>
            <WrapPanel Grid.Column="1" VerticalAlignment="Top">
                <Button x:Name="RunHistoryReturnButton" Content="{loc:Loc RunHistory.ReturnToWork}" Command="{Binding DataContext.Navigation.ReturnFromResultsCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource HistoryButton}"><Style.Triggers><Trigger Property="Command" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers></Style></Button.Style>
                </Button>
                <Button x:Name="RunHistoryRefreshButton" Content="{loc:Loc RunHistory.Refresh}" Command="{Binding RefreshCommand}" Style="{StaticResource HistoryButton}" />
                <Button x:Name="RunHistoryRetryButton" Content="{loc:Loc RunHistory.RetrySave}" Command="{Binding RetrySaveCommand}" Style="{StaticResource HistoryButton}" />
            </WrapPanel>
        </Grid>
        <Grid Grid.Row="1">
                <Grid.RowDefinitions><RowDefinition Height="144" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <ScrollViewer x:Name="RunDetailsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,12"><StackPanel>
                <StackPanel Margin="0,0,0,8">
                    <Border x:Name="RunDraftConfirmation" Padding="12" BorderBrush="{DynamicResource Border.Default}" Background="{DynamicResource Surface.Raised}" BorderThickness="1" CornerRadius="4"
                            Visibility="{Binding HasDraft, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <ScrollViewer MaxHeight="70" VerticalScrollBarVisibility="Auto"><TextBlock Text="{loc:Loc RunHistory.DraftHint}" TextWrapping="Wrap" /></ScrollViewer>
                            <WrapPanel Margin="0,8,0,0">
                                <Button x:Name="RunHistoryApplyButton" Content="{loc:Loc RunHistory.ApplyDraft}" Command="{Binding ApplyDraftCommand}" Style="{StaticResource HistoryPrimaryButton}" />
                                <Button x:Name="RunHistoryCancelDraftButton" Content="{loc:Loc RunHistory.Cancel}" Command="{Binding CancelDraftCommand}" Style="{StaticResource HistoryButton}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border x:Name="RunDeleteConfirmation" Padding="12" BorderBrush="{DynamicResource Border.Default}" Background="{DynamicResource Surface.Raised}" BorderThickness="1" CornerRadius="4"
                            Visibility="{Binding IsDeletePending, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <ScrollViewer MaxHeight="90" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock x:Name="RunDeleteId" Text="{Binding Selected.RunId}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,6" /><TextBlock x:Name="RunDeleteHint" Text="{loc:Loc RunHistory.DeleteHint}" TextWrapping="Wrap" /></StackPanel></ScrollViewer>
                            <WrapPanel Margin="0,8,0,0">
                                <Button x:Name="RunHistoryCancelDeleteButton" Content="{loc:Loc RunHistory.Cancel}" Command="{Binding CancelDeleteCommand}" Style="{StaticResource HistoryButton}" />
                                <Button x:Name="RunHistoryConfirmDeleteButton" Content="{loc:Loc RunHistory.ConfirmDelete}" Command="{Binding ConfirmDeleteCommand}" Style="{StaticResource HistoryButton}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <Grid x:Name="RunSummarySection">
                    <Grid.Style><Style TargetType="Grid"><Style.Triggers>
                        <DataTrigger Binding="{Binding HasDraft}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                        <DataTrigger Binding="{Binding IsDeletePending}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                    </Style.Triggers></Style></Grid.Style>
                    <StackPanel>
                        <ScrollViewer MaxHeight="70" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,6">
                            <ScrollViewer.Style><Style TargetType="ScrollViewer"><Style.Triggers><DataTrigger Binding="{Binding StatusText}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></ScrollViewer.Style>
                            <TextBlock x:Name="RunHistoryStatus" Text="{Binding StatusText}" TextWrapping="Wrap" />
                        </ScrollViewer>
                        <ScrollViewer x:Name="RunSummaryScroll" MaxHeight="54" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,12"><TextBlock x:Name="RunSummary" Text="{Binding SummaryText}" TextWrapping="Wrap" /></ScrollViewer>
                    </StackPanel>
                </Grid>
                <StackPanel Margin="0,0,0,12">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Button x:Name="RunHistoryDraftButton" HorizontalAlignment="Left" Content="{loc:Loc RunHistory.PrepareDraft}" Command="{Binding PrepareRerunCommand}" Style="{StaticResource HistoryPrimaryButton}" />
                        <Grid Grid.Column="1" Margin="0,0,8,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Button x:Name="RunHistoryCameraSettingsButton" HorizontalAlignment="Left" VerticalAlignment="Top" Content="{loc:Loc RunHistory.CurrentCameraSettings}"
                                    Command="{Binding OpenCameraSettingsCommand}" CommandParameter="{Binding SelectedCapture}" Style="{StaticResource HistoryButton}" AutomationProperties.Name="{loc:Loc RunHistory.CurrentCameraSettings}" />
                            <ScrollViewer x:Name="RunHistoryCameraTargetScroll" Grid.Column="1" MaxHeight="40" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
                                <TextBlock x:Name="RunHistoryCameraTarget" Text="{Binding CurrentCameraSettingsTargetText, Converter={StaticResource HistoryWordWrapping}}" Style="{StaticResource HistorySecondaryText}" />
                                <TextBlock x:Name="RunHistoryCameraSettingsHint" Text="{loc:Loc RunHistory.CameraSettingsHint}" Style="{StaticResource HistorySecondaryText}" />
                            </StackPanel></ScrollViewer>
                        </Grid>
                        <Button x:Name="RunHistoryDeleteButton" Grid.Column="2" Content="{loc:Loc RunHistory.Delete}" Command="{Binding DeleteCommand}" Style="{StaticResource HistoryButton}" />
                    </Grid>
                    <TextBlock Text="{loc:Loc RunHistory.DraftSteps}" Style="{StaticResource HistorySecondaryText}" Margin="0,4,0,0" />
                </StackPanel>
                </StackPanel></ScrollViewer>
                <TabControl x:Name="RunEvidenceTabs" Grid.Row="1">
                    <TabItem Header="{loc:Loc RunHistory.Product}">
                        <Grid Margin="0,12,0,0"><DataGrid x:Name="RunProductsGrid" ItemsSource="{Binding Products}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Loc RunHistory.ProductId}" Binding="{Binding Record.Id}" Width="2*" ElementStyle="{StaticResource HistoryCellText}" />
                                <DataGridTextColumn Header="{loc:Loc RunHistory.ProductName}" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource HistoryCellText}" />
                                <DataGridTextColumn Header="{loc:Loc RunHistory.Unit}" Binding="{Binding Record.UnitId, Converter={StaticResource EvidenceText}}" Width="*" ElementStyle="{StaticResource HistoryCellText}" />
                                <DataGridTextColumn Header="{loc:Loc RunHistory.State}" Binding="{Binding State}" Width="*" ElementStyle="{StaticResource HistoryCellText}" />
                                <DataGridTextColumn Header="{loc:Loc RunHistory.Verdict}" Binding="{Binding Record.Verdict, Converter={StaticResource EvidenceText}}" Width="*" ElementStyle="{StaticResource HistoryCellText}" />
                                <DataGridTextColumn Header="{loc:Loc RunHistory.Exit}" Binding="{Binding Record.ExitRoute, Converter={StaticResource EvidenceText}}" Width="*" ElementStyle="{StaticResource HistoryCellText}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="{loc:Loc RunHistory.NoProducts}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource HistorySecondaryText}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasProducts}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                        </Grid>
                    </TabItem>
                    <TabItem Header="{loc:Loc RunHistory.Images}">
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition x:Name="RunCaptureSidebarColumn">
                                <ColumnDefinition.Style><Style TargetType="ColumnDefinition"><Setter Property="Width" Value="240" /><Style.Triggers><DataTrigger Binding="{Binding (shell:ShellWindow.IsCompactLayout), RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Width" Value="180" /></DataTrigger></Style.Triggers></Style></ColumnDefinition.Style>
                            </ColumnDefinition></Grid.ColumnDefinitions>
                            <Border x:Name="RunCaptureFrame" Background="{DynamicResource Surface.Root}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="4">
                                <Grid><TextBlock x:Name="RunCaptureStatus" Text="{Binding CaptureImageStatusText}" TextWrapping="Wrap" Margin="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource HistorySecondaryText}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding CaptureImage}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                                    <Image x:Name="RunCaptureImage" Source="{Binding CaptureImage}" Stretch="Uniform" />
                                </Grid>
                            </Border>
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <ListBox x:Name="RunCaptureThumbnails" ItemsSource="{Binding CaptureThumbnails}" SelectedItem="{Binding SelectedCaptureThumbnail, Mode=TwoWay}"
                                         ItemContainerStyle="{StaticResource HistoryCaptureItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.ScrollUnit="Pixel" AutomationProperties.Name="{loc:Loc RunHistory.Images}">
                                    <ListBox.Style><Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                <ScrollViewer x:Name="PART_ScrollViewer" Focusable="False" CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer>
                                            </Border>
                                        </ControlTemplate></Setter.Value></Setter>
                                        <Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers>
                                    </Style></ListBox.Style>
                                    <ListBox.ItemTemplate><DataTemplate><StackPanel>
                                        <Border Height="96" Background="{DynamicResource Surface.Root}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="4"><Grid>
                                            <Image Source="{Binding Image}" Stretch="Uniform" />
                                            <TextBlock Margin="8" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource HistorySecondaryText}">
                                                <Setter Property="Text" Value="{loc:Loc RunHistory.ImageUnreadable}" /><Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers><DataTrigger Binding="{Binding Image}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger><DataTrigger Binding="{Binding Record.Pixels}" Value="{x:Null}"><Setter Property="Text" Value="{loc:Loc RunHistory.ImageMissing}" /></DataTrigger></Style.Triggers>
                                            </Style></TextBlock.Style></TextBlock>
                                        </Grid></Border>
                                        <TextBlock Text="{Binding Record.CameraId}" Style="{StaticResource HistorySecondaryText}" Margin="0,6,0,0" />
                                        <TextBlock Text="{Binding Record.ProductId, Converter={StaticResource EvidenceText}}" Style="{StaticResource HistorySecondaryText}" />
                                        <TextBlock Text="{Binding Record.AcquisitionId}" Style="{StaticResource HistorySecondaryText}" />
                                        <TextBlock Text="{Binding Record.Verdict, Converter={StaticResource EvidenceText}}" Style="{StaticResource HistorySecondaryText}" FontWeight="SemiBold" />
                                    </StackPanel></DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                                <ScrollViewer x:Name="RunCaptureDetailsScroll" Grid.Row="1" MaxHeight="140" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0"><TextBlock x:Name="RunCaptureDescription" Text="{Binding CaptureDescription}" Style="{StaticResource HistorySecondaryText}" /></ScrollViewer>
                            </Grid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="{loc:Loc RunHistory.Inspection}">
                        <ScrollViewer x:Name="RunInspectionScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc RunHistory.MissingHint}" Style="{StaticResource HistorySecondaryText}" Margin="0,0,0,12" />
                                <TextBlock Text="{loc:Loc RunHistory.NoInspections}" TextWrapping="Wrap" Margin="0,0,0,12"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource HistorySecondaryText}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasInspections}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                <ItemsControl ItemsSource="{Binding Inspections}"><ItemsControl.ItemTemplate><DataTemplate>
                                    <Border BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Id}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding FrameId, Converter={StaticResource EvidenceText}}" Style="{StaticResource HistorySecondaryText}" Margin="0,4,0,0" />
                                            <TextBlock Text="{loc:Loc RunHistory.Request}" Margin="0,8,0,4" />
                                            <TextBox Text="{Binding RequestJson, Mode=OneWay, Converter={StaticResource EvidenceText}}" IsReadOnly="True" TextWrapping="Wrap" FontSize="13" />
                                            <TextBlock Text="{loc:Loc RunHistory.Result}" Margin="0,8,0,4" />
                                            <TextBox Text="{Binding ResultJson, Mode=OneWay, Converter={StaticResource EvidenceText}}" IsReadOnly="True" TextWrapping="Wrap" FontSize="13" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="{loc:Loc RunHistory.Compare}">
                        <Grid Margin="0,12,0,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:Loc RunHistory.ComparisonRun}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <ComboBox x:Name="RunComparisonPicker" Grid.Column="1" ItemsSource="{Binding ComparisonRuns}" SelectedItem="{Binding ComparedRun, Mode=TwoWay}" DisplayMemberPath="SelectionText"
                                          MaxWidth="580" HorizontalAlignment="Left" MinWidth="240" AutomationProperties.Name="{loc:Loc RunHistory.ComparisonRun}">
                                    <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers></Style></ComboBox.Style>
                                </ComboBox>
                            </Grid>
                            <TextBlock Grid.Row="1" x:Name="RunComparisonHint" Text="{Binding ComparisonHint}" Style="{StaticResource HistorySecondaryText}" Margin="0,8,0,12" />
                            <Grid Grid.Row="2" Visibility="{Binding HasComparison, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition><ColumnDefinition.Style><Style TargetType="ColumnDefinition"><Setter Property="Width" Value="400" /><Style.Triggers><DataTrigger Binding="{Binding (shell:ShellWindow.IsCompactLayout), RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Width" Value="360" /></DataTrigger></Style.Triggers></Style></ColumnDefinition.Style></ColumnDefinition>
                                    <ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ScrollViewer x:Name="RunComparisonSidebar" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
                                    <TextBlock Text="{loc:Loc RunHistory.ManualComparison}" Style="{StaticResource HistorySecondaryText}" Margin="0,0,0,12" />
                                    <TextBlock Text="{loc:Loc RunHistory.SelectedRun}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <ListBox x:Name="RunComparisonSelectedCaptures" ItemsSource="{Binding CaptureThumbnails}" SelectedItem="{Binding SelectedCaptureThumbnail, Mode=TwoWay}" MaxHeight="110" Margin="0,0,0,12"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{loc:Loc RunHistory.SelectedRun}">
                                        <ListBox.Style><Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}"><Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers></Style></ListBox.Style>
                                        <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Record.CameraId}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding Record.AcquisitionId}" Style="{StaticResource HistorySecondaryText}" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Text="{loc:Loc RunHistory.ComparisonRun}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <ListBox x:Name="RunComparisonOtherCaptures" ItemsSource="{Binding ComparedCaptureThumbnails}" SelectedItem="{Binding ComparedCaptureThumbnail, Mode=TwoWay}" MaxHeight="110" Margin="0,0,0,12"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{loc:Loc RunHistory.ComparisonRun}">
                                        <ListBox.Style><Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}"><Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers></Style></ListBox.Style>
                                        <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Record.CameraId}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding Record.AcquisitionId}" Style="{StaticResource HistorySecondaryText}" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
                                    </ListBox>
                                    <Expander x:Name="RunComparisonSummary" Header="{loc:Loc RunHistory.ComparisonSummary}">
                            <DataGrid x:Name="RunComparisonGrid" ItemsSource="{Binding ComparisonRows}" MaxHeight="220" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                                      Visibility="{Binding HasComparison, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MachineDataGridColumnHeaderStyle}">
                                    <Setter Property="Height" Value="NaN" /><Setter Property="MinHeight" Value="30" /><Setter Property="Padding" Value="4" />
                                    <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></Setter.Value></Setter>
                                </Style></DataGrid.ColumnHeaderStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:Loc RunHistory.ComparisonMetric}" Binding="{Binding Label, Converter={StaticResource HistoryWordWrapping}}" Width="1.4*" ElementStyle="{StaticResource HistoryCellText}" />
                                    <DataGridTextColumn Header="{loc:Loc RunHistory.SelectedRun}" Binding="{Binding SelectedValue}" Width="*" ElementStyle="{StaticResource HistoryCellText}" />
                                    <DataGridTextColumn Header="{loc:Loc RunHistory.ComparisonRun}" Binding="{Binding ComparedValue}" Width="*" ElementStyle="{StaticResource HistoryCellText}" />
                                    <DataGridTextColumn Header="{loc:Loc RunHistory.Difference}" Binding="{Binding Difference}" Width="*" ElementStyle="{StaticResource HistoryCellText}" />
                                </DataGrid.Columns>
                            </DataGrid>
                                    </Expander>
                            <Expander x:Name="RunComparisonSettings" Header="{loc:Loc RunHistory.ComparisonSettings}" Margin="0,12,0,0"
                                      Visibility="{Binding HasComparison, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ScrollViewer x:Name="RunComparisonSettingsScroll" MaxHeight="190" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{loc:Loc RunHistory.SelectedRun}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Selected.RunId}" Style="{StaticResource HistorySecondaryText}" Margin="0,4,0,8" />
                                            <TextBox x:Name="RunComparisonSelectedSettings" Text="{Binding Selected.Record.AppliedRecipeJson, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="{StaticResource Typography.Telemetry}" />
                                            <TextBlock Text="{loc:Loc RunHistory.RuntimeSettings}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,4" />
                                            <TextBox Text="{Binding Selected.Record.RuntimeSettingsJson, Mode=OneWay, Converter={StaticResource EvidenceText}}" IsReadOnly="True" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{loc:Loc RunHistory.ComparisonRun}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding ComparedRun.RunId}" Style="{StaticResource HistorySecondaryText}" Margin="0,4,0,8" />
                                            <TextBox x:Name="RunComparisonOtherSettings" Text="{Binding ComparedRun.Record.AppliedRecipeJson, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="{StaticResource Typography.Telemetry}" />
                                            <TextBlock Text="{loc:Loc RunHistory.RuntimeSettings}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,4" />
                                            <TextBox Text="{Binding ComparedRun.Record.RuntimeSettingsJson, Mode=OneWay, Converter={StaticResource EvidenceText}}" IsReadOnly="True" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </ScrollViewer>
                            </Expander>                                </StackPanel></ScrollViewer>
                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="72" /></Grid.RowDefinitions>
                                    <TextBlock Text="{loc:Loc RunHistory.ComparisonRun}" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <Border x:Name="RunComparisonOtherFrame" Grid.Row="1" Background="{DynamicResource Surface.Root}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="4">
                                        <Grid>
                                            <Image x:Name="RunComparisonOtherImage" Source="{Binding ComparedImage}" Stretch="Uniform" />
                                            <TextBlock Text="{Binding ComparedImageStatusText}" Margin="12" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource HistorySecondaryText}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding ComparedImage}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0"><StackPanel>
                                        <TextBlock Text="{Binding ComparedCaptureThumbnail.Record.Verdict, Converter={StaticResource EvidenceText}}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding ComparedCaptureDescription}" Style="{StaticResource HistorySecondaryText}" />
                                    </StackPanel></ScrollViewer>
                                </Grid>
                                <Grid Grid.Column="4">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="72" /></Grid.RowDefinitions>
                                    <TextBlock Text="{loc:Loc RunHistory.SelectedRun}" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <Border x:Name="RunComparisonSelectedFrame" Grid.Row="1" Background="{DynamicResource Surface.Root}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="4">
                                        <Grid>
                                            <Image x:Name="RunComparisonSelectedImage" Source="{Binding CaptureImage}" Stretch="Uniform" />
                                            <TextBlock Text="{Binding CaptureImageStatusText}" Margin="12" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource HistorySecondaryText}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding CaptureImage}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0"><StackPanel>
                                        <TextBlock Text="{Binding SelectedCapture.Verdict, Converter={StaticResource EvidenceText}}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding CaptureDescription}" Style="{StaticResource HistorySecondaryText}" />
                                    </StackPanel></ScrollViewer>
                                </Grid>
                            </Grid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="{loc:Loc RunHistory.Settings}">
                        <ScrollViewer x:Name="RunSettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding AppliedSettingsText}" TextWrapping="Wrap" />
                                <TextBlock Text="{loc:Loc RunHistory.AppliedRecipe}" FontWeight="SemiBold" Margin="0,16,0,8" />
                                <TextBox x:Name="RunAppliedRecipe" Text="{Binding AppliedRecipeJson, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontSize="13" FontFamily="{StaticResource Typography.Telemetry}" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
        </Grid>
    </Grid>
</UserControl>
