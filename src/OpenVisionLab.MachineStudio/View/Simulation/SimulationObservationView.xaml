<UserControl x:Class="OpenVisionLab.MachineStudio.View.Simulation.SimulationObservationView" x:Name="ObservationRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OpenVisionLab.MachineStudio.View.Simulation"
             xmlns:conv="clr-namespace:OpenVisionLab.MachineStudio.Converter"
             xmlns:loc="clr-namespace:OpenVisionLab.MachineStudio.Localization">
    <UserControl.Resources>
        <conv:KoreanWordWrappingConverter x:Key="KoreanWordWrappingConverter" />
        <conv:SimulationObservationScopeConverter x:Key="SimulationObservationScopeConverter" />
        <Style x:Key="ObservationText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Margin" Value="0,2" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
        </Style>
        <Style x:Key="ObservationButton" TargetType="Button" BasedOn="{StaticResource GlobalCommandButtonStyle}">
            <Setter Property="MinHeight" Value="30" /><Setter Property="Padding" Value="8,4" /><Setter Property="Margin" Value="4,0,0,0" />
        </Style>
    </UserControl.Resources>
    <Border Padding="10,6" Background="{DynamicResource Surface.Raised}" BorderBrush="{DynamicResource Border.Default}">
        <Border.Style><Style TargetType="Border"><Setter Property="BorderThickness" Value="0,1,0,0" /><Style.Triggers><DataTrigger Binding="{Binding IsSidebar, ElementName=ObservationRoot}" Value="True"><Setter Property="BorderThickness" Value="1,0,0,0" /></DataTrigger></Style.Triggers></Style></Border.Style>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition><RowDefinition.Style><Style TargetType="RowDefinition"><Setter Property="Height" Value="Auto" /><Style.Triggers><DataTrigger Binding="{Binding IsSidebar, ElementName=ObservationRoot}" Value="True"><Setter Property="Height" Value="*" /></DataTrigger></Style.Triggers></Style></RowDefinition.Style></RowDefinition></Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                    <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding IsSidebar, ElementName=ObservationRoot}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                    <TextBlock TextWrapping="Wrap" FontWeight="SemiBold">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding CurrentRunStatusText}" /><Style.Triggers><DataTrigger Binding="{Binding IsDryRunPlaybackActive}" Value="True"><Setter Property="Text" Value="{Binding DryRunPlaybackTitleText}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding RecipeExecutionStatusText}" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding HasRecipeExecutionStatus}" Value="True" /><Condition Binding="{Binding IsDryRunPlaybackActive}" Value="False" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="SimulationDiagnosticsToggle" Content="{loc:Loc Key=SimObservation.Diagnostics}" IsChecked="{Binding Navigation.IsSimulationDiagnosticsExpanded, Mode=TwoWay}"
                              VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button x:Name="SimulationRunHistoryButton" Content="{loc:Loc Key=SimObservation.History}" Command="{Binding Navigation.OpenResultsWorkspaceCommand}" Style="{StaticResource ObservationButton}" />
                </StackPanel>
            </Grid>
            <ScrollViewer x:Name="SimulationDiagnosticsScroll" Grid.Row="1" Margin="0,6,0,0"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding Navigation.IsSimulationDiagnosticsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="MaxHeight" Value="200" /><Style.Triggers><DataTrigger Binding="{Binding IsSidebar, ElementName=ObservationRoot}" Value="True"><Setter Property="MaxHeight" Value="Infinity" /></DataTrigger></Style.Triggers></Style></ScrollViewer.Style>
                <StackPanel>
                    <Border Padding="0,2,0,8" Margin="0,0,0,8" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,0,1">
                        <StackPanel><TextBlock x:Name="SimulationObservationScopeName" FontWeight="SemiBold" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{loc:Loc Key=Equipment.OverviewButton}" /><Style.Triggers><DataTrigger Binding="{Binding Layout.IsUnitView}" Value="True"><Setter Property="Text" Value="{Binding Layout.SceneTitleText, Converter={StaticResource KoreanWordWrappingConverter}}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                            <TextBlock x:Name="SimulationObservationScopeId" Text="{Binding Layout.ActiveUnitId}" TextWrapping="Wrap" FontFamily="{StaticResource Typography.Telemetry}" Foreground="{DynamicResource Text.Secondary}" />
                            <Button x:Name="SimulationObserveWholeButton" Content="{loc:Loc Key=Equipment.OverviewButton}" Command="{Binding ObserveWholeSimulationCommand}" HorizontalAlignment="Left" Margin="0,6,0,0" Style="{StaticResource ObservationButton}" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="SimulationPendingDefinitionHint" Text="{Binding SimulationObservationUnavailableText, Converter={StaticResource KoreanWordWrappingConverter}}" Foreground="{DynamicResource State.Warning}">
                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource ObservationText}"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding AreSimulationObservationsCurrent}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <ItemsControl x:Name="SimulationSequenceRows"
                                  Visibility="{Binding AreSimulationObservationsCurrent, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl.ItemsSource><MultiBinding Converter="{StaticResource SimulationObservationScopeConverter}" Mode="OneWay"><Binding Path="RuntimeDebugger.SequenceObservations" /><Binding Path="Layout.ActiveUnitId" /></MultiBinding></ItemsControl.ItemsSource>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Border Padding="8" Margin="0,0,0,5" Background="{DynamicResource Surface.Panel}" BorderThickness="1" CornerRadius="5">
                                <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" /><Style.Triggers><DataTrigger Binding="{Binding IsFaulted}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource State.Fault}" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <StackPanel Margin="0,0,8,0">
                                        <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding IsSidebar, RelativeSource={RelativeSource AncestorType=local:SimulationObservationView}}" Value="True"><Setter Property="Grid.ColumnSpan" Value="2" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                        <TextBlock Text="{Binding ProcessText, Converter={StaticResource KoreanWordWrappingConverter}}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding UnitId}" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}" FontFamily="{StaticResource Typography.Telemetry}" />
                                        <TextBlock Text="{Binding StepText, Converter={StaticResource KoreanWordWrappingConverter}}" TextWrapping="Wrap" />
                                        <TextBlock Style="{StaticResource ObservationText}" Text="{Binding DetailText, Converter={StaticResource KoreanWordWrappingConverter}}" />
                                        <TextBlock Style="{StaticResource ObservationText}" Text="{Binding ValuesText, Converter={StaticResource KoreanWordWrappingConverter}}" />
                                        <TextBlock Style="{StaticResource ObservationText}" Text="{Binding TimingText, Converter={StaticResource KoreanWordWrappingConverter}}" FontFamily="{StaticResource Typography.Telemetry}" FontSize="11" />
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Grid.Column" Value="1" /><Style.Triggers><DataTrigger Binding="{Binding IsSidebar, RelativeSource={RelativeSource AncestorType=local:SimulationObservationView}}" Value="True"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.Row" Value="1" /><Setter Property="Grid.ColumnSpan" Value="2" /><Setter Property="Margin" Value="0,8,0,0" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                        <TextBlock Text="{Binding StateText}" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,0,0,6" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="{loc:Loc Key=SimObservation.ObserveUnit}" AutomationProperties.HelpText="{Binding ProcessText}" Command="{Binding DataContext.ObserveSimulationUnitCommand, RelativeSource={RelativeSource AncestorType={x:Type local:SimulationObservationView}}}" CommandParameter="{Binding UnitId}" Style="{StaticResource ObservationButton}" />
                                            <Button Content="{loc:Loc Key=SimObservation.OpenStep}" AutomationProperties.HelpText="{Binding StepText}" Command="{Binding DataContext.OpenSimulationObservationStepCommand, RelativeSource={RelativeSource AncestorType={x:Type local:SimulationObservationView}}}" CommandParameter="{Binding}" Style="{StaticResource ObservationButton}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="SimulationNoProcessesHint">
                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource ObservationText}"><Setter Property="Text" Value="{loc:Loc Key=SimObservation.NoProcesses}" /><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding HasItems, ElementName=SimulationSequenceRows}" Value="False" /><Condition Binding="{Binding AreSimulationObservationsCurrent}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger><DataTrigger Binding="{Binding Layout.IsUnitView}" Value="True"><Setter Property="Text" Value="{loc:Loc Key=SimObservation.NoScopedProcesses}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <ItemsControl x:Name="SimulationUnitCards">
                        <ItemsControl.ItemsSource><MultiBinding Converter="{StaticResource SimulationObservationScopeConverter}" Mode="OneWay"><Binding Path="EquipmentMaterialFlow.UnitActivities" /><Binding Path="Layout.ActiveUnitId" /></MultiBinding></ItemsControl.ItemsSource>
                        <ItemsControl.Style><Style TargetType="ItemsControl"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding EquipmentMaterialFlow.HasSlots}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding AreSimulationObservationsCurrent}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></ItemsControl.Style>
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Button Margin="0,3,5,0" Padding="8,4" MinHeight="30" Height="Auto" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Name}" Command="{Binding DataContext.ObserveSimulationUnitCommand, RelativeSource={RelativeSource AncestorType={x:Type local:SimulationObservationView}}}" CommandParameter="{Binding UnitId}">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource GlobalCommandButtonStyle}"><Setter Property="Width" Value="300" /><Style.Triggers><DataTrigger Binding="{Binding IsSidebar, RelativeSource={RelativeSource AncestorType=local:SimulationObservationView}}" Value="True"><Setter Property="Width" Value="Auto" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                <StackPanel><TextBlock Text="{Binding Name, Converter={StaticResource KoreanWordWrappingConverter}}" TextWrapping="Wrap" FontWeight="SemiBold" /><TextBlock Text="{Binding UnitId}" TextWrapping="Wrap" FontFamily="{StaticResource Typography.Telemetry}" Foreground="{DynamicResource Text.Secondary}" /><TextBlock Text="{Binding StateText, Converter={StaticResource KoreanWordWrappingConverter}}" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}" /></StackPanel>
                            </Button>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <WrapPanel>
                        <WrapPanel.Style><Style TargetType="WrapPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Layout.UnitOverviewItems.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></WrapPanel.Style>
                        <TextBlock Text="{loc:Loc Key=Equipment.SimulationUnitsEmpty}" Margin="0,0,10,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="300" />
                        <Button Content="{loc:Loc Key=Equipment.OutlineAddUnit}" Command="{Binding OpenStationUnitEditorCommand}" Style="{StaticResource ObservationButton}" />
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
