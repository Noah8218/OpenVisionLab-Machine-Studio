<UserControl x:Class="OpenVisionLab.MachineStudio.View.Project.EquipmentComponentLibraryDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:OpenVisionLab.MachineStudio.Localization"
             AutomationProperties.Name="{loc:Loc Key=Equipment.LibraryDialogTitle}"
             Focusable="True"
             FocusManager.IsFocusScope="True"
             FocusManager.FocusedElement="{Binding ElementName=LibrarySearchTextBox}"
             KeyboardNavigation.TabNavigation="Cycle"
             Visibility="{Binding IsEquipmentComponentLibraryDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseEquipmentComponentLibraryDialogCommand}" />
    </UserControl.InputBindings>
    <Grid Background="Transparent">
        <Border Background="{DynamicResource Surface.Root}" Opacity="0.69" />
        <Border Width="620"
                MaxWidth="760"
                MaxHeight="660"
                Margin="20"
                Padding="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource Surface.Raised}"
                BorderBrush="{DynamicResource Border.Default}"
                BorderThickness="1"
                CornerRadius="9">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border BorderBrush="{DynamicResource Border.Default}"
                        BorderThickness="0,0,0,1"
                        Padding="20,16">
                    <TextBlock FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Text.Primary}"
                               TextWrapping="Wrap">
                        <Run Text="{loc:Loc Key=Equipment.LibraryDialogTitle}" />
                        <Run Text=" / " />
                        <Run Text="{Binding Layout.SceneTitleText, Mode=OneWay}" />
                    </TextBlock>
                </Border>
                <Grid Grid.Row="1" Margin="20,20,20,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="LibrarySearchTextBox"
                                 MinHeight="34"
                                 Padding="10,4,34,4"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding Layout.LibrarySearchText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{loc:Loc Key=Equipment.LibrarySearchLabel}" />
                        <Button Grid.Column="1"
                                Width="32"
                                MinWidth="32"
                                MinHeight="0"
                                Margin="-36,4,4,4"
                                Padding="0"
                                HorizontalAlignment="Right"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Foreground="{DynamicResource Text.Secondary}"
                                Command="{Binding Layout.ClearLibrarySearchCommand}"
                                ToolTip="{loc:Loc Key=Equipment.LibrarySearchClear}"
                                AutomationProperties.Name="{loc:Loc Key=Equipment.LibrarySearchClear}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource GlobalCommandButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Layout.IsLibrarySearchEmpty}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="×" FontSize="16" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </Grid>
                    <Grid Grid.Row="1" MinHeight="100">
                        <ScrollViewer MaxHeight="480"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Layout.FilteredLibraryItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button MinHeight="34"
                                                Margin="0,0,0,8"
                                                Padding="10,7"
                                                HorizontalContentAlignment="Stretch"
                                                AutomationProperties.Name="{Binding Name}"
                                                AutomationProperties.HelpText="{Binding Description}"
                                                Command="{Binding DataContext.AddEquipmentComponentFromLibraryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Kind}"
                                                Style="{StaticResource GlobalCommandButtonStyle}">
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Text.Primary}"
                                                           Text="{Binding Name}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock FontSize="12"
                                                           Foreground="{DynamicResource Text.Secondary}"
                                                           Text="{Binding Description}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   Text="{loc:Loc Key=Equipment.LibraryNoMatches}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding Layout.HasNoLibrarySearchResults, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                    <TextBlock Grid.Row="2"
                               Margin="0,8,0,0"
                               Foreground="{DynamicResource Text.Secondary}"
                               Text="{Binding EquipmentComponentLibraryDialogStatusText}"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EquipmentComponentLibraryDialogStatusText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <Border Grid.Row="2"
                        BorderBrush="{DynamicResource Border.Default}"
                        BorderThickness="0,1,0,0"
                        Padding="20,16">
                    <Button MinWidth="112"
                            MinHeight="36"
                            HorizontalAlignment="Right"
                            Command="{Binding CloseEquipmentComponentLibraryDialogCommand}"
                            Content="{loc:Loc Key=Gallery.Close}"
                            AutomationProperties.Name="{loc:Loc Key=Gallery.Close}"
                            Style="{StaticResource GlobalCommandButtonStyle}" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
