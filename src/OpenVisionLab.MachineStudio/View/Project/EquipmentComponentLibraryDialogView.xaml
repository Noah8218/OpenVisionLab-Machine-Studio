<UserControl x:Class="OpenVisionLab.MachineStudio.View.Project.EquipmentComponentLibraryDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:OpenVisionLab.MachineStudio.Localization"
             xmlns:conv="clr-namespace:OpenVisionLab.MachineStudio.Converter"
             xmlns:layouts="clr-namespace:OpenVisionLab.Machine.Core.Layouts;assembly=OpenVisionLab.Machine.Core"
             xmlns:devices="clr-namespace:OpenVisionLab.Machine.Core.Devices;assembly=OpenVisionLab.Machine.Core"
             AutomationProperties.Name="{loc:Loc Key=Equipment.LibraryDialogTitle}"
             Foreground="{DynamicResource ApprovedDeviceAdd.ControlForeground}"
             Focusable="True"
             FocusManager.IsFocusScope="True"
             FocusManager.FocusedElement="{Binding ElementName=LibrarySearchTextBox}"
             KeyboardNavigation.TabNavigation="Cycle"
             Visibility="{Binding IsEquipmentComponentLibraryDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/OpenVisionLab.MachineStudio;component/Theme/ApprovedDeviceAddTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:BooleanToVisibilityConverter x:Key="LibraryBooleanToVisibilityConverter" />
            <SolidColorBrush x:Key="Library.DialogSurface" Color="#122833" />
            <SolidColorBrush x:Key="Library.DialogOutline" Color="#5A7B88" />
            <SolidColorBrush x:Key="Library.Divider" Color="#2F4A57" />
            <SolidColorBrush x:Key="Library.InputSurface" Color="#0F1D26" />
            <SolidColorBrush x:Key="Library.InputBorder" Color="#3E5E6C" />
            <SolidColorBrush x:Key="Library.DetailText" Color="#7D96A3" />
            <SolidColorBrush x:Key="Library.HeightSensor" Color="#B48FF0" />
            <Style TargetType="TextBlock" BasedOn="{StaticResource ApprovedDeviceAddTextBlockStyle}">
                <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic" />
            </Style>
            <Style TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
                <Setter Property="Foreground" Value="{StaticResource ApprovedDeviceAdd.TextPrimary}" />
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="{StaticResource ApprovedDeviceAdd.TextPrimary}" />
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="LibraryListButtonStyle" TargetType="Button" BasedOn="{StaticResource QuietCommandButtonStyle}">
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="LibrarySearchStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Background" Value="{DynamicResource Library.InputSurface}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Library.InputBorder}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="InputBorder" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                    CornerRadius="4">
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Padding="0"
                                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource Accent.Hover}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.55" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="LibraryUnitStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                <Setter Property="Foreground" Value="{StaticResource ApprovedDeviceAdd.ControlForeground}" />
                <Setter Property="Background" Value="{DynamicResource Library.InputSurface}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Library.InputBorder}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <Border x:Name="InputBorder" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                                    <Grid>
                                        <ToggleButton Style="{x:Null}" OverridesDefaultStyle="True"
                                                      Focusable="False" IsTabStop="False" ClickMode="Press"
                                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="Transparent" />
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>
                                        <ContentPresenter Margin="7,4,28,4" IsHitTestVisible="False"
                                                          VerticalAlignment="Center"
                                                          Content="{TemplateBinding SelectionBoxItem}"
                                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                                        <TextBlock Margin="0,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   IsHitTestVisible="False" Text="⌄" Foreground="{TemplateBinding Foreground}" />
                                    </Grid>
                                </Border>
                                <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                       IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False">
                                    <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                            Background="{DynamicResource Library.DialogSurface}"
                                            BorderBrush="{DynamicResource Library.InputBorder}" BorderThickness="1" CornerRadius="4">
                                        <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" CanContentScroll="True"
                                                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource Accent.Hover}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.55" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseEquipmentComponentLibraryDialogCommand}" />
    </UserControl.InputBindings>
    <Grid Background="Transparent">
        <Border Background="{DynamicResource Surface.Root}" Opacity="0.69" />
        <Border Width="900"
                MaxWidth="900"
                MaxHeight="850"
                Margin="20"
                Padding="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource Library.DialogSurface}"
                BorderBrush="{DynamicResource Library.DialogOutline}"
                BorderThickness="1"
                CornerRadius="9">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border BorderBrush="{DynamicResource Library.Divider}"
                        BorderThickness="0,0,0,1"
                        Padding="18,13">
                    <TextBlock FontSize="16" LineHeight="23.2"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Text.Primary}"
                               TextWrapping="Wrap"
                               Text="{loc:Loc Key=Equipment.LibraryDialogTitle}" />
                </Border>
                <Grid Grid.Row="1" Margin="18,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <Label Content="{loc:Loc Key=Equipment.LibraryTargetUnit}" Target="{Binding ElementName=LibraryUnitCombo}" Padding="0,0,0,3" FontSize="12" />
                            <ComboBox x:Name="LibraryUnitCombo"
                                      Height="Auto" MinHeight="28" Style="{StaticResource LibraryUnitStyle}"
                                      ItemsSource="{Binding EquipmentComponentLibraryUnits}"
                                      SelectedValuePath="Key"
                                      SelectedValue="{Binding EquipmentComponentLibraryUnitId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      AutomationProperties.Name="{loc:Loc Key=Equipment.LibraryTargetUnit}"
                                      IsEnabled="{Binding IsSceneEditable}"
                                      HorizontalContentAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Value}" Foreground="{StaticResource ApprovedDeviceAdd.TextPrimary}" TextWrapping="Wrap" MaxWidth="240" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Label Content="{loc:Loc Key=Equipment.LibraryTypeSearch}" Target="{Binding ElementName=LibrarySearchTextBox}" Padding="0,0,0,3" FontSize="12" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="LibrarySearchTextBox"
                                         Height="28" MinHeight="28" Style="{StaticResource LibrarySearchStyle}"
                                         FontFamily="Segoe UI, Malgun Gothic"
                                         Padding="7,4,28,4"
                                         VerticalContentAlignment="Center"
                                         Text="{Binding Layout.LibrarySearchText, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="{loc:Loc Key=Equipment.LibrarySearchLabel}" />
                                <TextBlock x:Name="LibrarySearchPlaceholder" Margin="8,0,28,0" VerticalAlignment="Center"
                                           IsHitTestVisible="False" FontSize="12" Foreground="{DynamicResource Library.DetailText}"
                                           Text="{loc:Loc Key=Equipment.LibrarySearchPlaceholder}"
                                           Visibility="{Binding Layout.IsLibrarySearchEmpty, Converter={StaticResource LibraryBooleanToVisibilityConverter}}" />
                                <Button Grid.Column="1"
                                        Width="24"
                                        Height="24"
                                        MinWidth="24"
                                        MinHeight="0"
                                        Margin="-27,2,2,2"
                                        Padding="0"
                                        HorizontalAlignment="Right"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        Foreground="{DynamicResource Text.Secondary}"
                                        Command="{Binding Layout.ClearLibrarySearchCommand}"
                                        ToolTip="{loc:Loc Key=Equipment.LibrarySearchClear}"
                                        AutomationProperties.Name="{loc:Loc Key=Equipment.LibrarySearchClear}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource GlobalCommandButtonStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Layout.IsLibrarySearchEmpty}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="×" FontSize="16" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" MinHeight="100">
                        <ScrollViewer x:Name="LibraryListScroll" MaxHeight="576"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding EquipmentComponentLibraryItems}"
                                          AutomationProperties.HelpText="{loc:Loc Key=Equipment.LibraryAddHint}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Height="Auto" MinHeight="48"
                                                Margin="0"
                                                Padding="6,4"
                                                HorizontalContentAlignment="Stretch"
                                                AutomationProperties.Name="{Binding Name}"
                                                AutomationProperties.HelpText="{Binding Description}"
                                                Command="{Binding DataContext.AddEquipmentComponentFromLibraryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource LibraryListButtonStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="19" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Symbol}" FontFamily="Segoe UI Symbol" FontSize="13" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                            <Setter Property="Foreground" Value="{DynamicResource Scene.Component.Conveyor}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static layouts:LayoutComponentKind.DigitalSensor}">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Scene.Component.Sensor}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static layouts:LayoutComponentKind.LinearStage}">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Scene.Component.Axis}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static layouts:LayoutComponentKind.RotaryStage}">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Scene.Component.Axis}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static layouts:LayoutComponentKind.PneumaticCylinder}">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Scene.Component.Cylinder}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static layouts:LayoutComponentKind.Camera}">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Scene.Component.Camera}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding CameraInputKind}" Value="{x:Static devices:NumericalCameraInputKind.HeightMap3D}">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Library.HeightSensor}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static layouts:LayoutComponentKind.DigitalIo}">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Scene.Component.DigitalIo}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock FontSize="13" LineHeight="18.85"
                                                               Text="{Binding Name}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock FontSize="10.5" LineHeight="15.225"
                                                               Foreground="{DynamicResource Library.DetailText}"
                                                               Text="{Binding Description}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   Text="{loc:Loc Key=Equipment.LibraryNoMatches}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding EquipmentComponentLibraryHasNoMatches, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                    <TextBlock Grid.Row="2"
                               Margin="0,8,0,0"
                               Foreground="{DynamicResource Text.Secondary}"
                               Text="{Binding EquipmentComponentLibraryDialogStatusText}"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EquipmentComponentLibraryDialogStatusText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Row="3" Margin="0,8,0,0"
                               Foreground="{DynamicResource State.Warning}"
                               Text="{Binding EquipmentComponentLibraryUnitValidationText}" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EquipmentComponentLibraryUnitValidationText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <Border Grid.Row="2"
                        BorderBrush="{DynamicResource Library.Divider}"
                        BorderThickness="0,1,0,0"
                        Padding="18,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="LibraryReadOnlyHint" Text="{loc:Loc Key=Equipment.LibraryReadOnlyHint}"
                                       Foreground="{DynamicResource Text.Primary}" TextWrapping="Wrap"
                                       Visibility="{Binding IsSceneEditable, Converter={StaticResource LibraryBooleanToVisibilityConverter}, ConverterParameter=invert}" />
                        </StackPanel>
                        <Button Grid.Column="2" MinWidth="48" Height="Auto"
                                MinHeight="28" Margin="0" Padding="7,4"
                                HorizontalAlignment="Right"
                                Command="{Binding CloseEquipmentComponentLibraryDialogCommand}"
                                Content="{loc:Loc Key=Gallery.Close}"
                                AutomationProperties.Name="{loc:Loc Key=Gallery.Close}"
                                Style="{StaticResource GlobalCommandButtonStyle}" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
