                            BorderThickness="1"
                            CornerRadius="6"
                            Visibility="{Binding RecipeConnections.IsOhtHandoffSetupVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <DockPanel LastChildFill="True"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="10,0,0,0"><Button x:Name="ApplyOhtSetupButton" Command="{Binding RecipeConnections.ApplyOhtHandoffSetupCommand}" AutomationProperties.Name="{loc:Loc Key=Connections.SemanticSetupApply}" Style="{StaticResource PrimaryCommandButtonStyle}"><TextBlock Text="{loc:Loc Key=Connections.SemanticSetupApply}" /></Button><Button Margin="6,0,0,0" Command="{Binding RecipeConnections.CancelOhtHandoffSetupCommand}" AutomationProperties.Name="{loc:Loc Key=Connections.SemanticSetupClose}" Style="{StaticResource QuietCommandButtonStyle}"><TextBlock Text="{loc:Loc Key=Connections.SemanticSetupClose}" /></Button><Button Margin="6,0,0,0" Command="{Binding RecipeConnections.ResetOhtHandoffSetupCommand}" AutomationProperties.Name="{loc:Loc Key=Connections.SemanticSetupReset}" Style="{StaticResource QuietCommandButtonStyle}"><TextBlock Text="{loc:Loc Key=Connections.SemanticSetupReset}" /></Button></StackPanel><StackPanel><TextBlock FontWeight="SemiBold" Text="{loc:Loc Key=Connections.OhtSetupTitle}" /><TextBlock Margin="0,2,0,0" Foreground="{DynamicResource Text.Secondary}" Text="{loc:Loc Key=Connections.SemanticSetupHint}" TextWrapping="Wrap" /></StackPanel></DockPanel>
