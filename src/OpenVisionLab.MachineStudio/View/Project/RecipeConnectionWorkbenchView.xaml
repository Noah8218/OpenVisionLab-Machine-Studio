<UserControl x:Class="OpenVisionLab.MachineStudio.View.Project.RecipeConnectionWorkbenchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behavior="clr-namespace:OpenVisionLab.MachineStudio.Behavior"
             xmlns:layouts="clr-namespace:OpenVisionLab.Machine.Core.Layouts;assembly=OpenVisionLab.Machine.Core"
             xmlns:loc="clr-namespace:OpenVisionLab.MachineStudio.Localization"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:OpenVisionLab.MachineStudio.View.Project">
    <UserControl.Resources>
        <Style x:Key="StationSetupTextBoxStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="False">
                    <Setter Property="BorderBrush" Value="{DynamicResource State.Fault}" />
                    <Setter Property="BorderThickness" Value="1" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LoadLockSetupComboBoxStyle"
               TargetType="ComboBox"
               BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="False">
                    <Setter Property="BorderBrush" Value="{DynamicResource State.Fault}" />
                    <Setter Property="BorderThickness" Value="1" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LoadLockSetupFieldStyle" TargetType="StackPanel">
            <Setter Property="Width" Value="190" />
            <Setter Property="Margin" Value="0,0,7,6" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompactLayout}" Value="True">
                    <Setter Property="Width" Value="158" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LoadLockSetupTimingFieldStyle"
               TargetType="StackPanel"
               BasedOn="{StaticResource LoadLockSetupFieldStyle}">
            <Setter Property="Width" Value="130" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompactLayout}" Value="True">
                    <Setter Property="Width" Value="122" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Border Style="{StaticResource PanelSurfaceStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource PanelHeaderStyle}">
                <TextBlock Style="{StaticResource PanelHeaderTextStyle}"
                           Text="{loc:Loc Key=Connections.Title}" />
            </Border>

            <ScrollViewer Grid.Row="1"
                          MaxHeight="500"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <Border Margin="10,8,10,4"
                        Padding="12,10"
                        Background="{DynamicResource Surface.Raised}"
                        BorderBrush="{DynamicResource Border.Subtle}"
                        BorderThickness="1"
                        CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <local:RecipeConnectionQuickAddView Grid.RowSpan="4" />
                    <Border x:Name="SemiconductorProcessBlockPreview"
                            Grid.Row="4"
                            Margin="0,10,0,0"
                            Padding="10,8"
                            Background="{DynamicResource Surface.Panel}"
                            BorderBrush="{DynamicResource Border.Subtle}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Visibility="{Binding RecipeConnections.ProcessBlocks.IsProcessBlockPreviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Right"
                                            Margin="10,0,0,0"
                                            Orientation="Horizontal">
                                    <Button x:Name="ApplySemiconductorProcessBlockButton"
                                            Command="{Binding RecipeConnections.ProcessBlocks.ApplyProcessBlockCommand}"
                                            AutomationProperties.Name="{loc:Loc Key=Connections.ProcessBlockApply}"
                                            Style="{StaticResource PrimaryCommandButtonStyle}"
                                            ToolTip="{loc:Loc Key=Connections.ProcessBlockEditApplyTooltip}">
                                        <TextBlock Text="{Binding RecipeConnections.ProcessBlocks.ProcessBlockApplyText}" />
                                    </Button>
                                    <Button x:Name="CancelSemiconductorProcessBlockButton"
                                            Margin="6,0,0,0"
                                            Command="{Binding RecipeConnections.ProcessBlocks.CancelProcessBlockCommand}"
                                            AutomationProperties.Name="{loc:Loc Key=Connections.ProcessBlockClose}"
                                            Style="{StaticResource QuietCommandButtonStyle}"
                                            ToolTip="{loc:Loc Key=Connections.ProcessBlockCloseTooltip}">
                                        <TextBlock Text="{loc:Loc Key=Connections.ProcessBlockClose}" />
                                    </Button>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold">
                                        <Run Text="{loc:Loc Key=Connections.ProcessBlockTitle}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding RecipeConnections.ProcessBlocks.ProcessBlockKindText, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Margin="0,2,0,0"
                                               Foreground="{DynamicResource Text.Secondary}"
                                               Text="{Binding RecipeConnections.ProcessBlocks.ProcessBlockSummaryText}" />
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Margin="0,5,0,0"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{loc:Loc Key=Connections.ProcessBlockEditHint}"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsCompactLayout}" Value="True" />
                                                    <Condition Binding="{Binding RecipeConnections.ProcessBlocks.IsProcessBlockTimeoutPreviewVisible}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <WrapPanel Margin="0,7,0,1"
                                       IsEnabled="{Binding RecipeConnections.IsEditable}">
                                <CheckBox x:Name="ProcessBlockLoadCheckBox"
                                          Margin="0,0,14,5"
                                          AutomationProperties.Name="{loc:Loc Key=Connections.ProcessBlock.Load}"
                                          Content="{loc:Loc Key=Connections.ProcessBlock.Load}"
                                          IsChecked="{Binding RecipeConnections.ProcessBlocks.IsLoadBlockSelected, Mode=TwoWay}" />
                                <CheckBox x:Name="ProcessBlockAlignCheckBox"
                                          Margin="0,0,14,5"
                                          AutomationProperties.Name="{loc:Loc Key=Connections.ProcessBlock.Align}"
                                          Content="{loc:Loc Key=Connections.ProcessBlock.Align}"
                                          IsChecked="{Binding RecipeConnections.ProcessBlocks.IsAlignBlockSelected, Mode=TwoWay}" />
                                <CheckBox x:Name="ProcessBlockProcessCheckBox"
                                          Margin="0,0,14,5"
                                          AutomationProperties.Name="{loc:Loc Key=Connections.ProcessBlock.Process}"
                                          Content="{loc:Loc Key=Connections.ProcessBlock.Process}"
                                          IsChecked="{Binding RecipeConnections.ProcessBlocks.IsProcessBlockSelected, Mode=TwoWay}" />
                                <CheckBox x:Name="ProcessBlockInspectCheckBox"
                                          Margin="0,0,14,5"
                                          AutomationProperties.Name="{loc:Loc Key=Connections.ProcessBlock.Inspect}"
                                          Content="{loc:Loc Key=Connections.ProcessBlock.Inspect}"
                                          IsChecked="{Binding RecipeConnections.ProcessBlocks.IsInspectBlockSelected, Mode=TwoWay}" />
                                <CheckBox x:Name="ProcessBlockUnloadCheckBox"
                                          Margin="0,0,0,5"
                                          AutomationProperties.Name="{loc:Loc Key=Connections.ProcessBlock.Unload}"
                                          Content="{loc:Loc Key=Connections.ProcessBlock.Unload}"
                                          IsChecked="{Binding RecipeConnections.ProcessBlocks.IsUnloadBlockSelected, Mode=TwoWay}" />
                            </WrapPanel>
                            <TextBlock Margin="0,1,0,0"
                                       FontSize="11"
                                       Text="{Binding RecipeConnections.ProcessBlocks.ProcessBlockValidationText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RecipeConnections.ProcessBlocks.HasProcessBlockPlanError}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource State.Warning}" />
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsCompactLayout}" Value="True" />
                                                    <Condition Binding="{Binding RecipeConnections.ProcessBlocks.IsProcessBlockTimeoutPreviewVisible}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ItemsControl Margin="0,3,0,0"
                                          ItemsSource="{Binding RecipeConnections.ProcessBlocks.ProcessBlockConnectionItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,6,5"
                                                Padding="7,4"
                                                Background="{DynamicResource Surface.Raised}"
                                                BorderBrush="{DynamicResource Border.Subtle}"
                                                BorderThickness="1"
                                                CornerRadius="4">
                                            <StackPanel>
                                                <TextBlock FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource State.Vision}"
                                                           Text="{Binding RoleText}" />
                                                <TextBlock Margin="0,2,0,0"
                                                           FontFamily="{StaticResource Typography.Telemetry}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource Text.Secondary}"
                                                           Text="{Binding DetailText}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <WrapPanel Margin="0,4,0,1">
                                <TextBlock Margin="0,0,7,4"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           Text="{loc:Loc Key=Connections.ProcessBlockFilterLabel}" />
                                <RadioButton x:Name="ProcessBlockFilterAllRadioButton"
                                             Margin="0,0,5,4"
                                             AutomationProperties.Name="{loc:Loc Key=Connections.ProcessBlockFilterAll}"
                                             Content="{Binding RecipeConnections.ProcessBlocks.ProcessBlockFilterAllText}"
                                             GroupName="ProcessBlockItemFilter"
                                             IsChecked="{Binding RecipeConnections.ProcessBlocks.IsProcessBlockFilterAll, Mode=TwoWay}"
                                             Style="{StaticResource WorkspaceModeRadioStyle}" />
                                <RadioButton x:Name="ProcessBlockFilterCustomizedRadioButton"
                                             Margin="0,0,5,4"
                                             AutomationProperties.Name="{loc:Loc Key=Connections.ProcessBlockStepCustomized}"
                                             Content="{Binding RecipeConnections.ProcessBlocks.ProcessBlockFilterCustomizedText}"
                                             GroupName="ProcessBlockItemFilter"
                                             IsChecked="{Binding RecipeConnections.ProcessBlocks.IsProcessBlockFilterCustomized, Mode=TwoWay}"
                                             Style="{StaticResource WorkspaceModeRadioStyle}" />
                                <RadioButton x:Name="ProcessBlockFilterRemovalRadioButton"
                                             Margin="0,0,5,4"
                                             AutomationProperties.Name="{loc:Loc Key=Connections.ProcessBlockStepProposedRemoval}"
                                             Content="{Binding RecipeConnections.ProcessBlocks.ProcessBlockFilterRemovalText}"
                                             GroupName="ProcessBlockItemFilter"
                                             IsChecked="{Binding RecipeConnections.ProcessBlocks.IsProcessBlockFilterRemoval, Mode=TwoWay}"
                                             Style="{StaticResource WorkspaceModeRadioStyle}" />
                                <RadioButton x:Name="ProcessBlockFilterConflictRadioButton"
                                             Margin="0,0,0,4"
                                             AutomationProperties.Name="{loc:Loc Key=Connections.ProcessBlockFilterConflict}"
                                             Content="{Binding RecipeConnections.ProcessBlocks.ProcessBlockFilterConflictText}"
                                             GroupName="ProcessBlockItemFilter"
                                             IsChecked="{Binding RecipeConnections.ProcessBlocks.IsProcessBlockFilterConflict, Mode=TwoWay}"
                                             Style="{StaticResource WorkspaceModeRadioStyle}" />
                            </WrapPanel>
                            <Border x:Name="ProcessBlockTimeoutAdjustmentPanel"
                                    Margin="0,3,0,5"
                                    Padding="8,6"
                                    Background="{DynamicResource Surface.Raised}"
                                    BorderBrush="{DynamicResource Border.Subtle}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <StackPanel>
                                    <WrapPanel IsEnabled="{Binding RecipeConnections.IsEditable}">
                                        <TextBlock Margin="0,0,7,4"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Text="{loc:Loc Key=Connections.ProcessBlockTimeoutTitle}" />
                                        <TextBox x:Name="ProcessBlockTimeoutTextBox"
                                                 Width="92"
                                                 Margin="0,0,5,4"
                                                 Tag="{Binding RecipeConnections.ProcessBlocks.IsProcessBlockTimeoutValid}"
                                                 AutomationProperties.Name="{loc:Loc Key=Connections.ProcessBlockTimeoutInput}"
                                                 Style="{StaticResource StationSetupTextBoxStyle}"
                                                 Text="{Binding RecipeConnections.ProcessBlocks.ProcessBlockTimeoutText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Margin="0,0,7,4"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{StaticResource Typography.Telemetry}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource Text.Secondary}"
                                                   Text="ms" />
                                        <Button x:Name="PreviewProcessBlockTimeoutButton"
                                                Margin="0,0,5,4"
                                                Command="{Binding RecipeConnections.ProcessBlocks.PreviewProcessBlockTimeoutsCommand}"
                                                AutomationProperties.Name="{loc:Loc Key=Connections.ProcessBlockTimeoutPreview}"
                                                Content="{loc:Loc Key=Connections.ProcessBlockTimeoutPreview}"
                                                Style="{StaticResource QuietCommandButtonStyle}"
                                                ToolTip="{loc:Loc Key=Connections.ProcessBlockTimeoutPreviewTooltip}" />
                                        <Button x:Name="ApplyProcessBlockTimeoutButton"
                                                Margin="0,0,5,4"
                                                Command="{Binding RecipeConnections.ProcessBlocks.ApplyProcessBlockTimeoutsCommand}"
                                                AutomationProperties.Name="{loc:Loc Key=Connections.ProcessBlockTimeoutApply}"
                                                Content="{Binding RecipeConnections.ProcessBlocks.ProcessBlockTimeoutApplyText}"
                                                Style="{StaticResource PrimaryCommandButtonStyle}"
                                                ToolTip="{loc:Loc Key=Connections.ProcessBlockTimeoutApplyTooltip}"
                                                Visibility="{Binding RecipeConnections.ProcessBlocks.IsProcessBlockTimeoutPreviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <Button x:Name="CancelProcessBlockTimeoutButton"
                                                Margin="0,0,0,4"
                                                Command="{Binding RecipeConnections.ProcessBlocks.CancelProcessBlockTimeoutsCommand}"
                                                AutomationProperties.Name="{loc:Loc Key=Connections.ProcessBlockTimeoutCancel}"
                                                Content="{loc:Loc Key=Connections.ProcessBlockTimeoutCancel}"
                                                Style="{StaticResource QuietCommandButtonStyle}"
                                                ToolTip="{loc:Loc Key=Connections.ProcessBlockTimeoutCancelTooltip}"
                                                Visibility="{Binding RecipeConnections.ProcessBlocks.IsProcessBlockTimeoutPreviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </WrapPanel>
                                    <TextBlock FontSize="10.5"
                                               Foreground="{DynamicResource Text.Secondary}"
                                               Text="{Binding RecipeConnections.ProcessBlocks.ProcessBlockTimeoutScopeText}" />
                                    <TextBlock Margin="0,2,0,0"
                                               FontSize="10.5"
                                               Text="{Binding RecipeConnections.ProcessBlocks.ProcessBlockTimeoutValidationText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RecipeConnections.ProcessBlocks.IsProcessBlockTimeoutValid}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource State.Fault}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RecipeConnections.ProcessBlocks.IsProcessBlockTimeoutPreviewVisible}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource State.Running}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ItemsControl x:Name="ProcessBlockTimeoutItemsControl"
                                                  Margin="0,5,0,0"
                                                  ItemsSource="{Binding RecipeConnections.ProcessBlocks.ProcessBlockTimeoutItems}"
                                                  Visibility="{Binding RecipeConnections.ProcessBlocks.IsProcessBlockTimeoutPreviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,6,4"
                                                        Padding="6,3"
                                                        Background="{DynamicResource Surface.Panel}"
                                                        BorderBrush="{DynamicResource Border.Subtle}"
                                                        BorderThickness="1"
                                                        CornerRadius="3">
                                                    <StackPanel>
                                                        <TextBlock FontSize="10.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource Accent.Primary}"
                                                                   Text="{Binding StepText}" />
                                                        <TextBlock Margin="0,1,0,0"
                                                                   FontFamily="{StaticResource Typography.Telemetry}"
                                                                   FontSize="9.5"
                                                                   Foreground="{DynamicResource Text.Secondary}"
                                                                   Text="{Binding DetailText}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <ListBox x:Name="ProcessBlockItemsListBox"
                                     Margin="0,3,0,0"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ItemsSource="{Binding RecipeConnections.ProcessBlocks.VisibleProcessBlockItems}"
                                     SelectedItem="{Binding RecipeConnections.ProcessBlocks.SelectedProcessBlockItem, Mode=TwoWay}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <b:Interaction.Behaviors>
                                    <behavior:ListBoxScrollIntoViewBehavior />
                                </b:Interaction.Behaviors>
                                <ListBox.Style>
                                    <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                        <Setter Property="MaxHeight" Value="170" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCompactLayout}" Value="True">
                                                <Setter Property="MaxHeight" Value="105" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.Style>
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,6,5"
                                                Padding="7,4"
                                                BorderThickness="1"
                                                CornerRadius="4">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource Surface.Raised}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource Surface.Selected}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding StepText}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsProposed}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource State.Vision}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsAlreadyConfigured}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource State.Running}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsCustomized}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Accent.Primary}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsProposedRemoval}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource State.Warning}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsUnavailable}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource State.Warning}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    </TextBlock>
                                                    <Button x:Name="OpenProcessBlockSequenceStepButton"
                                                            Grid.Column="1"
                                                            Width="24"
                                                            Height="22"
                                                            MinWidth="24"
                                                            Margin="5,-2,-4,-2"
                                                            Padding="2"
                                                            Command="{Binding DataContext.RecipeConnections.OpenSequenceStepCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                                            CommandParameter="{Binding}"
                                                            AutomationProperties.Name="{loc:Loc Key=Connections.OpenStep}"
                                                            Style="{StaticResource QuietCommandButtonStyle}"
                                                            ToolTip="{loc:Loc Key=Connections.OpenStepTooltip}"
                                                            Visibility="{Binding CanOpenSequenceStep, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <ui:SymbolIcon Symbol="Next24" />
                                                    </Button>
                                                </Grid>
                                                <TextBlock Margin="0,2,0,0"
                                                           FontFamily="{StaticResource Typography.Telemetry}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource Text.Secondary}"
                                                           TextWrapping="Wrap"
                                                           Text="{Binding DetailText}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Margin="0,4,0,1"
                                       FontSize="11"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{loc:Loc Key=Connections.ProcessBlockFilterEmpty}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RecipeConnections.ProcessBlocks.HasVisibleProcessBlockItems}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border x:Name="LoadLockSetupPreview"
                            Grid.Row="4"
                            Margin="0,10,0,0"
                            Padding="10,8"
                            Background="{DynamicResource Surface.Panel}"
                            BorderBrush="{DynamicResource Border.Subtle}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Visibility="{Binding RecipeConnections.LoadLocks.IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Right"
                                            Margin="10,0,0,0"
                                            Orientation="Horizontal">
                                    <Button x:Name="ApplyLoadLockSetupButton"
                                            Command="{Binding RecipeConnections.LoadLocks.ApplyCommand}"
                                            AutomationProperties.Name="{loc:Loc Key=Connections.LoadLockSetupApply}"
                                            Style="{StaticResource PrimaryCommandButtonStyle}"
                                            ToolTip="{loc:Loc Key=Connections.LoadLockSetupApplyTooltip}">
                                        <TextBlock Text="{loc:Loc Key=Connections.LoadLockSetupApply}" />
                                    </Button>
                                    <Button x:Name="CancelLoadLockSetupButton"
                                            Margin="6,0,0,0"
                                            Command="{Binding RecipeConnections.LoadLocks.CancelCommand}"
                                            AutomationProperties.Name="{loc:Loc Key=Connections.LoadLockSetupClose}"
                                            Style="{StaticResource QuietCommandButtonStyle}"
                                            ToolTip="{loc:Loc Key=Connections.LoadLockSetupCloseTooltip}">
                                        <TextBlock Text="{loc:Loc Key=Connections.LoadLockSetupClose}" />
                                    </Button>
                                    <Button x:Name="ResetLoadLockSetupButton"
                                            Margin="6,0,0,0"
                                            Command="{Binding RecipeConnections.LoadLocks.ResetCommand}"
                                            AutomationProperties.Name="{loc:Loc Key=Connections.LoadLockSetupReset}"
                                            Style="{StaticResource QuietCommandButtonStyle}"
                                            ToolTip="{loc:Loc Key=Connections.LoadLockSetupResetTooltip}">
                                        <TextBlock Text="{loc:Loc Key=Connections.LoadLockSetupReset}" />
                                    </Button>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold"
                                               Text="{loc:Loc Key=Connections.LoadLockSetupTitle}" />
                                    <TextBlock Margin="0,2,0,0"
                                               Foreground="{DynamicResource Text.Secondary}"
                                               Text="{loc:Loc Key=Connections.LoadLockSetupScope}" />
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Margin="0,5,0,0"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{loc:Loc Key=Connections.LoadLockSetupHint}"
                                       TextWrapping="Wrap" />
                            <WrapPanel Margin="0,8,0,0"
                                       IsEnabled="{Binding RecipeConnections.IsEditable}">
                                <StackPanel Style="{StaticResource LoadLockSetupFieldStyle}">
