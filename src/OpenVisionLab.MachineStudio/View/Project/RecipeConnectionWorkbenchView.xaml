                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,5,4"
                                                Padding="6,3"
                                                Background="{DynamicResource Surface.Raised}"
                                                BorderThickness="1"
                                                CornerRadius="4">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLoadLock}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource State.Vision}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsWaferHandler}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource State.Vision}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsInspectionSorter}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource State.Vision}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsInspectionHandoff}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource State.Vision}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsPrealigner}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource State.Vision}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsFault}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource State.Fault}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontFamily="{StaticResource Typography.Telemetry}"
                                                       FontSize="11"
                                                       Text="{Binding Text}"
                                                       ToolTip="{Binding Text}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLoadLock}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource State.Vision}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsWaferHandler}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource State.Vision}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsInspectionSorter}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource State.Vision}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsInspectionHandoff}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource State.Vision}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsPrealigner}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource State.Vision}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsFault}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource State.Fault}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Margin="0,3,0,3"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{loc:Loc Key=Connections.DryRunTimeline}" />
                            <ListBox x:Name="RecipeDryRunTimelineListBox"
                                     ItemsSource="{Binding RecipeConnections.DryRun.Timeline}"
                                     SelectedItem="{Binding RecipeConnections.DryRun.SelectedRecipeDryRunStep, Mode=TwoWay}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Margin" Value="0,0,5,4" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Background" Value="{DynamicResource Surface.Raised}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="TimelineStepBorder"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="4">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="TimelineStepBorder" Property="Background" Value="{DynamicResource Surface.Selected}" />
                                                            <Setter TargetName="TimelineStepBorder" Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding HasIssue}" Value="True">
                                                            <Setter TargetName="TimelineStepBorder" Property="BorderBrush" Value="{DynamicResource State.Warning}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HasCheckpointMismatch}" Value="True">
                                                            <Setter TargetName="TimelineStepBorder" Property="BorderBrush" Value="{DynamicResource State.Fault}" />
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Command="{Binding DataContext.RecipeConnections.DryRun.OpenRecipeDryRunStepCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                                    CommandParameter="{Binding}"
                                                    AutomationProperties.Name="{Binding Name}"
                                                    Style="{StaticResource QuietCommandButtonStyle}"
                                                    ToolTip="{loc:Loc Key=Connections.DryRunOpenStepTooltip}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Margin="0,0,4,0"
                                                               FontFamily="{StaticResource Typography.Telemetry}"
                                                               Foreground="{DynamicResource Accent.Primary}"
                                                               Text="{Binding OrderText}" />
                                                    <TextBlock MaxWidth="180"
                                                               Text="{Binding Name}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Margin="5,0,0,0"
                                                               FontFamily="{StaticResource Typography.Telemetry}"
                                                               Foreground="{DynamicResource Text.Secondary}"
                                                               Text="{Binding TickText}" />
                                                    <TextBlock MaxWidth="190"
                                                               Margin="5,0,0,0"
                                                               FontFamily="{StaticResource Typography.Telemetry}"
                                                               Foreground="{DynamicResource State.Warning}"
                                                               Text="{Binding CheckpointText}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding CheckpointText}"
                                                               Visibility="{Binding HasCheckpoint, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    <ui:SymbolIcon Margin="5,0,0,0"
                                                                   Symbol="Next24"
                                                                   Foreground="{DynamicResource Accent.Primary}" />
                                                </StackPanel>
                                            </Button>
                                            <Button Width="28"
                                                    Margin="2,0,0,0"
                                                    Padding="0"
                                                    AutomationProperties.Name="{loc:Loc Key=Connections.DryRunPlaybackOpen}"
                                                     Command="{Binding DataContext.RecipeConnections.DryRun.PlayRecipeDryRunStepCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource QuietCommandButtonStyle}"
                                                    ToolTip="{loc:Loc Key=Connections.DryRunPlaybackOpenTooltip}">
                                                <ui:SymbolIcon Symbol="Play24" Foreground="{DynamicResource State.Warning}" />
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                </Grid>
                </Border>
            </ScrollViewer>

            <ListBox x:Name="ConnectionRowsListBox"
                     Grid.Row="2"
                     Margin="7,4,7,8"
                     ItemsSource="{Binding RecipeConnections.Rows}"
                     SelectedItem="{Binding RecipeConnections.SelectedRow, Mode=TwoWay}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <b:Interaction.Behaviors>
                    <behavior:ListBoxScrollIntoViewBehavior />
                </b:Interaction.Behaviors>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Margin" Value="3,2" />
                        <Setter Property="Padding" Value="11,8" />
                        <Setter Property="Background" Value="{DynamicResource Surface.Raised}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ConnectionCard"
                                            Padding="{TemplateBinding Padding}"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="5">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ConnectionCard" Property="Background" Value="{DynamicResource Surface.Hover}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ConnectionCard" Property="Background" Value="{DynamicResource Surface.Selected}" />
                                            <Setter TargetName="ConnectionCard" Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseCaptured" Value="True">
                                            <Setter TargetName="ConnectionCard" Property="Background" Value="{DynamicResource Accent.Soft}" />
                                            <Setter TargetName="ConnectionCard" Property="BorderBrush" Value="{DynamicResource Accent.Hover}" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="ConnectionCard" Property="Background" Value="{DynamicResource Surface.Panel}" />
                                            <Setter TargetName="ConnectionCard" Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ToolTip="{Binding ValidationText}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="112" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal">
                                <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding Name}" />
                                <TextBlock Margin="8,2,0,0"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           Text="{Binding KindText}" />
                                <TextBlock Margin="8,2,0,0"
                                           FontFamily="{StaticResource Typography.Telemetry}"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           Text="{Binding ComponentId}" />
                                <Border Margin="10,0,0,0"
                                        Padding="7,2"
                                        Background="{DynamicResource Surface.Panel}"
                                        CornerRadius="8">
                                    <TextBlock Text="{Binding StatusText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource State.Running}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource State.Warning}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Margin="0,7,8,0" Foreground="{DynamicResource Text.Secondary}" Text="{loc:Loc Key=Connections.Behavior}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,7,0,0" Text="{Binding BehaviorText}" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="2" Margin="0,4,8,0" Foreground="{DynamicResource Text.Secondary}" Text="{loc:Loc Key=Connections.IoAndTarget}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,4,0,0" FontFamily="{StaticResource Typography.Telemetry}" Text="{Binding ConnectionText}" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="3" Margin="0,4,8,0" Foreground="{DynamicResource Text.Secondary}" Text="{loc:Loc Key=Connections.SequenceUse}" />
                            <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,4,0,0">
                                <TextBlock Text="{Binding SequenceText}" TextWrapping="Wrap" />
                                <WrapPanel Margin="0,5,0,0">
                                    <Button x:Name="OpenConnectionSequenceStepButton"
                                            Margin="0,0,6,0"
                                            Command="{Binding DataContext.RecipeConnections.OpenSequenceStepCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="{loc:Loc Key=Connections.OpenStep}"
                                            ToolTip="{loc:Loc Key=Connections.OpenStepTooltip}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource QuietCommandButtonStyle}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasSequenceUse}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Next24" Foreground="{DynamicResource Accent.Primary}" />
                                            <TextBlock Margin="5,0,0,0" Text="{loc:Loc Key=Connections.OpenStep}" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="PreviewConnectionSequenceStepButton"
                                            Margin="0,0,6,0"
                                            Command="{Binding DataContext.RecipeConnections.SequenceStepPreview.PreviewSequenceStepCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="{loc:Loc Key=Connections.PreviewStep}"
                                            ToolTip="{loc:Loc Key=Connections.PreviewStepTooltip}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource QuietCommandButtonStyle}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanPreviewSequenceStep}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Play24" Foreground="{DynamicResource Accent.Primary}" />
                                            <TextBlock Margin="5,0,0,0" Text="{loc:Loc Key=Connections.PreviewStep}" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="AddConnectionSequenceStepButton"
                                            Command="{Binding DataContext.RecipeConnections.AddSequenceStepCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="{loc:Loc Key=Connections.AddStep}"
                                            ToolTip="{loc:Loc Key=Connections.AddStepTooltip}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource QuietCommandButtonStyle}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanAddSequenceStep}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Add24" Foreground="{DynamicResource Accent.Primary}" />
                                            <TextBlock Margin="5,0,0,0" Text="{loc:Loc Key=Connections.AddStep}" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                                <Border x:Name="PreviewConnectionResult"
                                        Margin="0,7,0,0"
                                        Padding="8,6"
                                        Background="{DynamicResource Surface.Panel}"
                                        BorderBrush="{DynamicResource Border.Subtle}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Visibility="{Binding HasPreviewResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="{Binding PreviewStatusText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPreviewSuccessful}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource State.Running}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsPreviewWarning}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource State.Warning}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Margin="0,2,0,0"
                                                   Foreground="{DynamicResource Text.Secondary}"
                                                   Text="{Binding PreviewDetailText}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</UserControl>
