<UserControl x:Class="OpenVisionLab.MachineStudio.View.Project.RecipeConnectionWorkbenchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behavior="clr-namespace:OpenVisionLab.MachineStudio.Behavior"
             xmlns:layouts="clr-namespace:OpenVisionLab.Machine.Core.Layouts;assembly=OpenVisionLab.Machine.Core"
             xmlns:loc="clr-namespace:OpenVisionLab.MachineStudio.Localization"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <Style x:Key="StationSetupTextBoxStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="False">
                    <Setter Property="BorderBrush" Value="{DynamicResource State.Fault}" />
                    <Setter Property="BorderThickness" Value="1" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LoadLockSetupComboBoxStyle"
               TargetType="ComboBox"
               BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="False">
                    <Setter Property="BorderBrush" Value="{DynamicResource State.Fault}" />
                    <Setter Property="BorderThickness" Value="1" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LoadLockSetupFieldStyle" TargetType="StackPanel">
            <Setter Property="Width" Value="190" />
            <Setter Property="Margin" Value="0,0,7,6" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompactLayout}" Value="True">
                    <Setter Property="Width" Value="158" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LoadLockSetupTimingFieldStyle"
               TargetType="StackPanel"
               BasedOn="{StaticResource LoadLockSetupFieldStyle}">
            <Setter Property="Width" Value="130" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCompactLayout}" Value="True">
                    <Setter Property="Width" Value="122" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Border Style="{StaticResource PanelSurfaceStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource PanelHeaderStyle}">
                <TextBlock Style="{StaticResource PanelHeaderTextStyle}"
                           Text="{loc:Loc Key=Connections.Title}" />
            </Border>

            <Border Grid.Row="1"
                    Margin="10,8,10,4"
                    Padding="12,10"
                    Background="{DynamicResource Surface.Raised}"
                    BorderBrush="{DynamicResource Border.Subtle}"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="{loc:Loc Key=Connections.QuickAddTitle}" />
                        <TextBlock Margin="0,3,0,0"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   Text="{loc:Loc Key=Connections.QuickAddHint}"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsCompactLayout}" Value="True" />
                                                <Condition Binding="{Binding RecipeConnections.IsProcessBlockTimeoutPreviewVisible}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsCompactLayout}" Value="True" />
                                                <Condition Binding="{Binding RecipeConnections.IsLoadLockSetupVisible}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <WrapPanel Grid.Row="1" Margin="0,10,0,0">
                        <Button x:Name="AddConnectionStageButton"
                                Margin="0,0,6,5"
                                Command="{Binding AddLayoutComponentCommand}"
                                CommandParameter="{x:Static layouts:LayoutComponentKind.LinearStage}"
                                AutomationProperties.Name="{loc:Loc Key=Connections.AddStage}"
                                Style="{StaticResource PrimaryCommandButtonStyle}"
                                ToolTip="{loc:Loc Key=Connections.AddStageTooltip}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Add24" Foreground="{DynamicResource Accent.Primary}" />
                                <TextBlock Margin="5,0,0,0" Text="{loc:Loc Key=Connections.AddStage}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="AddConnectionRotaryStageButton"
                                Margin="0,0,6,5"
                                Command="{Binding AddLayoutComponentCommand}"
                                CommandParameter="{x:Static layouts:LayoutComponentKind.RotaryStage}"
                                AutomationProperties.Name="{loc:Loc Key=Connections.AddRotaryStage}"
                                Style="{StaticResource QuietCommandButtonStyle}"
                                ToolTip="{loc:Loc Key=Connections.AddRotaryStageTooltip}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ArrowRotateClockwise24" Foreground="{DynamicResource Accent.Primary}" />
                                <TextBlock Margin="5,0,0,0" Text="{loc:Loc Key=Connections.AddRotaryStage}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="AddConnectionSensorButton"
                                Margin="0,0,6,5"
                                Command="{Binding AddLayoutComponentCommand}"
                                CommandParameter="{x:Static layouts:LayoutComponentKind.DigitalSensor}"
                                AutomationProperties.Name="{loc:Loc Key=Connections.AddSensor}"
                                Style="{StaticResource QuietCommandButtonStyle}"
                                ToolTip="{loc:Loc Key=Connections.AddSensorTooltip}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Add24" Foreground="{DynamicResource Accent.Primary}" />
                                <TextBlock Margin="5,0,0,0" Text="{loc:Loc Key=Connections.AddSensor}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="AddConnectionCylinderButton"
                                Margin="0,0,6,5"
                                Command="{Binding AddLayoutComponentCommand}"
                                CommandParameter="{x:Static layouts:LayoutComponentKind.PneumaticCylinder}"
                                AutomationProperties.Name="{loc:Loc Key=Connections.AddCylinder}"
                                Style="{StaticResource QuietCommandButtonStyle}"
                                ToolTip="{loc:Loc Key=Connections.AddCylinderTooltip}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Add24" Foreground="{DynamicResource Accent.Primary}" />
                                <TextBlock Margin="5,0,0,0" Text="{loc:Loc Key=Connections.AddCylinder}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="AddConnectionConveyorButton"
                                Margin="0,0,6,5"
                                Command="{Binding AddLayoutComponentCommand}"
                                CommandParameter="{x:Static layouts:LayoutComponentKind.Conveyor}"
                                AutomationProperties.Name="{loc:Loc Key=Connections.AddConveyor}"
                                Style="{StaticResource QuietCommandButtonStyle}"
                                ToolTip="{loc:Loc Key=Connections.AddConveyorTooltip}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Add24" Foreground="{DynamicResource Accent.Primary}" />
                                <TextBlock Margin="5,0,0,0" Text="{loc:Loc Key=Connections.AddConveyor}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="AddConnectionWorkpieceButton"
                                Margin="0,0,0,5"
                                Command="{Binding AddLayoutComponentCommand}"
                                CommandParameter="{x:Static layouts:LayoutComponentKind.Workpiece}"
                                AutomationProperties.Name="{loc:Loc Key=Connections.AddWorkpiece}"
                                Style="{StaticResource QuietCommandButtonStyle}"
                                ToolTip="{loc:Loc Key=Connections.AddWorkpieceTooltip}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Add24" Foreground="{DynamicResource Accent.Primary}" />
                                <TextBlock Margin="5,0,0,0" Text="{loc:Loc Key=Connections.AddWorkpiece}" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <Grid Grid.Row="2" Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <WrapPanel>
                                <TextBlock Foreground="{DynamicResource Text.Secondary}"
                                           Text="{Binding RecipeConnections.SummaryText}" />
                                <TextBlock x:Name="RecipeCheckpointCoverageText"
                                           Margin="10,0,0,0"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource State.Vision}"
                                           Text="{Binding RecipeConnections.CheckpointCoverageText}"
                                           ToolTip="{loc:Loc Key=Connections.CheckpointCoverageTooltip}" />
                            </WrapPanel>
                            <WrapPanel Margin="0,4,0,0">
                                <Border Padding="7,2"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource Accent.Soft}"
                                        BorderBrush="{DynamicResource Accent.Primary}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <TextBlock Text="{Binding RecipeConnections.ValidationSummaryText}" />
                                </Border>
                                <Button x:Name="PreviewSemiconductorStationButton"
                                        Margin="7,0,0,0"
                                        Command="{Binding RecipeConnections.PreviewStationSkeletonCommand}"
                                        AutomationProperties.Name="{loc:Loc Key=Connections.StationSkeletonPreview}"
                                        Style="{StaticResource PrimaryCommandButtonStyle}"
                                        ToolTip="{loc:Loc Key=Connections.StationSkeletonPreviewTooltip}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Add24" Foreground="{DynamicResource Accent.Primary}" />
                                        <TextBlock Margin="5,0,0,0"
                                                   Text="{loc:Loc Key=Connections.StationSkeletonPreview}" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="PreviewProcessBlockComposerButton"
                                        Margin="7,0,0,0"
                                        Command="{Binding RecipeConnections.PreviewProcessBlockCommand}"
                                        AutomationProperties.Name="{loc:Loc Key=Connections.ProcessBlockPreview}"
                                        Style="{StaticResource PrimaryCommandButtonStyle}"
                                ToolTip="{loc:Loc Key=Connections.ProcessBlockEditPreviewTooltip}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Add24" Foreground="{DynamicResource Accent.Primary}" />
                                        <TextBlock Margin="5,0,0,0"
                                                   Text="{loc:Loc Key=Connections.ProcessBlockPreview}" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="PreviewLoadLockSetupButton"
                                        Margin="7,0,0,0"
                                        Command="{Binding RecipeConnections.PreviewLoadLockSetupCommand}"
                                        AutomationProperties.Name="{loc:Loc Key=Connections.LoadLockSetupPreview}"
                                        Style="{StaticResource PrimaryCommandButtonStyle}"
                                        ToolTip="{loc:Loc Key=Connections.LoadLockSetupPreviewTooltip}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Add24" Foreground="{DynamicResource Accent.Primary}" />
                                        <TextBlock Margin="5,0,0,0"
                                                   Text="{loc:Loc Key=Connections.LoadLockSetupPreview}" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="PreviewWaferHandlerSetupButton"
                                        Margin="7,0,0,0"
                                        Command="{Binding RecipeConnections.PreviewWaferHandlerSetupCommand}"
                                        AutomationProperties.Name="{loc:Loc Key=Connections.WaferHandlerSetupPreview}"
                                        Style="{StaticResource PrimaryCommandButtonStyle}"
                                        ToolTip="{loc:Loc Key=Connections.WaferHandlerSetupPreviewTooltip}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Next24" Foreground="{DynamicResource Accent.Primary}" />
                                        <TextBlock Margin="5,0,0,0" Text="{loc:Loc Key=Connections.WaferHandlerSetupPreview}" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="PreviewPrealignerSetupButton"
                                        Margin="7,0,0,0"
                                        Command="{Binding RecipeConnections.PreviewPrealignerSetupCommand}"
                                        AutomationProperties.Name="{loc:Loc Key=Connections.PrealignerSetupPreview}"
                                        Style="{StaticResource PrimaryCommandButtonStyle}"
                                        ToolTip="{loc:Loc Key=Connections.PrealignerSetupPreviewTooltip}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ArrowRotateClockwise24" Foreground="{DynamicResource Accent.Primary}" />
                                        <TextBlock Margin="5,0,0,0" Text="{loc:Loc Key=Connections.PrealignerSetupPreview}" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="PreviewInspectionHandoffSetupButton"
                                        Margin="7,0,0,0"
                                        Command="{Binding RecipeConnections.PreviewInspectionHandoffSetupCommand}"
                                        AutomationProperties.Name="{loc:Loc Key=Connections.InspectionHandoffSetupPreview}"
                                        Style="{StaticResource PrimaryCommandButtonStyle}"
                                        ToolTip="{loc:Loc Key=Connections.InspectionHandoffSetupPreviewTooltip}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Next24" Foreground="{DynamicResource Accent.Primary}" />
                                        <TextBlock Margin="5,0,0,0" Text="{loc:Loc Key=Connections.InspectionHandoffSetupPreview}" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="PreviewInspectionSortSetupButton"
                                        Margin="7,0,0,0"
                                        Command="{Binding RecipeConnections.PreviewInspectionSortRouterSetupCommand}"
                                        AutomationProperties.Name="{loc:Loc Key=Connections.InspectionSortSetupPreview}"
                                        Style="{StaticResource PrimaryCommandButtonStyle}"
                                        ToolTip="{loc:Loc Key=Connections.InspectionSortSetupPreviewTooltip}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Next24" Foreground="{DynamicResource Accent.Primary}" />
                                        <TextBlock Margin="5,0,0,0" Text="{loc:Loc Key=Connections.InspectionSortSetupPreview}" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="PreviewOhtSetupButton"
                                        Margin="7,0,0,0"
                                        Command="{Binding RecipeConnections.PreviewOhtHandoffSetupCommand}"
                                        AutomationProperties.Name="{loc:Loc Key=Connections.OhtSetupPreview}"
                                        Style="{StaticResource PrimaryCommandButtonStyle}"
                                        ToolTip="{loc:Loc Key=Connections.OhtSetupPreviewTooltip}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Next24" Foreground="{DynamicResource Accent.Primary}" />
                                        <TextBlock Margin="5,0,0,0" Text="{loc:Loc Key=Connections.OhtSetupPreview}" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="PreviewRecipeCheckpointTemplateButton"
                                        Margin="7,0,0,0"
                                        Command="{Binding RecipeConnections.PreviewCheckpointTemplateCommand}"
                                        AutomationProperties.Name="{loc:Loc Key=Connections.CheckpointTemplatePreview}"
                                        Style="{StaticResource QuietCommandButtonStyle}"
                                        ToolTip="{loc:Loc Key=Connections.CheckpointTemplatePreviewTooltip}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Add24" Foreground="{DynamicResource Accent.Primary}" />
                                        <TextBlock Margin="5,0,0,0"
                                                   Text="{loc:Loc Key=Connections.CheckpointTemplatePreview}" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="ValidateSimulationReadinessButton"
                                    Command="{Binding RecipeConnections.ValidateSimulationReadinessCommand}"
                                    AutomationProperties.Name="{loc:Loc Key=Connections.CheckReadiness}"
                                    Style="{StaticResource QuietCommandButtonStyle}"
                                    ToolTip="{loc:Loc Key=Connections.CheckReadinessTooltip}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Next24" Foreground="{DynamicResource Accent.Primary}" />
                                    <TextBlock Margin="5,0,0,0" Text="{loc:Loc Key=Connections.CheckReadiness}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="RunRecipeDryRunButton"
                                    Margin="6,0,0,0"
                                    Command="{Binding RecipeConnections.RunRecipeDryRunCommand}"
                                    AutomationProperties.Name="{loc:Loc Key=Connections.DryRun}"
                                    Style="{StaticResource PrimaryCommandButtonStyle}"
                                    ToolTip="{loc:Loc Key=Connections.DryRunTooltip}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Play24" Foreground="{DynamicResource Accent.Primary}" />
                                    <TextBlock Margin="5,0,0,0" Text="{loc:Loc Key=Connections.DryRun}" />
                                </StackPanel>
                            </Button>
                            <Border Margin="7,0,0,0"
                                    Padding="8,3"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource Surface.Panel}"
                                    CornerRadius="8">
                                <TextBlock Text="{Binding RecipeConnections.ReadinessStatusText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RecipeConnections.ReadinessPassed}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource State.Running}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RecipeConnections.ReadinessPassed}" Value="False">
                                                    <Setter Property="Foreground" Value="{DynamicResource State.Warning}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="3"
                               Margin="0,6,0,0"
                               Foreground="{DynamicResource Text.Secondary}"
                               Text="{Binding RecipeConnections.ReadinessDetailText}"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                        <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsCompactLayout}" Value="True" />
                                            <Condition Binding="{Binding RecipeConnections.IsProcessBlockTimeoutPreviewVisible}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsCompactLayout}" Value="True" />
                                                <Condition Binding="{Binding RecipeConnections.IsLoadLockSetupVisible}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Border x:Name="SemiconductorProcessBlockPreview"
                            Grid.Row="4"
                            Margin="0,10,0,0"
                            Padding="10,8"
                            Background="{DynamicResource Surface.Panel}"
                            BorderBrush="{DynamicResource Border.Subtle}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Visibility="{Binding RecipeConnections.IsProcessBlockPreviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Right"
                                            Margin="10,0,0,0"
                                            Orientation="Horizontal">
                                    <Button x:Name="ApplySemiconductorProcessBlockButton"
                                            Command="{Binding RecipeConnections.ApplyProcessBlockCommand}"
                                            AutomationProperties.Name="{loc:Loc Key=Connections.ProcessBlockApply}"
                                            Style="{StaticResource PrimaryCommandButtonStyle}"
                                            ToolTip="{loc:Loc Key=Connections.ProcessBlockEditApplyTooltip}">
                                        <TextBlock Text="{Binding RecipeConnections.ProcessBlockApplyText}" />
                                    </Button>
                                    <Button x:Name="CancelSemiconductorProcessBlockButton"
                                            Margin="6,0,0,0"
                                            Command="{Binding RecipeConnections.CancelProcessBlockCommand}"
                                            AutomationProperties.Name="{loc:Loc Key=Connections.ProcessBlockClose}"
                                            Style="{StaticResource QuietCommandButtonStyle}"
                                            ToolTip="{loc:Loc Key=Connections.ProcessBlockCloseTooltip}">
                                        <TextBlock Text="{loc:Loc Key=Connections.ProcessBlockClose}" />
                                    </Button>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold">
                                        <Run Text="{loc:Loc Key=Connections.ProcessBlockTitle}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding RecipeConnections.ProcessBlockKindText, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Margin="0,2,0,0"
                                               Foreground="{DynamicResource Text.Secondary}"
                                               Text="{Binding RecipeConnections.ProcessBlockSummaryText}" />
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Margin="0,5,0,0"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{loc:Loc Key=Connections.ProcessBlockEditHint}"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsCompactLayout}" Value="True" />
                                                    <Condition Binding="{Binding RecipeConnections.IsProcessBlockTimeoutPreviewVisible}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <WrapPanel Margin="0,7,0,1"
                                       IsEnabled="{Binding RecipeConnections.IsEditable}">
                                <CheckBox x:Name="ProcessBlockLoadCheckBox"
                                          Margin="0,0,14,5"
                                          AutomationProperties.Name="{loc:Loc Key=Connections.ProcessBlock.Load}"
                                          Content="{loc:Loc Key=Connections.ProcessBlock.Load}"
                                          IsChecked="{Binding RecipeConnections.IsLoadBlockSelected, Mode=TwoWay}" />
                                <CheckBox x:Name="ProcessBlockAlignCheckBox"
                                          Margin="0,0,14,5"
                                          AutomationProperties.Name="{loc:Loc Key=Connections.ProcessBlock.Align}"
                                          Content="{loc:Loc Key=Connections.ProcessBlock.Align}"
                                          IsChecked="{Binding RecipeConnections.IsAlignBlockSelected, Mode=TwoWay}" />
                                <CheckBox x:Name="ProcessBlockProcessCheckBox"
                                          Margin="0,0,14,5"
                                          AutomationProperties.Name="{loc:Loc Key=Connections.ProcessBlock.Process}"
                                          Content="{loc:Loc Key=Connections.ProcessBlock.Process}"
                                          IsChecked="{Binding RecipeConnections.IsProcessBlockSelected, Mode=TwoWay}" />
                                <CheckBox x:Name="ProcessBlockInspectCheckBox"
                                          Margin="0,0,14,5"
                                          AutomationProperties.Name="{loc:Loc Key=Connections.ProcessBlock.Inspect}"
                                          Content="{loc:Loc Key=Connections.ProcessBlock.Inspect}"
                                          IsChecked="{Binding RecipeConnections.IsInspectBlockSelected, Mode=TwoWay}" />
                                <CheckBox x:Name="ProcessBlockUnloadCheckBox"
                                          Margin="0,0,0,5"
                                          AutomationProperties.Name="{loc:Loc Key=Connections.ProcessBlock.Unload}"
                                          Content="{loc:Loc Key=Connections.ProcessBlock.Unload}"
                                          IsChecked="{Binding RecipeConnections.IsUnloadBlockSelected, Mode=TwoWay}" />
                            </WrapPanel>
                            <TextBlock Margin="0,1,0,0"
                                       FontSize="11"
                                       Text="{Binding RecipeConnections.ProcessBlockValidationText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RecipeConnections.HasProcessBlockPlanError}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource State.Warning}" />
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsCompactLayout}" Value="True" />
                                                    <Condition Binding="{Binding RecipeConnections.IsProcessBlockTimeoutPreviewVisible}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ItemsControl Margin="0,3,0,0"
                                          ItemsSource="{Binding RecipeConnections.ProcessBlockConnectionItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,6,5"
                                                Padding="7,4"
                                                Background="{DynamicResource Surface.Raised}"
                                                BorderBrush="{DynamicResource Border.Subtle}"
                                                BorderThickness="1"
                                                CornerRadius="4">
                                            <StackPanel>
                                                <TextBlock FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource State.Vision}"
                                                           Text="{Binding RoleText}" />
                                                <TextBlock Margin="0,2,0,0"
                                                           FontFamily="{StaticResource Typography.Telemetry}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource Text.Secondary}"
                                                           Text="{Binding DetailText}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <WrapPanel Margin="0,4,0,1">
                                <TextBlock Margin="0,0,7,4"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           Text="{loc:Loc Key=Connections.ProcessBlockFilterLabel}" />
                                <RadioButton x:Name="ProcessBlockFilterAllRadioButton"
                                             Margin="0,0,5,4"
                                             AutomationProperties.Name="{loc:Loc Key=Connections.ProcessBlockFilterAll}"
