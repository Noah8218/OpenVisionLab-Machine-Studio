<UserControl x:Class="OpenVisionLab.MachineStudio.View.Project.LeftToolRegionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behavior="clr-namespace:OpenVisionLab.MachineStudio.Behavior"
             xmlns:conv="clr-namespace:OpenVisionLab.MachineStudio.Converter"
             xmlns:loc="clr-namespace:OpenVisionLab.MachineStudio.Localization"
             xmlns:shell="clr-namespace:OpenVisionLab.MachineStudio.View.Shell"
             xmlns:project="clr-namespace:OpenVisionLab.MachineStudio.View.Project">
    <UserControl.Resources>
        <conv:KoreanWordWrappingConverter x:Key="KoreanWordWrappingConverter" />
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="OutlineHeaderCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic" /><Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="Normal" /><Setter Property="LineHeight" Value="18.85" /><Setter Property="LineStackingStrategy" Value="BlockLineHeight" /><Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            <Style.Triggers><DataTrigger Binding="{Binding (shell:ShellWindow.IsCompactLayout), RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="FontSize" Value="12.5" /><Setter Property="LineHeight" Value="18.125" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="OutlineHeaderButtonStyle" TargetType="Button" BasedOn="{StaticResource GlobalCommandButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource Surface.Raised}" /><Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" /><Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="HeaderButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderButtonBorder" Property="Background" Value="{DynamicResource Surface.Hover}" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="HeaderButtonBorder" Property="Background" Value="{DynamicResource Surface.Pressed}" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HeaderButtonBorder" Property="BorderBrush" Value="{DynamicResource Accent.Primary}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource Text.Disabled}" /><Setter TargetName="HeaderButtonBorder" Property="Background" Value="{DynamicResource Surface.Disabled}" /><Setter TargetName="HeaderButtonBorder" Property="BorderBrush" Value="{DynamicResource Border.Disabled}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="InspectionCameraTitleText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic" /><Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LineHeight" Value="18.85" /><Setter Property="LineStackingStrategy" Value="BlockLineHeight" /><Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
            <Style.Triggers><DataTrigger Binding="{Binding DataContext.Navigation.IsCompactLayout, RelativeSource={RelativeSource AncestorType=project:LeftToolRegionView}}" Value="True">
                <Setter Property="FontSize" Value="12.5" /><Setter Property="LineHeight" Value="18.125" />
            </DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="InspectionCameraSecondaryText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic" /><Setter Property="FontSize" Value="10.5" /><Setter Property="FontWeight" Value="Normal" />
            <Setter Property="LineHeight" Value="15.225" /><Setter Property="LineStackingStrategy" Value="BlockLineHeight" /><Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" /><Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="InspectionCameraFocusVisual" TargetType="Control">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Control">
                <Border BorderBrush="{DynamicResource Accent.Primary}" BorderThickness="2" CornerRadius="5" Margin="-3" />
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <DataTemplate x:Key="LayoutComponentIconTemplate">
            <Viewbox Stretch="Uniform">
                <Border Width="48"
                        Height="38"
                        Background="{DynamicResource Surface.Root}"
                        BorderBrush="{DynamicResource Border.Default}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <Grid>
                        <Canvas x:Name="MachineFrameIcon" Width="40" Height="30" Visibility="Collapsed">
                            <Rectangle Canvas.Left="3" Canvas.Top="3" Width="34" Height="22"
                                       RadiusX="2" RadiusY="2"
                                       Stroke="{DynamicResource Text.Secondary}" StrokeThickness="2" />
                            <Line X1="7" Y1="25" X2="7" Y2="29" Stroke="{DynamicResource Text.Secondary}" StrokeThickness="2" />
                            <Line X1="33" Y1="25" X2="33" Y2="29" Stroke="{DynamicResource Text.Secondary}" StrokeThickness="2" />
                            <Line X1="9" Y1="8" X2="31" Y2="8" Stroke="{DynamicResource Border.Default}" StrokeThickness="2" />
                        </Canvas>

                        <Canvas x:Name="LinearStageIcon" Width="40" Height="30" Visibility="Collapsed">
                            <Line X1="3" Y1="24" X2="37" Y2="24" Stroke="{DynamicResource Text.Secondary}" StrokeThickness="3" />
                            <Rectangle Canvas.Left="10" Canvas.Top="7" Width="20" Height="13"
                                       RadiusX="3" RadiusY="3"
                                       Fill="{DynamicResource Accent.Soft}"
                                       Stroke="{DynamicResource Accent.Primary}" StrokeThickness="2" />
                            <Ellipse Canvas.Left="17" Canvas.Top="11" Width="6" Height="6" Fill="{DynamicResource Accent.Primary}" />
                            <Line X1="7" Y1="21" X2="7" Y2="27" Stroke="{DynamicResource Accent.Primary}" StrokeThickness="2" />
                            <Line X1="33" Y1="21" X2="33" Y2="27" Stroke="{DynamicResource Accent.Primary}" StrokeThickness="2" />
                        </Canvas>

                        <Canvas x:Name="RotaryStageIcon" Width="40" Height="30" Visibility="Collapsed">
                            <Ellipse Canvas.Left="8" Canvas.Top="2" Width="24" Height="24"
                                     Fill="{DynamicResource Accent.Soft}"
                                     Stroke="{DynamicResource Accent.Primary}"
                                     StrokeThickness="2" />
                            <Ellipse Canvas.Left="16" Canvas.Top="10" Width="8" Height="8"
                                     Fill="{DynamicResource Surface.Panel}"
                                     Stroke="{DynamicResource Text.Secondary}"
                                     StrokeThickness="1.5" />
                            <Line X1="20" Y1="5" X2="20" Y2="11"
                                  Stroke="{DynamicResource Accent.Primary}"
                                  StrokeThickness="2" />
                            <Line X1="13" Y1="27" X2="27" Y2="27"
                                  Stroke="{DynamicResource Text.Secondary}"
                                  StrokeThickness="2" />
                        </Canvas>

                        <Canvas x:Name="DigitalSensorIcon" Width="40" Height="30" Visibility="Collapsed">
                            <Rectangle Canvas.Left="6" Canvas.Top="4" Width="13" Height="22"
                                       RadiusX="3" RadiusY="3"
                                       Fill="{DynamicResource Surface.Raised}"
                                       Stroke="{DynamicResource State.Vision}" StrokeThickness="2" />
                            <Ellipse Canvas.Left="10" Canvas.Top="10" Width="5" Height="5" Fill="{DynamicResource State.Vision}" />
                            <Path Data="M 22,8 C 29,9 29,21 22,22 M 26,4 C 38,7 38,23 26,26"
                                  Fill="Transparent"
                                  Stroke="{DynamicResource State.Vision}"
                                  StrokeThickness="2" />
                        </Canvas>

                        <Canvas x:Name="PneumaticCylinderIcon" Width="40" Height="30" Visibility="Collapsed">
                            <Rectangle Canvas.Left="3" Canvas.Top="8" Width="22" Height="14"
                                       RadiusX="2" RadiusY="2"
                                       Fill="{DynamicResource Surface.Raised}"
                                       Stroke="{DynamicResource State.Warning}" StrokeThickness="2" />
                            <Line X1="13" Y1="9" X2="13" Y2="21" Stroke="{DynamicResource State.Warning}" StrokeThickness="2" />
                            <Line X1="25" Y1="15" X2="37" Y2="15" Stroke="{DynamicResource Text.Primary}" StrokeThickness="3" />
                            <Line X1="36" Y1="10" X2="36" Y2="20" Stroke="{DynamicResource Text.Primary}" StrokeThickness="2" />
                        </Canvas>

                        <Canvas x:Name="ConveyorIcon" Width="40" Height="30" Visibility="Collapsed">
                            <Rectangle Canvas.Left="2" Canvas.Top="6" Width="36" Height="18"
                                       RadiusX="3" RadiusY="3"
                                       Fill="{DynamicResource State.RunningSurface}"
                                       Stroke="{DynamicResource State.Running}" StrokeThickness="2" />
                            <Ellipse Canvas.Left="7" Canvas.Top="11" Width="8" Height="8" Stroke="{DynamicResource State.Running}" StrokeThickness="2" />
                            <Ellipse Canvas.Left="16" Canvas.Top="11" Width="8" Height="8" Stroke="{DynamicResource State.Running}" StrokeThickness="2" />
                            <Ellipse Canvas.Left="25" Canvas.Top="11" Width="8" Height="8" Stroke="{DynamicResource State.Running}" StrokeThickness="2" />
                            <Path Data="M 12,3 L 28,3 M 24,0 L 28,3 L 24,6"
                                  Stroke="{DynamicResource State.Running}" StrokeThickness="2" />
                        </Canvas>

                        <Canvas x:Name="WorkpieceIcon" Width="40" Height="30" Visibility="Collapsed">
                            <Path Data="M 5,9 L 20,3 L 35,9 L 35,25 L 5,25 Z M 5,9 L 20,15 L 35,9 M 20,15 L 20,25"
                                  Fill="{DynamicResource Accent.Soft}"
                                  Stroke="{DynamicResource State.Forced}"
                                  StrokeThickness="2" />
                            <Ellipse Canvas.Left="17" Canvas.Top="12" Width="6" Height="6" Fill="{DynamicResource State.Forced}" />
                        </Canvas>
                    </Grid>
                </Border>
            </Viewbox>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="MachineFrame">
                    <Setter TargetName="MachineFrameIcon" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="LinearStage">
                    <Setter TargetName="LinearStageIcon" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="RotaryStage">
                    <Setter TargetName="RotaryStageIcon" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="DigitalSensor">
                    <Setter TargetName="DigitalSensorIcon" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="PneumaticCylinder">
                    <Setter TargetName="PneumaticCylinderIcon" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Conveyor">
                    <Setter TargetName="ConveyorIcon" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Workpiece">
                    <Setter TargetName="WorkpieceIcon" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <Style x:Key="HistorySecondaryText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" /><Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="HistoryRunItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Margin" Value="0,0,0,8" /><Setter Property="Padding" Value="10" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="HistoryRunBorder" Background="{DynamicResource Surface.Raised}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Stretch" /></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="HistoryRunBorder" Property="Background" Value="{DynamicResource Surface.Selected}" /><Setter TargetName="HistoryRunBorder" Property="BorderBrush" Value="{DynamicResource Accent.Primary}" /><Setter TargetName="HistoryRunBorder" Property="BorderThickness" Value="4,1,1,1" /></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HistoryRunBorder" Property="Background" Value="{DynamicResource Surface.Hover}" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HistoryRunBorder" Property="BorderBrush" Value="{DynamicResource Accent.Primary}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SequenceUnitItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,8" /><Setter Property="Padding" Value="10" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="SequenceUnitBorder" Background="{DynamicResource Surface.Raised}" BorderBrush="{DynamicResource Border.Default}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Stretch" /></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="SequenceUnitBorder" Property="Background" Value="{DynamicResource Surface.Selected}" /><Setter TargetName="SequenceUnitBorder" Property="BorderBrush" Value="{DynamicResource Accent.Primary}" /><Setter TargetName="SequenceUnitBorder" Property="BorderThickness" Value="4,1,1,1" /></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SequenceUnitBorder" Property="Background" Value="{DynamicResource Surface.Hover}" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="SequenceUnitBorder" Property="Opacity" Value="0.55" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SequenceUnitBorder" Property="BorderBrush" Value="{DynamicResource Accent.Primary}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>

    <Border x:Name="NavigationPanelSurface">
        <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource PanelSurfaceStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Navigation.IsInspectionWorkspace}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Surface.Tinted}" /><Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" /><Setter Property="BorderThickness" Value="0,0,1,0" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Navigation.IsEquipmentWorkspace}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Surface.Tinted}" /><Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" /><Setter Property="BorderThickness" Value="0,0,1,0" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="SequenceUnitNavigation" Grid.RowSpan="4" Margin="10"
                  Visibility="{Binding Navigation.IsSequenceWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock Text="{loc:Loc Key=Properties.Unit}" FontWeight="SemiBold" Margin="0,0,0,12" />
                <ListBox x:Name="SequenceUnitList" Grid.Row="1" ItemsSource="{Binding SequenceNavigationItems}"
                         SelectedValuePath="Key" SelectedValue="{Binding SelectedSequenceNavigationKey, Mode=TwoWay}"
                         IsEnabled="{Binding CanNavigateSequenceUnits}" Padding="0" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ItemContainerStyle="{StaticResource SequenceUnitItem}" AutomationProperties.Name="{loc:Loc Key=Properties.Unit}">
                    <ListBox.Template><ControlTemplate TargetType="ListBox">
                        <Border x:Name="SequenceListSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ScrollViewer" Background="Transparent" Padding="{TemplateBinding Padding}" Focusable="False" CanContentScroll="True">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate></ListBox.Template>
                    <ListBox.ItemTemplate><DataTemplate><StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ScopeText}" Style="{StaticResource HistorySecondaryText}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding Id}" Style="{StaticResource HistorySecondaryText}" />
                        <TextBlock Text="{Binding StepCountText}" Style="{StaticResource HistorySecondaryText}" Margin="0,4,0,0" />
                    </StackPanel></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <Grid x:Name="RunHistoryNavigation" Grid.RowSpan="4" DataContext="{Binding RunHistory}" Margin="10"
                  Visibility="{Binding DataContext.Navigation.IsResultsWorkspace, RelativeSource={RelativeSource AncestorType=project:LeftToolRegionView}, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="{loc:Loc RunHistory.ViewTitle}" FontWeight="SemiBold" Margin="0,0,0,12" />
                <Grid Grid.Row="1" Margin="0,0,0,12"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Loc Key=Debugger.AlarmHistoryFilter}" Grid.ColumnSpan="2" Style="{StaticResource HistorySecondaryText}" Margin="0,0,0,4" />
                    <TextBox x:Name="RunHistorySearch" Grid.Row="1" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{loc:Loc Key=Debugger.AlarmHistoryFilter}" VerticalContentAlignment="Center">
                        <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers></Style></TextBox.Style>
                    </TextBox>
                    <Button x:Name="RunHistoryClearSearch" Grid.Row="1" Grid.Column="1" Margin="6,0,0,0" Content="{loc:Loc Key=ProjectTree.ClearSearch}" Command="{Binding ClearSearchCommand}" Style="{StaticResource GlobalCommandButtonStyle}" />
                </Grid>
                <ListBox x:Name="SavedRunList" Grid.Row="2" ItemsSource="{Binding VisibleRuns}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource HistoryRunItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel" AutomationProperties.Name="{loc:Loc RunHistory.SavedRuns}">
                    <ListBox.Style><Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox">
                            <Border x:Name="HistoryListBorder" Padding="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                                <ScrollViewer x:Name="PART_ScrollViewer" Padding="{TemplateBinding Padding}" Focusable="False" CanContentScroll="True"
                                              HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}" VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                                    <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                </ScrollViewer>
                            </Border>
                        </ControlTemplate></Setter.Value></Setter>
                        <Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers>
                    </Style></ListBox.Style>
                    <ListBox.ItemTemplate><DataTemplate><StackPanel>
                        <TextBlock Text="{Binding Record.RecipeName}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding Outcome}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Title}" Style="{StaticResource HistorySecondaryText}" Margin="0,6,0,4" />
                        <TextBlock Text="{Binding RunId}" Style="{StaticResource HistorySecondaryText}" />
                    </StackPanel></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="2" Text="{loc:Loc RunHistory.Empty}" Style="{StaticResource HistorySecondaryText}" Margin="8" Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Grid.Row="2" Text="{loc:Loc Key=ProjectTree.SearchNoMatches}" Style="{StaticResource HistorySecondaryText}" Margin="8" Visibility="{Binding HasNoSearchMatches, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Grid.Row="3" Text="{loc:Loc RunHistory.RetentionScope}" Style="{StaticResource HistorySecondaryText}" Margin="0,12,0,0" />
            </Grid>

            <Border x:Name="NavigationPanelHeader" Grid.Row="0"
                    Height="Auto"
                    MinHeight="{StaticResource Density.PanelHeaderHeight}"
                    >
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource PanelHeaderStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Navigation.IsResultsWorkspace}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            <DataTrigger Binding="{Binding Navigation.IsSequenceWorkspace}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            <DataTrigger Binding="{Binding Navigation.IsInspectionWorkspace}" Value="True">
                                <Setter Property="Padding" Value="10,8" /><Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" /><Setter Property="Background" Value="Transparent" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Navigation.IsEquipmentOutlineVisible}" Value="True">
                                <Setter Property="Padding" Value="10,8,10,0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding LeftPanelHeaderText}"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource PanelHeaderTextStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Navigation.IsEquipmentOutlineVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Navigation.IsInspectionWorkspace}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock x:Name="EquipmentOutlineTitle" Text="{loc:Loc Key=R40.DeviceNavigation}" FontFamily="Segoe UI, Malgun Gothic" FontWeight="Bold" LineStackingStrategy="BlockLineHeight"
                               TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource Text.Primary}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource PanelHeaderTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed" /><Setter Property="FontSize" Value="13" /><Setter Property="LineHeight" Value="18.85" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Navigation.IsEquipmentOutlineVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                <DataTrigger Binding="{Binding (shell:ShellWindow.IsCompactLayout), RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="FontSize" Value="12.5" /><Setter Property="LineHeight" Value="18.125" /></DataTrigger></Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock x:Name="InspectionCameraListTitle" Text="{loc:Loc Key=Camera.ListTitle}" TextWrapping="Wrap" FontFamily="Segoe UI, Malgun Gothic"
                               FontWeight="Bold" Foreground="{DynamicResource Text.Primary}" LineStackingStrategy="BlockLineHeight"
                               Visibility="{Binding Navigation.IsInspectionWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock.Style><Style TargetType="TextBlock">
                            <Setter Property="FontSize" Value="13" /><Setter Property="LineHeight" Value="18.85" />
                            <Style.Triggers><DataTrigger Binding="{Binding Navigation.IsCompactLayout}" Value="True"><Setter Property="FontSize" Value="12.5" /><Setter Property="LineHeight" Value="18.125" /></DataTrigger></Style.Triggers>
                        </Style></TextBlock.Style>
                    </TextBlock>
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                Visibility="{Binding Navigation.IsEquipmentOutlineVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button x:Name="OutlineAddUnitButton" MinWidth="0" MinHeight="28" Height="Auto" FontFamily="Segoe UI, Malgun Gothic" FontSize="13" FontWeight="Normal" Padding="10,4" Margin="0,0,6,0"
                                Command="{Binding OpenStationUnitEditorCommand}"
                                AutomationProperties.Name="{loc:Loc Key=Equipment.OutlineAddUnit}" Style="{StaticResource OutlineHeaderButtonStyle}">
                            <TextBlock Style="{StaticResource OutlineHeaderCaptionStyle}" Text="{loc:Loc Key=Equipment.OutlineAddUnit}" />
                        </Button>

                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="EquipmentAuthoringNavigation" Grid.Row="1" Padding="10,10,10,8" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,0,1"
                    Visibility="{Binding Navigation.IsEquipmentWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}">
                <WrapPanel>
                    <Border Padding="8,6" Margin="0,0,4,4" Background="{DynamicResource Accent.Soft}" BorderBrush="{DynamicResource Accent.Primary}" BorderThickness="0,0,0,2">
                        <TextBlock Text="{loc:Loc Key=R40.Configuration}" Foreground="{DynamicResource Accent.Primary}" />
                    </Border>
                    <Button x:Name="OutlineAddDeviceButton" MinWidth="0" MinHeight="28" Height="Auto" Padding="8,5" Margin="0,0,4,4"
                            Command="{Binding OpenEquipmentComponentLibraryDialogCommand}" Content="{loc:Loc Key=R40.AddDevice}"
                            AutomationProperties.Name="{loc:Loc Key=Equipment.AddPartButton}" Style="{StaticResource OutlineHeaderButtonStyle}" />
                    <Button x:Name="EquipmentRecipeExamplesButton" MinWidth="0" MinHeight="28" Height="Auto" Padding="8,5" Margin="0,0,0,4"
                            Command="{Binding SemiconductorRecipes.OpenCommand}" Content="{loc:Loc Key=R40.RecipeExamples}"
                            AutomationProperties.Name="{loc:Loc Key=Gallery.Open}" ToolTip="{loc:Loc Key=Gallery.OpenTooltip}" Style="{StaticResource OutlineHeaderButtonStyle}" />
                </WrapPanel>
            </Border>

            <project:EquipmentOutlineView Grid.Row="2">
                <project:EquipmentOutlineView.Style><Style TargetType="project:EquipmentOutlineView">
                    <Setter Property="Visibility" Value="{Binding Navigation.IsEquipmentOutlineVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Style.Triggers><DataTrigger Binding="{Binding Navigation.IsSequenceWorkspace}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                </Style></project:EquipmentOutlineView.Style>
            </project:EquipmentOutlineView>

            <Grid x:Name="InspectionAuthoringNavigation" Grid.Row="2" Margin="6"
                  Visibility="{Binding Navigation.IsInspectionWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <ListBox x:Name="InspectionCameraList" MaxHeight="280"
                         Padding="0" Background="Transparent" BorderThickness="0"
                         ItemsSource="{Binding Camera.VirtualCameras}"
                         SelectedValuePath="Id"
                         SelectedValue="{Binding Camera.SelectedCameraId, Mode=OneWay}"
                         Visibility="{Binding Camera.HasVirtualCamera, Converter={StaticResource BooleanToVisibilityConverter}}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         AutomationProperties.Name="{loc:Loc Key=Camera.ListTitle}">
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="SelectionChanged">
                            <b:InvokeCommandAction Command="{Binding Camera.SelectCameraCommand}"
                                                   CommandParameter="{Binding SelectedItem.Id, ElementName=InspectionCameraList}" />
                        </b:EventTrigger>
                    </b:Interaction.Triggers>
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                                <ScrollViewer x:Name="PART_ScrollViewer" Padding="{TemplateBinding Padding}" Focusable="False"
                                              HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                              VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                              CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}">
                                    <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                </ScrollViewer>
                            </Border>
                            <ControlTemplate.Triggers>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsGrouping" Value="True" />
                                        <Condition Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="False" />
                                    </MultiTrigger.Conditions>
                                    <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ListBox.Template>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Padding" Value="6,4" /><Setter Property="MinHeight" Value="26" /><Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                            <Setter Property="FocusVisualStyle" Value="{StaticResource InspectionCameraFocusVisual}" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                            <Setter Property="AutomationProperties.HelpText" Value="{Binding Id}" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="InspectionCameraItemChrome" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="{TemplateBinding Padding}" CornerRadius="4" SnapsToDevicePixels="True">
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Surface.Hover}" /></Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Accent.Soft}" /><Setter Property="BorderBrush" Value="{DynamicResource Accent.Primary}" /><Setter Property="Foreground" Value="{DynamicResource Accent.Primary}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Accent.Primary}" /></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource Text.Disabled}" /></Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <WrapPanel x:Name="InspectionCameraRowTitle">
                                    <DockPanel MaxWidth="{Binding ActualWidth, ElementName=InspectionCameraRowTitle}">
                                        <TextBlock x:Name="InspectionCameraRowIcon" DockPanel.Dock="Left" Margin="0,0,4,0">
                                            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource InspectionCameraTitleText}">
                                                <Setter Property="Text" Value="▣" /><Style.Triggers><DataTrigger Binding="{Binding Camera.NumericalInput.InputKind}" Value="HeightMap3D"><Setter Property="Text" Value="▤" /></DataTrigger></Style.Triggers>
                                            </Style></TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock x:Name="InspectionCameraRowName" Text="{Binding Name}" Style="{StaticResource InspectionCameraTitleText}" />
                                    </DockPanel>
                                    <TextBlock x:Name="InspectionCameraRowId" Text="{Binding Id}" Style="{StaticResource InspectionCameraSecondaryText}" FontWeight="SemiBold" Margin="4,0,0,0"
                                               MaxWidth="{Binding ActualWidth, ElementName=InspectionCameraRowTitle}" />
                                </WrapPanel>
                                <TextBlock x:Name="InspectionCameraRowKind" Margin="0,1,0,0">
                                    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource InspectionCameraSecondaryText}">
                                        <Setter Property="Text" Value="{loc:Loc Key=Camera.TwoDImage}" />
                                        <Style.Triggers><DataTrigger Binding="{Binding Camera.NumericalInput.InputKind}" Value="HeightMap3D"><Setter Property="Text" Value="{loc:Loc Key=Camera.HeightMap3D}" /></DataTrigger></Style.Triggers>
                                    </Style></TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="1" Margin="6,12,6,5" Text="{loc:Loc Key=Camera.CaptureStepList}" FontWeight="SemiBold"
                           Visibility="{Binding Camera.HasVirtualCamera, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding Camera.HasVirtualCamera, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <ItemsControl x:Name="InspectionCaptureSteps" ItemsSource="{Binding Camera.CurrentAcquisitionSteps}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Button Command="{Binding DataContext.OpenCameraAcquisitionStepCommand, RelativeSource={RelativeSource AncestorType=project:LeftToolRegionView}}"
                                        CommandParameter="{Binding}" AutomationProperties.Name="{Binding Caption}" ToolTip="{loc:Loc Key=Camera.OpenCaptureStep}"
                                        Style="{StaticResource GlobalCommandButtonStyle}" Height="Auto" MinHeight="36" Padding="7,6" Margin="0,0,0,5" HorizontalContentAlignment="Stretch">
                                    <StackPanel><TextBlock Text="{Binding Caption, Converter={StaticResource KoreanWordWrappingConverter}}" TextWrapping="Wrap" /><TextBlock Text="{Binding LocationText, Converter={StaticResource KoreanWordWrappingConverter}}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Text.Secondary}" /></StackPanel>
                                </Button>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Margin="6" Text="{loc:Loc Key=Camera.NoCaptureSteps}" TextWrapping="Wrap" Foreground="{DynamicResource Text.Secondary}">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Camera.CurrentAcquisitionSteps.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </ScrollViewer>
                <TextBlock x:Name="InspectionCameraEmptyHint" Grid.RowSpan="3" Margin="10" VerticalAlignment="Top"
                           Foreground="{DynamicResource Text.Secondary}"
                           Text="{loc:Loc Key=Camera.EmptyListHint}" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Camera.HasVirtualCamera}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>


            <Grid Grid.Row="2">

                <TabControl SelectedIndex="{Binding Navigation.SelectedLeftToolTabIndex, Mode=TwoWay}">
                    <TabControl.Style>
                        <Style TargetType="TabControl" BasedOn="{StaticResource {x:Type TabControl}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Navigation.IsSequenceWorkspace}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                <DataTrigger Binding="{Binding Navigation.IsResultsWorkspace}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                <DataTrigger Binding="{Binding Navigation.IsInspectionWorkspace}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Navigation.IsEquipmentOutlineVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TabControl.Style>
                    <TabItem Header="{loc:Loc Key=Shell.Project}">
                        <Grid Margin="4,6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Margin="2,0,2,4"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{loc:Loc Key=ProjectTree.SearchLabel}" />
                            <DockPanel Grid.Row="1" Margin="0,0,0,4" LastChildFill="True">
                                <Button DockPanel.Dock="Right"
                                        Height="30"
                                        MinWidth="58"
                                        Margin="5,0,0,0"
                                        Padding="8,0"
                                        Command="{Binding ProjectTree.ClearSearchCommand}"
                                        Content="{loc:Loc Key=ProjectTree.ClearSearch}"
                                        AutomationProperties.Name="{loc:Loc Key=ProjectTree.ClearSearch}" />
                                <TextBox Height="30"
                                         VerticalContentAlignment="Center"
                                         Text="{Binding ProjectTree.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="{loc:Loc Key=ProjectTree.SearchLabel}" />
                            </DockPanel>
                            <TextBlock Grid.Row="2"
                                       Margin="2,0,2,5"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Visibility="{Binding ProjectTree.HasSearchMatches, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Run Text="{Binding ProjectTree.SearchResultCount, Mode=OneWay}" />
                                <Run Text="{loc:Loc Key=ProjectTree.SearchResultsSuffix}" />
                            </TextBlock>
                            <TextBlock Grid.Row="2"
                                       Margin="2,0,2,5"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{loc:Loc Key=ProjectTree.SearchNoMatches}"
                                       Visibility="{Binding ProjectTree.HasNoSearchMatches, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TreeView Grid.Row="3"
                                      ItemsSource="{Binding ProjectTree.Roots}"
                                      HorizontalContentAlignment="Stretch"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <TreeView.Resources>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{StaticResource Color.Surface.Selected}" />
                                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{StaticResource Color.Surface.Selected}" />
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{StaticResource Color.Text.Primary}" />
                                </TreeView.Resources>
                                <b:Interaction.Behaviors>
                                    <behavior:TreeViewSelectedItemBehavior SelectedItem="{Binding ProjectTree.SelectedNode, Mode=TwoWay}" />
                                </b:Interaction.Behaviors>
                                <TreeView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel HorizontalAlignment="Stretch" />
                                    </ItemsPanelTemplate>
                                </TreeView.ItemsPanel>
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                                        <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="6"
                                                    Height="6"
                                                    Margin="2,0,7,0"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource State.Vision}"
                                                    CornerRadius="3" />
                                            <TextBlock Grid.Column="1"
                                                       VerticalAlignment="Center"
                                                       MaxWidth="95"
                                                       Text="{Binding DisplayName}"
                                                       TextWrapping="Wrap" />
                                        </Grid>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </Grid>
                    </TabItem>
                    <TabItem Header="{loc:Loc Key=Shell.Library}">
                        <Grid Margin="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="80" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Margin="4,4,4,7"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{loc:Loc Key=Shell.LibraryPlacementHint}"
                                       TextWrapping="Wrap" />
                            <TextBlock Grid.Row="1"
                                       Margin="4,0,4,3"
                                       Style="{StaticResource SectionCaptionStyle}"
                                       Text="{loc:Loc Key=Equipment.LibrarySearchLabel}" />
                            <Grid Grid.Row="2" Margin="2,0,2,6">
                                <TextBox Height="30"
                                         Padding="8,0,34,0"
                                         VerticalContentAlignment="Center"
                                         Text="{Binding Layout.LibrarySearchText, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="{loc:Loc Key=Equipment.LibrarySearchLabel}" />
                                <Button Width="26"
                                        MinWidth="26"
                                        MinHeight="0"
                                        Margin="0,2,3,2"
                                        Padding="0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Stretch"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        BorderThickness="1"
                                        Foreground="{DynamicResource Text.Secondary}"
                                        Command="{Binding Layout.ClearLibrarySearchCommand}"
                                        ToolTip="{loc:Loc Key=Equipment.LibrarySearchClear}"
                                        AutomationProperties.Name="{loc:Loc Key=Equipment.LibrarySearchClear}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource GlobalCommandButtonStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Layout.IsLibrarySearchEmpty}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="×" FontSize="16" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>
                            </Grid>
                            <Grid Grid.Row="3">
                                <ListBox ItemsSource="{Binding Layout.FilteredLibraryItems}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.Style>
                                        <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Navigation.IsEquipmentOutlineVisible}" Value="True" />
                                                        <Condition Binding="{Binding Layout.IsUnitView}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.Style>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                            <Setter Property="Padding" Value="0" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Button Margin="1"
                                                    Padding="5,5"
                                                    MinHeight="64"
                                                    HorizontalContentAlignment="Stretch"
                                                    AutomationProperties.Name="{Binding Name}"
                                                    Command="{Binding DataContext.AddEquipmentLayoutComponentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Kind}"
                                                    ToolTip="{Binding Description}">
                                                <b:Interaction.Behaviors>
                                                    <behavior:LibraryDragBehavior DragData="{Binding}" />
                                                </b:Interaction.Behaviors>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="40" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <ContentControl Width="34"
                                                                    Height="28"
                                                                    VerticalAlignment="Top"
                                                                    Focusable="False"
                                                                    IsHitTestVisible="False"
                                                                    Content="{Binding}"
                                                                    ContentTemplate="{StaticResource LayoutComponentIconTemplate}" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <DockPanel LastChildFill="True">
                                                            <TextBlock DockPanel.Dock="Right"
                                                                       Margin="6,0,0,0"
                                                                       FontSize="10"
                                                                       Foreground="{DynamicResource Accent.Primary}"
                                                                       Text="{Binding Category}" />
                                                            <TextBlock FontWeight="SemiBold"
                                                                       Text="{Binding Name}"
                                                                       TextWrapping="Wrap" />
                                                        </DockPanel>
                                                        <TextBlock Margin="0,3,0,0"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource Text.Secondary}"
                                                                   Text="{Binding Description}"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Margin="8"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           Text="{loc:Loc Key=Equipment.LibraryNoMatches}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding Layout.HasNoLibrarySearchResults, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Button Panel.ZIndex="2"
                                        MinHeight="64"
                                        Margin="5"
                                        Padding="8,6"
                                        VerticalAlignment="Center"
                                        Command="{Binding OpenStationUnitEditorCommand}"
                                        AutomationProperties.Name="{loc:Loc Key=Equipment.StationUnitAddButton}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryCommandButtonStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Navigation.IsEquipmentOutlineVisible}" Value="True" />
                                                        <Condition Binding="{Binding Layout.IsUnitView}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="{loc:Loc Key=Equipment.LibraryUnitRequired}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap" />
                                </Button>
                            </Grid>
                            <TextBlock Grid.Row="4"
                                       Margin="4,8,4,4"
                                       Style="{StaticResource SectionCaptionStyle}"
                                       Text="{loc:Loc Key=Left.PlacedComponents}" />
                            <ListBox Grid.Row="5"
                                     ItemsSource="{Binding Layout.Items}"
                                     SelectionMode="Extended"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ToolTip="{Binding Name}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ContentControl Width="24"
                                                            Height="20"
                                                            Focusable="False"
                                                            IsHitTestVisible="False"
                                                            Content="{Binding}"
                                                            ContentTemplate="{StaticResource LayoutComponentIconTemplate}" />
                                            <TextBlock Grid.Column="1"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button Grid.Row="6"
                                    Margin="2,6,2,2"
                                    Command="{Binding DeleteLayoutComponentCommand}"
                                    Content="{loc:Loc Key=Left.RemoveSelected}" />
                        </Grid>
                    </TabItem>
                    <TabItem Header="{loc:Loc Key=Project.Diagnostics}">
                        <TabItem.Style>
                            <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Navigation.IsEquipmentOutlineVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Navigation.IsInspectionWorkspace}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TabItem.Style>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="4">
                                <Border Style="{StaticResource InspectorCardStyle}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionCaptionStyle}"
                                                   Text="{loc:Loc Key=ProjectDiagnostics.Title}" />
                                        <TextBlock Margin="0,3,0,0"
                                                   Foreground="{DynamicResource Text.Secondary}"
                                                   Text="{Binding ProjectDiagnostics.PathText}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="0,6,0,0"
                                                   Text="{Binding ProjectDiagnostics.CurrentStateText}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="0,6,0,0"
                                                   Foreground="{DynamicResource State.Warning}"
                                                   Text="{Binding ProjectDiagnostics.LoadSourceNoticeText}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding ProjectDiagnostics.HasLoadSourceNotice, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <TextBlock Margin="0,6,0,0"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding ProjectDiagnostics.SummaryText}"
                                                   TextWrapping="Wrap" />
                                        <StackPanel Margin="0,8,0,0"
                                                    Orientation="Horizontal">
                                            <Button MinHeight="34"
                                                    Padding="9,0"
                                                    Command="{Binding ProjectDiagnostics.RefreshCommand}"
                                                    Content="{loc:Loc Key=ProjectDiagnostics.Refresh}" />
                                            <Button MinHeight="34"
                                                    Padding="9,0"
                                                    Command="{Binding ProjectDiagnostics.PreviewRecoveryCommand}"
                                                    Content="{loc:Loc Key=ProjectDiagnostics.Preview}"
                                                    IsEnabled="{Binding ProjectDiagnostics.CanPreviewRecovery}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InspectorCardStyle}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionCaptionStyle}"
                                                   Text="{loc:Loc Key=ProjectDiagnostics.Findings}" />
                                        <ListBox Margin="0,5,0,0"
                                                 ItemsSource="{Binding ProjectDiagnostics.Items}"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,3,0,3">
                                                        <TextBlock FontWeight="SemiBold"
                                                                   Text="{Binding SeverityText}" />
                                                        <TextBlock Margin="0,2,0,0"
                                                                   Text="{Binding MessageText}"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Margin="0,2,0,0"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource Text.Secondary}"
                                                                   Text="{Binding DetailText}"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InspectorCardStyle}"
                                        Visibility="{Binding ProjectDiagnostics.HasRecoveryPreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionCaptionStyle}"
                                                   Text="{loc:Loc Key=ProjectDiagnostics.PreviewTitle}" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Text="{Binding ProjectDiagnostics.RecoveryPreviewText}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="0,5,0,0"
                                                   Foreground="{DynamicResource Text.Secondary}"
                                                   Text="{loc:Loc Key=ProjectDiagnostics.ApplyHint}"
                                                   TextWrapping="Wrap" />
                                        <StackPanel Margin="0,8,0,0"
                                                    Orientation="Horizontal">
                                            <Button MinHeight="34"
                                                    Padding="9,0"
                                                    Command="{Binding ProjectDiagnostics.ApplyRecoveryCommand}"
                                                    Content="{loc:Loc Key=ProjectDiagnostics.Apply}" />
                                            <Button MinHeight="34"
                                                    Padding="9,0"
                                                    Command="{Binding ProjectDiagnostics.CancelRecoveryPreviewCommand}"
                                                    Content="{loc:Loc Key=ProjectDiagnostics.Cancel}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                <TabItem Header="{loc:Loc Key=Workspace.Equipment}">
                    <TabItem.Style>
                        <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Navigation.IsSimulationWorkspace}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TabItem.Style>
                    <project:EquipmentOutlineView />
                </TabItem>
                </TabControl>
            </Grid>


        </Grid>
    </Border>
</UserControl>
