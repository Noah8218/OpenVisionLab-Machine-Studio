<UserControl x:Class="OpenVisionLab.MachineStudio.View.Project.LeftToolRegionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behavior="clr-namespace:OpenVisionLab.MachineStudio.Behavior"
             xmlns:loc="clr-namespace:OpenVisionLab.MachineStudio.Localization">
    <UserControl.Resources>
        <DataTemplate x:Key="LayoutComponentIconTemplate">
            <Viewbox Stretch="Uniform">
                <Border Width="48"
                        Height="38"
                        Background="{DynamicResource Surface.Root}"
                        BorderBrush="{DynamicResource Border.Default}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <Grid>
                        <Canvas x:Name="MachineFrameIcon" Width="40" Height="30" Visibility="Collapsed">
                            <Rectangle Canvas.Left="3" Canvas.Top="3" Width="34" Height="22"
                                       RadiusX="2" RadiusY="2"
                                       Stroke="{DynamicResource Text.Secondary}" StrokeThickness="2" />
                            <Line X1="7" Y1="25" X2="7" Y2="29" Stroke="{DynamicResource Text.Secondary}" StrokeThickness="2" />
                            <Line X1="33" Y1="25" X2="33" Y2="29" Stroke="{DynamicResource Text.Secondary}" StrokeThickness="2" />
                            <Line X1="9" Y1="8" X2="31" Y2="8" Stroke="{DynamicResource Border.Default}" StrokeThickness="2" />
                        </Canvas>

                        <Canvas x:Name="LinearStageIcon" Width="40" Height="30" Visibility="Collapsed">
                            <Line X1="3" Y1="24" X2="37" Y2="24" Stroke="{DynamicResource Text.Secondary}" StrokeThickness="3" />
                            <Rectangle Canvas.Left="10" Canvas.Top="7" Width="20" Height="13"
                                       RadiusX="3" RadiusY="3"
                                       Fill="{DynamicResource Accent.Soft}"
                                       Stroke="{DynamicResource Accent.Primary}" StrokeThickness="2" />
                            <Ellipse Canvas.Left="17" Canvas.Top="11" Width="6" Height="6" Fill="{DynamicResource Accent.Primary}" />
                            <Line X1="7" Y1="21" X2="7" Y2="27" Stroke="{DynamicResource Accent.Primary}" StrokeThickness="2" />
                            <Line X1="33" Y1="21" X2="33" Y2="27" Stroke="{DynamicResource Accent.Primary}" StrokeThickness="2" />
                        </Canvas>

                        <Canvas x:Name="RotaryStageIcon" Width="40" Height="30" Visibility="Collapsed">
                            <Ellipse Canvas.Left="8" Canvas.Top="2" Width="24" Height="24"
                                     Fill="{DynamicResource Accent.Soft}"
                                     Stroke="{DynamicResource Accent.Primary}"
                                     StrokeThickness="2" />
                            <Ellipse Canvas.Left="16" Canvas.Top="10" Width="8" Height="8"
                                     Fill="{DynamicResource Surface.Panel}"
                                     Stroke="{DynamicResource Text.Secondary}"
                                     StrokeThickness="1.5" />
                            <Line X1="20" Y1="5" X2="20" Y2="11"
                                  Stroke="{DynamicResource Accent.Primary}"
                                  StrokeThickness="2" />
                            <Line X1="13" Y1="27" X2="27" Y2="27"
                                  Stroke="{DynamicResource Text.Secondary}"
                                  StrokeThickness="2" />
                        </Canvas>

                        <Canvas x:Name="DigitalSensorIcon" Width="40" Height="30" Visibility="Collapsed">
                            <Rectangle Canvas.Left="6" Canvas.Top="4" Width="13" Height="22"
                                       RadiusX="3" RadiusY="3"
                                       Fill="{DynamicResource Surface.Raised}"
                                       Stroke="{DynamicResource State.Vision}" StrokeThickness="2" />
                            <Ellipse Canvas.Left="10" Canvas.Top="10" Width="5" Height="5" Fill="{DynamicResource State.Vision}" />
                            <Path Data="M 22,8 C 29,9 29,21 22,22 M 26,4 C 38,7 38,23 26,26"
                                  Fill="Transparent"
                                  Stroke="{DynamicResource State.Vision}"
                                  StrokeThickness="2" />
                        </Canvas>

                        <Canvas x:Name="PneumaticCylinderIcon" Width="40" Height="30" Visibility="Collapsed">
                            <Rectangle Canvas.Left="3" Canvas.Top="8" Width="22" Height="14"
                                       RadiusX="2" RadiusY="2"
                                       Fill="{DynamicResource Surface.Raised}"
                                       Stroke="{DynamicResource State.Warning}" StrokeThickness="2" />
                            <Line X1="13" Y1="9" X2="13" Y2="21" Stroke="{DynamicResource State.Warning}" StrokeThickness="2" />
                            <Line X1="25" Y1="15" X2="37" Y2="15" Stroke="{DynamicResource Text.Primary}" StrokeThickness="3" />
                            <Line X1="36" Y1="10" X2="36" Y2="20" Stroke="{DynamicResource Text.Primary}" StrokeThickness="2" />
                        </Canvas>

                        <Canvas x:Name="ConveyorIcon" Width="40" Height="30" Visibility="Collapsed">
                            <Rectangle Canvas.Left="2" Canvas.Top="6" Width="36" Height="18"
                                       RadiusX="3" RadiusY="3"
                                       Fill="{DynamicResource State.RunningSurface}"
                                       Stroke="{DynamicResource State.Running}" StrokeThickness="2" />
                            <Ellipse Canvas.Left="7" Canvas.Top="11" Width="8" Height="8" Stroke="{DynamicResource State.Running}" StrokeThickness="2" />
                            <Ellipse Canvas.Left="16" Canvas.Top="11" Width="8" Height="8" Stroke="{DynamicResource State.Running}" StrokeThickness="2" />
                            <Ellipse Canvas.Left="25" Canvas.Top="11" Width="8" Height="8" Stroke="{DynamicResource State.Running}" StrokeThickness="2" />
                            <Path Data="M 12,3 L 28,3 M 24,0 L 28,3 L 24,6"
                                  Stroke="{DynamicResource State.Running}" StrokeThickness="2" />
                        </Canvas>

                        <Canvas x:Name="WorkpieceIcon" Width="40" Height="30" Visibility="Collapsed">
                            <Path Data="M 5,9 L 20,3 L 35,9 L 35,25 L 5,25 Z M 5,9 L 20,15 L 35,9 M 20,15 L 20,25"
                                  Fill="{DynamicResource Accent.Soft}"
                                  Stroke="{DynamicResource State.Forced}"
                                  StrokeThickness="2" />
                            <Ellipse Canvas.Left="17" Canvas.Top="12" Width="6" Height="6" Fill="{DynamicResource State.Forced}" />
                        </Canvas>
                    </Grid>
                </Border>
            </Viewbox>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="MachineFrame">
                    <Setter TargetName="MachineFrameIcon" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="LinearStage">
                    <Setter TargetName="LinearStageIcon" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="RotaryStage">
                    <Setter TargetName="RotaryStageIcon" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="DigitalSensor">
                    <Setter TargetName="DigitalSensorIcon" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="PneumaticCylinder">
                    <Setter TargetName="PneumaticCylinderIcon" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Conveyor">
                    <Setter TargetName="ConveyorIcon" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Workpiece">
                    <Setter TargetName="WorkpieceIcon" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Border Style="{StaticResource PanelSurfaceStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource PanelHeaderStyle}">
                <TextBlock Style="{StaticResource PanelHeaderTextStyle}"
                           Text="{Binding LeftPanelHeaderText}" />
            </Border>

            <Grid Grid.Row="1">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRunMode}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <TabControl SelectedIndex="{Binding SelectedLeftToolTabIndex, Mode=TwoWay}">
                    <TabItem Header="{loc:Loc Key=Shell.Project}">
                        <TreeView ItemsSource="{Binding ProjectTree.Roots}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <TreeView.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#20394B" />
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#20394B" />
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#F3F6F9" />
                            </TreeView.Resources>
                            <b:Interaction.Behaviors>
                                <behavior:TreeViewSelectedItemBehavior SelectedItem="{Binding ProjectTree.SelectedNode, Mode=TwoWay}" />
                            </b:Interaction.Behaviors>
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="6"
                                                Height="6"
                                                Margin="2,0,7,0"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource State.Vision}"
                                                CornerRadius="3" />
                                        <TextBlock Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding DisplayName}"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </TabItem>
                    <TabItem Header="{loc:Loc Key=Shell.Library}">
                        <Grid Margin="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="80" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Margin="4,4,4,7"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{loc:Loc Key=Shell.LibraryPlacementHint}"
                                       TextWrapping="Wrap" />
                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding Layout.LibraryItems}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="Padding" Value="0" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                <DataTemplate>
                                        <Button Margin="1"
                                                Padding="5,4"
                                                MinHeight="44"
                                                HorizontalContentAlignment="Stretch"
                                                AutomationProperties.Name="{Binding Name}"
                                                Command="{Binding DataContext.AddLayoutComponentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Kind}"
                                                ToolTip="{Binding Description}">
                                                <b:Interaction.Behaviors>
                                                    <behavior:LibraryDragBehavior DragData="{Binding}" />
                                                </b:Interaction.Behaviors>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ContentControl Width="34"
                                                                Height="28"
                                                                VerticalAlignment="Center"
                                                                Focusable="False"
                                                                IsHitTestVisible="False"
                                                                Content="{Binding}"
                                                                ContentTemplate="{StaticResource LayoutComponentIconTemplate}" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock FontWeight="SemiBold"
                                                               Text="{Binding Name}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Margin="0,2,0,0"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource Text.Secondary}"
                                                               Text="{Binding Category}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Grid.Row="2"
                                       Margin="4,8,4,4"
                                       Style="{StaticResource SectionCaptionStyle}"
                                       Text="{loc:Loc Key=Left.PlacedComponents}" />
                            <ListBox Grid.Row="3"
                                     ItemsSource="{Binding Layout.Items}"
                                     SelectionMode="Extended"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ToolTip="{Binding Name}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ContentControl Width="24"
                                                            Height="20"
                                                            Focusable="False"
                                                            IsHitTestVisible="False"
                                                            Content="{Binding}"
                                                            ContentTemplate="{StaticResource LayoutComponentIconTemplate}" />
                                            <TextBlock Grid.Column="1"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button Grid.Row="4"
                                    Margin="2,6,2,2"
                                    Command="{Binding DeleteLayoutComponentCommand}"
                                    Content="{loc:Loc Key=Left.RemoveSelected}" />
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRunMode}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <StackPanel Margin="4">
                    <Border Style="{StaticResource InspectorCardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionCaptionStyle}" Text="{loc:Loc Key=Left.MachineState}" />
                            <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding StateText}" />
                            <TextBlock Margin="0,5,0,0"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{Binding SimulationStatusText}" />
                        </StackPanel>
                    </Border>
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource InspectorCardStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasAutomaticRun}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionCaptionStyle}" Text="{loc:Loc Key=Left.AutomaticSimulation}" />
                            <TextBlock FontWeight="SemiBold"
                                       Text="{Binding AutomaticRunStateText}"
                                       TextWrapping="Wrap" />
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Foreground="{DynamicResource Text.Secondary}" Text="{loc:Loc Key=Left.CompletedCycles}" />
                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource TelemetryTextStyle}"
                                           Text="{Binding CompletedCycleCountText}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource InspectorCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="{DynamicResource Text.Secondary}" Text="{loc:Loc Key=Left.ConfiguredAxes}" />
                            <TextBlock Grid.Column="1"
                                       Style="{StaticResource TelemetryTextStyle}"
                                       Text="{Binding AxisCountText}" />
                            <TextBlock Grid.Row="1"
                                       Margin="0,7,0,0"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{loc:Loc Key=Left.LayoutComponents}" />
                            <TextBlock Grid.Row="1"
                                       Grid.Column="1"
                                       Margin="0,7,0,0"
                                       Style="{StaticResource TelemetryTextStyle}"
                                       Text="{Binding LayoutComponentCountText}" />
                            <TextBlock Grid.Row="2"
                                       Margin="0,7,0,0"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{loc:Loc Key=Left.VirtualCameras}" />
                            <TextBlock Grid.Row="2"
                                       Grid.Column="1"
                                       Margin="0,7,0,0"
                                       Style="{StaticResource TelemetryTextStyle}"
                                       Text="{Binding CameraCountText}" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource InspectorCardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionCaptionStyle}" Text="{loc:Loc Key=Left.EmbeddedSequence}" />
                            <TextBlock FontSize="14"
                                       FontWeight="SemiBold"
                                       Text="{Binding CurrentSequenceName}"
                                       TextWrapping="Wrap" />
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Foreground="{DynamicResource Text.Secondary}" Text="State" />
                                <TextBlock Grid.Column="1"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource TelemetryTextStyle}"
                                           Text="{Binding CurrentSequenceStateText}" />
                            </Grid>
                            <TextBlock Margin="0,7,0,0"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{loc:Loc Key=Left.CurrentStep}" />
                            <TextBlock Margin="0,2,0,0"
                                       Text="{Binding CurrentSequenceStepText}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource InspectorCardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionCaptionStyle}" Text="{loc:Loc Key=Left.ControlOwner}" />
                            <TextBlock Text="{Binding ControlOwnerText}" />
                            <TextBlock Margin="0,4,0,0"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{Binding ControlOwnerHelpText}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
