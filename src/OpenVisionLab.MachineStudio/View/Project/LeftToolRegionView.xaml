<UserControl x:Class="OpenVisionLab.MachineStudio.View.Project.LeftToolRegionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behavior="clr-namespace:OpenVisionLab.MachineStudio.Behavior"
             xmlns:conv="clr-namespace:OpenVisionLab.MachineStudio.Converter"
             xmlns:loc="clr-namespace:OpenVisionLab.MachineStudio.Localization"
             xmlns:project="clr-namespace:OpenVisionLab.MachineStudio.View.Project">
    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <DataTemplate x:Key="LayoutComponentIconTemplate">
            <Viewbox Stretch="Uniform">
                <Border Width="48"
                        Height="38"
                        Background="{DynamicResource Surface.Root}"
                        BorderBrush="{DynamicResource Border.Default}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <Grid>
                        <Canvas x:Name="MachineFrameIcon" Width="40" Height="30" Visibility="Collapsed">
                            <Rectangle Canvas.Left="3" Canvas.Top="3" Width="34" Height="22"
                                       RadiusX="2" RadiusY="2"
                                       Stroke="{DynamicResource Text.Secondary}" StrokeThickness="2" />
                            <Line X1="7" Y1="25" X2="7" Y2="29" Stroke="{DynamicResource Text.Secondary}" StrokeThickness="2" />
                            <Line X1="33" Y1="25" X2="33" Y2="29" Stroke="{DynamicResource Text.Secondary}" StrokeThickness="2" />
                            <Line X1="9" Y1="8" X2="31" Y2="8" Stroke="{DynamicResource Border.Default}" StrokeThickness="2" />
                        </Canvas>

                        <Canvas x:Name="LinearStageIcon" Width="40" Height="30" Visibility="Collapsed">
                            <Line X1="3" Y1="24" X2="37" Y2="24" Stroke="{DynamicResource Text.Secondary}" StrokeThickness="3" />
                            <Rectangle Canvas.Left="10" Canvas.Top="7" Width="20" Height="13"
                                       RadiusX="3" RadiusY="3"
                                       Fill="{DynamicResource Accent.Soft}"
                                       Stroke="{DynamicResource Accent.Primary}" StrokeThickness="2" />
                            <Ellipse Canvas.Left="17" Canvas.Top="11" Width="6" Height="6" Fill="{DynamicResource Accent.Primary}" />
                            <Line X1="7" Y1="21" X2="7" Y2="27" Stroke="{DynamicResource Accent.Primary}" StrokeThickness="2" />
                            <Line X1="33" Y1="21" X2="33" Y2="27" Stroke="{DynamicResource Accent.Primary}" StrokeThickness="2" />
                        </Canvas>

                        <Canvas x:Name="RotaryStageIcon" Width="40" Height="30" Visibility="Collapsed">
                            <Ellipse Canvas.Left="8" Canvas.Top="2" Width="24" Height="24"
                                     Fill="{DynamicResource Accent.Soft}"
                                     Stroke="{DynamicResource Accent.Primary}"
                                     StrokeThickness="2" />
                            <Ellipse Canvas.Left="16" Canvas.Top="10" Width="8" Height="8"
                                     Fill="{DynamicResource Surface.Panel}"
                                     Stroke="{DynamicResource Text.Secondary}"
                                     StrokeThickness="1.5" />
                            <Line X1="20" Y1="5" X2="20" Y2="11"
                                  Stroke="{DynamicResource Accent.Primary}"
                                  StrokeThickness="2" />
                            <Line X1="13" Y1="27" X2="27" Y2="27"
                                  Stroke="{DynamicResource Text.Secondary}"
                                  StrokeThickness="2" />
                        </Canvas>

                        <Canvas x:Name="DigitalSensorIcon" Width="40" Height="30" Visibility="Collapsed">
                            <Rectangle Canvas.Left="6" Canvas.Top="4" Width="13" Height="22"
                                       RadiusX="3" RadiusY="3"
                                       Fill="{DynamicResource Surface.Raised}"
                                       Stroke="{DynamicResource State.Vision}" StrokeThickness="2" />
                            <Ellipse Canvas.Left="10" Canvas.Top="10" Width="5" Height="5" Fill="{DynamicResource State.Vision}" />
                            <Path Data="M 22,8 C 29,9 29,21 22,22 M 26,4 C 38,7 38,23 26,26"
                                  Fill="Transparent"
                                  Stroke="{DynamicResource State.Vision}"
                                  StrokeThickness="2" />
                        </Canvas>

                        <Canvas x:Name="PneumaticCylinderIcon" Width="40" Height="30" Visibility="Collapsed">
                            <Rectangle Canvas.Left="3" Canvas.Top="8" Width="22" Height="14"
                                       RadiusX="2" RadiusY="2"
                                       Fill="{DynamicResource Surface.Raised}"
                                       Stroke="{DynamicResource State.Warning}" StrokeThickness="2" />
                            <Line X1="13" Y1="9" X2="13" Y2="21" Stroke="{DynamicResource State.Warning}" StrokeThickness="2" />
                            <Line X1="25" Y1="15" X2="37" Y2="15" Stroke="{DynamicResource Text.Primary}" StrokeThickness="3" />
                            <Line X1="36" Y1="10" X2="36" Y2="20" Stroke="{DynamicResource Text.Primary}" StrokeThickness="2" />
                        </Canvas>

                        <Canvas x:Name="ConveyorIcon" Width="40" Height="30" Visibility="Collapsed">
                            <Rectangle Canvas.Left="2" Canvas.Top="6" Width="36" Height="18"
                                       RadiusX="3" RadiusY="3"
                                       Fill="{DynamicResource State.RunningSurface}"
                                       Stroke="{DynamicResource State.Running}" StrokeThickness="2" />
                            <Ellipse Canvas.Left="7" Canvas.Top="11" Width="8" Height="8" Stroke="{DynamicResource State.Running}" StrokeThickness="2" />
                            <Ellipse Canvas.Left="16" Canvas.Top="11" Width="8" Height="8" Stroke="{DynamicResource State.Running}" StrokeThickness="2" />
                            <Ellipse Canvas.Left="25" Canvas.Top="11" Width="8" Height="8" Stroke="{DynamicResource State.Running}" StrokeThickness="2" />
                            <Path Data="M 12,3 L 28,3 M 24,0 L 28,3 L 24,6"
                                  Stroke="{DynamicResource State.Running}" StrokeThickness="2" />
                        </Canvas>

                        <Canvas x:Name="WorkpieceIcon" Width="40" Height="30" Visibility="Collapsed">
                            <Path Data="M 5,9 L 20,3 L 35,9 L 35,25 L 5,25 Z M 5,9 L 20,15 L 35,9 M 20,15 L 20,25"
                                  Fill="{DynamicResource Accent.Soft}"
                                  Stroke="{DynamicResource State.Forced}"
                                  StrokeThickness="2" />
                            <Ellipse Canvas.Left="17" Canvas.Top="12" Width="6" Height="6" Fill="{DynamicResource State.Forced}" />
                        </Canvas>
                    </Grid>
                </Border>
            </Viewbox>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="MachineFrame">
                    <Setter TargetName="MachineFrameIcon" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="LinearStage">
                    <Setter TargetName="LinearStageIcon" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="RotaryStage">
                    <Setter TargetName="RotaryStageIcon" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="DigitalSensor">
                    <Setter TargetName="DigitalSensorIcon" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="PneumaticCylinder">
                    <Setter TargetName="PneumaticCylinderIcon" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Conveyor">
                    <Setter TargetName="ConveyorIcon" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Workpiece">
                    <Setter TargetName="WorkpieceIcon" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Border Style="{StaticResource PanelSurfaceStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Height="Auto"
                    MinHeight="{StaticResource Density.PanelHeaderHeight}"
                    Style="{StaticResource PanelHeaderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding LeftPanelHeaderText}"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource PanelHeaderTextStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Navigation.IsEquipmentOutlineVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{loc:Loc Key=Workspace.Equipment}"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource PanelHeaderTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Navigation.IsEquipmentOutlineVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Column="1"
                             Margin="6,0,0,0"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource Text.Secondary}"
                             Text="{Binding Layout.EquipmentOutlineCountText}"
                             Visibility="{Binding Navigation.IsEquipmentOutlineVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    </TextBlock>
                </Grid>
            </Border>

            <project:EquipmentOutlineView Grid.Row="2"
                                           Visibility="{Binding Navigation.IsEquipmentOutlineVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <Grid Grid.Row="2">

                <TabControl SelectedIndex="{Binding Navigation.SelectedLeftToolTabIndex, Mode=TwoWay}">
                    <TabControl.Style>
                        <Style TargetType="TabControl" BasedOn="{StaticResource {x:Type TabControl}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Navigation.IsEquipmentOutlineVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TabControl.Style>
                    <TabItem Header="{loc:Loc Key=Shell.Project}">
                        <Grid Margin="4,6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Margin="2,0,2,4"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{loc:Loc Key=ProjectTree.SearchLabel}" />
                            <DockPanel Grid.Row="1" Margin="0,0,0,4" LastChildFill="True">
                                <Button DockPanel.Dock="Right"
                                        Height="30"
                                        MinWidth="58"
                                        Margin="5,0,0,0"
                                        Padding="8,0"
                                        Command="{Binding ProjectTree.ClearSearchCommand}"
                                        Content="{loc:Loc Key=ProjectTree.ClearSearch}"
                                        AutomationProperties.Name="{loc:Loc Key=ProjectTree.ClearSearch}" />
                                <TextBox Height="30"
                                         VerticalContentAlignment="Center"
                                         Text="{Binding ProjectTree.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="{loc:Loc Key=ProjectTree.SearchLabel}" />
                            </DockPanel>
                            <TextBlock Grid.Row="2"
                                       Margin="2,0,2,5"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Visibility="{Binding ProjectTree.HasSearchMatches, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Run Text="{Binding ProjectTree.SearchResultCount, Mode=OneWay}" />
                                <Run Text="{loc:Loc Key=ProjectTree.SearchResultsSuffix}" />
                            </TextBlock>
                            <TextBlock Grid.Row="2"
                                       Margin="2,0,2,5"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{loc:Loc Key=ProjectTree.SearchNoMatches}"
                                       Visibility="{Binding ProjectTree.HasNoSearchMatches, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TreeView Grid.Row="3"
                                      ItemsSource="{Binding ProjectTree.Roots}"
                                      HorizontalContentAlignment="Stretch"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <TreeView.Resources>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#20394B" />
                                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#20394B" />
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#F3F6F9" />
                                </TreeView.Resources>
                                <b:Interaction.Behaviors>
                                    <behavior:TreeViewSelectedItemBehavior SelectedItem="{Binding ProjectTree.SelectedNode, Mode=TwoWay}" />
                                </b:Interaction.Behaviors>
                                <TreeView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel HorizontalAlignment="Stretch" />
                                    </ItemsPanelTemplate>
                                </TreeView.ItemsPanel>
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                                        <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="6"
                                                    Height="6"
                                                    Margin="2,0,7,0"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource State.Vision}"
                                                    CornerRadius="3" />
                                            <TextBlock Grid.Column="1"
                                                       VerticalAlignment="Center"
                                                       MaxWidth="95"
                                                       Text="{Binding DisplayName}"
                                                       TextWrapping="Wrap" />
                                        </Grid>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </Grid>
                    </TabItem>
                    <TabItem Header="{loc:Loc Key=Shell.Library}">
                        <Grid Margin="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="80" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Margin="4,4,4,7"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{loc:Loc Key=Shell.LibraryPlacementHint}"
                                       TextWrapping="Wrap" />
                            <TextBlock Grid.Row="1"
                                       Margin="4,0,4,3"
                                       Style="{StaticResource SectionCaptionStyle}"
                                       Text="{loc:Loc Key=Equipment.LibrarySearchLabel}" />
                            <Grid Grid.Row="2" Margin="2,0,2,6">
                                <TextBox Height="30"
                                         Padding="8,0,34,0"
                                         VerticalContentAlignment="Center"
                                         Text="{Binding Layout.LibrarySearchText, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="{loc:Loc Key=Equipment.LibrarySearchLabel}" />
                                <Button Width="26"
                                        MinWidth="26"
                                        MinHeight="0"
                                        Margin="0,2,3,2"
                                        Padding="0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Stretch"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        BorderThickness="1"
                                        Foreground="{DynamicResource Text.Secondary}"
                                        Command="{Binding Layout.ClearLibrarySearchCommand}"
                                        ToolTip="{loc:Loc Key=Equipment.LibrarySearchClear}"
                                        AutomationProperties.Name="{loc:Loc Key=Equipment.LibrarySearchClear}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource GlobalCommandButtonStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Layout.IsLibrarySearchEmpty}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="×" FontSize="16" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>
                            </Grid>
                            <Grid Grid.Row="3">
                                <ListBox ItemsSource="{Binding Layout.FilteredLibraryItems}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.Style>
                                        <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Navigation.IsEquipmentOutlineVisible}" Value="True" />
                                                        <Condition Binding="{Binding Layout.IsUnitView}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.Style>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                            <Setter Property="Padding" Value="0" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Button Margin="1"
                                                    Padding="5,5"
                                                    MinHeight="64"
                                                    HorizontalContentAlignment="Stretch"
                                                    AutomationProperties.Name="{Binding Name}"
                                                    Command="{Binding DataContext.AddEquipmentLayoutComponentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Kind}"
                                                    ToolTip="{Binding Description}">
                                                <b:Interaction.Behaviors>
                                                    <behavior:LibraryDragBehavior DragData="{Binding}" />
                                                </b:Interaction.Behaviors>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="40" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <ContentControl Width="34"
                                                                    Height="28"
                                                                    VerticalAlignment="Top"
                                                                    Focusable="False"
                                                                    IsHitTestVisible="False"
                                                                    Content="{Binding}"
                                                                    ContentTemplate="{StaticResource LayoutComponentIconTemplate}" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <DockPanel LastChildFill="True">
                                                            <TextBlock DockPanel.Dock="Right"
                                                                       Margin="6,0,0,0"
                                                                       FontSize="10"
                                                                       Foreground="{DynamicResource Accent.Primary}"
                                                                       Text="{Binding Category}" />
                                                            <TextBlock FontWeight="SemiBold"
                                                                       Text="{Binding Name}"
                                                                       TextWrapping="Wrap" />
                                                        </DockPanel>
                                                        <TextBlock Margin="0,3,0,0"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource Text.Secondary}"
                                                                   Text="{Binding Description}"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Margin="8"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           Text="{loc:Loc Key=Equipment.LibraryNoMatches}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding Layout.HasNoLibrarySearchResults, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Button Panel.ZIndex="2"
                                        MinHeight="64"
                                        Margin="5"
                                        Padding="8,6"
                                        VerticalAlignment="Center"
                                        Command="{Binding OpenStationUnitEditorCommand}"
                                        AutomationProperties.Name="{loc:Loc Key=Equipment.StationUnitAddButton}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryCommandButtonStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Navigation.IsEquipmentOutlineVisible}" Value="True" />
                                                        <Condition Binding="{Binding Layout.IsUnitView}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="{loc:Loc Key=Equipment.LibraryUnitRequired}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap" />
                                </Button>
                            </Grid>
                            <TextBlock Grid.Row="4"
                                       Margin="4,8,4,4"
                                       Style="{StaticResource SectionCaptionStyle}"
                                       Text="{loc:Loc Key=Left.PlacedComponents}" />
                            <ListBox Grid.Row="5"
                                     ItemsSource="{Binding Layout.Items}"
                                     SelectionMode="Extended"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ToolTip="{Binding Name}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ContentControl Width="24"
                                                            Height="20"
                                                            Focusable="False"
                                                            IsHitTestVisible="False"
                                                            Content="{Binding}"
                                                            ContentTemplate="{StaticResource LayoutComponentIconTemplate}" />
                                            <TextBlock Grid.Column="1"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button Grid.Row="6"
                                    Margin="2,6,2,2"
                                    Command="{Binding DeleteLayoutComponentCommand}"
                                    Content="{loc:Loc Key=Left.RemoveSelected}" />
                        </Grid>
                    </TabItem>
                    <TabItem Header="{loc:Loc Key=Project.Diagnostics}">
                        <TabItem.Style>
                            <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Navigation.IsEquipmentOutlineVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TabItem.Style>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="4">
                                <Border Style="{StaticResource InspectorCardStyle}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionCaptionStyle}"
                                                   Text="{loc:Loc Key=ProjectDiagnostics.Title}" />
                                        <TextBlock Margin="0,3,0,0"
                                                   Foreground="{DynamicResource Text.Secondary}"
                                                   Text="{Binding ProjectDiagnostics.PathText}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="0,6,0,0"
                                                   Text="{Binding ProjectDiagnostics.CurrentStateText}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="0,6,0,0"
                                                   Foreground="{DynamicResource State.Warning}"
                                                   Text="{Binding ProjectDiagnostics.LoadSourceNoticeText}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding ProjectDiagnostics.HasLoadSourceNotice, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <TextBlock Margin="0,6,0,0"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding ProjectDiagnostics.SummaryText}"
                                                   TextWrapping="Wrap" />
                                        <StackPanel Margin="0,8,0,0"
                                                    Orientation="Horizontal">
                                            <Button MinHeight="34"
                                                    Padding="9,0"
                                                    Command="{Binding ProjectDiagnostics.RefreshCommand}"
                                                    Content="{loc:Loc Key=ProjectDiagnostics.Refresh}" />
                                            <Button MinHeight="34"
                                                    Padding="9,0"
                                                    Command="{Binding ProjectDiagnostics.PreviewRecoveryCommand}"
                                                    Content="{loc:Loc Key=ProjectDiagnostics.Preview}"
                                                    IsEnabled="{Binding ProjectDiagnostics.CanPreviewRecovery}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InspectorCardStyle}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionCaptionStyle}"
                                                   Text="{loc:Loc Key=ProjectDiagnostics.Findings}" />
                                        <ListBox Margin="0,5,0,0"
                                                 ItemsSource="{Binding ProjectDiagnostics.Items}"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,3,0,3">
                                                        <TextBlock FontWeight="SemiBold"
                                                                   Text="{Binding SeverityText}" />
                                                        <TextBlock Margin="0,2,0,0"
                                                                   Text="{Binding MessageText}"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Margin="0,2,0,0"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource Text.Secondary}"
                                                                   Text="{Binding DetailText}"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InspectorCardStyle}"
                                        Visibility="{Binding ProjectDiagnostics.HasRecoveryPreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionCaptionStyle}"
                                                   Text="{loc:Loc Key=ProjectDiagnostics.PreviewTitle}" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Text="{Binding ProjectDiagnostics.RecoveryPreviewText}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="0,5,0,0"
                                                   Foreground="{DynamicResource Text.Secondary}"
                                                   Text="{loc:Loc Key=ProjectDiagnostics.ApplyHint}"
                                                   TextWrapping="Wrap" />
                                        <StackPanel Margin="0,8,0,0"
                                                    Orientation="Horizontal">
                                            <Button MinHeight="34"
                                                    Padding="9,0"
                                                    Command="{Binding ProjectDiagnostics.ApplyRecoveryCommand}"
                                                    Content="{loc:Loc Key=ProjectDiagnostics.Apply}" />
                                            <Button MinHeight="34"
                                                    Padding="9,0"
                                                    Command="{Binding ProjectDiagnostics.CancelRecoveryPreviewCommand}"
                                                    Content="{loc:Loc Key=ProjectDiagnostics.Cancel}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                <TabItem Header="{loc:Loc Key=Workspace.Equipment}">
                    <TabItem.Style>
                        <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Navigation.IsSimulationWorkspace}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TabItem.Style>
                    <project:EquipmentOutlineView />
                </TabItem>
                </TabControl>
            </Grid>


        </Grid>
    </Border>
</UserControl>
