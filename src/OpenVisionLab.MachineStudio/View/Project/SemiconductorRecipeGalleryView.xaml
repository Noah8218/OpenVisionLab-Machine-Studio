<UserControl x:Class="OpenVisionLab.MachineStudio.View.Project.SemiconductorRecipeGalleryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:OpenVisionLab.MachineStudio.Localization"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="Transparent"
             Focusable="True">
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SemiconductorRecipes.IsOpen}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>

    <Grid>
        <Rectangle Fill="{DynamicResource Surface.Root}" Opacity="0.88" />

        <Border Margin="18"
                Padding="0"
                MaxWidth="1060"
                MaxHeight="590"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource Surface.Panel}"
                BorderBrush="{DynamicResource Border.Default}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="76" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="64" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Padding="18,12"
                        Background="{DynamicResource Surface.Raised}"
                        BorderBrush="{DynamicResource Border.Default}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="8,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="19"
                                       FontWeight="SemiBold"
                                       Text="{loc:Loc Key=Gallery.Title}" />
                            <TextBlock Margin="0,4,0,0"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{loc:Loc Key=Gallery.Subtitle}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Width="34"
                                Height="34"
                                Command="{Binding SemiconductorRecipes.CloseCommand}"
                                AutomationProperties.Name="{loc:Loc Key=Gallery.Close}"
                                Style="{StaticResource QuietCommandButtonStyle}"
                                ToolTip="{loc:Loc Key=Gallery.Close}">
                            <TextBlock FontSize="20" Text="×" />
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="16,14">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SemiconductorRecipes.IsComparisonOpen}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="390" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{DynamicResource Surface.Root}"
                            BorderBrush="{DynamicResource Border.Subtle}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <ListBox ItemsSource="{Binding SemiconductorRecipes.Items}"
                                 SelectedItem="{Binding SemiconductorRecipes.SelectedItem, Mode=TwoWay}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="Padding" Value="10,3" />
                                    <Setter Property="Margin" Value="3,0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemBorder"
                                                        Padding="{TemplateBinding Padding}"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="4">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Surface.Hover}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Surface.Selected}" />
                                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
                                                    </Trigger>
                                                    <Trigger Property="IsMouseCaptured" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Accent.Soft}" />
                                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource Accent.Hover}" />
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Surface.Panel}" />
                                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Foreground" Value="{DynamicResource Text.Disabled}" />
                                            <Setter Property="Opacity" Value="0.55" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock FontWeight="SemiBold"
                                                   Text="{Binding DisplayName}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1"
                                                   Margin="8,0,0,0"
                                                   FontSize="10.5"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding ValidationStatusText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsValidationRunning}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource State.Running}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsValidationPassed}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource State.Success}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsValidationFailed}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource State.Fault}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                         <TextBlock Grid.Row="1"
                                                    Margin="0,2,0,0"
                                                   Foreground="{DynamicResource Text.Secondary}"
                                                   FontFamily="{StaticResource Typography.Telemetry}"
                                                   FontSize="10.5"
                                                   Text="{Binding TopologySummary}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTip="{Binding EquipmentFocus}" />
                                         <TextBlock Grid.Row="1"
                                                    Grid.Column="1"
                                                    Margin="8,2,0,0"
                                                    HorizontalAlignment="Right"
                                                    Foreground="{DynamicResource Text.Secondary}"
                                                    FontFamily="{StaticResource Typography.Telemetry}"
                                                    FontSize="9.5"
                                                    Text="{Binding ValidationContextCompactText}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTip="{Binding ValidationContextDetailText}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <Border Grid.Column="2"
                            Padding="18"
                            Background="{DynamicResource Surface.Raised}"
                            BorderBrush="{DynamicResource Border.Subtle}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                         <RowDefinition Height="Auto" />
                                         <RowDefinition Height="Auto" />
                                         <RowDefinition Height="Auto" />
                                         <RowDefinition Height="Auto" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock FontSize="17"
                                       FontWeight="SemiBold"
                                       Text="{Binding SemiconductorRecipes.SelectedItem.DisplayName}"
                                       TextWrapping="Wrap" />
                            <TextBlock Grid.Row="1"
                                       Margin="0,5,0,0"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       FontFamily="{StaticResource Typography.Telemetry}"
                                       Text="{Binding SemiconductorRecipes.SelectedItem.FileName}" />

                            <Border Grid.Row="3"
                                    Padding="12"
                                    Background="{DynamicResource Surface.Panel}"
                                    CornerRadius="5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Foreground="{DynamicResource Text.Secondary}" Text="{loc:Loc Key=Gallery.Sequence}" />
                                    <TextBlock Grid.Column="1" Margin="14,0,0,0" Text="{Binding SemiconductorRecipes.SelectedItem.SequenceName}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Row="1" Margin="0,7,0,0" Foreground="{DynamicResource Text.Secondary}" Text="{loc:Loc Key=Gallery.EquipmentFocus}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Margin="14,7,0,0" Text="{Binding SemiconductorRecipes.SelectedItem.EquipmentFocus}" TextWrapping="Wrap" ToolTip="{Binding SemiconductorRecipes.SelectedItem.EquipmentFocus}" />
                                    <TextBlock Grid.Row="2" Margin="0,7,0,0" Foreground="{DynamicResource Text.Secondary}" Text="{loc:Loc Key=Gallery.Axes}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Margin="14,7,0,0" Text="{Binding SemiconductorRecipes.SelectedItem.AxisCount}" />
                                    <TextBlock Grid.Row="3" Margin="0,7,0,0" Foreground="{DynamicResource Text.Secondary}" Text="{loc:Loc Key=Gallery.Devices}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Margin="14,7,0,0" Text="{Binding SemiconductorRecipes.SelectedItem.DeviceCount}" />
                                    <TextBlock Grid.Row="4" Margin="0,7,0,0" Foreground="{DynamicResource Text.Secondary}" Text="{loc:Loc Key=Gallery.Channels}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Margin="14,7,0,0" Text="{Binding SemiconductorRecipes.SelectedItem.ChannelCount}" />
                                    <TextBlock Grid.Row="5" Margin="0,7,0,0" Foreground="{DynamicResource Text.Secondary}" Text="{loc:Loc Key=Gallery.Components}" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Margin="14,7,0,0" Text="{Binding SemiconductorRecipes.SelectedItem.ComponentCount}" />
                                    <TextBlock Grid.Row="6" Margin="0,7,0,0" Foreground="{DynamicResource Text.Secondary}" Text="{loc:Loc Key=Gallery.Steps}" />
                                     <TextBlock Grid.Row="6" Grid.Column="1" Margin="14,7,0,0" Text="{Binding SemiconductorRecipes.SelectedItem.StepCount}" />
                                     <TextBlock Grid.Row="7" Margin="0,7,0,0" Foreground="{DynamicResource Text.Secondary}" Text="{loc:Loc Key=Gallery.ProjectSchema}" />
                                     <TextBlock Grid.Row="7" Grid.Column="1" Margin="14,7,0,0" Text="{Binding SemiconductorRecipes.SelectedItem.ProjectSchema}" />
                                     <TextBlock Grid.Row="8" Margin="0,7,0,0" Foreground="{DynamicResource Text.Secondary}" Text="{loc:Loc Key=Gallery.ValidatedBuild}" />
                                     <TextBlock Grid.Row="8" Grid.Column="1" Margin="14,7,0,0"
                                                Text="{Binding SemiconductorRecipes.SelectedItem.ValidationBuildIdentity}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTip="{Binding SemiconductorRecipes.SelectedItem.ValidationContextDetailText}" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Row="5" VerticalAlignment="Bottom">
                                <Border Margin="0,0,0,9"
                                        Padding="11,8"
                                        BorderThickness="1"
                                        CornerRadius="5">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource Surface.Panel}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource State.Success}" />
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SemiconductorRecipes.HasValidationSummary}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SemiconductorRecipes.HasFirstFailure}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource State.Fault}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Foreground="{DynamicResource Text.Primary}"
                                               Text="{Binding SemiconductorRecipes.ValidationSummary}"
                                               TextWrapping="Wrap" />
                                </Border>
                                <Border Padding="11,8"
                                        Background="{DynamicResource Accent.Soft}"
                                        BorderBrush="{DynamicResource Accent.Primary}"
                                        BorderThickness="1"
                                        CornerRadius="5">
                                    <TextBlock Foreground="{DynamicResource Text.Primary}"
                                               Text="{loc:Loc Key=Gallery.SafePreview}"
                                               TextWrapping="Wrap" />
                                </Border>
                                <TextBlock Margin="0,9,0,0"
                                           Foreground="{DynamicResource State.Fault}"
                                           Text="{Binding SemiconductorRecipes.ErrorMessage}"
                                           TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SemiconductorRecipes.HasError}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="1" Margin="16,14">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SemiconductorRecipes.IsComparisonOpen}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Padding="14,10"
                            Background="{DynamicResource Surface.Raised}"
                            BorderBrush="{DynamicResource Border.Subtle}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontSize="16"
                                           FontWeight="SemiBold"
                                           Text="{loc:Loc Key=Gallery.ComparisonTitle}" />
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           Text="{Binding SemiconductorRecipes.ComparisonSummary}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="20,0,0,0" HorizontalAlignment="Right">
                                <TextBlock HorizontalAlignment="Right"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           FontFamily="{StaticResource Typography.Telemetry}"
                                           Text="{Binding SemiconductorRecipes.BaselineReportText}" />
                                <TextBlock Margin="0,3,0,0"
                                           HorizontalAlignment="Right"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           FontFamily="{StaticResource Typography.Telemetry}"
                                           Text="{Binding SemiconductorRecipes.CurrentReportText}" />
                                <TextBlock Margin="0,3,0,0"
                                           HorizontalAlignment="Right"
                                           FontFamily="{StaticResource Typography.Telemetry}"
                                           Text="{Binding SemiconductorRecipes.ProjectSchemaComparison}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SemiconductorRecipes.IsProjectSchemaChanged}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource State.Warning}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2"
                            Background="{DynamicResource Surface.Root}"
                            BorderBrush="{DynamicResource Border.Subtle}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding SemiconductorRecipes.ComparisonItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="4,3"
                                                Padding="10,6"
                                                Background="{DynamicResource Surface.Panel}"
                                                BorderThickness="1"
                                                CornerRadius="4">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsNewlyFailed}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource State.Fault}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsRecovered}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource State.Success}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsAdded}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsRemoved}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource State.Warning}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsMetadataChanged}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource State.Warning}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="260" />
                                                    <ColumnDefinition Width="130" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold"
                                                               Text="{Binding DisplayName}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Margin="0,2,0,0"
                                                               Foreground="{DynamicResource Text.Secondary}"
                                                               FontFamily="{StaticResource Typography.Telemetry}"
                                                               FontSize="10.5"
                                                               Text="{Binding FileName}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           Margin="12,0"
                                                           VerticalAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding ChangeStatusText}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsNewlyFailed}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource State.Fault}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsRecovered}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource State.Success}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsAdded}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Accent.Primary}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsRemoved}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource State.Warning}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsMetadataChanged}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource State.Warning}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding OutcomeChangeText}" />
                                                    <TextBlock Margin="0,2,0,0"
                                                               Foreground="{DynamicResource Text.Secondary}"
                                                               FontFamily="{StaticResource Typography.Telemetry}"
                                                               FontSize="10.5"
                                                               Text="{Binding ProjectSchemaChangeText}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasProjectSchemaChange}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Margin="0,2,0,0"
                                                               Foreground="{DynamicResource Text.Secondary}"
                                                               FontFamily="{StaticResource Typography.Telemetry}"
                                                               FontSize="10.5"
                                                               Text="{Binding BuildChangeText}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding BuildChangeDetailText}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasBuildChange}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <Border Grid.Row="2"
                        Padding="16,10"
                        Background="{DynamicResource Surface.Raised}"
                        BorderBrush="{DynamicResource Border.Default}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,8,8">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SemiconductorRecipes.IsComparisonOpen}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Foreground="{DynamicResource Text.Secondary}"
                                       Text="{loc:Loc Key=Gallery.CopyHint}" />
                             <TextBlock Margin="0,2,0,0"
                                       Foreground="{DynamicResource State.Running}"
                                       FontFamily="{StaticResource Typography.Telemetry}"
                                       FontSize="10.5"
                                        Text="{Binding SemiconductorRecipes.ValidationProgressText}" />
                         </StackPanel>
                         <TextBlock VerticalAlignment="Center"
                                    Foreground="{DynamicResource Text.Secondary}"
                                    Text="{loc:Loc Key=Gallery.Comparison.SafeHint}"
                                    TextWrapping="Wrap">
                             <TextBlock.Style>
                                 <Style TargetType="TextBlock">
                                     <Setter Property="Visibility" Value="Collapsed" />
                                     <Style.Triggers>
                                         <DataTrigger Binding="{Binding SemiconductorRecipes.IsComparisonOpen}" Value="True">
                                             <Setter Property="Visibility" Value="Visible" />
                                         </DataTrigger>
                                     </Style.Triggers>
                                 </Style>
                             </TextBlock.Style>
                         </TextBlock>
                         <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                             <StackPanel.Style>
                                 <Style TargetType="StackPanel">
                                     <Setter Property="Visibility" Value="Visible" />
                                     <Style.Triggers>
                                         <DataTrigger Binding="{Binding SemiconductorRecipes.IsComparisonOpen}" Value="True">
                                             <Setter Property="Visibility" Value="Collapsed" />
                                         </DataTrigger>
                                     </Style.Triggers>
                                 </Style>
                             </StackPanel.Style>
                             <Button Command="{Binding SemiconductorRecipes.CompareCompatibilityReportsCommand}"
                                     AutomationProperties.Name="{loc:Loc Key=Gallery.CompareCompatibilityReports}"
                                     Style="{StaticResource QuietCommandButtonStyle}"
                                     ToolTip="{loc:Loc Key=Gallery.CompareCompatibilityReportsTooltip}">
                                 <StackPanel Orientation="Horizontal">
                                     <ui:SymbolIcon Symbol="FolderOpen24"
                                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                     <TextBlock Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                Text="{loc:Loc Key=Gallery.CompareCompatibilityReports}" />
                                 </StackPanel>
                             </Button>
                            <Button Command="{Binding SemiconductorRecipes.ValidateAllCommand}"
                                    Margin="8,0,0,0"
                                    AutomationProperties.Name="{loc:Loc Key=Gallery.ValidateAll}"
                                Style="{StaticResource QuietCommandButtonStyle}"
                                ToolTip="{loc:Loc Key=Gallery.ValidateAllTooltip}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Play24"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock Margin="6,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                               Text="{loc:Loc Key=Gallery.ValidateAll}" />
                                </StackPanel>
                             </Button>
                             <Button Margin="8,0,0,0"
                                     Command="{Binding SemiconductorRecipes.SaveCompatibilityReportCommand}"
                                     AutomationProperties.Name="{loc:Loc Key=Gallery.SaveCompatibilityReport}"
                                     Style="{StaticResource QuietCommandButtonStyle}"
                                     ToolTip="{loc:Loc Key=Gallery.SaveCompatibilityReportTooltip}">
                                 <StackPanel Orientation="Horizontal">
                                     <ui:SymbolIcon Symbol="Save24"
                                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                     <TextBlock Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                Text="{loc:Loc Key=Gallery.SaveCompatibilityReport}" />
                                 </StackPanel>
                             </Button>
                             <Button Command="{Binding SemiconductorRecipes.CloseCommand}"
                                    Margin="8,0,0,0"
                                    AutomationProperties.Name="{loc:Loc Key=Gallery.Close}"
                                    Style="{StaticResource QuietCommandButtonStyle}"
                                    Content="{loc:Loc Key=Gallery.Close}" />
                            <Button Margin="8,0,0,0"
                                    Command="{Binding SemiconductorRecipes.CreateCopyCommand}"
                                    AutomationProperties.Name="{loc:Loc Key=Gallery.CreateCopy}"
                                    Style="{StaticResource PrimaryCommandButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Add24" Foreground="{DynamicResource Accent.Primary}" />
                                    <TextBlock Margin="6,0,0,0"
                                               VerticalAlignment="Center"
                                               Text="{loc:Loc Key=Gallery.CreateCopy}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SemiconductorRecipes.IsComparisonOpen}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Button Command="{Binding SemiconductorRecipes.CloseCompatibilityComparisonCommand}"
                                    AutomationProperties.Name="{loc:Loc Key=Gallery.CloseComparison}"
                                    Style="{StaticResource QuietCommandButtonStyle}"
                                    Content="{loc:Loc Key=Gallery.CloseComparison}" />
                            <Button Margin="8,0,0,0"
                                    Command="{Binding SemiconductorRecipes.CloseCommand}"
                                    AutomationProperties.Name="{loc:Loc Key=Gallery.Close}"
                                    Style="{StaticResource QuietCommandButtonStyle}"
                                    Content="{loc:Loc Key=Gallery.Close}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
