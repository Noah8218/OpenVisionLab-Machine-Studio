<UserControl x:Class="OpenVisionLab.MachineStudio.View.Project.NewProjectNameDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:OpenVisionLab.MachineStudio.Localization"
             AutomationProperties.Name="{loc:Loc Key=Project.NewRecipeTitle}"
             Focusable="True"
             FocusManager.IsFocusScope="True"
             FocusManager.FocusedElement="{Binding ElementName=ProjectNameTextBox}"
             KeyboardNavigation.TabNavigation="Cycle"
             Visibility="{Binding IsNewProjectNameDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelNewProjectNameCommand}" />
    </UserControl.InputBindings>
    <Grid Background="Transparent">
        <Border Background="{DynamicResource Surface.Root}" Opacity="0.69" />
        <Border Width="480"
                MaxWidth="620"
                Margin="20"
                Padding="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource Surface.Raised}"
                BorderBrush="{DynamicResource Border.Default}"
                BorderThickness="1"
                CornerRadius="9">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border BorderBrush="{DynamicResource Border.Default}"
                        BorderThickness="0,0,0,1"
                        Padding="20,16">
                    <TextBlock FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Text.Primary}"
                               Text="{loc:Loc Key=Project.NewRecipeTitle}"
                               TextWrapping="Wrap" />
                </Border>
                <StackPanel Grid.Row="1" Margin="20,18,20,20">
                    <TextBlock Margin="0,0,0,8"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Text.Primary}"
                               Text="{loc:Loc Key=Project.NewRecipeNameLabel}"
                               TextWrapping="Wrap" />
                    <TextBox x:Name="ProjectNameTextBox"
                             MinHeight="38"
                             Padding="10,6"
                             MaxLength="60"
                             VerticalContentAlignment="Center"
                             Text="{Binding NewProjectNameDraft, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="{loc:Loc Key=Project.NewRecipeNameLabel}" />
                    <TextBlock Margin="0,9,0,0"
                               Foreground="{DynamicResource Text.Secondary}"
                               Text="{loc:Loc Key=Project.NewRecipeEmptyHint}"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="{DynamicResource State.Fault}"
                               Text="{Binding NewProjectNameValidationText}"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasNewProjectNameValidationError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
                <Border Grid.Row="2"
                        BorderBrush="{DynamicResource Border.Default}"
                        BorderThickness="0,1,0,0"
                        Padding="20,14">
                    <StackPanel HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                KeyboardNavigation.TabNavigation="Local">
                        <Button MinWidth="96"
                                MinHeight="36"
                                Margin="0,0,8,0"
                                Command="{Binding CancelNewProjectNameCommand}"
                                Content="{loc:Loc Key=Project.Cancel}"
                                AutomationProperties.Name="{loc:Loc Key=Project.Cancel}"
                                Style="{StaticResource GlobalCommandButtonStyle}" />
                        <Button MinWidth="96"
                                MinHeight="36"
                                IsDefault="True"
                                Command="{Binding ConfirmNewProjectNameCommand}"
                                Content="{loc:Loc Key=Project.Create}"
                                AutomationProperties.Name="{loc:Loc Key=Project.Create}"
                                Style="{StaticResource PrimaryCommandButtonStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
