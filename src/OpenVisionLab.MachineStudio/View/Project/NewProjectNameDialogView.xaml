<UserControl x:Class="OpenVisionLab.MachineStudio.View.Project.NewProjectNameDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:OpenVisionLab.MachineStudio.Localization"
             FontFamily="Segoe UI, Malgun Gothic" Foreground="{DynamicResource Text.Primary}" UseLayoutRounding="False"
             AutomationProperties.Name="{loc:Loc Key=Project.NewRecipeTitle}"
             Focusable="True"
             FocusManager.IsFocusScope="True"
             FocusManager.FocusedElement="{Binding ElementName=ProjectNameTextBox}"
             KeyboardNavigation.TabNavigation="Cycle"
             Visibility="{Binding IsNewProjectNameDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelNewProjectNameCommand}" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <Style x:Key="NameDialogTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic" /><Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" /><Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            <Setter Property="LineHeight" Value="18.85" /><Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Style.Triggers><DataTrigger Binding="{Binding DataContext.Navigation.IsCompactLayout, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"><Setter Property="FontSize" Value="12.5" /><Setter Property="LineHeight" Value="18.125" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="NameDialogInputStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic" /><Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" /><Setter Property="Background" Value="{DynamicResource Surface.Input}" /><Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{DynamicResource Text.Secondary}" /><Setter Property="Padding" Value="5,4" /><Setter Property="Height" Value="28" /><Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
                <Grid>
                    <Border x:Name="InputBorder" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Padding="0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <Border x:Name="InputFocusCue" Margin="-3" CornerRadius="5" BorderBrush="{DynamicResource Accent.Primary}" BorderThickness="2" IsHitTestVisible="False" Visibility="Collapsed" />
                </Grid>
                <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="InputFocusCue" Property="Visibility" Value="Visible" /></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasNewProjectNameValidationError}" Value="True"><Setter Property="Background" Value="{DynamicResource State.FaultSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource State.Fault}" /></DataTrigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.6" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NameDialogButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic" /><Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" /><Setter Property="Background" Value="{DynamicResource Surface.Raised}" /><Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="28" /><Setter Property="Padding" Value="10,4" /><Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
                <TextBlock Text="{Binding}" Style="{StaticResource NameDialogTextStyle}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=Button}}" />
            </DataTemplate></Setter.Value></Setter>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Grid>
                    <Border CornerRadius="5" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <Border x:Name="ButtonFocusCue" Margin="-4" CornerRadius="6" BorderThickness="2" BorderBrush="{DynamicResource Accent.Primary}" IsHitTestVisible="False" Visibility="Collapsed" />
                </Grid>
                <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonFocusCue" Property="Visibility" Value="Visible" /></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Navigation.IsCompactLayout}" Value="True"><Setter Property="FontSize" Value="12.5" /></DataTrigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Surface.Hover}" /></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource Surface.Pressed}" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource Text.Disabled}" /><Setter Property="Background" Value="{DynamicResource Surface.Disabled}" /><Setter Property="BorderBrush" Value="{DynamicResource Border.Disabled}" /><Setter Property="Cursor" Value="No" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NameDialogCreateButtonStyle" TargetType="Button" BasedOn="{StaticResource NameDialogButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource Accent.Primary}" /><Setter Property="BorderBrush" Value="{DynamicResource Accent.Primary}" /><Setter Property="Foreground" Value="{DynamicResource Text.OnAccent}" /><Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers><Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource Accent.Pressed}" /></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Accent.Hover}" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{DynamicResource Accent.Soft}" /><Setter Property="Foreground" Value="{DynamicResource Text.Disabled}" /><Setter Property="BorderBrush" Value="{DynamicResource State.RunningBorder}" /></Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Background="Transparent">
        <Border Background="{DynamicResource Surface.ModalScrim}" Opacity="0.69" />
        <Border x:Name="NameDialogPanel" Width="640"
                MaxWidth="640"
                Margin="20"
                Padding="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource Surface.Panel}"
                BorderBrush="{DynamicResource Border.Default}"
                BorderThickness="1"
                CornerRadius="9">
            <Border.Effect><DropShadowEffect Color="Black" Opacity="0.733" BlurRadius="80" ShadowDepth="20" Direction="270" /></Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border BorderBrush="{DynamicResource Border.Subtle}"
                        BorderThickness="0,0,0,1"
                        Padding="18,13">
                    <TextBlock Style="{StaticResource NameDialogTextStyle}" FontSize="16" LineHeight="23.2"
                               FontWeight="Bold"
                               Text="{loc:Loc Key=Project.NewRecipeTitle}"
                               TextWrapping="Wrap" />
                </Border>
                <StackPanel Grid.Row="1" Margin="18,14">
                    <TextBlock Style="{StaticResource NameDialogTextStyle}" FontSize="12" LineHeight="17.4" Margin="0,0,0,3"
                               Foreground="{DynamicResource Text.Secondary}"
                               Text="{loc:Loc Key=Project.NewRecipeNameLabel}"
                               TextWrapping="Wrap" />
                    <TextBox x:Name="ProjectNameTextBox"
                             Style="{StaticResource NameDialogInputStyle}"
                             IsEnabled="{Binding IsNewProjectNameEntryEnabled}"
                             MaxLength="60"
                             VerticalContentAlignment="Center"
                             Text="{Binding NewProjectNameDraft, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="{loc:Loc Key=Project.NewRecipeNameLabel}" />
                    <Border Margin="0,3,0,0">
                        <TextBlock Style="{StaticResource NameDialogTextStyle}" FontSize="11.5" LineHeight="16.675"
                                   Foreground="{DynamicResource State.Fault}"
                                   Text="{Binding NewProjectNameValidationText}" TextWrapping="Wrap"
                                   Visibility="{Binding HasNewProjectNameValidationError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Border>
                    <TextBlock Style="{StaticResource NameDialogTextStyle}" FontSize="11.5" LineHeight="16.675" Margin="0,10,0,0"
                               Foreground="{DynamicResource Text.Secondary}"
                               Text="{loc:Loc Key=Project.NewRecipeEmptyHint}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Row="2"
                        BorderBrush="{DynamicResource Border.Subtle}"
                        BorderThickness="0,1,0,0"
                        Padding="18,10">
                    <StackPanel HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                KeyboardNavigation.TabNavigation="Local">
                        <Button Margin="0,0,6,0"
                                Command="{Binding CancelNewProjectNameCommand}"
                                Content="{loc:Loc Key=Project.Cancel}"
                                AutomationProperties.Name="{loc:Loc Key=Project.Cancel}"
                                Style="{StaticResource NameDialogButtonStyle}" />
                        <Button IsDefault="True"
                                Command="{Binding ConfirmNewProjectNameCommand}"
                                Content="{loc:Loc Key=Project.Create}"
                                AutomationProperties.Name="{loc:Loc Key=Project.Create}"
                                Style="{StaticResource NameDialogCreateButtonStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
