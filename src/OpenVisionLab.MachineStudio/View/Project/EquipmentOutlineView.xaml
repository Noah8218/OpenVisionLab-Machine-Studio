<UserControl x:Class="OpenVisionLab.MachineStudio.View.Project.EquipmentOutlineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:OpenVisionLab.MachineStudio.Converter"
             xmlns:loc="clr-namespace:OpenVisionLab.MachineStudio.Localization"
             xmlns:project="clr-namespace:OpenVisionLab.MachineStudio.View.Project">
    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0"
                Padding="10"
                Background="{DynamicResource Surface.Panel}"
                BorderBrush="{DynamicResource Border.Default}"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <Grid>
                    <TextBox Height="34"
                             Padding="8,0,34,0"
                             VerticalContentAlignment="Center"
                             Text="{Binding Layout.EquipmentOutlineSearchText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="{loc:Loc Key=Equipment.OutlineSearch}" />
                    <TextBlock Margin="10,0,4,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Foreground="{DynamicResource Text.Secondary}"
                               FontSize="11"
                               Text="{loc:Loc Key=Equipment.OutlineSearch}"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding Layout.IsEquipmentOutlineSearchEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button Width="26"
                            MinWidth="26"
                            MinHeight="0"
                            Margin="0,3,3,3"
                            Padding="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            Foreground="{DynamicResource Text.Secondary}"
                            Command="{Binding Layout.ClearEquipmentOutlineSearchCommand}"
                            ToolTip="{loc:Loc Key=Equipment.OutlineSearchClear}"
                            AutomationProperties.Name="{loc:Loc Key=Equipment.OutlineSearchClear}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GlobalCommandButtonStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Layout.IsEquipmentOutlineSearchEmpty}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="×" FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                </Grid>
                <UniformGrid Columns="2" Margin="0,8,0,0">
                <Button MinHeight="34"
                         Margin="0,0,3,0"
                         Padding="6,2"
                         Command="{Binding OpenStationUnitEditorCommand}"
                         AutomationProperties.Name="{loc:Loc Key=Equipment.OutlineAddUnit}"
                         Style="{StaticResource PrimaryCommandButtonStyle}">
                    <TextBlock Text="{loc:Loc Key=Equipment.OutlineAddUnit}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                </Button>
                <Button MinHeight="34"
                         Margin="3,0,0,0"
                         Padding="6,2"
                         Command="{Binding OpenEquipmentComponentLibraryDialogCommand}"
                         AutomationProperties.Name="{loc:Loc Key=Equipment.AddPartButton}"
                         Style="{StaticResource GlobalCommandButtonStyle}">
                    <TextBlock Text="{loc:Loc Key=Equipment.AddPartButton}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </Button>
                </UniformGrid>
            </StackPanel>
        </Border>


        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="8,5">
                    <ItemsControl ItemsSource="{Binding Layout.EquipmentOutlineUnits}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4,0,8">
                                    <Border Margin="0,3,0,5" Padding="5,2"
                                            BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,0,1"
                                            Visibility="{Binding ShowStationHeader, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <DockPanel LastChildFill="True">
                                            <TextBlock DockPanel.Dock="Right" Margin="4,0,0,0"
                                                       Foreground="{DynamicResource Text.Secondary}"
                                                       Text="{Binding StationComponentCount}" />
                                            <TextBlock DockPanel.Dock="Left" Margin="0,0,5,0"
                                                       Foreground="{DynamicResource Accent.Primary}" Text="▦" />
                                            <TextBlock Text="{Binding StationName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        </DockPanel>
                                    </Border>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="34" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Height="Auto" MinHeight="34"
                                                Padding="6,3"
                                                HorizontalContentAlignment="Stretch"
                                                Command="{Binding DataContext.ShowEquipmentUnitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding UnitId}"
                                                IsEnabled="{Binding CanOpenUnit}"
                                                AutomationProperties.ItemStatus="{Binding AutomationItemStatus}"
                                                AutomationProperties.Name="{Binding AutomationName}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource GlobalCommandButtonStyle}">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderBrush" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource Accent.Soft}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <DockPanel LastChildFill="True">
                                                <TextBlock DockPanel.Dock="Right" Margin="5,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Text.Secondary}"
                                                           Text="{Binding ComponentCount}" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Margin="0,1,0,0" FontSize="10"
                                                               Foreground="{DynamicResource Text.Secondary}"
                                                               Text="{Binding UnitId}"
                                                               Visibility="{Binding ShowUnitId, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Button>
                                        <Button Grid.Column="1" Width="30" MinWidth="30" MinHeight="34" Margin="0" Padding="0"
                                                Command="{Binding DataContext.RemoveEquipmentUnitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding UnitId}"
                                                AutomationProperties.Name="{Binding RemoveAutomationName}"
                                                ToolTip="{loc:Loc Key=Equipment.OutlineRemoveUnit}"
                                                Visibility="{Binding CanOpenUnit, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Style="{StaticResource QuietCommandButtonStyle}">
                                            <TextBlock Text="×" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        </Button>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Parts}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="36" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid>
                                                        <project:EquipmentOutlineSelectionCheckBox x:Name="PartSelectionBox" Opacity="0"
                                                                  IsChecked="{Binding Item.IsSelected, Mode=OneWay}"
                                                                  Command="{Binding DataContext.Layout.ToggleEquipmentOutlinePartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  CommandParameter="{Binding Item}"
                                                                  AutomationProperties.Name="{Binding SelectionAutomationName}" />
                                                        <Border Width="16" Height="16" Margin="7,0,0,0"
                                                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                CornerRadius="3"
                                                                IsHitTestVisible="False">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource Text.Secondary}" />
                                                                    <Setter Property="BorderThickness" Value="1" />
                                                                    <Setter Property="Background" Value="Transparent" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Item.IsSelected}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource Accent.Primary}" />
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=PartSelectionBox}" Value="True">
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsPressed, ElementName=PartSelectionBox}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource Accent.Soft}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=PartSelectionBox}" Value="True">
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
                                                                            <Setter Property="BorderThickness" Value="2" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="✓" FontSize="12" FontWeight="Bold"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource Surface.Root}"
                                                                       Visibility="{Binding Item.IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                        </Border>
                                                    </Grid>
                                                    <Button Grid.Column="1" Height="Auto" Padding="6,4" MinHeight="44"
                                                            HorizontalContentAlignment="Stretch"
                                                            Command="{Binding DataContext.Layout.SelectEquipmentOutlinePartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding Item}"
                                                            AutomationProperties.Name="{Binding AutomationName}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource GlobalCommandButtonStyle}">
                                                                <Setter Property="Background" Value="Transparent" />
                                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Item.IsSelected}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource Accent.Soft}" />
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Item.CurrentName}" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding DetailText}" FontSize="10"
                                                                       Foreground="{DynamicResource Text.Secondary}"
                                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Margin="4,8" Text="{loc:Loc Key=Equipment.OutlineNoMatches}"
                               Foreground="{DynamicResource Text.Secondary}"
                               TextWrapping="Wrap"
                               Visibility="{Binding Layout.EquipmentOutlineHasNoMatches, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0"
                                Visibility="{Binding Layout.EquipmentOutlineHasPages, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button Content="{loc:Loc Key=Equipment.OutlinePrevious}"
                                Command="{Binding Layout.PreviousEquipmentOutlinePageCommand}" />
                        <TextBlock Margin="8,0" VerticalAlignment="Center"
                                   Text="{Binding Layout.EquipmentOutlinePageText}" />
                        <Button Content="{loc:Loc Key=Equipment.OutlineNext}"
                                Command="{Binding Layout.NextEquipmentOutlinePageCommand}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Border Grid.Row="2"
                Padding="8"
                Background="{DynamicResource Surface.Raised}"
                BorderBrush="{DynamicResource Border.Default}"
                BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" MinHeight="34" Padding="8,0" Margin="6,0,0,0"
                        Command="{Binding ShowEquipmentOverviewCommand}"
                        Content="{loc:Loc Key=Equipment.OverviewButton}"
                        AutomationProperties.Name="{loc:Loc Key=Equipment.OverviewButton}"
                        Style="{StaticResource GlobalCommandButtonStyle}" />
                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource Accent.Primary}"
                           Text="{Binding Layout.EquipmentOutlineSelectionText}" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
