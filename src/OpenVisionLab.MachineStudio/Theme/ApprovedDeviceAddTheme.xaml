<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!-- V08 approval lock, 2026-10-07. Preserve the pre-R40 resource closure here;
         application theme changes must not restyle the approved Device Add view. -->
    <ResourceDictionary.MergedDictionaries>
        <ui:ThemesDictionary Theme="Dark" />
        <ui:ControlsDictionary />
    </ResourceDictionary.MergedDictionaries>
    <SolidColorBrush x:Key="ApprovedDeviceAdd.TextPrimary" Color="#E5EEF3" />
    <SolidColorBrush x:Key="ApprovedDeviceAdd.ControlForeground" Color="#FFFFFF" />
    <!-- OpenVisionLab Machine Studio semantic tokens. -->
    <SolidColorBrush x:Key="Shell.WorkbarSurface" Color="#0F1E28" />
    <SolidColorBrush x:Key="Surface.Root" Color="#09131B" />
    <SolidColorBrush x:Key="Surface.Panel" Color="#122430" />
    <SolidColorBrush x:Key="Surface.Raised" Color="#1B3340" />
    <SolidColorBrush x:Key="Surface.Hover" Color="#254653" />
    <SolidColorBrush x:Key="Surface.Selected" Color="#203F49" />
    <SolidColorBrush x:Key="Border.Default" Color="#34505E" />
    <SolidColorBrush x:Key="Border.Subtle" Color="#29434F" />

    <SolidColorBrush x:Key="Text.Primary" Color="#E5EEF3" />
    <SolidColorBrush x:Key="Text.Secondary" Color="#A7BECB" />
    <SolidColorBrush x:Key="Text.Disabled" Color="#6F7B87" />
    <SolidColorBrush x:Key="Text.OnAccent" Color="#08362C" />

    <SolidColorBrush x:Key="Accent.Primary" Color="#70D9C5" />
    <SolidColorBrush x:Key="Accent.Hover" Color="#9FE8DC" />
    <SolidColorBrush x:Key="Accent.Soft" Color="#173E3D" />
    <SolidColorBrush x:Key="TextControlFocusedBorderBrush" Color="{Binding Color, Source={StaticResource Accent.Primary}}" />

    <SolidColorBrush x:Key="State.Ready" Color="#7F8C99" />
    <SolidColorBrush x:Key="State.Running" Color="#2CCB78" />
    <SolidColorBrush x:Key="State.Paused" Color="#F0B429" />
    <SolidColorBrush x:Key="State.Warning" Color="#F4D38D" />
    <SolidColorBrush x:Key="State.Fault" Color="#FFA7B0" />
    <SolidColorBrush x:Key="State.Forced" Color="#B579FF" />
    <SolidColorBrush x:Key="State.Vision" Color="#3BC9DB" />
    <SolidColorBrush x:Key="State.Selected" Color="#70D9C5" />
    <SolidColorBrush x:Key="State.RunningSurface" Color="#173B2D" />
    <SolidColorBrush x:Key="State.PausedSurface" Color="#3D3018" />

    <SolidColorBrush x:Key="Scene.Background" Color="#0D202B" />
    <SolidColorBrush x:Key="Scene.Component.Axis" Color="#6DC5D6" />
    <SolidColorBrush x:Key="Scene.Component.Cylinder" Color="#70D9C5" />
    <SolidColorBrush x:Key="Scene.Component.Sensor" Color="#F0C76F" />
    <SolidColorBrush x:Key="Scene.Component.DigitalIo" Color="#E4AA9D" />
    <SolidColorBrush x:Key="Scene.Component.Camera" Color="#92A4ED" />
    <SolidColorBrush x:Key="Scene.Component.Conveyor" Color="#88A7B6" />
    <SolidColorBrush x:Key="Scene.Component.Frame" Color="#314F5E" />
    <SolidColorBrush x:Key="Scene.Component.FrameSupport" Color="#537687" />
    <SolidColorBrush x:Key="Scene.Component.AxisBase" Color="#476978" />
    <SolidColorBrush x:Key="Scene.Component.CylinderRod" Color="#BACBD3" />
    <SolidColorBrush x:Key="Scene.Component.CylinderJaw" Color="#EAC77D" />
    <SolidColorBrush x:Key="Scene.Component.CameraPost" Color="#688A9B" />
    <SolidColorBrush x:Key="Scene.Component.CameraPlate" Color="#9CB7C4" />
    <SolidColorBrush x:Key="Scene.Component.ConveyorBase" Color="#375362" />
    <SolidColorBrush x:Key="Scene.Component.ConveyorRoller" Color="#9EB1B9" />
    <SolidColorBrush x:Key="Scene.Component.Selected" Color="#B9FFF0" />
    <SolidColorBrush x:Key="Scene.Component.Outline" Color="#06141C" />
    <LinearGradientBrush x:Key="Equipment.OverviewCardBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1F4151" Offset="0" />
        <GradientStop Color="#112633" Offset="1" />
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="Scene.ObliqueBackground" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.75" RadiusY="0.75">
        <GradientStop Color="#183946" Offset="0" />
        <GradientStop Color="#0D202B" Offset="1" />
    </RadialGradientBrush>
    <SolidColorBrush x:Key="Scene.ObliqueGrid" Color="#25414E" />
    <SolidColorBrush x:Key="Scene.Grid" Color="#27313D" />
    <SolidColorBrush x:Key="Scene.GridMajor" Color="#344252" />
    <SolidColorBrush x:Key="Scene.AxisX" Color="#FF6B6B" />
    <SolidColorBrush x:Key="Scene.AxisY" Color="#51CF66" />
    <SolidColorBrush x:Key="Scene.AxisZ" Color="#4DABF7" />

    <FontFamily x:Key="Typography.FontFamily">Segoe UI Variable Text, Malgun Gothic, Segoe UI</FontFamily>
    <FontFamily x:Key="Typography.Telemetry">Cascadia Mono, Consolas</FontFamily>

    <sys:Double x:Key="Density.PanelHeaderHeight">30</sys:Double>
    <sys:Double x:Key="Density.ToolbarButtonSize">32</sys:Double>
    <sys:Double x:Key="Density.GlobalCommandButtonHeight">34</sys:Double>
    <sys:Double x:Key="Density.TreeRowHeight">26</sys:Double>
    <sys:Double x:Key="Density.DataGridRowHeight">26</sys:Double>
    <sys:Double x:Key="Density.InspectorFieldHeight">30</sys:Double>
    <sys:Double x:Key="Density.StandardMargin">8</sys:Double>
    <sys:Double x:Key="Density.SectionGap">12</sys:Double>
    <sys:Double x:Key="Density.MajorGap">16</sys:Double>
    <CornerRadius x:Key="Density.CornerRadius">6</CornerRadius>

    <Style x:Key="ApprovedDeviceAddTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Typography.FontFamily}" />
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, FallbackValue=#E5EEF3}" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="CommandFocusVisualStyle" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Rectangle Margin="-3" RadiusX="4" RadiusY="4" Stroke="{DynamicResource Accent.Hover}" StrokeThickness="2" StrokeDashArray="2,2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="GlobalCommandButtonStyle" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource CommandFocusVisualStyle}" />
        <Setter Property="Height" Value="{StaticResource Density.GlobalCommandButtonHeight}" />
        <Setter Property="MinWidth" Value="58" />
        <Setter Property="Margin" Value="3,0" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource Surface.Raised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Surface.Hover}" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource Accent.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Accent.Soft}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Text.Disabled}" />
                            <Setter Property="Opacity" Value="0.55" />
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Surface.Panel}" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="QuietCommandButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource GlobalCommandButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
</ResourceDictionary>
