<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- R40 light palette: docs/design/machine-studio-design-r25.html, SHA 02262c3c... -->
    <Color x:Key="Color.Shell.WorkbarSurface">#FFFFFF</Color>
    <Color x:Key="Color.Surface.Root">#F3F5F8</Color>
    <Color x:Key="Color.Surface.Panel">#FFFFFF</Color>
    <Color x:Key="Color.Surface.Raised">#EAF0F6</Color>
    <Color x:Key="Color.Surface.Hover">#EDF3F7</Color>
    <Color x:Key="Color.Surface.Selected">#E7F4F0</Color>
    <Color x:Key="Color.Border.Default">#CBD6E2</Color>
    <Color x:Key="Color.Border.Subtle">#DCE3EB</Color>
    <Color x:Key="Color.Text.Primary">#243448</Color>
    <Color x:Key="Color.Text.Secondary">#52687C</Color>
    <Color x:Key="Color.Text.Disabled">#718398</Color>
    <Color x:Key="Color.Text.OnAccent">#FFFFFF</Color>
    <Color x:Key="Color.Accent.Primary">#087F73</Color>
    <Color x:Key="Color.Accent.Pressed">#06584F</Color>
    <Color x:Key="Color.Accent.Hover">#07695F</Color>
    <Color x:Key="Color.Accent.Soft">#E4F4EF</Color>
    <Color x:Key="Color.State.Ready">#52687C</Color>
    <Color x:Key="Color.State.Running">#147854</Color>
    <Color x:Key="Color.State.Paused">#986610</Color>
    <Color x:Key="Color.State.Warning">#986610</Color>
    <Color x:Key="Color.State.Fault">#BD3C50</Color>
    <Color x:Key="Color.State.Forced">#7655AA</Color>
    <Color x:Key="Color.State.Vision">#456ED0</Color>
    <Color x:Key="Color.State.Selected">#087F73</Color>
    <Color x:Key="Color.State.RunningSurface">#EDF8F1</Color>
    <Color x:Key="Color.State.PausedSurface">#FFF8E9</Color>
    <Color x:Key="Color.Scene.Background">#E9EEF4</Color>
    <Color x:Key="Color.Scene.ObliqueGrid">#D5DFE9</Color>
    <Color x:Key="Color.Scene.Grid">#DCE3EB</Color>
    <Color x:Key="Color.Scene.GridMajor">#CBD6E2</Color>
    <Color x:Key="Color.Scene.AxisX">#C24A50</Color>
    <Color x:Key="Color.Scene.AxisY">#23845A</Color>
    <Color x:Key="Color.Scene.AxisZ">#456ED0</Color>
    <Color x:Key="Color.Surface.Input">#FFFFFF</Color>
    <Color x:Key="Color.Surface.Disabled">#F3F5F8</Color>
    <Color x:Key="Color.Surface.Pressed">#DCE9EE</Color>
    <Color x:Key="Color.Surface.Tinted">#F8FAFC</Color>
    <Color x:Key="Color.Surface.Overlay">#E6FFFFFF</Color>
    <Color x:Key="Color.Surface.ModalScrim">#66132F45</Color>
    <Color x:Key="Color.Border.Disabled">#E0E5ED</Color>
    <Color x:Key="Color.State.WarningBorder">#E5CF9A</Color>
    <Color x:Key="Color.State.FaultBorder">#EABEC8</Color>
    <Color x:Key="Color.State.RunningBorder">#B7DBCA</Color>
    <Color x:Key="Color.State.FaultSurface">#FFF0F3</Color>
    <Color x:Key="Color.State.InfoSurface">#F0F6FB</Color>
    <Color x:Key="Color.Scene.ImageBackground">#E9EDF3</Color>
    <Color x:Key="Color.Scene.IconAxis">#287F93</Color>
    <Color x:Key="Color.Scene.IconDigitalIo">#A25D4C</Color>
    <Color x:Key="Color.Scene.Feed">#986610</Color>
    <Color x:Key="Color.Scene.Exit">#A06432</Color>
    <Color x:Key="Color.Scene.GradientCenter">#FFFFFF</Color>
    <Color x:Key="Color.Scene.GradientEdge">#E9EEF4</Color>
    <Color x:Key="Color.Equipment.CardGradientEdge">#EDF3F8</Color>
    <Color x:Key="Color.Scene.Component.Axis">#6DC5D6</Color>
    <Color x:Key="Color.Scene.Component.Cylinder">#70D9C5</Color>
    <Color x:Key="Color.Scene.Component.Sensor">#F0C76F</Color>
    <Color x:Key="Color.Scene.Component.DigitalIo">#E4AA9D</Color>
    <Color x:Key="Color.Scene.Component.Camera">#92A4ED</Color>
    <Color x:Key="Color.Scene.Component.Conveyor">#88A7B6</Color>
    <Color x:Key="Color.Scene.Component.Frame">#314F5E</Color>
    <Color x:Key="Color.Scene.Component.FrameSupport">#537687</Color>
    <Color x:Key="Color.Scene.Component.AxisBase">#476978</Color>
    <Color x:Key="Color.Scene.Component.CylinderRod">#BACBD3</Color>
    <Color x:Key="Color.Scene.Component.CylinderJaw">#EAC77D</Color>
    <Color x:Key="Color.Scene.Component.CameraPost">#688A9B</Color>
    <Color x:Key="Color.Scene.Component.CameraPlate">#9CB7C4</Color>
    <Color x:Key="Color.Scene.Component.ConveyorBase">#375362</Color>
    <Color x:Key="Color.Scene.Component.ConveyorRoller">#9EB1B9</Color>
    <Color x:Key="Color.Scene.Component.Selected">#B9FFF0</Color>
    <Color x:Key="Color.Scene.Component.Outline">#06141C</Color>

    <!-- Semantic brushes shared by the application and view-local resource aliases. -->
    <SolidColorBrush x:Key="Shell.WorkbarSurface" Color="{StaticResource Color.Shell.WorkbarSurface}" />
    <SolidColorBrush x:Key="Surface.Root" Color="{StaticResource Color.Surface.Root}" />
    <SolidColorBrush x:Key="Surface.Panel" Color="{StaticResource Color.Surface.Panel}" />
    <SolidColorBrush x:Key="Surface.Raised" Color="{StaticResource Color.Surface.Raised}" />
    <SolidColorBrush x:Key="Surface.Hover" Color="{StaticResource Color.Surface.Hover}" />
    <SolidColorBrush x:Key="Surface.Selected" Color="{StaticResource Color.Surface.Selected}" />
    <SolidColorBrush x:Key="Border.Default" Color="{StaticResource Color.Border.Default}" />
    <SolidColorBrush x:Key="Border.Subtle" Color="{StaticResource Color.Border.Subtle}" />

    <SolidColorBrush x:Key="Text.Primary" Color="{StaticResource Color.Text.Primary}" />
    <SolidColorBrush x:Key="Text.Secondary" Color="{StaticResource Color.Text.Secondary}" />
    <SolidColorBrush x:Key="Text.Disabled" Color="{StaticResource Color.Text.Disabled}" />
    <SolidColorBrush x:Key="Text.OnAccent" Color="{StaticResource Color.Text.OnAccent}" />

    <SolidColorBrush x:Key="Accent.Primary" Color="{StaticResource Color.Accent.Primary}" />
    <SolidColorBrush x:Key="Accent.Pressed" Color="{StaticResource Color.Accent.Pressed}" />
    <SolidColorBrush x:Key="Accent.Hover" Color="{StaticResource Color.Accent.Hover}" />
    <SolidColorBrush x:Key="Accent.Soft" Color="{StaticResource Color.Accent.Soft}" />
    <SolidColorBrush x:Key="TextControlFocusedBorderBrush" Color="{Binding Color, Source={StaticResource Accent.Primary}}" />

    <SolidColorBrush x:Key="State.Ready" Color="{StaticResource Color.State.Ready}" />
    <SolidColorBrush x:Key="State.Running" Color="{StaticResource Color.State.Running}" />
    <SolidColorBrush x:Key="State.Paused" Color="{StaticResource Color.State.Paused}" />
    <SolidColorBrush x:Key="State.Warning" Color="{StaticResource Color.State.Warning}" />
    <SolidColorBrush x:Key="State.Fault" Color="{StaticResource Color.State.Fault}" />
    <SolidColorBrush x:Key="State.Forced" Color="{StaticResource Color.State.Forced}" />
    <SolidColorBrush x:Key="State.Vision" Color="{StaticResource Color.State.Vision}" />
    <SolidColorBrush x:Key="State.Selected" Color="{StaticResource Color.State.Selected}" />
    <SolidColorBrush x:Key="State.RunningSurface" Color="{StaticResource Color.State.RunningSurface}" />
    <SolidColorBrush x:Key="State.PausedSurface" Color="{StaticResource Color.State.PausedSurface}" />

    <SolidColorBrush x:Key="Scene.Background" Color="{StaticResource Color.Scene.Background}" />
    <SolidColorBrush x:Key="Scene.Component.Axis" Color="{StaticResource Color.Scene.Component.Axis}" />
    <SolidColorBrush x:Key="Scene.Component.Cylinder" Color="{StaticResource Color.Scene.Component.Cylinder}" />
    <SolidColorBrush x:Key="Scene.Component.Sensor" Color="{StaticResource Color.Scene.Component.Sensor}" />
    <SolidColorBrush x:Key="Scene.Component.DigitalIo" Color="{StaticResource Color.Scene.Component.DigitalIo}" />
    <SolidColorBrush x:Key="Scene.Component.Camera" Color="{StaticResource Color.Scene.Component.Camera}" />
    <SolidColorBrush x:Key="Scene.Component.Conveyor" Color="{StaticResource Color.Scene.Component.Conveyor}" />
    <SolidColorBrush x:Key="Scene.Component.Frame" Color="{StaticResource Color.Scene.Component.Frame}" />
    <SolidColorBrush x:Key="Scene.Component.FrameSupport" Color="{StaticResource Color.Scene.Component.FrameSupport}" />
    <SolidColorBrush x:Key="Scene.Component.AxisBase" Color="{StaticResource Color.Scene.Component.AxisBase}" />
    <SolidColorBrush x:Key="Scene.Component.CylinderRod" Color="{StaticResource Color.Scene.Component.CylinderRod}" />
    <SolidColorBrush x:Key="Scene.Component.CylinderJaw" Color="{StaticResource Color.Scene.Component.CylinderJaw}" />
    <SolidColorBrush x:Key="Scene.Component.CameraPost" Color="{StaticResource Color.Scene.Component.CameraPost}" />
    <SolidColorBrush x:Key="Scene.Component.CameraPlate" Color="{StaticResource Color.Scene.Component.CameraPlate}" />
    <SolidColorBrush x:Key="Scene.Component.ConveyorBase" Color="{StaticResource Color.Scene.Component.ConveyorBase}" />
    <SolidColorBrush x:Key="Scene.Component.ConveyorRoller" Color="{StaticResource Color.Scene.Component.ConveyorRoller}" />
    <SolidColorBrush x:Key="Scene.Component.Selected" Color="{StaticResource Color.Scene.Component.Selected}" />
    <SolidColorBrush x:Key="Scene.Component.Outline" Color="{StaticResource Color.Scene.Component.Outline}" />
    <LinearGradientBrush x:Key="Equipment.OverviewCardBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource Color.Scene.GradientCenter}" Offset="0" />
        <GradientStop Color="{StaticResource Color.Equipment.CardGradientEdge}" Offset="1" />
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="Scene.ObliqueBackground" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.75" RadiusY="0.75">
        <GradientStop Color="{StaticResource Color.Scene.GradientCenter}" Offset="0" />
        <GradientStop Color="{StaticResource Color.Scene.GradientEdge}" Offset="1" />
    </RadialGradientBrush>
    <SolidColorBrush x:Key="Scene.ObliqueGrid" Color="{StaticResource Color.Scene.ObliqueGrid}" />
    <SolidColorBrush x:Key="Scene.Grid" Color="{StaticResource Color.Scene.Grid}" />
    <SolidColorBrush x:Key="Scene.GridMajor" Color="{StaticResource Color.Scene.GridMajor}" />
    <SolidColorBrush x:Key="Scene.AxisX" Color="{StaticResource Color.Scene.AxisX}" />
    <SolidColorBrush x:Key="Scene.AxisY" Color="{StaticResource Color.Scene.AxisY}" />
    <SolidColorBrush x:Key="Scene.AxisZ" Color="{StaticResource Color.Scene.AxisZ}" />

    <SolidColorBrush x:Key="Surface.Input" Color="{StaticResource Color.Surface.Input}" />
    <SolidColorBrush x:Key="Surface.Disabled" Color="{StaticResource Color.Surface.Disabled}" />
    <SolidColorBrush x:Key="Surface.Pressed" Color="{StaticResource Color.Surface.Pressed}" />
    <SolidColorBrush x:Key="Surface.Tinted" Color="{StaticResource Color.Surface.Tinted}" />
    <SolidColorBrush x:Key="Surface.Overlay" Color="{StaticResource Color.Surface.Overlay}" />
    <SolidColorBrush x:Key="Surface.ModalScrim" Color="{StaticResource Color.Surface.ModalScrim}" />
    <SolidColorBrush x:Key="Border.Disabled" Color="{StaticResource Color.Border.Disabled}" />
    <SolidColorBrush x:Key="State.WarningBorder" Color="{StaticResource Color.State.WarningBorder}" />
    <SolidColorBrush x:Key="State.FaultBorder" Color="{StaticResource Color.State.FaultBorder}" />
    <SolidColorBrush x:Key="State.RunningBorder" Color="{StaticResource Color.State.RunningBorder}" />
    <SolidColorBrush x:Key="State.FaultSurface" Color="{StaticResource Color.State.FaultSurface}" />
    <SolidColorBrush x:Key="State.InfoSurface" Color="{StaticResource Color.State.InfoSurface}" />
    <SolidColorBrush x:Key="Scene.ImageBackground" Color="{StaticResource Color.Scene.ImageBackground}" />
    <SolidColorBrush x:Key="Scene.IconAxis" Color="{StaticResource Color.Scene.IconAxis}" />
    <SolidColorBrush x:Key="Scene.IconDigitalIo" Color="{StaticResource Color.Scene.IconDigitalIo}" />
    <SolidColorBrush x:Key="Scene.Feed" Color="{StaticResource Color.Scene.Feed}" />
    <SolidColorBrush x:Key="Scene.Exit" Color="{StaticResource Color.Scene.Exit}" />
    <SolidColorBrush x:Key="Scene.GradientCenter" Color="{StaticResource Color.Scene.GradientCenter}" />
    <SolidColorBrush x:Key="Scene.GradientEdge" Color="{StaticResource Color.Scene.GradientEdge}" />
    <SolidColorBrush x:Key="Equipment.CardGradientEdge" Color="{StaticResource Color.Equipment.CardGradientEdge}" />

    <FontFamily x:Key="Typography.FontFamily">Segoe UI Variable Text, Malgun Gothic, Segoe UI</FontFamily>
    <FontFamily x:Key="Typography.Telemetry">Cascadia Mono, Consolas</FontFamily>

    <sys:Double x:Key="Density.PanelHeaderHeight">30</sys:Double>
    <sys:Double x:Key="Density.ToolbarButtonSize">32</sys:Double>
    <sys:Double x:Key="Density.GlobalCommandButtonHeight">34</sys:Double>
    <sys:Double x:Key="Density.TreeRowHeight">26</sys:Double>
    <sys:Double x:Key="Density.DataGridRowHeight">26</sys:Double>
    <sys:Double x:Key="Density.InspectorFieldHeight">30</sys:Double>
    <sys:Double x:Key="Density.StandardMargin">8</sys:Double>
    <sys:Double x:Key="Density.SectionGap">12</sys:Double>
    <sys:Double x:Key="Density.MajorGap">16</sys:Double>
    <CornerRadius x:Key="Density.CornerRadius">6</CornerRadius>

    <!-- Wpf.Ui native control roles use the same R40 accent as the shell. -->
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource Color.Accent.Primary}" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{StaticResource Color.Accent.Hover}" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{StaticResource Color.Accent.Pressed}" />
    <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="{StaticResource Color.Surface.Disabled}" />
    <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush" Color="{StaticResource Color.Accent.Primary}" />
    <SolidColorBrush x:Key="SystemAccentColorSecondaryBrush" Color="{StaticResource Color.Accent.Hover}" />
    <SolidColorBrush x:Key="SystemAccentColorTertiaryBrush" Color="{StaticResource Color.Accent.Pressed}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="{StaticResource Color.Text.OnAccent}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="{StaticResource Color.Text.OnAccent}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorDisabledBrush" Color="{StaticResource Color.Text.Disabled}" />
    <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="{StaticResource Color.Surface.Selected}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSelectedTextBrush" Color="{StaticResource Color.Text.Primary}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="{StaticResource Color.Accent.Primary}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="{StaticResource Color.Accent.Hover}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="{StaticResource Color.Accent.Pressed}" />
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForeground" Color="{StaticResource Color.Text.OnAccent}" />
    <SolidColorBrush x:Key="ComboBoxItemPillFillBrush" Color="{StaticResource Color.Accent.Primary}" />

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Typography.FontFamily}" />
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, FallbackValue={StaticResource Text.Primary}}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="PanelSurfaceStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface.Panel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="PanelHeaderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface.Raised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Height" Value="{StaticResource Density.PanelHeaderHeight}" />
    </Style>

    <Style x:Key="PanelHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SectionCaptionStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="CompactCommandLabelStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="TelemetryTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Typography.Telemetry}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
    </Style>

    <Style x:Key="StatusPillStyle" TargetType="Border">
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Background" Value="{DynamicResource Surface.Raised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="InspectorCardStyle" TargetType="Border">
        <Setter Property="Margin" Value="8,4" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="CornerRadius" Value="{StaticResource Density.CornerRadius}" />
        <Setter Property="Background" Value="{DynamicResource Surface.Raised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style TargetType="TreeView">
        <Setter Property="Background" Value="{DynamicResource Surface.Panel}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4" />
    </Style>

    <Style TargetType="TreeViewItem">
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="{StaticResource Density.TreeRowHeight}" />
        <Setter Property="Padding" Value="2" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Surface.Selected}" />
                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Surface.Hover}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource Surface.Panel}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Surface.Hover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Surface.Selected}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="MachineDataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource Surface.Raised}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Surface.Hover}" />
                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Surface.Selected}" />
                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Text.Disabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LanguageComboBoxStyle"
           TargetType="ComboBox"
           BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Height" Value="24" />
        <Setter Property="MinWidth" Value="82" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="MachineDataGridCellStyle" TargetType="DataGridCell">
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Surface.Selected}" />
                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
                <Setter Property="BorderThickness" Value="1" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Text.Disabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="MachineDataGridRowStyle" TargetType="DataGridRow">
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Surface.Hover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Surface.Selected}" />
                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Text.Disabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource Surface.Panel}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Border.Subtle}" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource Surface.Raised}" />
        <Setter Property="RowHeight" Value="{StaticResource Density.DataGridRowHeight}" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource MachineDataGridColumnHeaderStyle}" />
        <Setter Property="CellStyle" Value="{StaticResource MachineDataGridCellStyle}" />
        <Setter Property="RowStyle" Value="{StaticResource MachineDataGridRowStyle}" />
    </Style>

    <Style TargetType="Menu">
        <Setter Property="Background" Value="{DynamicResource Surface.Root}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
        <Setter Property="Padding" Value="5,0" />
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="FontSize" Value="11.5" />
        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                <Setter Property="Background" Value="{DynamicResource Surface.Hover}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="MachineTopMenuItemStyle" TargetType="MenuItem">
        <Setter Property="Height" Value="25" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border x:Name="HeaderBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Focusable="False"
                               IsOpen="{TemplateBinding IsSubmenuOpen}"
                               Placement="Bottom"
                               PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                               PopupAnimation="Fade">
                            <Border MinWidth="220"
                                    Padding="4"
                                    Background="{DynamicResource Surface.Raised}"
                                    BorderBrush="{DynamicResource Border.Default}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <ScrollViewer CanContentScroll="True"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource Surface.Hover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                        </Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource Surface.Selected}" />
                            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MachineSubmenuItemStyle" TargetType="MenuItem">
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="ItemBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True" />
                            <TextBlock Grid.Column="1"
                                       Margin="20,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Text="{TemplateBinding InputGestureText}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Surface.Hover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Text.Disabled}" />
                            <Setter Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="StatusBar">
        <Setter Property="Background" Value="{DynamicResource Surface.Root}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
    </Style>

    <Style TargetType="GridSplitter">
        <Setter Property="Background" Value="{DynamicResource Border.Default}" />
        <Setter Property="Width" Value="4" />
        <Setter Property="Height" Value="Auto" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Accent.Primary}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="WorkspaceModeRadioStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinWidth" Value="72" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="ModeBorder"
                            Padding="12,0"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ModeBorder" Property="Background" Value="{DynamicResource Surface.Hover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ModeBorder" Property="Background" Value="{DynamicResource Accent.Soft}" />
                            <Setter TargetName="ModeBorder" Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
                            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ModeBorder" Property="Background" Value="{DynamicResource Surface.Selected}" />
                            <Setter TargetName="ModeBorder" Property="BorderBrush" Value="{DynamicResource Accent.Hover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ModeBorder" Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Text.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CommandFocusVisualStyle" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Rectangle Margin="-3" RadiusX="4" RadiusY="4" Stroke="{DynamicResource Accent.Hover}" StrokeThickness="2" StrokeDashArray="2,2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlobalCommandButtonStyle" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource CommandFocusVisualStyle}" />
        <Setter Property="Height" Value="{StaticResource Density.GlobalCommandButtonHeight}" />
        <Setter Property="MinWidth" Value="58" />
        <Setter Property="Margin" Value="3,0" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource Surface.Panel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Surface.Hover}" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource Accent.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Surface.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Text.Disabled}" />
                            <Setter Property="Opacity" Value="1" />
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Surface.Panel}" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryCommandButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource GlobalCommandButtonStyle}">
        <Style.Resources>
            <SolidColorBrush x:Key="Surface.Hover" Color="{StaticResource Color.Accent.Hover}" />
            <SolidColorBrush x:Key="Surface.Pressed" Color="{StaticResource Color.Accent.Pressed}" />
        </Style.Resources>
        <Setter Property="Foreground" Value="{DynamicResource Text.OnAccent}" />
        <Setter Property="Background" Value="{DynamicResource Accent.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
    </Style>

    <Style x:Key="QuietCommandButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource GlobalCommandButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style x:Key="SimulationOnCommandButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource GlobalCommandButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource State.RunningSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource State.Running}" />
    </Style>
            <Style x:Key="ShellChipToggleStyle" TargetType="ToggleButton">
                <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
                <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="{DynamicResource Border.Default}" />
                <Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="8,0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template"><Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ChipBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ChipBorder" Property="Background" Value="{DynamicResource Surface.Hover}" /><Setter TargetName="ChipBorder" Property="BorderBrush" Value="{DynamicResource Accent.Hover}" /></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="ChipBorder" Property="Background" Value="{DynamicResource Accent.Soft}" /><Setter TargetName="ChipBorder" Property="BorderBrush" Value="{DynamicResource Accent.Primary}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ChipBorder" Property="Background" Value="{DynamicResource Surface.Selected}" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ChipBorder" Property="BorderBrush" Value="{DynamicResource Accent.Primary}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource Text.Disabled}" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value></Setter>
            </Style>
            <Style x:Key="WorkspaceTabStyle" TargetType="RadioButton">
                <Setter Property="Height" Value="44" /><Setter Property="Padding" Value="14,0" />
                <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" /><Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template"><Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabSurface" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource Surface.Hover}" /></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource Accent.Soft}" /><Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource Accent.Primary}" /><Setter Property="Foreground" Value="{DynamicResource Accent.Primary}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource Surface.Selected}" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource Accent.Hover}" /><Setter TargetName="TabSurface" Property="BorderThickness" Value="1,1,1,3" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource Text.Disabled}" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value></Setter>
            </Style>

</ResourceDictionary>
