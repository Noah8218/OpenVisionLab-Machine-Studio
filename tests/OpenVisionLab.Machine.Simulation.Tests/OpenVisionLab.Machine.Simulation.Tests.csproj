<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>OpenVisionLab.Machine.Simulation.Tests</RootNamespace>
    <AssemblyName>OpenVisionLab.Machine.Simulation.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenVisionLab.Machine.Simulation\OpenVisionLab.Machine.Simulation.csproj" />
    <ProjectReference Include="..\..\src\OpenVisionLab.Machine.IO\OpenVisionLab.Machine.IO.csproj" />
    <ProjectReference Include="..\..\src\OpenVisionLab.Machine.Sequence\OpenVisionLab.Machine.Sequence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\samples\AutomaticTransferCell\AutomaticTransferCell.ovmachine"
          Link="AutomaticTransferCell.ovmachine"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\samples\sample-pick-and-place.ovmachine"
          Link="sample-pick-and-place.ovmachine"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\samples\SemiconductorRecipes\*.ovmachine"
          Link="SemiconductorRecipes\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
