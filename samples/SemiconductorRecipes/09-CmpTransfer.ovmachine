  "sequences": [
    {
      "id": "automatic-cycle",
      "name": "CMP transfer automatic cycle",
      "steps": [
        {
          "id": "cycle-active",
          "name": "Cycle Active",
          "action": "SetSignal",
          "targetId": "do.cycle-active",
          "parameter": "true",
          "nextStepId": "extend-cylinder"
        },
        {
          "id": "extend-cylinder",
          "name": "Extend Carrier Clamp Cylinder",
          "action": "SetSignal",
          "targetId": "do.cylinder.extend",
          "parameter": "true",
          "nextStepId": "wait-cylinder-extended"
        },
        {
          "id": "wait-cylinder-extended",
          "name": "Wait Carrier Clamp Cylinder Extended",
          "action": "WaitSignal",
          "targetId": "di.cylinder.extended",
          "parameter": "true",
          "timeoutMs": 3000,
          "nextStepId": "start-transport",
          "expectedTargetId": "process-cylinder",
          "expectedState": "Extended"
        },
        {
          "id": "start-transport",
          "name": "Start Wafer Transport",
          "action": "SetSignal",
          "targetId": "do.transport.run",
          "parameter": "true",
          "nextStepId": "wait-process-position"
        },
        {
          "id": "wait-process-position",
          "name": "Wait Polisher Handoff Sensor",
          "action": "WaitSignal",
          "targetId": "di.sensor-process",
          "parameter": "true",
          "timeoutMs": 5000,
          "nextStepId": "stop-transport",
          "expectedTargetId": "sensor-process",
          "expectedState": "Detected"
        },
        {
          "id": "stop-transport",
          "name": "Stop Wafer Transport",
          "action": "SetSignal",
          "targetId": "do.transport.run",
          "parameter": "false",
          "nextStepId": "move-process-axis"
        },
        {
          "id": "move-process-axis",
          "name": "Move CMP Loader Servo Axis",
          "action": "MoveAxis",
          "targetId": "axis.process",
          "parameter": "220",
          "nextStepId": "wait-process-axis"
        },
        {
          "id": "wait-process-axis",
          "name": "Wait CMP Loader Servo Axis",
          "action": "WaitAxisDone",
          "targetId": "axis.process",
          "parameter": "",
          "timeoutMs": 5000,
          "nextStepId": "move-cmp-head",
          "expectedTargetId": "axis.process",
          "expectedState": "Idle"
        },
        {
          "id": "move-cmp-head",
          "name": "Lower CMP Head",
          "action": "MoveAxis",
          "targetId": "axis.cmp-head",
          "parameter": "100",
          "nextStepId": "wait-cmp-head"
        },
        {
          "id": "wait-cmp-head",
          "name": "Wait CMP Head Lift",
          "action": "WaitAxisDone",
          "targetId": "axis.cmp-head",
          "parameter": "",
          "timeoutMs": 5000,
          "expectedTargetId": "axis.cmp-head",
          "expectedState": "Idle",
          "nextStepId": "rotate-cmp-platen"
        },
        {
          "id": "rotate-cmp-platen",
          "name": "Rotate CMP Platen",
          "action": "MoveAxis",
          "targetId": "axis.cmp-platen",
          "parameter": "360",
          "nextStepId": "wait-cmp-platen"
        },
        {
          "id": "wait-cmp-platen",
          "name": "Wait CMP Platen Rotation",
          "action": "WaitAxisDone",
          "targetId": "axis.cmp-platen",
          "parameter": "",
          "timeoutMs": 5000,
          "expectedTargetId": "axis.cmp-platen",
          "expectedState": "Idle",
          "nextStepId": "extend-cmp-load"
        },
        {
          "id": "extend-cmp-load",
          "name": "Apply CMP Head Load",
          "action": "SetSignal",
          "targetId": "do.cmp-head-load.extend",
          "parameter": "true",
          "nextStepId": "wait-cmp-load"
        },
        {
          "id": "wait-cmp-load",
          "name": "Wait CMP Head Load",
          "action": "WaitSignal",
          "targetId": "di.cmp-head-load.extended",
          "parameter": "true",
          "timeoutMs": 3000,
          "expectedTargetId": "cmp-head-load",
          "expectedState": "Extended",
          "nextStepId": "retract-cmp-load"
        },
        {
          "id": "retract-cmp-load",
          "name": "Release CMP Head Load",
          "action": "SetSignal",
          "targetId": "do.cmp-head-load.extend",
          "parameter": "false",
          "nextStepId": "wait-cmp-load-release"
        },
        {
          "id": "wait-cmp-load-release",
          "name": "Wait CMP Head Load Release",
          "action": "WaitSignal",
          "targetId": "di.cmp-head-load.retracted",
          "parameter": "true",
          "timeoutMs": 3000,
          "expectedTargetId": "cmp-head-load",
          "expectedState": "Retracted",
          "nextStepId": "retract-cylinder"
        },
        {
          "id": "retract-cylinder",
          "name": "Retract Carrier Clamp Cylinder",
          "action": "SetSignal",
          "targetId": "do.cylinder.extend",
          "parameter": "false",
          "nextStepId": "wait-cylinder-retracted"
        },
        {
          "id": "wait-cylinder-retracted",
          "name": "Wait Carrier Clamp Cylinder Retracted",
          "action": "WaitSignal",
          "targetId": "di.cylinder.retracted",
          "parameter": "true",
          "timeoutMs": 3000,
          "nextStepId": "cycle-done",
          "expectedTargetId": "process-cylinder",
          "expectedState": "Retracted"
        },
        {
          "id": "cycle-done",
          "name": "Cycle Done",
          "action": "SetSignal",
          "targetId": "do.cycle-done",
          "parameter": "true",
          "nextStepId": "complete",
          "expectedTargetId": "transport",
          "expectedState": "Stopped"
        },
        {
          "id": "complete",
          "name": "Complete",
          "action": "Complete",
          "targetId": "",
          "parameter": ""
        }
      ]
    }
  ]
