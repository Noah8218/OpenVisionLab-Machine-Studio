  "sequences": [
    {
      "id": "automatic-cycle",
      "name": "FOUP load port automatic cycle",
      "steps": [
        {
          "id": "cycle-active",
          "name": "Cycle Active",
          "action": "SetSignal",
          "targetId": "do.cycle-active",
          "parameter": "true",
          "nextStepId": "extend-cylinder"
        },
        {
          "id": "extend-cylinder",
          "name": "Extend FOUP Door Cylinder",
          "action": "SetSignal",
          "targetId": "do.cylinder.extend",
          "parameter": "true",
          "nextStepId": "wait-cylinder-extended"
        },
        {
          "id": "wait-cylinder-extended",
          "name": "Wait FOUP Door Cylinder Extended",
          "action": "WaitSignal",
          "targetId": "di.cylinder.extended",
          "parameter": "true",
          "timeoutMs": 3000,
          "nextStepId": "wait-oht-handoff-ready",
          "expectedTargetId": "process-cylinder",
          "expectedState": "Extended"
        },
        {
          "id": "wait-oht-handoff-ready",
          "name": "Wait OHT Handoff Ready",
          "action": "WaitSignal",
          "targetId": "di.oht.handoff-ready",
          "parameter": "true",
          "timeoutMs": 3000,
          "nextStepId": "start-transport"
        },
        {
          "id": "start-transport",
          "name": "Start Wafer Transport",
          "action": "SetSignal",
          "targetId": "do.transport.run",
          "parameter": "true",
          "nextStepId": "wait-process-position"
        },
        {
          "id": "wait-process-position",
          "name": "Wait Load Position Sensor",
          "action": "WaitSignal",
          "targetId": "di.sensor-process",
          "parameter": "true",
          "timeoutMs": 5000,
          "nextStepId": "stop-transport",
          "expectedTargetId": "sensor-process",
          "expectedState": "Detected"
        },
        {
          "id": "stop-transport",
          "name": "Stop Wafer Transport",
          "action": "SetSignal",
          "targetId": "do.transport.run",
          "parameter": "false",
          "nextStepId": "wait-oht-carrier-transferred"
        },
        {
          "id": "wait-oht-carrier-transferred",
          "name": "Wait OHT Carrier Transferred",
          "action": "WaitSignal",
          "targetId": "di.oht.carrier-transferred",
          "parameter": "true",
          "timeoutMs": 3000,
          "nextStepId": "move-process-axis"
        },
        {
          "id": "move-process-axis",
          "name": "Move Wafer Transfer Servo Axis",
          "action": "MoveAxis",
          "targetId": "axis.process",
          "parameter": "160",
          "nextStepId": "wait-process-axis"
        },
        {
          "id": "wait-process-axis",
          "name": "Wait Wafer Transfer Servo Axis",
          "action": "WaitAxisDone",
          "targetId": "axis.process",
          "parameter": "",
          "timeoutMs": 5000,
          "nextStepId": "retract-cylinder",
          "expectedTargetId": "axis.process",
          "expectedState": "Idle"
        },
        {
          "id": "retract-cylinder",
          "name": "Retract FOUP Door Cylinder",
          "action": "SetSignal",
          "targetId": "do.cylinder.extend",
          "parameter": "false",
          "nextStepId": "wait-cylinder-retracted"
        },
        {
          "id": "wait-cylinder-retracted",
          "name": "Wait FOUP Door Cylinder Retracted",
          "action": "WaitSignal",
          "targetId": "di.cylinder.retracted",
          "parameter": "true",
          "timeoutMs": 3000,
          "nextStepId": "cycle-done",
          "expectedTargetId": "process-cylinder",
          "expectedState": "Retracted"
        },
        {
          "id": "cycle-done",
          "name": "Cycle Done",
          "action": "SetSignal",
          "targetId": "do.cycle-done",
          "parameter": "true",
          "nextStepId": "complete",
          "expectedTargetId": "transport",
          "expectedState": "Stopped"
        },
        {
          "id": "complete",
          "name": "Complete",
          "action": "Complete",
          "targetId": "",
          "parameter": ""
        }
      ]
    }
