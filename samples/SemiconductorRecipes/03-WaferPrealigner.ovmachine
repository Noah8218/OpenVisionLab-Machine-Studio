  "sequences": [
    {
      "id": "automatic-cycle",
      "name": "wafer prealignment automatic cycle",
      "steps": [
        {
          "id": "cycle-active",
          "name": "Cycle Active",
          "action": "SetSignal",
          "targetId": "do.cycle-active",
          "parameter": "true",
          "nextStepId": "start-transport"
        },
        {
          "id": "start-transport",
          "name": "Start Wafer Transport",
          "action": "SetSignal",
          "targetId": "do.transport.run",
          "parameter": "true",
          "nextStepId": "wait-process-position"
        },
        {
          "id": "wait-process-position",
          "name": "Wait Alignment Position Sensor",
          "action": "WaitSignal",
          "targetId": "di.sensor-process",
          "parameter": "true",
          "timeoutMs": 5000,
          "nextStepId": "stop-transport",
          "expectedTargetId": "sensor-process",
          "expectedState": "Detected"
        },
        {
          "id": "stop-transport",
          "name": "Stop Wafer Transport",
          "action": "SetSignal",
          "targetId": "do.transport.run",
          "parameter": "false",
          "nextStepId": "extend-cylinder"
        },
        {
          "id": "extend-cylinder",
          "name": "Clamp Wafer At Alignment Position",
          "action": "SetSignal",
          "targetId": "do.cylinder.extend",
          "parameter": "true",
          "nextStepId": "wait-cylinder-extended"
        },
        {
          "id": "wait-cylinder-extended",
          "name": "Wait Wafer Clamp Extended",
          "action": "WaitSignal",
          "targetId": "di.cylinder.extended",
          "parameter": "true",
          "timeoutMs": 3000,
          "nextStepId": "wait-alignment-ready",
          "expectedTargetId": "process-cylinder",
          "expectedState": "Extended"
        },
        {
          "id": "wait-alignment-ready",
          "name": "Wait Pre-aligner Ready",
          "action": "WaitSignal",
          "targetId": "di.alignment-ready",
          "parameter": "true",
          "timeoutMs": 3000,
          "nextStepId": "move-process-axis"
        },
        {
          "id": "move-process-axis",
          "name": "Move Prealign Stage Servo Axis",
          "action": "MoveAxis",
          "targetId": "axis.process",
          "parameter": "210",
          "nextStepId": "wait-process-axis"
        },
        {
          "id": "wait-process-axis",
          "name": "Wait Prealign Stage Servo Axis",
          "action": "WaitAxisDone",
          "targetId": "axis.process",
          "parameter": "",
          "timeoutMs": 5000,
          "nextStepId": "rotate-alignment-table",
          "expectedTargetId": "axis.process",
          "expectedState": "Idle"
        },
        {
          "id": "rotate-alignment-table",
          "name": "Rotate Wafer To Notch Reference",
          "action": "MoveAxis",
          "targetId": "axis.alignment-rotation",
          "parameter": "180",
          "nextStepId": "wait-alignment-table"
        },
        {
          "id": "wait-alignment-table",
          "name": "Wait Wafer Alignment Rotation",
          "action": "WaitAxisDone",
          "targetId": "axis.alignment-rotation",
          "parameter": "",
          "timeoutMs": 5000,
          "expectedTargetId": "axis.alignment-rotation",
          "expectedState": "Idle",
          "nextStepId": "accept-alignment"
        },
        {
          "id": "accept-alignment",
          "name": "Accept Notch Alignment",
          "action": "SetSignal",
          "targetId": "do.alignment-accepted",
          "parameter": "true",
          "nextStepId": "wait-alignment-complete"
        },
        {
          "id": "wait-alignment-complete",
          "name": "Wait Alignment Complete",
          "action": "WaitSignal",
          "targetId": "di.alignment-complete",
          "parameter": "true",
          "timeoutMs": 3000,
          "nextStepId": "retract-cylinder"
        },
        {
          "id": "retract-cylinder",
          "name": "Retract Wafer Clamp Cylinder",
          "action": "SetSignal",
          "targetId": "do.cylinder.extend",
          "parameter": "false",
          "nextStepId": "wait-cylinder-retracted"
        },
        {
          "id": "wait-cylinder-retracted",
          "name": "Wait Wafer Clamp Cylinder Retracted",
          "action": "WaitSignal",
          "targetId": "di.cylinder.retracted",
          "parameter": "true",
          "timeoutMs": 3000,
          "nextStepId": "cycle-done",
          "expectedTargetId": "process-cylinder",
          "expectedState": "Retracted"
        },
        {
          "id": "cycle-done",
          "name": "Cycle Done",
          "action": "SetSignal",
          "targetId": "do.cycle-done",
          "parameter": "true",
          "nextStepId": "complete",
          "expectedTargetId": "transport",
          "expectedState": "Stopped"
        },
        {
          "id": "complete",
          "name": "Complete",
          "action": "Complete",
          "targetId": "",
          "parameter": ""
        }
      ]
    }
  ]
