  "sequences": [
    {
      "id": "automatic-cycle",
      "name": "metrology sorting automatic cycle",
      "steps": [
        {
          "id": "cycle-active",
          "name": "Cycle Active",
          "action": "SetSignal",
          "targetId": "do.cycle-active",
          "parameter": "true",
          "nextStepId": "extend-cylinder"
        },
        {
          "id": "extend-cylinder",
          "name": "Extend Sort Gate Cylinder",
          "action": "SetSignal",
          "targetId": "do.cylinder.extend",
          "parameter": "true",
          "nextStepId": "wait-cylinder-extended"
        },
        {
          "id": "wait-cylinder-extended",
          "name": "Wait Sort Gate Cylinder Extended",
          "action": "WaitSignal",
          "targetId": "di.cylinder.extended",
          "parameter": "true",
          "timeoutMs": 3000,
          "nextStepId": "start-transport",
          "expectedTargetId": "process-cylinder",
          "expectedState": "Extended"
        },
        {
          "id": "start-transport",
          "name": "Start Wafer Transport",
          "action": "SetSignal",
          "targetId": "do.transport.run",
          "parameter": "true",
          "nextStepId": "wait-process-position"
        },
        {
          "id": "wait-process-position",
          "name": "Wait Measurement Position Sensor",
          "action": "WaitSignal",
          "targetId": "di.sensor-process",
          "parameter": "true",
          "timeoutMs": 5000,
          "nextStepId": "stop-transport",
          "expectedTargetId": "sensor-process",
          "expectedState": "Detected"
        },
        {
          "id": "stop-transport",
          "name": "Stop Wafer Transport",
          "action": "SetSignal",
          "targetId": "do.transport.run",
          "parameter": "false",
          "nextStepId": "move-process-axis"
        },
        {
          "id": "move-process-axis",
          "name": "Move Metrology Scan Servo Axis",
          "action": "MoveAxis",
          "targetId": "axis.process",
          "parameter": "280",
          "nextStepId": "wait-process-axis"
        },
        {
          "id": "wait-process-axis",
          "name": "Wait Metrology Scan Servo Axis",
          "action": "WaitAxisDone",
          "targetId": "axis.process",
          "parameter": "",
          "timeoutMs": 5000,
          "nextStepId": "retract-cylinder",
          "expectedTargetId": "axis.process",
          "expectedState": "Idle"
        },
        {
          "id": "retract-cylinder",
          "name": "Retract Sort Gate Cylinder",
          "action": "SetSignal",
          "targetId": "do.cylinder.extend",
          "parameter": "false",
          "nextStepId": "wait-cylinder-retracted"
        },
        {
          "id": "wait-cylinder-retracted",
          "name": "Wait Sort Gate Cylinder Retracted",
          "action": "WaitSignal",
          "targetId": "di.cylinder.retracted",
          "parameter": "true",
          "timeoutMs": 3000,
          "nextStepId": "trigger-metrology-camera",
          "expectedTargetId": "process-cylinder",
          "expectedState": "Retracted"
        },
        {
          "id": "trigger-metrology-camera",
          "name": "Trigger Metrology Inspection",
          "action": "TriggerCamera",
          "targetId": "camera.metrology",
          "parameter": "metrology-disposition",
          "nextStepId": "wait-metrology-result"
        },
        {
          "id": "wait-metrology-result",
          "name": "Wait Metrology Disposition",
          "action": "WaitVisionResult",
          "targetId": "camera.metrology",
          "parameter": "",
          "timeoutMs": 2000,
          "nextStepId": "start-pass-transport",
          "failureStepId": "start-sort-transport"
        },
        {
          "id": "start-pass-transport",
          "name": "Start Pass Route Conveyor",
          "action": "SetSignal",
          "targetId": "do.transport.run",
          "parameter": "true",
          "nextStepId": "wait-pass-routed"
        },
        {
          "id": "wait-pass-routed",
          "name": "Wait Pass Route Selection",
          "action": "WaitSignal",
          "targetId": "di.sort.pass-routed",
          "parameter": "true",
          "timeoutMs": 2000,
          "nextStepId": "stop-pass-transport"
        },
        {
          "id": "stop-pass-transport",
          "name": "Stop Pass Route Conveyor",
          "action": "SetSignal",
          "targetId": "do.transport.run",
          "parameter": "false",
          "nextStepId": "cycle-done"
        },
        {
          "id": "start-sort-transport",
          "name": "Start NG Route Conveyor",
          "action": "SetSignal",
          "targetId": "do.sort-transport.run",
          "parameter": "true",
          "nextStepId": "wait-ng-routed"
        },
        {
          "id": "wait-ng-routed",
          "name": "Wait NG Route Selection",
          "action": "WaitSignal",
          "targetId": "di.sort.ng-routed",
          "parameter": "true",
          "timeoutMs": 2000,
          "nextStepId": "wait-sort-confirm"
        },
        {
          "id": "wait-sort-confirm",
          "name": "Wait NG Output Confirmation",
          "action": "WaitSignal",
          "targetId": "di.sensor-sort-confirm",
          "parameter": "true",
          "timeoutMs": 5000,
          "expectedTargetId": "sensor-sort-confirm",
          "expectedState": "Detected",
          "nextStepId": "stop-sort-transport"
        },
        {
          "id": "stop-sort-transport",
          "name": "Stop NG Route Conveyor",
          "action": "SetSignal",
          "targetId": "do.sort-transport.run",
          "parameter": "false",
          "nextStepId": "cycle-done"
        },
        {
          "id": "cycle-done",
          "name": "Cycle Done",
          "action": "SetSignal",
          "targetId": "do.cycle-done",
          "parameter": "true",
          "nextStepId": "complete",
          "expectedTargetId": "transport",
          "expectedState": "Stopped"
        },
        {
          "id": "complete",
          "name": "Complete",
          "action": "Complete",
          "targetId": "",
          "parameter": ""
        }
      ]
    }
  ]
}
