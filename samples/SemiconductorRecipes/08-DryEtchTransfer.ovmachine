  "sequences": [
    {
      "id": "automatic-cycle",
      "name": "dry-etch transfer automatic cycle",
      "steps": [
        {
          "id": "cycle-active",
          "name": "Cycle Active",
          "action": "SetSignal",
          "targetId": "do.cycle-active",
          "parameter": "true",
          "nextStepId": "extend-cylinder"
        },
        {
          "id": "extend-cylinder",
          "name": "Extend Chamber Slit Valve Cylinder",
          "action": "SetSignal",
          "targetId": "do.cylinder.extend",
          "parameter": "true",
          "nextStepId": "wait-cylinder-extended"
        },
        {
          "id": "wait-cylinder-extended",
          "name": "Wait Chamber Slit Valve Cylinder Extended",
          "action": "WaitSignal",
          "targetId": "di.cylinder.extended",
          "parameter": "true",
          "timeoutMs": 3000,
          "nextStepId": "start-transport",
          "expectedTargetId": "process-cylinder",
          "expectedState": "Extended"
        },
        {
          "id": "start-transport",
          "name": "Start Wafer Transport",
          "action": "SetSignal",
          "targetId": "do.transport.run",
          "parameter": "true",
          "nextStepId": "wait-chamber-entry"
        },
        {
          "id": "wait-chamber-entry",
          "name": "Wait Etch Chamber Entry",
          "action": "WaitSignal",
          "targetId": "di.sensor-chamber-entry",
          "parameter": "true",
          "timeoutMs": 5000,
          "expectedTargetId": "sensor-chamber-entry",
          "expectedState": "Detected",
          "nextStepId": "wait-process-position"
        },
        {
          "id": "wait-process-position",
          "name": "Wait Chamber Handoff Sensor",
          "action": "WaitSignal",
          "targetId": "di.sensor-process",
          "parameter": "true",
          "timeoutMs": 5000,
          "nextStepId": "stop-transport",
          "expectedTargetId": "sensor-process",
          "expectedState": "Detected"
        },
        {
          "id": "stop-transport",
          "name": "Stop Wafer Transport",
          "action": "SetSignal",
          "targetId": "do.transport.run",
          "parameter": "false",
          "nextStepId": "move-process-axis"
        },
        {
          "id": "move-process-axis",
          "name": "Move Chamber Transfer Servo Axis",
          "action": "MoveAxis",
          "targetId": "axis.process",
          "parameter": "260",
          "nextStepId": "wait-process-axis"
        },
        {
          "id": "wait-process-axis",
          "name": "Wait Chamber Transfer Servo Axis",
          "action": "WaitAxisDone",
          "targetId": "axis.process",
          "parameter": "",
          "timeoutMs": 5000,
          "nextStepId": "pick-wafer",
          "expectedTargetId": "axis.process",
          "expectedState": "Idle"
        },
        {
          "id": "pick-wafer",
          "name": "Pick Wafer At Handoff",
          "action": "SetSignal",
          "targetId": "do.handler.pick",
          "parameter": "true",
          "nextStepId": "wait-handler-holding"
        },
        {
          "id": "wait-handler-holding",
          "name": "Wait Wafer Handler Holding",
          "action": "WaitSignal",
          "targetId": "di.handler.holding",
          "parameter": "true",
          "timeoutMs": 1000,
          "nextStepId": "release-pick-command"
        },
        {
          "id": "release-pick-command",
          "name": "Release Wafer Pick Command",
          "action": "SetSignal",
          "targetId": "do.handler.pick",
          "parameter": "false",
          "nextStepId": "extend-chamber-gate"
        },
        {
          "id": "extend-chamber-gate",
          "name": "Open Etch Chamber Gate",
          "action": "SetSignal",
          "targetId": "do.chamber-gate.extend",
          "parameter": "true",
          "nextStepId": "wait-chamber-gate-open"
        },
        {
          "id": "wait-chamber-gate-open",
          "name": "Wait Etch Chamber Gate Open",
          "action": "WaitSignal",
          "targetId": "di.chamber-gate.extended",
          "parameter": "true",
          "timeoutMs": 4000,
          "expectedTargetId": "chamber-gate",
          "expectedState": "Extended",
          "nextStepId": "move-robot-reach"
        },
        {
          "id": "move-robot-reach",
          "name": "Move Transfer Robot Into Chamber",
          "action": "MoveAxis",
          "targetId": "axis.robot-reach",
          "parameter": "140",
          "nextStepId": "wait-robot-reach"
        },
        {
          "id": "wait-robot-reach",
          "name": "Wait Transfer Robot Reach",
          "action": "WaitAxisDone",
          "targetId": "axis.robot-reach",
          "parameter": "",
          "timeoutMs": 5000,
          "expectedTargetId": "axis.robot-reach",
          "expectedState": "Idle",
          "nextStepId": "place-wafer"
        },
        {
          "id": "place-wafer",
          "name": "Place Wafer In Chamber",
          "action": "SetSignal",
          "targetId": "do.handler.place",
          "parameter": "true",
          "nextStepId": "wait-handler-placed"
        },
        {
          "id": "wait-handler-placed",
          "name": "Wait Wafer Handler Placed",
          "action": "WaitSignal",
          "targetId": "di.handler.placed",
          "parameter": "true",
          "timeoutMs": 1000,
          "nextStepId": "release-place-command"
        },
        {
          "id": "release-place-command",
          "name": "Release Wafer Place Command",
          "action": "SetSignal",
          "targetId": "do.handler.place",
          "parameter": "false",
          "nextStepId": "return-robot-reach"
        },
        {
          "id": "return-robot-reach",
          "name": "Return Transfer Robot Reach",
          "action": "MoveAxis",
          "targetId": "axis.robot-reach",
          "parameter": "0",
