        },
        {
          "id": "wait-robot-returned",
          "name": "Wait Transfer Robot Returned",
          "action": "WaitAxisDone",
          "targetId": "axis.robot-reach",
          "parameter": "",
          "timeoutMs": 5000,
          "expectedTargetId": "axis.robot-reach",
          "expectedState": "Idle",
          "nextStepId": "retract-chamber-gate"
        },
        {
          "id": "retract-chamber-gate",
          "name": "Close Etch Chamber Gate",
          "action": "SetSignal",
