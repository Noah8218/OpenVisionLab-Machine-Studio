  "sequences": [
    {
      "id": "automatic-cycle",
      "name": "spin-coat track automatic cycle",
      "steps": [
        {
          "id": "cycle-active",
          "name": "Cycle Active",
          "action": "SetSignal",
          "targetId": "do.cycle-active",
          "parameter": "true",
          "nextStepId": "extend-cylinder"
        },
        {
          "id": "extend-cylinder",
          "name": "Extend Chuck Lift Cylinder",
          "action": "SetSignal",
          "targetId": "do.cylinder.extend",
          "parameter": "true",
          "nextStepId": "wait-cylinder-extended"
        },
        {
          "id": "wait-cylinder-extended",
          "name": "Wait Chuck Lift Cylinder Extended",
          "action": "WaitSignal",
          "targetId": "di.cylinder.extended",
          "parameter": "true",
          "timeoutMs": 3000,
          "nextStepId": "start-transport",
          "expectedTargetId": "process-cylinder",
          "expectedState": "Extended"
        },
        {
          "id": "start-transport",
          "name": "Start Wafer Transport",
          "action": "SetSignal",
          "targetId": "do.transport.run",
          "parameter": "true",
          "nextStepId": "wait-process-position"
        },
        {
          "id": "wait-process-position",
          "name": "Wait Coater Chuck Sensor",
          "action": "WaitSignal",
          "targetId": "di.sensor-process",
          "parameter": "true",
          "timeoutMs": 5000,
          "nextStepId": "stop-transport",
          "expectedTargetId": "sensor-process",
          "expectedState": "Detected"
        },
        {
          "id": "stop-transport",
          "name": "Stop Wafer Transport",
          "action": "SetSignal",
          "targetId": "do.transport.run",
          "parameter": "false",
          "nextStepId": "move-process-axis"
        },
        {
          "id": "move-process-axis",
          "name": "Move Coater Shuttle Servo Axis",
          "action": "MoveAxis",
          "targetId": "axis.process",
          "parameter": "180",
          "nextStepId": "wait-process-axis"
        },
        {
          "id": "wait-process-axis",
          "name": "Wait Coater Shuttle Servo Axis",
          "action": "WaitAxisDone",
          "targetId": "axis.process",
          "parameter": "",
          "timeoutMs": 5000,
          "nextStepId": "rotate-spin-chuck",
          "expectedTargetId": "axis.process",
          "expectedState": "Idle"
        },
        {
          "id": "rotate-spin-chuck",
          "name": "Rotate Spin Chuck",
          "action": "MoveAxis",
          "targetId": "axis.spin-chuck",
          "parameter": "360",
          "nextStepId": "wait-spin-chuck"
        },
        {
          "id": "wait-spin-chuck",
          "name": "Wait Spin Chuck Rotation",
          "action": "WaitAxisDone",
          "targetId": "axis.spin-chuck",
          "parameter": "",
          "timeoutMs": 5000,
          "expectedTargetId": "axis.spin-chuck",
          "expectedState": "Idle",
          "nextStepId": "move-dispense-height"
        },
        {
          "id": "move-dispense-height",
          "name": "Lower Coater Dispense Head",
          "action": "MoveAxis",
          "targetId": "axis.dispense-height",
          "parameter": "90",
          "nextStepId": "wait-dispense-height"
        },
        {
          "id": "wait-dispense-height",
          "name": "Wait Dispense Height Axis",
          "action": "WaitAxisDone",
          "targetId": "axis.dispense-height",
          "parameter": "",
          "timeoutMs": 5000,
          "expectedTargetId": "axis.dispense-height",
          "expectedState": "Idle",
          "nextStepId": "retract-cylinder"
        },
        {
          "id": "retract-cylinder",
          "name": "Retract Chuck Lift Cylinder",
          "action": "SetSignal",
          "targetId": "do.cylinder.extend",
          "parameter": "false",
          "nextStepId": "wait-cylinder-retracted"
        },
        {
          "id": "wait-cylinder-retracted",
          "name": "Wait Chuck Lift Cylinder Retracted",
          "action": "WaitSignal",
          "targetId": "di.cylinder.retracted",
          "parameter": "true",
          "timeoutMs": 3000,
          "nextStepId": "cycle-done",
          "expectedTargetId": "process-cylinder",
          "expectedState": "Retracted"
        },
        {
          "id": "cycle-done",
          "name": "Cycle Done",
          "action": "SetSignal",
          "targetId": "do.cycle-done",
          "parameter": "true",
          "nextStepId": "complete",
          "expectedTargetId": "transport",
          "expectedState": "Stopped"
        },
        {
          "id": "complete",
          "name": "Complete",
          "action": "Complete",
          "targetId": "",
          "parameter": ""
        }
      ]
    }
