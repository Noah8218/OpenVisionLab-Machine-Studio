  "sequences": [
    {
      "id": "automatic-cycle",
      "name": "wafer OCR inspection automatic cycle",
      "steps": [
        {
          "id": "cycle-active",
          "name": "Cycle Active",
          "action": "SetSignal",
          "targetId": "do.cycle-active",
          "parameter": "true",
          "nextStepId": "extend-cylinder"
        },
        {
          "id": "extend-cylinder",
          "name": "Extend Inspection Shutter Cylinder",
          "action": "SetSignal",
          "targetId": "do.cylinder.extend",
          "parameter": "true",
          "nextStepId": "wait-cylinder-extended"
        },
        {
          "id": "wait-cylinder-extended",
          "name": "Wait Inspection Shutter Cylinder Extended",
          "action": "WaitSignal",
          "targetId": "di.cylinder.extended",
          "parameter": "true",
          "timeoutMs": 3000,
          "nextStepId": "start-transport",
          "expectedTargetId": "process-cylinder",
          "expectedState": "Extended"
        },
        {
          "id": "start-transport",
          "name": "Start Wafer Transport",
          "action": "SetSignal",
          "targetId": "do.transport.run",
          "parameter": "true",
          "nextStepId": "wait-ocr-trigger"
        },
        {
          "id": "wait-ocr-trigger",
          "name": "Wait OCR Trigger Zone",
          "action": "WaitSignal",
          "targetId": "di.sensor-ocr-trigger",
          "parameter": "true",
          "timeoutMs": 5000,
          "expectedTargetId": "sensor-ocr-trigger",
          "expectedState": "Detected",
          "nextStepId": "wait-process-position"
        },
        {
          "id": "wait-process-position",
          "name": "Wait OCR Trigger Zone Sensor",
          "action": "WaitSignal",
          "targetId": "di.sensor-process",
          "parameter": "true",
          "timeoutMs": 5000,
          "nextStepId": "stop-transport",
          "expectedTargetId": "sensor-process",
          "expectedState": "Detected"
        },
        {
          "id": "stop-transport",
          "name": "Stop Wafer Transport",
          "action": "SetSignal",
          "targetId": "do.transport.run",
          "parameter": "false",
          "nextStepId": "move-process-axis"
        },
        {
          "id": "move-process-axis",
          "name": "Move OCR Scan Servo Axis",
          "action": "MoveAxis",
          "targetId": "axis.process",
          "parameter": "230",
          "nextStepId": "wait-process-axis"
        },
        {
          "id": "wait-process-axis",
          "name": "Wait OCR Scan Servo Axis",
          "action": "WaitAxisDone",
          "targetId": "axis.process",
          "parameter": "",
          "timeoutMs": 5000,
          "nextStepId": "move-ocr-focus",
          "expectedTargetId": "axis.process",
          "expectedState": "Idle"
        },
        {
          "id": "move-ocr-focus",
          "name": "Move OCR Focus Axis",
          "action": "MoveAxis",
          "targetId": "axis.ocr-focus",
          "parameter": "80",
          "nextStepId": "wait-ocr-focus"
        },
        {
          "id": "wait-ocr-focus",
          "name": "Wait OCR Focus Axis",
          "action": "WaitAxisDone",
          "targetId": "axis.ocr-focus",
          "parameter": "",
          "timeoutMs": 5000,
          "expectedTargetId": "axis.ocr-focus",
          "expectedState": "Idle",
          "nextStepId": "wait-inspection-ready"
        },
        {
          "id": "wait-inspection-ready",
          "name": "Wait Inspection Ready",
          "action": "WaitSignal",
          "targetId": "di.inspection-ready",
          "parameter": "true",
          "timeoutMs": 2000,
          "nextStepId": "trigger-ocr-camera"
        },
        {
          "id": "trigger-ocr-camera",
          "name": "Trigger Wafer OCR Inspection",
          "action": "TriggerCamera",
          "targetId": "camera.ocr",
          "parameter": "wafer-ocr-handoff",
          "nextStepId": "wait-ocr-result"
        },
        {
          "id": "wait-ocr-result",
          "name": "Wait Wafer OCR Result",
          "action": "WaitVisionResult",
          "targetId": "camera.ocr",
          "parameter": "",
          "timeoutMs": 2000,
          "nextStepId": "accept-ocr-result",
          "failureStepId": "accept-ocr-result"
        },
        {
          "id": "accept-ocr-result",
          "name": "Accept Wafer OCR Result",
          "action": "SetSignal",
          "targetId": "do.inspection-result-accepted",
          "parameter": "true",
          "nextStepId": "wait-inspection-complete"
        },
        {
          "id": "wait-inspection-complete",
          "name": "Wait Inspection Handoff Complete",
          "action": "WaitSignal",
          "targetId": "di.inspection-complete",
          "parameter": "true",
          "timeoutMs": 2000,
          "nextStepId": "clear-ocr-result-accept"
        },
        {
          "id": "clear-ocr-result-accept",
          "name": "Clear Wafer OCR Result Acceptance",
          "action": "SetSignal",
          "targetId": "do.inspection-result-accepted",
          "parameter": "false",
          "nextStepId": "retract-cylinder"
        },
        {
          "id": "retract-cylinder",
          "name": "Retract Inspection Shutter Cylinder",
          "action": "SetSignal",
          "targetId": "do.cylinder.extend",
          "parameter": "false",
          "nextStepId": "wait-cylinder-retracted"
        },
        {
          "id": "wait-cylinder-retracted",
          "name": "Wait Inspection Shutter Cylinder Retracted",
          "action": "WaitSignal",
          "targetId": "di.cylinder.retracted",
          "parameter": "true",
          "timeoutMs": 3000,
          "nextStepId": "cycle-done",
          "expectedTargetId": "process-cylinder",
          "expectedState": "Retracted"
        },
        {
          "id": "cycle-done",
          "name": "Cycle Done",
          "action": "SetSignal",
          "targetId": "do.cycle-done",
          "parameter": "true",
          "nextStepId": "complete",
          "expectedTargetId": "transport",
          "expectedState": "Stopped"
        },
        {
          "id": "complete",
          "name": "Complete",
          "action": "Complete",
          "targetId": "",
          "parameter": ""
        }
      ]
    }
  ]
}
