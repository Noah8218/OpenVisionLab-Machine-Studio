  "sequences": [
    {
      "id": "automatic-cycle",
      "name": "cassette mapping automatic cycle",
      "steps": [
        {
          "id": "cycle-active",
          "name": "Cycle Active",
          "action": "SetSignal",
          "targetId": "do.cycle-active",
          "parameter": "true",
          "nextStepId": "extend-cylinder"
        },
        {
          "id": "extend-cylinder",
          "name": "Extend Mapper Stop Cylinder",
          "action": "SetSignal",
          "targetId": "do.cylinder.extend",
          "parameter": "true",
          "nextStepId": "wait-cylinder-extended"
        },
        {
          "id": "wait-cylinder-extended",
          "name": "Wait Mapper Stop Cylinder Extended",
          "action": "WaitSignal",
          "targetId": "di.cylinder.extended",
          "parameter": "true",
          "timeoutMs": 3000,
          "nextStepId": "start-transport",
          "expectedTargetId": "process-cylinder",
          "expectedState": "Extended"
        },
        {
          "id": "start-transport",
          "name": "Start Wafer Transport",
          "action": "SetSignal",
          "targetId": "do.transport.run",
          "parameter": "true",
          "nextStepId": "wait-process-position"
        },
        {
          "id": "wait-process-position",
          "name": "Wait Mapping Position Sensor",
          "action": "WaitSignal",
          "targetId": "di.sensor-process",
          "parameter": "true",
          "timeoutMs": 5000,
          "nextStepId": "stop-transport",
          "expectedTargetId": "sensor-process",
          "expectedState": "Detected"
        },
        {
          "id": "stop-transport",
          "name": "Stop Wafer Transport",
          "action": "SetSignal",
          "targetId": "do.transport.run",
          "parameter": "false",
          "nextStepId": "move-process-axis"
        },
        {
          "id": "move-process-axis",
          "name": "Move Mapper Z Servo Axis",
          "action": "MoveAxis",
          "targetId": "axis.process",
          "parameter": "190",
          "nextStepId": "wait-process-axis"
        },
        {
          "id": "wait-process-axis",
          "name": "Wait Mapper Z Servo Axis",
          "action": "WaitAxisDone",
          "targetId": "axis.process",
          "parameter": "",
          "timeoutMs": 5000,
          "nextStepId": "move-mapper-lift",
          "expectedTargetId": "axis.process",
          "expectedState": "Idle"
        },
        {
          "id": "move-mapper-lift",
          "name": "Move Mapper Head To Slot",
          "action": "MoveAxis",
          "targetId": "axis.mapper-lift",
          "parameter": "170",
          "nextStepId": "wait-mapper-lift"
        },
        {
          "id": "wait-mapper-lift",
          "name": "Wait Mapper Head At Slot",
          "action": "WaitAxisDone",
          "targetId": "axis.mapper-lift",
          "parameter": "",
          "timeoutMs": 5000,
          "expectedTargetId": "axis.mapper-lift",
          "expectedState": "Idle",
          "nextStepId": "wait-slot-reference"
        },
        {
          "id": "wait-slot-reference",
          "name": "Confirm Cassette Slot Reference",
          "action": "WaitSignal",
          "targetId": "di.sensor-slot-reference",
          "parameter": "true",
          "timeoutMs": 3000,
          "expectedTargetId": "sensor-slot-reference",
          "expectedState": "Detected",
          "nextStepId": "retract-cylinder"
        },
        {
          "id": "retract-cylinder",
          "name": "Retract Mapper Stop Cylinder",
          "action": "SetSignal",
          "targetId": "do.cylinder.extend",
          "parameter": "false",
          "nextStepId": "wait-cylinder-retracted"
        },
        {
          "id": "wait-cylinder-retracted",
          "name": "Wait Mapper Stop Cylinder Retracted",
          "action": "WaitSignal",
          "targetId": "di.cylinder.retracted",
          "parameter": "true",
          "timeoutMs": 3000,
          "nextStepId": "cycle-done",
          "expectedTargetId": "process-cylinder",
          "expectedState": "Retracted"
        },
        {
          "id": "cycle-done",
          "name": "Cycle Done",
          "action": "SetSignal",
          "targetId": "do.cycle-done",
          "parameter": "true",
          "nextStepId": "complete",
          "expectedTargetId": "transport",
          "expectedState": "Stopped"
        },
        {
          "id": "complete",
          "name": "Complete",
          "action": "Complete",
          "targetId": "",
          "parameter": ""
        }
      ]
    }
  ]
}
