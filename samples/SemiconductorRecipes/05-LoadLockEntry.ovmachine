  "sequences": [
    {
      "id": "automatic-cycle",
      "name": "load-lock entry automatic cycle",
      "steps": [
        {
          "id": "cycle-active",
          "name": "Cycle Active",
          "action": "SetSignal",
          "targetId": "do.cycle-active",
          "parameter": "true",
          "nextStepId": "extend-outer-door"
        },
        {
          "id": "extend-outer-door",
          "name": "Open Load Lock Outer Door",
          "action": "SetSignal",
          "targetId": "do.outer-door.extend",
          "parameter": "true",
          "nextStepId": "wait-outer-door-extended"
        },
        {
          "id": "wait-outer-door-extended",
          "name": "Wait Outer Door Open",
          "action": "WaitSignal",
          "targetId": "di.outer-door.extended",
          "parameter": "true",
          "timeoutMs": 4000,
          "expectedTargetId": "outer-door",
          "expectedState": "Extended",
          "nextStepId": "start-transport"
        },
        {
          "id": "start-transport",
          "name": "Start Wafer Transport",
          "action": "SetSignal",
          "targetId": "do.transport.run",
          "parameter": "true",
          "nextStepId": "wait-process-position"
        },
        {
          "id": "wait-process-position",
          "name": "Wait Load Lock Position Sensor",
          "action": "WaitSignal",
          "targetId": "di.sensor-process",
          "parameter": "true",
          "timeoutMs": 5000,
          "nextStepId": "stop-transport",
          "expectedTargetId": "sensor-process",
          "expectedState": "Detected"
        },
        {
          "id": "stop-transport",
          "name": "Stop Wafer Transport",
          "action": "SetSignal",
          "targetId": "do.transport.run",
          "parameter": "false",
          "nextStepId": "retract-outer-door"
        },
        {
          "id": "retract-outer-door",
          "name": "Close Load Lock Outer Door",
          "action": "SetSignal",
          "targetId": "do.outer-door.extend",
          "parameter": "false",
          "nextStepId": "wait-outer-door-retracted"
        },
        {
          "id": "wait-outer-door-retracted",
          "name": "Wait Outer Door Closed",
          "action": "WaitSignal",
          "targetId": "di.outer-door.retracted",
          "parameter": "true",
          "timeoutMs": 4000,
          "expectedTargetId": "outer-door",
          "expectedState": "Retracted",
          "nextStepId": "start-pump-down"
        },
        {
          "id": "start-pump-down",
          "name": "Start Load Lock Pump Down",
          "action": "SetSignal",
          "targetId": "do.load-lock.evacuate",
          "parameter": "true",
          "nextStepId": "wait-vacuum-ready"
        },
        {
          "id": "wait-vacuum-ready",
          "name": "Wait Load Lock Vacuum Ready",
          "action": "WaitSignal",
          "targetId": "di.load-lock.vacuum-ready",
          "parameter": "true",
          "timeoutMs": 3000,
          "expectedTargetId": "load-lock-1",
          "expectedState": "Vacuum",
          "nextStepId": "extend-cylinder"
        },
        {
          "id": "extend-cylinder",
          "name": "Open Slit Valve",
          "action": "SetSignal",
          "targetId": "do.cylinder.extend",
          "parameter": "true",
          "nextStepId": "wait-cylinder-extended"
        },
        {
          "id": "wait-cylinder-extended",
          "name": "Wait Slit Valve Open",
          "action": "WaitSignal",
          "targetId": "di.cylinder.extended",
          "parameter": "true",
          "timeoutMs": 3000,
          "nextStepId": "move-process-axis",
          "expectedTargetId": "process-cylinder",
          "expectedState": "Extended"
        },
        {
          "id": "move-process-axis",
          "name": "Move Load Lock Transfer Servo Axis",
          "action": "MoveAxis",
          "targetId": "axis.process",
          "parameter": "250",
          "nextStepId": "wait-process-axis"
        },
        {
          "id": "wait-process-axis",
          "name": "Wait Load Lock Transfer Servo Axis",
          "action": "WaitAxisDone",
          "targetId": "axis.process",
          "parameter": "",
          "timeoutMs": 5000,
          "nextStepId": "retract-cylinder",
          "expectedTargetId": "axis.process",
          "expectedState": "Idle"
        },
        {
          "id": "retract-cylinder",
          "name": "Retract Slit Valve Cylinder",
          "action": "SetSignal",
          "targetId": "do.cylinder.extend",
          "parameter": "false",
          "nextStepId": "wait-cylinder-retracted"
        },
        {
          "id": "wait-cylinder-retracted",
          "name": "Wait Slit Valve Cylinder Retracted",
          "action": "WaitSignal",
          "targetId": "di.cylinder.retracted",
          "parameter": "true",
          "timeoutMs": 3000,
          "nextStepId": "stop-pump-down",
          "expectedTargetId": "process-cylinder",
          "expectedState": "Retracted"
        },
        {
          "id": "stop-pump-down",
          "name": "Stop Load Lock Pump Down",
          "action": "SetSignal",
          "targetId": "do.load-lock.evacuate",
          "parameter": "false",
          "nextStepId": "start-vent"
        },
        {
          "id": "start-vent",
          "name": "Start Load Lock Vent",
          "action": "SetSignal",
          "targetId": "do.load-lock.vent",
          "parameter": "true",
          "nextStepId": "wait-atmosphere-ready"
        },
        {
          "id": "wait-atmosphere-ready",
          "name": "Wait Load Lock Atmosphere Ready",
          "action": "WaitSignal",
          "targetId": "di.load-lock.atmosphere-ready",
          "parameter": "true",
          "timeoutMs": 3000,
          "expectedTargetId": "load-lock-1",
          "expectedState": "Atmosphere",
          "nextStepId": "stop-vent"
        },
        {
          "id": "stop-vent",
          "name": "Stop Load Lock Vent",
          "action": "SetSignal",
          "targetId": "do.load-lock.vent",
          "parameter": "false",
          "nextStepId": "cycle-done"
        },
        {
          "id": "cycle-done",
          "name": "Cycle Done",
          "action": "SetSignal",
          "targetId": "do.cycle-done",
          "parameter": "true",
          "nextStepId": "complete",
