  "sequences": [
    {
      "id": "automatic-cycle",
      "name": "developer track automatic cycle",
      "steps": [
        {
          "id": "cycle-active",
          "name": "Cycle Active",
          "action": "SetSignal",
          "targetId": "do.cycle-active",
          "parameter": "true",
          "nextStepId": "extend-cylinder"
        },
        {
          "id": "extend-cylinder",
          "name": "Extend Nozzle Guard Cylinder",
          "action": "SetSignal",
          "targetId": "do.cylinder.extend",
          "parameter": "true",
          "nextStepId": "wait-cylinder-extended"
        },
        {
          "id": "wait-cylinder-extended",
          "name": "Wait Nozzle Guard Cylinder Extended",
          "action": "WaitSignal",
          "targetId": "di.cylinder.extended",
          "parameter": "true",
          "timeoutMs": 3000,
          "nextStepId": "start-transport",
          "expectedTargetId": "process-cylinder",
          "expectedState": "Extended"
        },
        {
          "id": "start-transport",
          "name": "Start Wafer Transport",
          "action": "SetSignal",
          "targetId": "do.transport.run",
          "parameter": "true",
          "nextStepId": "wait-dispense-zone"
        },
        {
          "id": "wait-dispense-zone",
          "name": "Wait Developer Dispense Zone",
          "action": "WaitSignal",
          "targetId": "di.sensor-dispense-zone",
          "parameter": "true",
          "timeoutMs": 5000,
          "expectedTargetId": "sensor-dispense-zone",
          "expectedState": "Detected",
          "nextStepId": "wait-process-position"
        },
        {
          "id": "wait-process-position",
          "name": "Wait Develop Position Sensor",
          "action": "WaitSignal",
          "targetId": "di.sensor-process",
          "parameter": "true",
          "timeoutMs": 5000,
          "nextStepId": "stop-transport",
          "expectedTargetId": "sensor-process",
          "expectedState": "Detected"
        },
        {
          "id": "stop-transport",
          "name": "Stop Wafer Transport",
          "action": "SetSignal",
          "targetId": "do.transport.run",
          "parameter": "false",
          "nextStepId": "move-process-axis"
        },
        {
          "id": "move-process-axis",
          "name": "Move Developer Shuttle Servo Axis",
          "action": "MoveAxis",
          "targetId": "axis.process",
          "parameter": "200",
          "nextStepId": "wait-process-axis"
        },
        {
          "id": "wait-process-axis",
          "name": "Wait Developer Shuttle Servo Axis",
          "action": "WaitAxisDone",
          "targetId": "axis.process",
          "parameter": "",
          "timeoutMs": 5000,
          "nextStepId": "extend-nozzle-guard",
          "expectedTargetId": "axis.process",
          "expectedState": "Idle"
        },
        {
          "id": "extend-nozzle-guard",
          "name": "Open Developer Nozzle Guard",
          "action": "SetSignal",
          "targetId": "do.nozzle-guard.extend",
          "parameter": "true",
          "nextStepId": "wait-nozzle-guard-open"
        },
        {
          "id": "wait-nozzle-guard-open",
          "name": "Wait Nozzle Guard Open",
          "action": "WaitSignal",
          "targetId": "di.nozzle-guard.extended",
          "parameter": "true",
          "timeoutMs": 3000,
          "expectedTargetId": "nozzle-guard",
          "expectedState": "Extended",
          "nextStepId": "retract-nozzle-guard"
        },
        {
          "id": "retract-nozzle-guard",
          "name": "Close Developer Nozzle Guard",
          "action": "SetSignal",
          "targetId": "do.nozzle-guard.extend",
          "parameter": "false",
          "nextStepId": "wait-nozzle-guard-closed"
        },
        {
          "id": "wait-nozzle-guard-closed",
          "name": "Wait Nozzle Guard Closed",
          "action": "WaitSignal",
          "targetId": "di.nozzle-guard.retracted",
          "parameter": "true",
          "timeoutMs": 3000,
          "expectedTargetId": "nozzle-guard",
          "expectedState": "Retracted",
          "nextStepId": "retract-cylinder"
        },
        {
          "id": "retract-cylinder",
          "name": "Retract Nozzle Guard Cylinder",
          "action": "SetSignal",
          "targetId": "do.cylinder.extend",
          "parameter": "false",
          "nextStepId": "wait-cylinder-retracted"
        },
        {
          "id": "wait-cylinder-retracted",
          "name": "Wait Nozzle Guard Cylinder Retracted",
          "action": "WaitSignal",
          "targetId": "di.cylinder.retracted",
          "parameter": "true",
          "timeoutMs": 3000,
          "nextStepId": "cycle-done",
          "expectedTargetId": "process-cylinder",
          "expectedState": "Retracted"
        },
        {
          "id": "cycle-done",
          "name": "Cycle Done",
          "action": "SetSignal",
          "targetId": "do.cycle-done",
          "parameter": "true",
          "nextStepId": "complete",
          "expectedTargetId": "transport",
          "expectedState": "Stopped"
        },
        {
          "id": "complete",
          "name": "Complete",
          "action": "Complete",
          "targetId": "",
          "parameter": ""
        }
      ]
    }
  ]
